integer[1] class=rawConnection,connection 3
> readChar(h, c(2L, 3L, 100L, 4L))
character[3] "he" "llo" " world"
> close(h)
NULL
> h <- rawConnection(hello)
integer[1] class=rawConnection,connection 3
