  $can write
    character[1] "no"
> readBin(r, "raw", 2L)
raw[2] 01 02
> seek(r)
double[1] 2
> seek(r, -1, origin = "end")
double[1] 2
> readBin(r, "raw", 10L)
raw[1] 05
> seek(r, 9)
error: attempt to seek outside the range of the raw connection
> rawConnectionValue(r)
error: 'con' is not an output rawConnection
> writeBin(as.raw(c(0x01)), r)
error: cannot write to this connection
> close(r)
NULL
> w <- rawConnection(nothing, "w")
integer[1] class=rawConnection,connection 3
> summary.connection(w)
list[7]
  $description
    character[1] "nothing"
  $class
    character[1] "rawConnection"
  $mode
    character[1] "w"
  $text
    character[1] "binary"
  $opened
    character[1] "opened"
  $can read
    character[1] "no"
  $can write
    character[1] "yes"
> writeBin(c(1.5, -2), w)
NULL
> writeBin(c(1L, 2L), w)
NULL
> writeBin(c(TRUE, NA), w)
NULL
> writeBin(c("ab", "c"), w)
NULL
> writeBin(1L, w, size = 2L, endian = "big")
NULL
> v <- rawConnectionValue(w)
raw[39] 00 00 00 00 00 00 f8 3f 00 00 00 00 00 00 00 c0 01 00 00 00 02 00 00 00 01 00 00 00 00 00 00 80 61 62 00 63 00 00 01
> readLines(w)
error: cannot read from this connection
> close(w)
NULL
> r <- rawConnection(v)
integer[1] class=rawConnection,connection 3
> readBin(r, "double", 2L)
double[2] 1.5 -2
> readBin(r, "integer", 2L)
integer[2] 1 2
> readBin(r, "logical", 2L)
logical[2] TRUE NA
> readBin(r, "character", 2L)
character[2] "ab" "c"
> readBin(r, "integer", 1L, size = 2L, endian = "big")
integer[1] 1
> readBin(r, "integer", 1L)
integer[0]
> close(r)
NULL
> a <- rawConnection(bytes, "a")
integer[1] class=rawConnection,connection 3
> writeBin(as.raw(c(0x09)), a)
NULL
> rawConnectionValue(a)
raw[6] 01 02 03 04 05 09
> seek(a)
double[1] 6
> close(a)
NULL
> s <- rawConnection(signed)
integer[1] class=rawConnection,connection 3
> readBin(s, "integer", 2L, size = 1L, signed = FALSE)
integer[2] 255 255
> readBin(s, "int", 5L, size = 1L)
integer[4] 1 2 3 4
> close(s)
NULL
> readBin(signed, "integer", 3L, size = 2L)
integer[3] -1 513 1027
> readBin(signed, "integer", 1L, size = 3L)
error: size 3 is unknown on this machine
> writeBin(c(7L, 8L), nothing)
raw[8] 07 00 00 00 08 00 00 00
