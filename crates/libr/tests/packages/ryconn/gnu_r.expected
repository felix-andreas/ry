# file_reading
> con <- file(file.path(.dir, "a.txt"))
integer[1] class=file,connection 3
> summary.connection(con)
list[7]
  $description
    character[1] "<dir>/a.txt"
  $class
    character[1] "file"
  $mode
    character[1] "r"
  $text
    character[1] "text"
  $opened
    character[1] "closed"
  $can read
    character[1] "yes"
  $can write
    character[1] "yes"
> isOpen(con)
logical[1] FALSE
> readLines(con)
character[2] "a" "b"
> isOpen(con)
logical[1] FALSE
> open(con, "r")
NULL
> summary.connection(con)
list[7]
  $description
    character[1] "<dir>/a.txt"
  $class
    character[1] "file"
  $mode
    character[1] "r"
  $text
    character[1] "text"
  $opened
    character[1] "opened"
  $can read
    character[1] "yes"
  $can write
    character[1] "no"
> seek(con)
double[1] 0
> readLines(con, n = 1L)
character[1] "a"
> seek(con)
double[1] 2
> readLines(con)
character[1] "b"
> readLines(con)
character[0]
> open(con, "r")
NULL
warning: connection is already open
> seek(con, 0)
double[1] 4
> readLines(con)
character[2] "a" "b"
> close(con)
integer[1] 0
> readLines(con)
error: invalid connection
> summary.connection(con)
error: invalid connection
# file_writing
> con <- file(file.path(.dir, "b.txt"), "w")
integer[1] class=file,connection 3
> writeLines(c("x", "y"), con, sep = "|")
NULL
> isOpen(con, "write")
logical[1] TRUE
> isOpen(con, "read")
logical[1] FALSE
> readLines(con)
error: cannot read from this connection
> flush(con)
NULL
> close(con)
integer[1] 0
> readLines(file.path(.dir, "b.txt"))
character[1] "x|y|"
warning: incomplete final line found on '<dir>/b.txt'
> con <- file(file.path(.dir, "b.txt"), "a")
integer[1] class=file,connection 3
> summary.connection(con)
list[7]
  $description
    character[1] "<dir>/b.txt"
  $class
    character[1] "file"
  $mode
    character[1] "a"
  $text
    character[1] "text"
  $opened
    character[1] "opened"
  $can read
    character[1] "no"
  $can write
    character[1] "yes"
> writeLines("z", con)
NULL
> close(con)
integer[1] 0
> readChar(file.path(.dir, "b.txt"), 100L)
character[1] "x|y|z\n"
> writeLines(c("one", "two"), file.path(.dir, "c.txt"))
NULL
> readLines(file.path(.dir, "c.txt"))
character[2] "one" "two"
> con <- file(file.path(.dir, "b.txt"))
integer[1] class=file,connection 3
> open(con, "r+")
NULL
> readLines(con, n = 1L)
character[1] "x|y|z"
> writeLines("Q", con)
NULL
> seek(con, rw = "write")
double[1] 2
> seek(con, rw = "read")
double[1] 6
> close(con)
integer[1] 0
> readChar(file.path(.dir, "b.txt"), 100L)
character[1] "Q\ny|z\n"
> con <- file(file.path(.dir, "b.txt"), "r+")
integer[1] class=file,connection 3
> seek(con, 2)
double[1] 0
> truncate(con)
NULL
> close(con)
integer[1] 0
> readChar(file.path(.dir, "b.txt"), 100L)
character[1] "Q\n"
