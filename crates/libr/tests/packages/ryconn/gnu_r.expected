# line_endings_and_nul
> readLines(file.path(.dir, "d.txt"))
character[4] "" "A" "B" "C"
warning: incomplete final line found on '<dir>/d.txt'
> readLines(file.path(.dir, "d.txt"), warn = FALSE)
character[4] "" "A" "B" "C"
> readLines(file.path(.dir, "d.txt"), n = 5L, ok = FALSE)
error: too few lines read in readLines
warning: incomplete final line found on '<dir>/d.txt'
> readLines(file.path(.dir, "d.txt"), n = 2L)
character[2] "" "A"
> readLines(file.path(.dir, "e.txt"))
character[2] "a" "c"
warning: line 1 appears to contain an embedded nul
> readLines(file.path(.dir, "e.txt"), skipNul = TRUE)
character[2] "ab" "c"
> readLines(file.path(.dir, "empty.txt"))
character[0]
# push_back
> con <- file(file.path(.dir, "a.txt"), "r")
integer[1] class=file,connection 3
> pushBack(c("one", "two"), con)
NULL
> pushBackLength(con)
integer[1] 2
> readLines(con, n = 1L)
character[1] "one"
> pushBackLength(con)
integer[1] 1
> pushBack("pp", con, newLine = FALSE)
NULL
> readLines(con)
character[3] "pptwo" "a" "b"
> pushBack(c("gone"), con)
NULL
> clearPushBack(con)
NULL
> pushBackLength(con)
integer[1] 0
> readLines(con)
character[0]
> close(con)
integer[1] 0
# raw_connections
> r <- rawConnection(bytes)
integer[1] class=rawConnection,connection 3
> summary.connection(r)
list[7]
  $description
    character[1] "bytes"
  $class
    character[1] "rawConnection"
  $mode
    character[1] "r"
  $text
    character[1] "binary"
  $opened
    character[1] "opened"
