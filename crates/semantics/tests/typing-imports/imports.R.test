  d <- as.Date("2020-01-01") - 2 * x
  d < as.Date("2021-01-01")
}
#++++
f: <T: arithmetic> fn(x: T) -> logical

#---- polars_members_are_typed
library(polars)
frame <- as_polars_df(data.frame(x = c(1, 2)))
doubled <- frame$with_columns((pl$col("x") * 2)$alias("y"))
