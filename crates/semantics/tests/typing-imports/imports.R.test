#---- a_qualified_call_reads_its_own_namespace_s_declaration
#namespace import(rugarch)
#: fn(fit: Any) -> double
residual_scale <- function(fit) stats::sigma(fit)

#: fn(fit: uGARCHfit) -> matrix
volatility <- function(fit) sigma(fit)

#: fn(fit: uGARCHfit) -> matrix
qualified_volatility <- function(fit) rugarch::sigma(fit)
#++++
residual_scale: fn(fit: Any) -> double
volatility: fn(fit: uGARCHfit) -> matrix
qualified_volatility: fn(fit: uGARCHfit) -> matrix

#---- a_foreach_body_sees_its_iterators
#namespace import(foreach)
#: fn(groups: list[integer[]]) -> integer[]
totals <- function(groups) {
  foreach(g = groups, .combine = c) %do% sum(g)
}

#: fn(groups: list[integer[]]) -> Any
fields <- function(groups) {
  foreach(g = groups) %do% g$name
}

#: fn(n: integer) -> list[list[integer]]
pairs <- function(n) {
  foreach(i = seq_len(n)) %:% when(i > 1L) %:% foreach(j = seq_len(i)) %do% (i + j)
}

#: fn(xs: double[]) -> double
running <- function(xs) {
  total <- 0
  foreach(x = xs) %do% {
    total <- total + x
  }
  total
}

#: fn(groups: list[double[]], weights: double[]) -> list[double]
weighted <- function(groups, weights) {
  foreach(g = groups, w = weights) %dopar% {
    s <- sum(g)
    s * w
  }
}
#++++
totals: fn(groups: list[integer[]]) -> integer[]
fields: fn(groups: list[integer[]]) -> Any
pairs: fn(n: integer) -> list[list[integer]]
running: fn(xs: double[]) -> double
weighted: fn(groups: list[double[]], weights: double[]) -> list[double]
245..251 error[type-mismatch] R's `$` operator is invalid on atomic vectors, and this value is `integer[]`. Extract an element with `[[` instead

#---- a_subclass_subsets_with_its_own_method_before_its_representation
#namespace importFrom(xts, xts)
#namespace importFrom(zoo, index)
f <- function(x, at, n) {
  series <- xts(x, at)
  series[1:n] * series[1:n]
}
#++++
f: <T, U, V: scalar numeric> fn(x: T, at: U, n: V) -> xts

#==== s3_registrations
#---- a_registered_method_of_a_stubbed_generic_leaves_its_result_unchecked
#namespace S3method(str, Logger)
str.Logger <- function(object, ...) {
  cat("logger\n")
  invisible(TRUE)
}
report <- function(x) {
  log <- structure(list(level = 1), class = "Logger")
  if (str(log, x)) "shown" else "hidden"
}
#++++
str.Logger: <T> fn([object]: T, ...: Any) -> logical
report: <T> fn(x: T) -> character

#---- without_a_registration_the_stubbed_generic_s_result_is_checked
#namespace export(report)
report <- function(x) {
  log <- structure(list(level = 1), class = "Logger")
  if (str(log, x)) "shown" else "hidden"
}
#++++
report: Unknown
110..121 error[type-mismatch] expected `logical`, found `NULL`

#---- a_package_that_registers_its_methods_checks_only_those
#namespace S3method(mpfr, default)
#namespace S3method(mpfr, bigz, mpfr_from_bigz)
#namespace S3method(mpfr, character, mpfr_from_text)
mpfr <- function(x, precBits, ...) UseMethod("mpfr")
mpfr.default <- function(x, ...) x
mpfr_from_bigz <- function(x, precBits, ...) x
mpfr_from_text <- function(text, ...) text
mpfr.is.0 <- function(x) x == 0
#++++
mpfr: <T, U> fn([x]: T, [precBits]: U, ...: Any) -> Any
mpfr.default: <T> fn(x: T, ...: Any) -> T
mpfr_from_bigz: <T, U> fn(x: T, [precBits]: U, ...: Any) -> T
mpfr_from_text: <T> fn(text: T, ...: Any) -> T
mpfr.is.0: <T> fn(x: T) -> logical
298..302 warning[s3-method-signature] this method of `mpfr` takes `text` where the generic takes `x`, so a call that passes `x` by name fails for this class. Rename it to `x`
