#---- attaching_the_project_itself_buys_no_tolerance
# `usethis` writes `library(yourpkg)` into `tests/testthat.R`, so this shape is
# in every testthat package. Your own exports are the definitions the checker
# already sees, so the unknowable-export-set tolerance does not apply.
#description Package: tallyr
library(tallyr)
f <- function(x) zzframboz(x)
#++++
Any
f: <T> fn(x: T) -> Unknown
291..300 warning[unresolved] I could not resolve `zzframboz` in this package, its imports, or builtins.

