#==== naming-style
#---- camel_variable_in_function_warns
f <- function() {
  myVar <- 1
  myVar
}
#++++
20..25 warning[naming-style] Variable `myVar` should have snake_case name, e.g. my_var

#---- top_level_assignment_is_style_checked
myVar <- 1
#++++
0..5 warning[naming-style] Variable `myVar` should have snake_case name, e.g. my_var

#---- screaming_snake_constants_conform_at_any_scope
MAX_ITER <- 100L
f <- function() {
  RETRY_LIMIT <- 3L
  RETRY_LIMIT
}
#++++
clean

#---- camel_parameter_warns
f <- function(myParam) myParam
#++++
14..21 warning[naming-style] Parameter `myParam` should have snake_case name, e.g. my_param

#---- snake_names_clean
f <- function(my_param) {
  my_var <- my_param
  my_var
}
#++++
clean

#==== unused-parameter
#---- unread_parameter_warns
f <- function(count) 1
#++++
14..19 warning[unused-parameter] parameter `count` is never used.

#---- read_parameter_clean
f <- function(count) count + 1
#++++
clean

#---- dot_prefixed_parameters_are_throwaway
shout <- function(text, volume, .ignored) {
  toupper(text)
}
#++++
24..30 warning[unused-parameter] parameter `volume` is never used.

#---- dots_never_reported
f <- function(...) 1
#++++
clean

#---- s3_method_formals_are_mandated_not_reported
format.myclass <- function(x, ...) "myclass"
as.character.myclass <- function(x, ...) "myclass"
#++++
clean

#---- an_ordinary_dotted_name_is_still_reported
my.helper <- function(count) 1
#++++
22..27 warning[unused-parameter] parameter `count` is never used.

#---- a_projects_own_generic_and_its_methods_are_exempt
# A generic declares the argument it dispatches on and never touches it — every
# formal it names is unused by construction — and its methods must then match its
# signature. The generic being the project's own, not the standard library's,
# changes nothing.
speak <- function(x, ...) UseMethod("speak")
speak.dog <- function(x, ...) "woof"
speak.default <- function(x, ...) "..."
#++++
clean

#---- a_method_of_no_generic_at_all_is_still_reported
# Nothing here dispatches, so `render.thing` is an ordinary dotted name.
render.thing <- function(count) 1
#++++
98..103 warning[unused-parameter] parameter `count` is never used.

#---- closure_read_counts
f <- function(count) {
  g <- function() count
  g
}
#++++
clean

#---- default_only_use_is_a_read
f <- function(a, b = a) b
#++++
clean

#==== shadows
#---- top_level_builtin_rebinding_warns
mean <- function(x) x
#++++
0..4 warning[shadows-builtin] Top-level binding `mean` shadows a builtin.

#---- top_level_namespace_name_warns
sd <- 1
head <- function(x) x
#++++
0..2 warning[shadows-namespace] Top-level binding `sd` shadows `stats::sd`.
8..12 warning[shadows-namespace] Top-level binding `head` shadows `utils::head`.

#---- s3_method_dot_names_are_not_shadows
print.myclass <- function(x, ...) x
#++++
clean

#---- local_rebinding_is_fine
f <- function() {
  mean <- 1
  mean
}
#++++
clean

#==== inline_annotations
#---- annotated_binding_name_follows_the_style
myCount: integer <- 1L
#++++
0..7 warning[naming-style] Variable `myCount` should have snake_case name, e.g. my_count

#---- annotated_parameter_name_follows_the_style
f <- function(myValue: integer) myValue
#++++
14..21 warning[naming-style] Parameter `myValue` should have snake_case name, e.g. my_value

#==== commented-code
#---- commented_out_code_warns
# x <- compute(y)
# print(result)
#if (a) b
f <- function(x) x
#++++
0..17 warning[commented-code] This comment is code. Delete it, since version control keeps the history
18..33 warning[commented-code] This comment is code. Delete it, since version control keeps the history
34..43 warning[commented-code] This comment is code. Delete it, since version control keeps the history

#---- prose_and_documentation_are_clean
# Compute the total from the inputs.
# TODO: handle NA
#' @param x a number
#: fn(x: num) -> num
#> [1] 1
# x
# see section 3
f <- function(x) x
#++++
clean

#==== redundant-return
#---- tail_return_warns
f <- function(x) {
  y <- x + 1
  return(y)
}
g <- function(x) {
  if (x) return(1) else return(2)
}
h <- function(x) return(y <- x)
#++++
34..43 warning[redundant-return] This return() is redundant: a function returns the value of its last expression
  safe fix 34..43 "y"
74..83 warning[redundant-return] This return() is redundant: a function returns the value of its last expression
  safe fix 74..83 "1"
89..98 warning[redundant-return] This return() is redundant: a function returns the value of its last expression
  safe fix 89..98 "2"
118..132 warning[redundant-return] This return() is redundant: a function returns the value of its last expression
  safe fix 118..132 "y <- x"

#---- early_return_and_bound_return_are_clean
f <- function(x) {
  if (x) return(1)
  2
}
g <- function() return
h <- function(x) invisible(x)
#++++
clean

#---- return_redefined_in_the_file_is_clean
return <- function(x) x
f <- function(x) {
  return(x)
}
#++++
0..6 warning[shadows-builtin] Top-level binding `return` shadows a builtin.

#---- directives_and_prose_with_parentheses_are_clean
y <- 3L # ry: allow(assignment-operator)
# fmt: skip
# nolint start
# Returns (invisibly) the input
f <- function(x) x
#++++
clean

#==== any-is-na
#---- any_of_is_na_warns
if (any(is.na(x))) stop("missing")
#++++
4..17 warning[any-is-na] Use anyNA(x), which stops at the first NA instead of building a vector for any()
  safe fix 4..17 "anyNA(x)"

#---- na_rm_and_other_reductions_are_clean
any(is.na(x), na.rm = TRUE)
all(is.na(x))
#++++
clean

#==== paste-sep
#---- empty_separator_warns
