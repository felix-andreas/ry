  unsafe fix 32..45 "(nzchar(y))"

#---- other_counts_are_clean
nchar(x) == 1
nchar(x, "bytes") == 0
0 == nchar(x)
#++++
clean

#==== sample-int
#---- sampling_a_sequence_from_one_warns
sample(1:n, 2)
sample(1L:length(x), size = 3, replace = TRUE)
#++++
0..14 warning[sample-int] Use sample.int(n, ...), which draws the same values without building 1:n
  unsafe fix 0..14 "sample.int(n, 2)"
15..61 warning[sample-int] Use sample.int(length(x), ...), which draws the same values without building 1:length(x)
  unsafe fix 15..61 "sample.int(length(x), size = 3, replace = TRUE)"
22..34 warning[length-sequence] `1:length(...)` is `c(1, 0)` when the vector is empty. Use seq_along()
  unsafe fix 22..34 "seq_along(x)"

#---- other_samples_are_clean
sample(x, 2)
sample(2:n, 1)
sample(x = 1:n, 2)
#++++
clean

#==== unnecessary-concatenation
#---- combining_one_constant_or_nothing_warns
x <- c("a")
y <- c()
z <- c(-1) + 1
#++++
5..11 warning[unnecessary-concatenation] Write `"a"` directly: c() has nothing to combine here
  safe fix 5..11 "\"a\""
17..20 warning[unnecessary-concatenation] Write `NULL` directly: c() has nothing to combine here
  safe fix 17..20 "NULL"
26..31 warning[unnecessary-concatenation] Write `-1` directly: c() has nothing to combine here
  safe fix 26..31 "(-1)"

#---- combining_values_is_clean
c("a", "b")
c(x)
c(name = 1)
quote(c())
#++++
clean
