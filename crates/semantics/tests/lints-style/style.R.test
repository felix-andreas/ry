#==== naming-style
#---- camel_variable_in_function_warns
f <- function() {
  myVar <- 1
  myVar
}
#++++
20..25 warning[naming-style] Variable `myVar` should have snake_case name, e.g. my_var

#---- top_level_assignment_is_style_checked
myVar <- 1
#++++
0..5 warning[naming-style] Variable `myVar` should have snake_case name, e.g. my_var

#---- screaming_snake_constants_conform_at_any_scope
MAX_ITER <- 100L
f <- function() {
  RETRY_LIMIT <- 3L
  RETRY_LIMIT
}
#++++
clean

#---- camel_parameter_warns
f <- function(myParam) myParam
#++++
14..21 warning[naming-style] Parameter `myParam` should have snake_case name, e.g. my_param

#---- snake_names_clean
f <- function(my_param) {
  my_var <- my_param
  my_var
}
#++++
clean

#==== unused-parameter
#---- unread_parameter_warns
f <- function(count) 1
#++++
14..19 warning[unused-parameter] parameter `count` is never used.

#---- read_parameter_clean
f <- function(count) count + 1
#++++
clean

#---- dot_prefixed_parameters_are_throwaway
shout <- function(text, volume, .ignored) {
  toupper(text)
}
#++++
24..30 warning[unused-parameter] parameter `volume` is never used.

#---- dots_never_reported
f <- function(...) 1
#++++
clean

#---- s3_method_formals_are_mandated_not_reported
format.myclass <- function(x, ...) "myclass"
as.character.myclass <- function(x, ...) "myclass"
#++++
clean

#---- an_ordinary_dotted_name_is_still_reported
my.helper <- function(count) 1
#++++
22..27 warning[unused-parameter] parameter `count` is never used.

#---- a_projects_own_generic_and_its_methods_are_exempt
# A generic declares the argument it dispatches on and never touches it — every
# formal it names is unused by construction — and its methods must then match its
# signature. The generic being the project's own, not the standard library's,
# changes nothing.
speak <- function(x, ...) UseMethod("speak")
speak.dog <- function(x, ...) "woof"
speak.default <- function(x, ...) "..."
#++++
clean

#---- a_method_of_no_generic_at_all_is_still_reported
# Nothing here dispatches, so `render.thing` is an ordinary dotted name.
render.thing <- function(count) 1
#++++
98..103 warning[unused-parameter] parameter `count` is never used.

#---- closure_read_counts
f <- function(count) {
  g <- function() count
  g
}
#++++
clean

#---- default_only_use_is_a_read
f <- function(a, b = a) b
#++++
clean

#==== shadows
#---- top_level_builtin_rebinding_warns
mean <- function(x) x
#++++
0..4 warning[shadows-builtin] Top-level binding `mean` shadows a builtin.

#---- top_level_namespace_name_warns
sd <- 1
head <- function(x) x
#++++
0..2 warning[shadows-namespace] Top-level binding `sd` shadows `stats::sd`.
8..12 warning[shadows-namespace] Top-level binding `head` shadows `utils::head`.

#---- s3_method_dot_names_are_not_shadows
print.myclass <- function(x, ...) x
#++++
clean

#---- local_rebinding_is_fine
f <- function() {
  mean <- 1
  mean
}
#++++
clean

#==== inline_annotations
#---- annotated_binding_name_follows_the_style
myCount: integer <- 1L
#++++
0..7 warning[naming-style] Variable `myCount` should have snake_case name, e.g. my_count

#---- annotated_parameter_name_follows_the_style
f <- function(myValue: integer) myValue
#++++
14..21 warning[naming-style] Parameter `myValue` should have snake_case name, e.g. my_value

#==== commented-code
#---- commented_out_code_warns
# x <- compute(y)
# print(result)
#if (a) b
f <- function(x) x
#++++
0..17 warning[commented-code] This comment is code. Delete it, since version control keeps the history
18..33 warning[commented-code] This comment is code. Delete it, since version control keeps the history
34..43 warning[commented-code] This comment is code. Delete it, since version control keeps the history

#---- prose_and_documentation_are_clean
# Compute the total from the inputs.
# TODO: handle NA
#' @param x a number
#: fn(x: num) -> num
#> [1] 1
# x
# see section 3
f <- function(x) x
#++++
clean

#==== redundant-return
#---- tail_return_warns
f <- function(x) {
  y <- x + 1
  return(y)
}
g <- function(x) {
  if (x) return(1) else return(2)
}
h <- function(x) return(y <- x)
#++++
34..43 warning[redundant-return] This return() is redundant: a function returns the value of its last expression
  safe fix 34..43 "y"
74..83 warning[redundant-return] This return() is redundant: a function returns the value of its last expression
  safe fix 74..83 "1"
89..98 warning[redundant-return] This return() is redundant: a function returns the value of its last expression
  safe fix 89..98 "2"
118..132 warning[redundant-return] This return() is redundant: a function returns the value of its last expression
  safe fix 118..132 "y <- x"

#---- early_return_and_bound_return_are_clean
f <- function(x) {
  if (x) return(1)
  2
}
g <- function() return
h <- function(x) invisible(x)
#++++
clean

#---- return_redefined_in_the_file_is_clean
return <- function(x) x
f <- function(x) {
  return(x)
}
#++++
0..6 warning[shadows-builtin] Top-level binding `return` shadows a builtin.

#---- directives_and_prose_with_parentheses_are_clean
y <- 3L # ry: allow(assignment-operator)
# fmt: skip
# nolint start
# Returns (invisibly) the input
f <- function(x) x
#++++
clean

#==== any-is-na
#---- any_of_is_na_warns
if (any(is.na(x))) stop("missing")
#++++
4..17 warning[any-is-na] Use anyNA(x), which stops at the first NA instead of building a vector for any()
  safe fix 4..17 "anyNA(x)"

#---- na_rm_and_other_reductions_are_clean
any(is.na(x), na.rm = TRUE)
all(is.na(x))
#++++
clean

#==== paste-sep
#---- empty_separator_warns
paste("a", x, sep = "")
paste(sep = '', "id_", n, collapse = ",")
paste("a", # why
  x, sep = "")
#++++
0..23 warning[paste-sep] Use paste0(...) instead of paste(..., sep = "")
  safe fix 0..23 "paste0(\"a\", x)"
24..65 warning[paste-sep] Use paste0(...) instead of paste(..., sep = "")
  safe fix 24..65 "paste0(\"id_\", n, collapse = \",\")"
36..38 warning[single-quotes] Use double quotes for strings
  safe fix 36..38 "\"\""
66..97 warning[paste-sep] Use paste0(...) instead of paste(..., sep = "")

#---- other_separators_are_clean
paste("a", x)
paste("a", x, sep = "-")
#++++
clean

#==== lengths
#---- applying_length_warns
n <- sapply(parts, length)
m <- vapply(parts, length, integer(1))
#++++
5..26 warning[lengths] Use lengths(x), which counts every element's length without calling length() through sapply()
  unsafe fix 5..26 "lengths(parts)"
32..65 warning[lengths] Use lengths(x), which counts every element's length without calling length() through vapply()
  unsafe fix 32..65 "lengths(parts)"

#---- other_functions_are_clean
n <- sapply(parts, nchar)
m <- vapply(parts, length, integer(1), USE.NAMES = FALSE)
#++++
clean

#==== literal-coercion
#---- coerced_literals_warn
a <- as.integer(1)
b <- as.numeric(2L)
e <- as.character("x")
d <- as.logical(TRUE)
#++++
5..18 warning[literal-coercion] Write the literal `1L` instead of coercing it with as.integer()
  safe fix 5..18 "1L"
24..38 warning[literal-coercion] Write the literal `2` instead of coercing it with as.numeric()
  safe fix 24..38 "2"
44..61 warning[literal-coercion] Write the literal `"x"` instead of coercing it with as.character()
  safe fix 44..61 "\"x\""
67..83 warning[literal-coercion] Write the literal `TRUE` instead of coercing it with as.logical()
  safe fix 67..83 "TRUE"

#---- non_literals_and_lossy_coercions_are_clean
a <- as.integer(1.5)
b <- as.integer(x)
e <- as.character(1)
#++++
clean

#---- values_beyond_the_integer_range_are_clean
as.integer(3000000000)
#++++
clean

#==== redundant-equals
#---- comparing_with_a_boolean_warns
if (ok == TRUE) 1
if (done != TRUE) 2
y <- FALSE == flag
#++++
4..14 warning[redundant-equals] Comparing with TRUE is redundant for a logical value. Write `ok`
  unsafe fix 4..14 "ok"
22..34 warning[redundant-equals] Comparing with TRUE is redundant for a logical value. Write `!done`
  unsafe fix 22..34 "!done"
43..56 warning[redundant-equals] Comparing with FALSE is redundant for a logical value. Write `!flag`
  unsafe fix 43..56 "!flag"

#---- other_comparisons_are_clean
if (x == 1) 1
if (TRUE == FALSE) 2
#++++
clean

#---- a_negation_inside_a_looser_operator_gets_parentheses
a <- x == FALSE & y
#++++
5..15 warning[redundant-equals] Comparing with FALSE is redundant for a logical value. Write `!x`
  unsafe fix 5..15 "(!x)"

#==== single-quotes
#---- single_quoted_strings_warn
x <- 'abc'
y <- 'say "hi"'
#++++
5..10 warning[single-quotes] Use double quotes for strings
  safe fix 5..10 "\"abc\""
16..26 warning[single-quotes] Use double quotes for strings

#---- double_quotes_are_clean
x <- "abc"
y <- "it's"
#++++
clean

#==== duplicate-argument
#---- a_name_given_twice_warns
f(a = 1, b = 2, a = 3)
x <- list(`key` = 1, "key" = 2)
#++++
16..17 warning[duplicate-argument] `a` is passed twice in this call. A function stops with "matched by multiple actual arguments", and c() or list() keeps both values under one name
44..49 warning[duplicate-argument] `key` is passed twice in this call. A function stops with "matched by multiple actual arguments", and c() or list() keeps both values under one name

#---- distinct_names_and_sequential_verbs_are_clean
f(a = 1, b = 2)
df |> mutate(x = x + 1, x = x * 2)
g(1, 1, 1)
#++++
clean

#==== testthat-expectation
#---- general_expectations_with_a_specific_form_warn
expect_equal(x, NULL)
expect_identical(x, TRUE)
expect_equal(length(x), 3)
expect_equal(names(x), e)
expect_true(!ok)
expect_false(!ok)
expect_true(is.null(x))
expect_true(inherits(x, "tbl"))
#++++
0..21 warning[testthat-expectation] Use expect_null(), which says what the test checks and fails with a clearer message
  safe fix 0..21 "expect_null(x)"
22..47 warning[testthat-expectation] Use expect_true(), which says what the test checks and fails with a clearer message
  unsafe fix 22..47 "expect_true(x)"
48..74 warning[testthat-expectation] Use expect_length(), which says what the test checks and fails with a clearer message
  unsafe fix 48..74 "expect_length(x, 3)"
75..100 warning[testthat-expectation] Use expect_named(), which says what the test checks and fails with a clearer message
  unsafe fix 75..100 "expect_named(x, e)"
101..117 warning[testthat-expectation] Use expect_false(), which says what the test checks and fails with a clearer message
  unsafe fix 101..117 "expect_false(ok)"
118..135 warning[testthat-expectation] Use expect_true(), which says what the test checks and fails with a clearer message
  unsafe fix 118..135 "expect_true(ok)"
136..159 warning[testthat-expectation] Use expect_null(), which says what the test checks and fails with a clearer message
  safe fix 136..159 "expect_null(x)"
160..191 warning[testthat-expectation] Use expect_s3_class(), which says what the test checks and fails with a clearer message
  unsafe fix 160..191 "expect_s3_class(x, \"tbl\")"

#---- specific_expectations_are_clean
expect_null(x)
expect_equal(x, 1)
expect_true(ok)
expect_false(is.null(x))
expect_equal(x, NULL, info = "why")
#++++
clean

#==== condition-message
#---- pasted_messages_warn
stop(paste0("no file ", path))
warning(paste("a", b, sep = ""), call. = FALSE)
message(paste0())
#++++
5..29 warning[condition-message] stop() joins its arguments itself, so paste0() is not needed
  unsafe fix 5..29 "\"no file \", path"
39..62 warning[condition-message] warning() joins its arguments itself, so paste() is not needed
  unsafe fix 39..62 "\"a\", b"
39..62 warning[paste-sep] Use paste0(...) instead of paste(..., sep = "")
  safe fix 39..62 "paste0(\"a\", b)"
87..95 warning[condition-message] message() joins its arguments itself, so paste0() is not needed

#---- plain_messages_are_clean
stop("no file ", path)
stop(paste("no", "file"))
message(paste0(x, collapse = ", "))
#++++
clean

#==== comparison-negation
#---- negated_comparisons_warn
if (!(x == 1)) 1
y <- !(a < b)
z <- 1 + !(a >= b)
#++++
4..13 warning[comparison-negation] Use `!=` instead of negating `==`
  safe fix 4..13 "x != 1"
22..30 warning[comparison-negation] Use `>=` instead of negating `<`
  safe fix 22..30 "a >= b"
40..49 warning[comparison-negation] Use `<` instead of negating `>=`
  safe fix 40..49 "(a < b)"

#---- other_negations_are_clean
if (!(x %in% y)) 1
!x
!(a & b)
#++++
clean

#---- rlang_injection_is_clean
filter(z, !!(x == y))
#++++
clean

#==== outer-negation
#---- negated_elements_warn
all(!x)
y <- any(!is.na(x))
all(!x) + 1
#++++
0..7 warning[outer-negation] Use `!any(x)` instead of `all(!x)`, which negates every element first
  safe fix 0..7 "!any(x)"
13..27 warning[outer-negation] Use `!all(x)` instead of `any(!x)`, which negates every element first
  safe fix 13..27 "!all(is.na(x))"
28..35 warning[outer-negation] Use `!any(x)` instead of `all(!x)`, which negates every element first
  safe fix 28..35 "(!any(x))"

#---- outer_negations_are_clean
!any(x)
all(!x, na.rm = TRUE)
#++++
clean

#---- rlang_injection_is_clean
any(!!x)
#++++
clean

#==== fixed-regex
#---- plain_patterns_warn
grepl("abc", x)
sub("-", "_", x)
strsplit(x, ",")
regexpr(text = x, "a b")
#++++
6..11 warning[fixed-regex] This pattern has no regular expression syntax, so grepl() matches it faster with `fixed = TRUE`
  unsafe fix 14..14 ", fixed = TRUE"
20..23 warning[fixed-regex] This pattern has no regular expression syntax, so sub() matches it faster with `fixed = TRUE`
  unsafe fix 31..31 ", fixed = TRUE"
45..48 warning[fixed-regex] This pattern has no regular expression syntax, so strsplit() matches it faster with `fixed = TRUE`
  unsafe fix 48..48 ", fixed = TRUE"
68..73 warning[fixed-regex] This pattern has no regular expression syntax, so regexpr() matches it faster with `fixed = TRUE`
  unsafe fix 73..73 ", fixed = TRUE"

#---- regex_and_configured_patterns_are_clean
grepl("^abc", x)
grepl("a.c", x)
grepl("abc", x, fixed = TRUE)
grepl("abc", x, ignore.case = TRUE)
gsub("a", "\\1", x)
grepl(pattern, x)
grepl("abc", ...)
#++++
clean

#==== which-grepl
#---- which_of_grepl_warns
which(grepl("a", x, fixed = TRUE))
#++++
0..34 warning[which-grepl] Use grep(...), which returns the matching positions directly, instead of which(grepl(...))
  safe fix 0..34 "grep(\"a\", x, fixed = TRUE)"

#---- which_of_others_is_clean
which(x > 1)
which(grepl("^a", x), arr.ind = TRUE)
#++++
clean

#---- five_positional_grepl_arguments_are_clean
which(grepl("^a", z, FALSE, FALSE, TRUE))
#++++
clean

#==== length-levels
#---- length_of_levels_warns
length(levels(f))
#++++
0..17 warning[length-levels] Use nlevels(x) instead of length(levels(x))
  safe fix 0..17 "nlevels(f)"

#---- nlevels_is_clean
nlevels(f)
length(unique(f))
#++++
clean

#==== browser-call
#---- browser_warns
f <- function() {
  browser()
}
#++++
20..29 warning[browser-call] Remove this browser() call, which pauses the code whenever it runs in an interactive session

#---- quoted_browser_is_clean
debug_at <- function(env) eval(quote(browser()), env)
#++++
clean

#==== numeric-leading-zero
#---- missing_leading_zeros_warn
x <- .5
y <- .5e3L
#++++
5..7 warning[numeric-leading-zero] Write `0.5` with a leading zero, which is easier to read
  safe fix 5..7 "0.5"
13..18 warning[numeric-leading-zero] Write `0.5e3L` with a leading zero, which is easier to read
  safe fix 13..18 "0.5e3L"

#---- leading_zeros_are_clean
x <- 0.5
y <- 5.
#++++
clean

