NULL

library(stats)
requireNamespace("utils", quietly = TRUE)

#: @alias Point = Record{x: double, y: double}
origin <- function() list(x = 0, y = 0)
.onLoad <- function(libname, pkgname) {
  cat("loaded\n")
  invisible(NULL)
}

setClass("Account", representation(balance = "numeric"))
setGeneric("deposit", function(account, amount) standardGeneric("deposit"))
setMethod("deposit", "Account", function(account, amount) account)
Stack <- R6::R6Class("Stack", public = list(items = list()))

if (getRversion() >= "2.15.1") utils::globalVariables(c("amount", "balance"))
