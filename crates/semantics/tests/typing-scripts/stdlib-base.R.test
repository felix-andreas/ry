#==== missing_guarded_formals
#---- missing_tested_formal_is_optional_at_call_sites
greet <- function(name, punct) {
  if (missing(punct)) {
    name
  } else {
    punct
  }
}
greet("ada")
#++++
greet: <T> fn(name: T, [punct]: T) -> T
character

#---- unguarded_formal_stays_required
