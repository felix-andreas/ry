#==== names_and_assignments
#---- known_name_after_assignment
value <- 1L
value
#++++
value: integer
integer

#---- assignment_expression_returns_assigned_type
other <- (value <- 1L)
value
other
#++++
other: integer
integer
integer

#---- rebinding_updates_name_type
value <- 1L
value <- "hello"
value
#++++
value: integer
value: character
character
0..5 warning[unused] `value` is assigned but never used.

#---- unknown_name
missing_value
#++++
Unknown
