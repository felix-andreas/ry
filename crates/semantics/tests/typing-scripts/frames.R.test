#==== script_frames
#---- a_walrus_statement_feeds_later_statements
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
prices[, tax := price * 0.2]
print(prices$tax)
#++++
prices: DataFrame{id: integer[], price: double[]}
DataFrame{id: integer[], price: double[], tax: double[]}
double[]

