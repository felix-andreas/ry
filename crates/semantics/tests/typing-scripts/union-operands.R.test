#==== arithmetic
#---- numeric_union_accepted_member_wise
flag <- TRUE
x <- if (flag) 1L else 2.5
x + 1L
#++++
flag: logical
x: integer | double
integer | double

#---- numeric_union_promotes_per_member
flag <- TRUE
x <- if (flag) 1L else 2.5
x + 1.5
#++++
flag: logical
x: integer | double
double

#---- always_double_operator_collapses_union
flag <- TRUE
x <- if (flag) 1L else 2.5
x / 2L
#++++
flag: logical
x: integer | double
double

#---- union_with_character_member_is_rejected
flag <- TRUE
x <- if (flag) 1L else "a"
x + 1L
#++++
flag: logical
x: integer | character
Unknown
40..41 error[type-mismatch] expected a numeric value (`integer` or `double`), found `integer | character`

#---- union_with_null_member_is_rejected
flag <- TRUE
x <- if (flag) 1L else NULL
x + 1L
#++++
flag: logical
x: integer | NULL
Unknown
41..42 error[type-mismatch] expected a numeric value (`integer` or `double`), found `integer | NULL`

#---- unary_minus_preserves_union
flag <- TRUE
x <- if (flag) 1L else 2.5
-x
#++++
flag: logical
x: integer | double
integer | double

#---- vector_member_makes_pair_result_vector
flag <- TRUE
x <- if (flag) 1L else c(1.5, 2.5)
x + 1L
#++++
flag: logical
x: integer | double[]
integer | double[]

#==== comparisons
#---- numeric_union_compares_member_wise
flag <- TRUE
x <- if (flag) 1L else 2.5
x > 0L
#++++
flag: logical
x: integer | double
logical

#---- union_of_mixed_families_is_rejected
flag <- TRUE
x <- if (flag) 1L else "a"
x > 0L
#++++
flag: logical
x: integer | character
Unknown
44..46 error[type-mismatch] expected `integer | character`, found `integer`

#---- character_union_compares_within_family
flag <- TRUE
x <- if (flag) "a" else "b"
x > "a"
#++++
flag: logical
x: character
logical

#==== iteration
#---- loop_variable_joins_union_of_vector_iterables
flag <- TRUE
items <- if (flag) c(1L, 2L) else c("a", "b")
for (item in items) item
#++++
flag: logical
items: integer[] | character[]
NULL

#---- heterogeneous_list_element_arithmetic_is_member_wise
for (item in list(1L, 2.5)) item + 1L
#++++
NULL

#---- union_iterable_with_non_iterable_member_is_rejected
flag <- TRUE
items <- if (flag) c(1L, 2L) else function(x) x
for (item in items) item
#++++
flag: logical
items: integer[] | (fn(x: Unknown) -> Unknown)
NULL
74..79 error[type-mismatch] this `for` sequence is `integer[] | (fn(x: Unknown) -> Unknown)`, which cannot be iterated — expected a vector or list.

#==== fields_and_elements
#---- shared_field_over_union_of_records
flag <- TRUE
rec <- if (flag) list(a = 1L) else list(a = 2L, b = "x")
rec$a
#++++
flag: logical
rec: list{a: integer} | list{a: integer, b: character}
integer

#---- field_with_differing_member_types_joins
flag <- TRUE
rec <- if (flag) list(a = 1L) else list(a = "x")
rec$a
#++++
flag: logical
rec: list{a: integer} | list{a: character}
integer | character

#---- field_missing_on_one_member_may_be_null
flag <- TRUE
rec <- if (flag) list(a = 1L) else list(b = "x")
rec$b
#++++
flag: logical
rec: list{a: integer} | list{b: character}
character | NULL

#---- subset2_over_union_of_lists
flag <- TRUE
items <- if (flag) list(1L, 2L) else list("a")
items[[1L]]
#++++
flag: logical
items: list{integer, integer} | list{character}
integer | character

#---- subset_over_union_of_lists
flag <- TRUE
items <- if (flag) list(1L, 2L) else list("a")
items[1L]
#++++
flag: logical
items: list{integer, integer} | list{character}
list[integer] | list[character]

#==== empty_collections
#---- empty_list_slice_is_list_of_null
list()[1L]
#++++
list[NULL]
