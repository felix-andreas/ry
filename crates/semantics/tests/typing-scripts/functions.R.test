#==== optional_parameters
#---- inferred_default_makes_parameter_optional
pad <- function(value, width = NULL) value
pad(1L)
#++++
pad: <T, U> fn(value: T, [width]: U) -> T
integer

#---- inferred_default_parameter_can_still_be_supplied
pad <- function(value, width = NULL) value
pad(1L, 2L)
#++++
pad: <T, U> fn(value: T, [width]: U) -> T
integer

#---- optional_parameter_supplied_by_name
