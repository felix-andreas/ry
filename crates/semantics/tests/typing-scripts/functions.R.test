#==== inferred_functions
#---- identity_function
mirror <- function(x) x
#++++
mirror: <T> fn(x: T) -> T
0..6 warning[unused] `mirror` is assigned but never used.

#---- two_parameter_function_returns_first_argument_type
first <- function(x, y) x
#++++
first: <T, U> fn(x: T, y: U) -> T
0..5 warning[unused] `first` is assigned but never used.

#==== annotated_functions
#---- compact_annotation_named_parameter_and_return
#: fn(count: integer) -> integer
double_count <- function(count) count + count
double_count
#++++
double_count: fn(count: integer) -> integer
fn(count: integer) -> integer

#---- compact_annotation_without_return_defaults_to_null
#: fn(count: integer)
log_count <- function(count) { }
log_count
#++++
log_count: fn(count: integer) -> NULL
fn(count: integer) -> NULL

#---- expanded_annotation_with_optional_parameter
#: @param count {integer}
#: @param [label] {character}
#: @return {integer}
double_count <- function(count, label = NULL) count + count
double_count(1L)
double_count(1L, "units")
#++++
double_count: fn(count: integer, [label]: character) -> integer
integer
integer
117..121 error[type-mismatch] `label` defaults to `NULL`, which its declared type `character` does not admit — a caller who omits it leaves `NULL` in the body. Declare it `character | NULL` and narrow with `is.null()`

#---- higher_order_function_annotation
#: @param render_count {fn(integer) -> character}
#: @param count {integer}
#: @return {character}
apply_renderer <- function(render_count, count) { render_count(count) }
#: fn(integer) -> character
render_count <- function(count) "ok"
apply_renderer(render_count, 1L)
#++++
apply_renderer: fn(render_count: fn(integer) -> character, count: integer) -> character
render_count: fn(count: integer) -> character
character

#==== calls
#---- annotated_named_parameter_accepts_named_argument
#: fn(count: integer) -> integer
mirror <- function(count) count
mirror(count = 1L)
#++++
mirror: fn(count: integer) -> integer
integer

#---- annotated_identity_call
#: fn(count: integer) -> integer
mirror <- function(count) count
mirror(1L)
#++++
mirror: fn(count: integer) -> integer
integer

#---- annotation_types_do_not_restrict_argument_names
#: fn(integer) -> integer
mirror <- function(value) value
mirror(value = 1L)
#++++
mirror: fn(value: integer) -> integer
integer

#---- missing_required_argument
mirror <- function(x) x
mirror()
#++++
mirror: <T> fn(x: T) -> T
T
24..30 error[type-mismatch] this call supplies 0 arguments, but the function requires 1 — a required argument is missing

#---- extra_argument
mirror <- function(x) x
mirror(1L, 2L)
#++++
mirror: <T> fn(x: T) -> T
integer
35..37 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

#---- non_variadic_annotated_function_still_rejects_surplus_arguments
#: fn(count: integer) -> integer
double_count <- function(count) count + count
double_count(1L, 2L)
#++++
double_count: fn(count: integer) -> integer
integer
96..98 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

