#==== variadic_functions
#---- dots_formal_infers_a_rest_parameter
join <- function(...) NULL
#++++
join: fn(...: Any) -> NULL
0..4 warning[unused] `join` is assigned but never used.

#---- pre_dots_formal_fills_positionally_and_surplus_is_absorbed
wrap <- function(x, ...) x + 1L
wrap(1L, "extra", TRUE)
#++++
wrap: <T: numeric> fn(x: T, ...: Any) -> T
integer

#---- pre_dots_formal_still_matches_by_name
wrap <- function(x, ...) x
wrap(x = 1L, "extra")
#++++
wrap: <T> fn(x: T, ...: Any) -> T
integer

#---- post_dots_formal_is_matched_by_name
f <- function(..., sep) sep
f("a", "b", sep = 1L)
#++++
f: <T> fn(...: Any, sep: T) -> T
integer

#---- post_dots_formal_is_not_filled_positionally
f <- function(..., sep) sep
f("a", 1L)
#++++
f: <T> fn(...: Any, sep: T) -> T
T
28..29 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

#---- unmatched_keyword_is_absorbed_by_the_rest
f <- function(...) NULL
f(anything = 1L, other = "x")
#++++
f: fn(...: Any) -> NULL
NULL

