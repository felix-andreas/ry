#==== named_argument_calls
#---- inferred_function_accepts_named_argument
mirror <- function(x) x
mirror(x = 1L)
#++++
mirror: <T> fn(x: T) -> T
integer

#---- inferred_function_accepts_named_arguments_out_of_order
#: fn(count: integer, label: character) -> character
describe <- function(count, label) label
describe(label = "items", count = 2L)
#++++
describe: fn(count: integer, label: character) -> character
