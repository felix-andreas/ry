#==== constrained_binders
#---- numeric_binder_is_writable_and_enforced
#: <T: numeric> fn(values: T) -> T
passthrough <- function(values) values
kept <- passthrough(2.5)
rejected <- passthrough("text")
#++++
passthrough: <T: numeric> fn(values: T) -> T
kept: double
rejected: Unknown
74..78 warning[unused] `kept` is assigned but never used.
99..107 warning[unused] `rejected` is assigned but never used.
123..129 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- numeric_binder_accepts_numeric_arguments
#: <T: numeric> fn(values: T) -> T
passthrough <- function(values) values
passthrough(2.5)
passthrough(1L)
#++++
passthrough: <T: numeric> fn(values: T) -> T
double
integer

#---- forall_binder_takes_the_same_constraint
#: @forall T: numeric
#: @param values {T}
#: @return {T}
passthrough <- function(values) values
passthrough(3.5)
#++++
passthrough: <T: numeric> fn(values: T) -> T
double
