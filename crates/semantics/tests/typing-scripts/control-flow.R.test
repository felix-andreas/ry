#++++
NULL

#---- for_over_any_yields_any_items
#: fn(values: Any) -> NULL
consume <- function(values) {
  for (item in values) item
  NULL
}
#++++
consume: fn(values: Any) -> NULL
27..34 warning[unused] `consume` is assigned but never used.

