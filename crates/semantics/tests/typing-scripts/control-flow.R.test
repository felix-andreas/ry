#==== if_normalization
#---- if_without_else_nullable_branch_stays_single_nullable
flag <- TRUE
value <- if (flag) 1L
if (flag) value
#++++
flag: logical
value: integer | NULL
integer | NULL

#---- if_else_same_nullable_branches
flag <- TRUE
left <- if (flag) 1L
right <- if (flag) 2L
if (flag) left else right
#++++
flag: logical
left: integer | NULL
right: integer | NULL
integer | NULL

#---- negated_condition
flag <- TRUE
if (!flag) 1L else 2L
#++++
flag: logical
integer

#---- comparison_condition
count <- 3L
if (count > 2L) "big" else "small"
#++++
count: integer
character

#==== loop_iteration_types
#---- for_over_range_binds_element_type
