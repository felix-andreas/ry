#==== top_level_guards
#---- a_guard_narrows_a_top_level_variable
# The shape a newcomer writes first, and it used to report: the checker demanded
# a null check that was right there. A top-level variable is a non-local to the
# statement that reads it, because scopes are per-statement, so the guard needs a
# slot of its own to refine.
#: fn(s: character) -> character
want_chr <- function(s) s

#: fn() -> character | NULL
maybe <- function() NULL

x <- maybe()
if (is.null(x)) {
  message <- "none"
} else {
  message <- want_chr(x)
}
#++++
want_chr: fn(s: character) -> character
maybe: fn() -> character | NULL
x: character | NULL
419..426 warning[unused] `message` is assigned but never used.

#---- a_negated_top_level_guard_narrows_the_other_edge
#: fn(s: character) -> character
want_chr <- function(s) s

#: fn() -> character | NULL
maybe <- function() NULL

x <- maybe()
narrowed <- if (!is.null(x)) want_chr(x) else "none"
#++++
want_chr: fn(s: character) -> character
maybe: fn() -> character | NULL
x: character | NULL
narrowed: character
127..135 warning[unused] `narrowed` is assigned but never used.

#---- a_family_guard_narrows_a_top_level_variable
