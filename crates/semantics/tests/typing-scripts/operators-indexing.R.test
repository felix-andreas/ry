#==== operators_indexing
#---- comparison_le_character
"a" <= "b"
#++++
logical

#---- comparison_ge_double
2.5 >= 1L
#++++
logical

#---- comparison_logical_ordering
TRUE < FALSE
#++++
logical

#---- comparison_character_vectors
c("a", "b") < c("c", "d")
#++++
logical[]

#---- comparison_both_map_like_loses_map
c(a = 1L) == c(b = 2L)
#++++
logical[]

#---- comparison_integer_double_mix_vector
c(1L, 2L) >= 1.5
#++++
logical[]

#---- comparison_logical_vs_character_rejected
TRUE == "a"
#++++
Unknown
8..11 error[type-mismatch] expected `logical`, found `character`

#---- comparison_against_null_rejected
1L == NULL
#++++
Unknown
6..10 error[type-mismatch] expected a comparable value (numeric, `character`, or `logical`), found `NULL`

#---- and_chained
TRUE && FALSE && TRUE
#++++
logical

#---- or_with_vector_right_rejected
TRUE || c(FALSE, TRUE)
#++++
logical
8..22 error[type-mismatch] expected `logical`, found `logical[]`

#---- and_of_comparisons
(1L < 2L) && (2L < 3L)
#++++
logical

#---- not_double_negation
!!TRUE
#++++
logical

#---- not_map_like_loses_map
!c(yes = TRUE, no = FALSE)
#++++
logical[]

#---- not_null_rejected
!NULL
#++++
Unknown
1..5 error[type-mismatch] expected a `logical` value, found `NULL`

#---- and_numeric_operand_coerces
1L && TRUE
#++++
logical

#==== operators_indexing_idx
#---- double_bracket_scalar_vector
x <- 1L
x[[1L]]
#++++
x: integer
integer

#---- double_bracket_array_vector
c(1.5, 2.5)[[1L]]
#++++
double

#---- double_bracket_named_vector_name_nullable
c(foo = 1L)[["foo"]]
#++++
integer | NULL

#---- double_bracket_named_vector_positional
c(foo = 1L, bar = 2L)[[2L]]
#++++
integer

#---- double_bracket_tuple_literal_position
list(1L, "foo", TRUE)[[2L]]
#++++
character

#---- double_bracket_tuple_out_of_bounds
list(1L, "foo")[[5L]]
#++++
Unknown
0..21 error[type-mismatch] position 5 does not exist in `list{integer, character}`

#---- double_bracket_tuple_nonliteral_unions_items
i <- 1L
list(1L, "foo")[[i]]
#++++
i: integer
integer | character

#---- double_bracket_record_literal_name
list(foo = 1L, bar = "x")[["foo"]]
#++++
integer

#---- double_bracket_record_missing_name_rejected
list(foo = 1L)[["missing"]]
#++++
Unknown
16..25 error[type-mismatch] field `missing` does not exist in `list{foo: integer}`

#---- double_bracket_array_list
#: list[integer]
v <- list(1L, 2L)
v[[1L]]
#++++
v: list[integer]
integer

#---- double_bracket_map_list_name_nullable
#: list[named: integer]
v <- list(foo = 1L)
v[["foo"]]
#++++
v: list[named: integer]
integer | NULL

#---- bracket_array_list_returns_array_list
#: list[integer]
v <- list(1L, 2L)
v[1L]
#++++
v: list[integer]
list[integer]

#---- bracket_map_list_returns_map_list
#: list[named: integer]
v <- list(foo = 1L)
v["foo"]
#++++
v: list[named: integer]
list[named: integer]

#---- bracket_tuple_coerces_to_array_list
list(1L, 2L, 3L)[2L]
#++++
list[integer]

#---- bracket_record_coerces_to_map_list
list(foo = 1L, bar = 2L)["bar"]
#++++
list[named: integer]

#---- bracket_heterogeneous_tuple_union_element
list(1L, "foo")[1L]
#++++
list[integer | character]

#---- bracket_on_scalar_vector
y <- 1L
y[1L]
#++++
y: integer
integer

#---- bracket_on_array_vector
c(1L, 2L)[1L]
#++++
integer

#---- dollar_record_field
list(foo = 1L, bar = "x")$foo
#++++
integer

#---- dollar_missing_record_field_rejected
list(foo = 1L)$bar
#++++
Unknown
15..18 error[type-mismatch] field `bar` does not exist in `list{foo: integer}`

#---- dollar_tuple_list_rejected
list(1L, 2L)$foo
#++++
Unknown
13..16 error[type-mismatch] field `foo` does not exist in `list{integer, integer}`

#---- dollar_map_list_nullable
#: list[named: integer]
v <- list(foo = 1L)
v$foo
#++++
v: list[named: integer]
integer | NULL

#---- dollar_named_vector_rejected
c(foo = 1L, bar = 2L)$foo
#++++
Unknown
0..25 error[type-mismatch] R's `$` operator is invalid on atomic vectors; this value is `integer[named]` — extract an element with `[[` instead.

#---- double_bracket_on_function_rejected
f <- function(x) x
f[[1L]]
#++++
f: <T> fn(x: T) -> T
Unknown
19..26 error[type-mismatch] expected a list, found `fn(x: T) -> T`

#---- chained_double_bracket_nested_list
#: list[list[integer]]
v <- list(list(1L), list(2L))
v[[1L]][[1L]]
#++++
v: list[list[integer]]
integer

#---- chained_dollar_record
cfg <- list(a = list(b = 2L))
cfg$a$b
#++++
cfg: list{a: list{b: integer}}
integer

#---- dollar_on_unannotated_param_yields_unknown
function(x) x$field
#++++
fn(x: T) -> Unknown

#---- double_bracket_on_unannotated_param_yields_unknown
function(x) x[[1L]]
#++++
fn(x: T) -> Unknown

#---- bracket_on_unannotated_param_yields_unknown
function(x) x[1L]
#++++
fn(x: T) -> Unknown

#==== operators_indexing_nominal
#---- nominal_dollar_projects
#: @type Person {list{name: character}}

#: @new Person
p <- list(name = "bob")
p$name
#++++
p: Person
character

#---- nominal_double_bracket_projects
#: @type Person {list{name: character, age: integer}}

#: @new Person
p <- list(name = "bob", age = 3L)
p[["age"]]
#++++
p: Person
integer

#---- nominal_arithmetic_projects
#: @type Meters {double}

#: @new Meters
h <- 1.8
h + h
#++++
h: Meters
double

#---- nominal_comparison_projects
#: @type Meters {double}

#: @new Meters
h <- 1.8
h < 2.0
#++++
h: Meters
logical

#---- nominal_bracket_projects_array_list
#: @type Bag {list[integer]}

#: @new Bag
b <- list(1L, 2L)
b[1L]
#++++
b: Bag
list[integer]

#==== operators_indexing_extra
#---- and_array_logical_left_rejected
c(TRUE, FALSE) && TRUE
#++++
logical
0..14 error[type-mismatch] expected `logical`, found `logical[]`

#---- comparison_chain_crossfamily
1L < 2L < 3L
#++++
logical

#---- bracket_single_on_function_rejected
f <- function(x) x
f[1L]
#++++
f: <T> fn(x: T) -> T
Unknown
19..24 error[type-mismatch] `[` is not supported on `fn(x: T) -> T`

#---- dollar_on_scalar_vector_rejected
x <- 1L
x$foo
#++++
x: integer
Unknown
8..13 error[type-mismatch] R's `$` operator is invalid on atomic vectors; this value is `integer` — extract an element with `[[` instead.

#---- map_like_vector_bracket_by_name
#: integer[named]
v <- c(foo = 1L)
v["foo"]
#++++
v: integer[named]
integer

#---- lists_equality_rejected
list(a = 1L) == list(a = 1L)
#++++
Unknown
0..12 error[type-mismatch] expected a comparable value (numeric, `character`, or `logical`), found `list{a: integer}`

#---- and_or_precedence
TRUE && FALSE || TRUE
#++++
logical

#---- not_of_array_comparison
!(c(1L, 2L) < 3L)
#++++
logical[]

#---- map_list_positional_double_bracket_extracts_the_item
#: list[named: integer]
v <- list(foo = 1L)
v[[1L]]
#++++
v: list[named: integer]
integer

#---- array_vector_variable_positional_index
i <- 1L
c(1L, 2L)[[i]]
#++++
i: integer
integer

#---- array_vector_name_double_bracket_returns_element
c(1L, 2L)[["foo"]]
#++++
integer

#---- comparison_scalar_vs_map_vector
1L < c(foo = 2L, bar = 3L)
#++++
logical[]

#---- not_scalar_extracted_from_array_vector
v <- c(TRUE, FALSE)
!v[[1L]]
#++++
v: logical[]
logical

#---- or_with_nullable_operand_rejected
c(a = TRUE)[["a"]] || FALSE
#++++
logical
0..18 error[type-mismatch] expected `logical`, found `logical | NULL`

