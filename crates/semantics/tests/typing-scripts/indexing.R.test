#==== vector_indexing
#---- scalar_vector_double_bracket_returns_element
value <- 1L
value[[1L]]
#++++
value: integer
integer

#---- array_vector_double_bracket_returns_element
c(1L, 2L, 3L)[[1L]]
#++++
integer

#---- named_vector_name_lookup_is_nullable
c(foo = 1L, bar = 2L)[["foo"]]
#++++
integer | NULL

#==== list_indexing
#---- tuple_literal_position_returns_element_type
list(1L, "foo")[[2L]]
#++++
character

#---- tuple_nonliteral_position_unions_items
index <- 2L
list(1L, "foo")[[index]]
#++++
index: integer
integer | character

#---- record_literal_name_returns_field_type
list(foo = 1L, bar = "foo")[["bar"]]
#++++
character

#---- record_missing_field_is_rejected
list(foo = 1L)[["bar"]]
#++++
Unknown
16..21 error[type-mismatch] field `bar` does not exist in `list{foo: integer}`

#---- array_like_list_double_bracket_returns_element
#: list[integer]
value <- list(1L, 2L)
value[[1L]]
#++++
value: list[integer]
integer

#---- map_like_list_name_lookup_is_nullable
#: list[named: integer]
value <- list(foo = 1L, bar = 2L)
value[["foo"]]
#++++
value: list[named: integer]
integer | NULL

#---- array_like_list_bracket_returns_array_like_list
#: list[integer]
value <- list(1L, 2L)
value[1L]
#++++
value: list[integer]
list[integer]

#---- map_like_list_bracket_returns_map_like_list
#: list[named: integer]
value <- list(foo = 1L, bar = 2L)
value["foo"]
#++++
value: list[named: integer]
list[named: integer]

#---- tuple_bracket_coerces_to_array_like_list
list(1L, 2L, 3L)[1L]
#++++
list[integer]

#---- record_bracket_coerces_to_map_like_list
list(foo = 1L, bar = 2L)["foo"]
#++++
list[named: integer]

#---- dollar_name_is_record_lookup_sugar
list(foo = 1L, bar = 2L)$foo
#++++
integer

#==== vector_indexing
#---- bracket_on_scalar_vector
value <- 1L
value[1L]
#++++
value: integer
integer

#---- bracket_on_named_vector
c(foo = 1L)[["foo"]]
c(foo = 1L)["foo"]
#++++
integer | NULL
integer

#==== boundary_cases
#---- tuple_out_of_bounds_literal_position_is_rejected
list(1L, "foo")[[3L]]
#++++
Unknown
0..21 error[type-mismatch] position 3 does not exist in `list{integer, character}`

#---- named_vector_positional_index_returns_element
c(foo = 1L, bar = 2L)[[1L]]
#++++
integer

#---- dollar_on_map_like_list_is_nullable
#: list[named: integer]
values <- list(foo = 1L, bar = 2L)
values$foo
#++++
values: list[named: integer]
integer | NULL

#---- dollar_on_named_vector_is_rejected
counts <- c(foo = 1L, bar = 2L)
counts$foo
#++++
counts: integer[named]
Unknown
32..42 error[type-mismatch] R's `$` operator is invalid on atomic vectors; this value is `integer[named]` — extract an element with `[[` instead.

#---- chained_record_access
config <- list(server = list(port = 8080L))
config$server$port
#++++
config: list{server: list{port: integer}}
integer

#==== double_literal_position
#---- tuple_double_literal_position_returns_element
list(1L, "foo", TRUE)[[2]]
#++++
character

#---- record_positional_double_bracket_extracts_the_field
config <- list(host = "localhost", port = 8080L)
config[[1L]]
config[[2L]]
#++++
config: list{host: character, port: integer}
character
integer

#---- record_positional_double_bracket_out_of_range
config <- list(host = "localhost")
config[[3L]]
#++++
config: list{host: character}
Unknown
43..45 error[type-mismatch] position 3 does not exist in `list{host: character}`
