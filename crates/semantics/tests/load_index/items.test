#==== laziness
#---- a_function_definition_with_one_writer_is_lazy
add <- function(x, y) x + y
"quoted" <- function() 1
#++++
package demo 0.1.0
== R/a.R
1:0 lazy add function at 1:7
2:0 lazy quoted function at 2:12

#---- top_level_code_is_eager_and_lists_what_it_reads
limit <- 10L
doubled <- limit * 2L
helper <- function() limit
#++++
package demo 0.1.0
== R/a.R
1:0 eager binds [limit]
2:0 eager binds [doubled] reads [limit]
3:0 lazy helper function at 3:10

#---- a_second_writer_makes_every_writer_eager
#~~~~ R/a.R
cache <- function(x) x
#~~~~ R/b.R
cache <- memoise::memoise(cache)
#++++
package demo 0.1.0
== R/a.R
1:0 eager binds [cache]
== R/b.R
1:0 eager binds [cache] reads [cache]

#---- a_conditional_definition_is_eager
if (getRversion() >= "4.0.0") {
  modern <- function() TRUE
} else {
  modern <- function() FALSE
}
#++++
package demo 0.1.0
== R/a.R
1:0 eager binds [modern] reads [getRversion]

#---- a_function_literal_swallows_a_rightward_assignment
function(x) x -> body_binding
#++++
package demo 0.1.0
== R/a.R
1:0 eager

#---- superassignment_at_top_level_is_eager
global <<- function() 1
#++++
package demo 0.1.0
== R/a.R
1:0 eager binds [global] reads [global]

#---- reads_inside_a_function_body_happen_later_so_they_are_not_listed
make <- function() list(helper = helper)
wrapped <- list(run = function() helper(), now = helper)
helper <- function() 1
#++++
package demo 0.1.0
== R/a.R
1:0 lazy make function at 1:8
2:0 eager binds [wrapped] reads [helper list]
3:0 lazy helper function at 3:10

#==== positions
#---- an_item_after_another_on_the_same_line_keeps_its_column
first <- function() 1; second <- function() 2
#++++
package demo 0.1.0
== R/a.R
1:0 lazy first function at 1:9
1:23 lazy second function at 1:33

#---- multi_line_items_start_at_their_first_line
alpha <- function(x) {
  x
}

beta <- function(y) {
  y
}
#++++
package demo 0.1.0
== R/a.R
1:0 lazy alpha function at 1:9
5:0 lazy beta function at 5:8

#---- inline_annotations_are_erased_but_lines_stay
typed <- function(x: int,
                  y: int) -> int {
  x + y
}
after <- function() 1
#++++
package demo 0.1.0
== R/a.R
1:0 lazy typed function at 1:9
5:0 lazy after function at 5:9

#---- a_syntax_error_is_reported_with_its_line
fine <- function() 1
broken <- function( {
#++++
package demo 0.1.0
== R/a.R
syntax error 2: unclosed `(`; expected `)` to close the parameter list
syntax error 2: expected a parameter name, found `{`
1:0 lazy fine function at 1:8
2:0 lazy broken function at 2:10

#==== strict_constants
#---- a_strict_file_binds_pure_constants_lazily
#~~~~ R/a.R
# typing: strict
version <- "1.2.0"
labels <- paste0("item_", seq_len(3))
squares <- local({
  out <- numeric(3)
  for (i in seq_len(3)) out[i] <- i * i
  out
})
setClass("Account", representation(balance = "numeric"))
#++++
package demo 0.1.0
== R/a.R
2:0 lazy version constant at 2:11
3:0 lazy labels constant at 3:10
4:0 lazy squares constant at 4:11
9:0 eager reads [representation setClass] registers S4Class { class: "Account" }

#---- an_impure_constant_a_chain_and_a_rewritten_name_stay_eager
#~~~~ R/a.R
# typing: strict
home <- Sys.getenv("HOME")
a <- b <- 1
limit <- 1
limit <- 2
#++++
package demo 0.1.0
== R/a.R
2:0 eager binds [home] reads [Sys.getenv]
3:0 eager binds [a b]
4:0 eager binds [limit]
5:0 eager binds [limit]

#---- a_constant_calling_a_project_pure_function
#~~~~ R/a.R
# typing: strict
#: @pure
twice <- function(x) x * 2
doubled <- twice(21)
#~~~~ R/b.R
# typing: strict
helper <- function(x) x
used <- helper(1)
#++++
package demo 0.1.0
== R/a.R
3:0 lazy twice function at 3:9
4:0 lazy doubled constant at 4:11
== R/b.R
2:0 lazy helper function at 2:10
3:0 eager binds [used] reads [helper]

#---- without_strict_mode_constants_stay_eager
#~~~~ R/a.R
version <- "1.2.0"
#++++
package demo 0.1.0
== R/a.R
1:0 eager binds [version]
