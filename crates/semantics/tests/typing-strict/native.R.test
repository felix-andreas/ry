#---- boundary_function_is_not_judged
#~~~~ script.R
# boundary: load_scores, report
# A function with an R type in its signature is where R values meet ry values. The interpreter
# runs it, and the native function it calls takes ry values only.
average <- function(scores: List<F64>) -> F64 List.sum(scores) / Num.to_f64(List.len(scores))
load_scores <- function(count: integer) -> List<F64> {
  raw <- sqrt(seq_len(count))
  List.from_r(raw[raw > 1.5])
}
report <- function(count: integer) -> character {
  scores <- load_scores(count)
  sprintf("%.3f", average(scores))
}
cat(report(10L), "\n")
#++++
== script.R
average: fn(scores: List<F64>) -> F64
load_scores: fn(count: integer) -> List<F64>
report: fn(count: integer) -> character
NULL

#---- clean_scalars
#~~~~ script.R
# Numbers, conditions, loops, early returns and recursion.
collatz <- function(start: I64) -> I64 {
  steps: I64 <- 0
  n <- start
  while (n != 1) {
    if (n %% 2 == 0) n <- n %/% 2 else n <- 3 * n + 1
    steps <- steps + 1
  }
  steps
}
gcd <- function(a: I64, b: I64) -> I64 {
  if (b == 0) return(a)
  gcd(b, a %% b)
}
mean_of_squares <- function(n: I64) -> F64 {
  total <- 0
  for (i in List.range(1, n)) {
    x <- Num.to_f64(i)
    total <- total + x * x
  }
  total / Num.to_f64(n)
}
classify <- function(x: F64, strict: Bool) -> Str {
  if (Num.is_nan(x)) return("nan")
  label: Str <- if (x < 0) "negative" else if (x == 0) "zero" else "positive"
  if (strict && Num.abs(x) > 100) "large" else label
}
cat(Num.to_r(collatz(27)), Num.to_r(gcd(1071, 462)), mean_of_squares(10), classify(-3, TRUE), classify(250, TRUE), "\n")
#++++
== script.R
collatz: fn(start: I64) -> I64
gcd: fn(a: I64, b: I64) -> I64
mean_of_squares: fn(n: I64) -> F64
classify: fn(x: F64, strict: Bool) -> Str
NULL

#---- clean_lists_and_closures
#~~~~ script.R
# Lists, local functions that capture, and function literals passed to the standard library.
square <- function(x: F64) -> F64 x * x
scaled_sum <- function(n: I64, factor: F64) -> F64 {
  scale <- function(x: F64) -> F64 x * factor
  values <- List.map(List.range(1, n), function(i: I64) -> F64 scale(Num.to_f64(i)))
  squares <- List.map(values, square)
  kept <- List.count_if(squares, function(value) value > 10)
  running <- List.walk(squares, 0, function(total, value) total + value)
  sorted <- List.sort_desc(values)
  doubled <- values * 2 + 1
  grown <- List.with_capacity(n)
  for (value in sorted) grown <- List.append(grown, value)
  grown[[1]] <- grown[[1]] + List.sum(doubled)
  running + Num.to_f64(kept) + grown[[1]] + Num.to_f64(List.len(List.concat(values, sorted)))
}
cat(scaled_sum(6, 1.5), "\n")
#++++
== script.R
square: fn(x: F64) -> F64
scaled_sum: fn(n: I64, factor: F64) -> F64
NULL

#---- clean_dicts_and_strings
#~~~~ script.R
# Dictionaries, sets, strings, format strings and results.
word_counts <- function(text: Str) -> Dict<Str, I64> {
  counts: Dict<Str, I64> <- Dict.empty()
  for (word in Str.split_on(text, " ")) {
    counts <- Dict.insert(counts, word, Result.with_default(Dict.get(counts, word), 0) + 1)
  }
  counts
}
describe <- function(text: Str) -> Str {
  counts <- word_counts(Str.with_ascii_lowercased(text))
  distinct <- Set.len(Set.from_list(Str.split_on(text, " ")))
  the <- Result.with_default(Dict.get(counts, "the"), 0)
  parsed <- match (Str.to_i64("42")) {
    :Ok(number) => number
    :Err(_) => 0
  }
  f"{Dict.len(counts)} words, {distinct} spellings, {the} the, {parsed}"
}
cat(describe("The cat and the hat and THE bat"), "\n")
#++++
== script.R
word_counts: fn(text: Str) -> Dict<Str, I64>
describe: fn(text: Str) -> Str
NULL

#---- clean_records_and_tags
#~~~~ script.R
# Records, tuples, tags, nominal types and `match`.
alias Point = Record{x: F64, y: F64}
type Shape = :Circle(center: Point, radius: F64) | :Rect(corner: Point, width: F64, height: F64) | :Dot
alias Light = :Red | :Amber | :Green

area <- function(shape: Shape) -> F64 {
  match (shape) {
    :Circle(center = _, radius = r) => Num.pi * r * r
    :Rect(corner = _, width = w, height = h) => w * h
    :Dot => 0
  }
}
moved <- function(point: Point, dx: F64) -> Point (..point, x = point$x + dx)
next_light <- function(light: Light) -> Light {
  match (light) {
    :Red => :Green
    :Amber => :Red
    :Green => :Amber
  }
}
bounds <- function(values: List<F64>) -> Tuple{F64, F64} {
  low <- values[[1]]
  high <- values[[1]]
  for (value in values) {
    low <- Num.min(low, value)
    high <- Num.max(high, value)
  }
  (low, high)
}
total_area <- function(n: I64) -> F64 {
  origin: Point <- (x = 0, y = 0)
  total <- 0
  light <- next_light(next_light(:Green))
  for (i in List.range(1, n)) {
    side <- Num.to_f64(i)
    shape <- if (i %% 3 == 0) @Shape(:Dot) else if (i %% 3 == 1) @Shape(:Circle(center = origin, radius = side)) else @Shape(:Rect(corner = moved(origin, side), width = side, height = 2f64))
    total <- total + area(shape)
  }
  range <- bounds([total, 1, 2 * total])
  weight: F64 <- match (light) {
    :Red => 1f64
    :Amber => 2f64
    :Green => 3f64
  }
  range[[2]] - range[[1]] + weight
}
cat(total_area(9), "\n")
#++++
== script.R
area: fn(shape: Shape) -> F64
moved: fn(point: Point, dx: F64) -> Point
next_light: fn(light: Light) -> Light
bounds: fn(values: List<F64>) -> Tuple{F64, F64}
total_area: fn(n: I64) -> F64
NULL

#---- clean_r_calls_as_statements_and_in_conversions
#~~~~ script.R
# R functions called where a native function may call them: as a statement, or inside a conversion.
# The first call runs in the interpreter, which loads `stats::rnorm`, so the second one is the
# call that has to run natively.
simulate <- function(draws: I64, label: Str) -> F64 {
  set.seed(Num.to_r(draws))
  noise <- List.from_r(stats::rnorm(Num.to_r(draws)))
  low_bits <- Num.from_r(bitwAnd(Num.to_r(draws), 3L))
  doubled <- Str.from_r(strrep(label, 2L))
  exists <- Bool.from_r(file.exists(label))
  if (exists) stop(sprintf("a file is named %s", toupper(label)))
  cat(doubled, "\n")
  message("drew ", List.to_r(noise))
  List.sum(noise) * 0 + Num.to_f64(low_bits)
}
cat(simulate(4, "native"), "\n")
cat(simulate(5, "native"), "\n")
#++++
== script.R
simulate: fn(draws: I64, label: Str) -> F64
NULL
NULL

#---- r_call_as_the_last_statement_of_a_loop_or_branch
#~~~~ script.R
# An R call whose value is unused, as the last statement of a loop body or of a branch. The
# checker accepts each, and the typed core does not compile them yet.
loop_tail <- function(n: I64) -> F64 {
  total <- 0f64
  for (i in List.range(1, n)) {
    total <- total + Num.to_f64(i)
    cat("step", total, "\n")
  }
  total
}
loop_statement <- function(n: I64) -> F64 {
  for (i in List.range(1, n)) cat("row", Num.to_r(i), "\n")
  1
}
while_tail <- function(n: I64) -> F64 {
  left <- n
  while (left > 0) {
    left <- left - 1
    cat("left", Num.to_r(left), "\n")
  }
  Num.to_f64(left)
}
branch_statement <- function(n: I64) -> F64 {
  if (n > 2) cat("large\n")
  1
}
both_branches <- function(n: I64) -> F64 {
  if (n > 2) {
    cat("large\n")
  } else {
    cat("small\n")
  }
  1
}
match_arms <- function(text: Str) -> F64 {
  match (Str.to_i64(text)) {
    :Ok(number) => cat("number", Num.to_r(number), "\n")
    :Err(_) => cat("not a number\n")
  }
  1
}
cat(loop_tail(2), loop_statement(2), while_tail(2), branch_statement(3), both_branches(3), match_arms("12"), "\n")
#++++
== script.R
loop_tail: fn(n: I64) -> F64
loop_statement: fn(n: I64) -> F64
while_tail: fn(n: I64) -> F64
branch_statement: fn(n: I64) -> F64
both_branches: fn(n: I64) -> F64
match_arms: fn(text: Str) -> F64
NULL

#---- conversion_of_a_base_function
#~~~~ script.R
# A conversion of what a base R function returns, where the typed core computes the function
# itself. The checker accepts each, and the typed core does not compile them yet.
