#---- operator_on_an_aliased_table_expression
#~~~~ script.R
alias Rule = Expr
alias Sales = DataFrame{units: integer[], price: double[]}
units <- function(name: Str) -> Rule Expr.col(name)
direct <- function(sales: Sales) -> DataFrame {
  DataFrame.filter(sales, units("units") > 2L)
}
through_a_variable <- function(sales: Sales) -> DataFrame {
  rule <- units("units")
  DataFrame.filter(sales, rule > 2L)
}
#++++
