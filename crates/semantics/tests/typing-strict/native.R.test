#---- r_calls_on_r_code_as_r_arguments
#~~~~ script.R
# A call of a base R function on literals and outside variables is R code too, which R evaluates
# lazily among another call's arguments. A call on a local, of a function that reads its caller's
# frame, or of another package's function, which may read it as `str_glue` does, is not. The fix
# for an inner call whose result is an integer would pass an `I64` to R, so there is none.
alias Days = DataFrame{day: Date, v: double}
#: character
start <- "2026-01-01"
since <- function(rows: Days) -> Days {
  rows |> DataFrame.filter(Expr.col("day") >= as.Date(start))
}
shout <- function(word: Str) -> Str {
  Str.from_r(paste(word, toupper(trimws(start)), base::nchar("abc")))
}
local_inner <- function(word: Str) -> Str {
  Str.from_r(paste(toupper(word)))
}
frame_inner <- function(word: Str) -> Str {
  Str.from_r(paste(word, get("start")))
}
member <- function(word: Str) -> Bool {
  Bool.from_r(all(start %in% letters))
}
interpolated <- function(word: Str) -> Str {
  Str.from_r(paste(word, stringr::str_glue("{start}")))
}
counted <- function(word: Str) -> Str {
  Str.from_r(paste(word, nchar(word)))
}
#++++
== script.R
start: character
since: fn(rows: Days) -> Days
shout: fn(word: Str) -> Str
local_inner: fn(word: Str) -> Str
frame_inner: fn(word: Str) -> Str
member: fn(word: Str) -> Bool
interpolated: fn(word: Str) -> Str
counted: fn(word: Str) -> Str
