  if (n > 1 && { x <- "big"; TRUE }) n else 0
}
bound_inside <- function(n: I64) -> Str {
  if (n > 1) {
    label <- n * 10
    label <- Num.to_str(label)
    label
  } else {
    "small"
  }
}
