#---- table_forms_the_typed_core_does_not_compile
#~~~~ script.R
by_position <- function(sales: DataFrame{units: integer[], price: double[]}) -> F64 {
  List.sum(List.from_r(sales[[2]]))
}
prefixed <- function(sales: DataFrame{units: integer[], price: double[]}) -> DataFrame {
  DataFrame.filter(sales, ry::Expr.col("units") > 2L)
}
boxed <- function(sales: DataFrame{units: integer[], price: double[]}) -> DataFrame {
  held <- (rule = Expr.col("units") > 2L, count = 1)
  DataFrame.filter(sales, held$rule)
}
#++++
