#---- a_local_converted_where_it_is_read_gets_no_conversion_fix
#~~~~ script.R
# Converting at the assignment would break the read that converts the local, or passes it to R
# as an `I64`.
lengths_of <- function(label: Str) -> I64 {
  width <- nchar(label)
  shown <- nchar(label)
  cat(shown, "\n")
  Num.from_r(width)
}
