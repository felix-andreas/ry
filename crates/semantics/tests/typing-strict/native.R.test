#---- invisible_result
#~~~~ script.R
# A body that ends every path invisibly compiles; one whose paths disagree is blocked.
remember <- function(x: F64) -> F64 {
  doubled <- x * 2
}
show_all <- function(n: I64) -> NULL {
  for (i in List.range(1, n)) {
    cat("row", Num.to_r(i), "\n")
    NULL
  }
}
bump_all <- function(xs: List<I64>) List.for_each(xs, function(x: I64) x + 1)
mixed <- function(x: F64) -> F64 if (x > 0) x else { y <- 0 }
first_above <- function(x: F64) -> F64 {
  repeat {
    x <- x + 1
    if (x > 3) return(x)
  }
}
show_all(2)
cat(remember(2), mixed(1), first_above(1), "\n")
bump_all([1, 2])
#++++
