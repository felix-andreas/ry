#~~~~ script.R
# The condition runs first and once, so computing its call before the `if` keeps the order.
long <- function(amount: F64) -> Bool {
  if (Num.from_r(nchar(format(amount))) > 3) {
    TRUE
  } else {
    FALSE
  }
}
