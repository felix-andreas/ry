#---- a_nested_r_call_that_might_not_run_is_not_moved
#~~~~ script.R
# A branch, a loop, the right side of `&&`, a function literal's bare body and an argument of
# `tryCatch` run the call under a condition, so computing it first would change the program.
guarded <- function(amount: F64, flag: Bool) -> F64 {
  if (flag) cat(format(amount), "\n")
  while (Num.from_r(nchar(format(amount))) > 10) {
    amount <- amount / 10
  }
  ok <- flag && Num.from_r(nchar(format(amount))) > 3
  labels <- List.map([amount], function(x: F64) -> Str Str.from_r(paste0("n", format(x))))
  tryCatch(cat(Str.from_r(format(amount)), "\n"), error = function(e) NULL)
  amount
}
