#---- names_set_on_some_paths
#~~~~ script.R
# A name a branch, a loop body or a `match` arm sets is read natively after it, and a local
# function defined inside a loop body runs there.
alias Outcome = :Ok(I64) | :Err(Str)
last_over <- function(xs: List<I64>, limit: I64) -> I64 {
  for (x in xs) {
    if (x > limit) {
      found <- x
    }
  }
  found
}
payload <- function(r: Outcome) -> I64 {
  match (r) {
    :Ok(n) => 0
    :Err(_) => 1
  }
  n
}
relabel <- function(flag: Bool) -> Str {
  if (flag) {
    label <- 1
  }
  label <- "text"
  Str.concat(label, "!")
}
shifted <- function(xs: List<I64>) -> I64 {
  total <- 0
  for (x in xs) {
    add <- function(v: I64) -> I64 v + x
    total <- total + add(1)
  }
  total
}
print(last_over([1, 5], 4))
print(payload(:Ok(9)))
print(relabel(TRUE))
print(shifted([1, 2]))
#++++
== script.R
last_over: fn(xs: List<I64>, limit: I64) -> I64
payload: fn(r: Outcome) -> I64
relabel: fn(flag: Bool) -> Str
shifted: fn(xs: List<I64>) -> I64
I64
I64
