#==== untyped_parameters
#---- a_parameter_nothing_constrains_is_untyped
describe <- function(x) cat("value\n")
#++++
describe: <T> fn(x: T) -> NULL
21..22 error[strict] strict mode: parameter `x` has no type. Nothing in the body constrains it, so any value is accepted unchecked. Annotate it, as in `x: TYPE`

#---- an_annotated_parameter_is_typed
describe <- function(x: Any) cat("value\n")
#: fn(y: Any) -> NULL
describe_too <- function(y) cat("value\n")
#++++
describe: fn(x: Any) -> NULL
describe_too: fn(y: Any) -> NULL

#---- a_type_variable_shared_with_the_return_is_generic
identity2 <- function(x) x
#++++
identity2: <T> fn(x: T) -> T

#---- a_type_variable_shared_by_two_parameters_is_generic
choose <- function(flag, a, b) if (flag) a else b
#++++
choose: <T> fn(flag: logical, a: T, b: T) -> T

#---- a_constrained_parameter_is_typed
increment <- function(x) x + 1L
#++++
increment: <T: numeric> fn(x: T) -> T

#---- partial_annotation_reports_the_rest
add <- function(x: integer, unused) x
#++++
add: fn(x: integer, unused: Unknown) -> integer
28..34 error[strict] strict mode: parameter `unused` has no type. Nothing in the body constrains it, so any value is accepted unchecked. Annotate it, as in `unused: TYPE`

#---- rest_parameters_are_not_reported
join <- function(...) paste0(...)
#++++
join: fn(...: Any) -> character

#---- a_closure_parameter_tied_to_the_enclosing_function_is_typed
apply_to <- function(f) function(x) f(x)
#++++
apply_to: <T, U> fn(f: fn(T) -> U) -> fn(x: T) -> U

#---- a_lambda_typed_by_its_call_site
doubled <- lapply(1:3, function(x) x * 2L)
#++++
doubled: list[integer]
