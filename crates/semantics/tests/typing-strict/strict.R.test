#==== literal_decisions
#---- c_decides_a_literal_as_r_type
grow <- function(target: double) -> double[] {
  bounds <- 1
  bounds <- c(bounds, target)
  bounds
}
#++++
grow: fn(target: double) -> double[]

#---- a_tuple_item_literal_takes_the_ry_number_beside_it
alias Move = :Buy(quantity: F64, price: F64) | :Fee(amount: F64)
spend <- function(moves: List<Move>) -> F64 {
  total <- 0.0
  for (move in moves) {
    step <- match (move) {
      :Buy(quantity = q, price = p) => (q, p)
      :Fee(amount = a) => (0, a)
    }
    total <- total + step[[1]] * step[[2]]
  }
  total
}
#++++
spend: fn(moves: List<Move>) -> F64

#---- a_tuple_item_literal_beside_an_r_double_is_a_double
alias Fill = :Buy(quantity: double, price: double) | :Sell(quantity: double, price: double) | :Fee(amount: double)
book <- function(fills: list[Fill]) -> double {
  position <- 0
  realised <- 0
  for (fill in fills) {
    step <- match (fill) {
      :Buy(quantity = q, price = p) => (q, p)
      :Sell(quantity = q, price = p) => (-q, p)
      :Fee(amount = a) => (0, a)
    }
    delta <- step[[1L]]
    if (delta == 0) {
      realised <- realised - step[[2L]]
    } else {
      position <- position + delta
    }
  }
  realised + position
}
#++++
book: fn(fills: list[Fill]) -> double

#---- a_record_field_literal_takes_the_ry_number_beside_it
alias Move = :Buy(quantity: F64, price: F64) | :Fee(amount: F64)
spend <- function(moves: List<Move>) -> F64 {
  total <- 0.0
  for (move in moves) {
    step <- match (move) {
      :Buy(quantity = q, price = p) => (size = q, price = p)
      :Fee(amount = a) => (size = 0, price = a)
    }
    total <- total + step$size * step$price
  }
  total
}
#++++
spend: fn(moves: List<Move>) -> F64

#---- a_string_item_literal_takes_the_str_beside_it
alias Move = :Buy(name: Str, price: F64) | :Fee(amount: F64)
spend <- function(moves: List<Move>) -> F64 {
  total <- 0.0
  for (move in moves) {
    step <- match (move) {
      :Buy(name = n, price = p) => (n, p)
      :Fee(amount = a) => ("fee", a)
    }
    total <- total + step[[2]]
  }
  total
}
#++++
spend: fn(moves: List<Move>) -> F64

#---- a_tag_payload_literal_takes_the_ry_number_beside_it
alias Move = :Buy(quantity: F64, price: F64) | :Fee(amount: F64)
spend <- function(moves: List<Move>) -> F64 {
  total <- 0.0
  for (move in moves) {
    step <- match (move) {
      :Buy(quantity = q, price = p) => :Step(q, p)
      :Fee(amount = a) => :Step(0, a)
    }
    total <- total + match (step) {
      :Step(x, y) => x * y
    }
  }
  total
}
#++++
spend: fn(moves: List<Move>) -> F64

#---- an_item_literal_the_number_cannot_hold_is_a_mismatch_at_the_literal
alias Move = :Buy(quantity: I64, price: F64) | :Fee(amount: F64)
spend <- function(moves: List<Move>) -> F64 {
  total <- 0.0
  for (move in moves) {
    step <- match (move) {
      :Buy(quantity = q, price = p) => (q, p)
      :Fee(amount = a) => (2.5, a)
    }
    total <- total + step[[2]]
  }
  total
}
#++++
spend: fn(moves: List<Move>) -> F64
250..253 error[type-mismatch] this literal does not fit `I64`, which cannot hold its value exactly
