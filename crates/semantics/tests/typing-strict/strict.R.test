#---- base_masking_family_results_are_typed
#: data.frame
d <- data.frame(a = c(1, 2), b = c(3, 4))
small <- subset(d, a > 1, select = b)
more <- transform(d, c = a + b)
inside <- within(d, c <- a * 2)
total <- with(d, sum(a + b))
kept <- subset(c(1, 2, 3), c(TRUE, FALSE, TRUE))
#++++
d: data.frame
small: data.frame
more: data.frame
inside: data.frame
total: Any
kept: double[]

