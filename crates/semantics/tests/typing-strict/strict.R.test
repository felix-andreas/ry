#==== directives
#---- typing_comment_sets_the_mode
# typing: strict
f <- function(x) x + 1L
#++++
typing mode: Strict
f: <T: numeric> fn(x: T) -> T

#---- last_directive_wins
# typing: strict
# typing: off
f <- function(x) x
#++++
typing mode: Off
f: <T> fn(x: T) -> T

#---- strict_annotation_form
#: @strict
f <- function(x) x
#++++
typing mode: Strict
f: <T> fn(x: T) -> T

#---- unknown_value_is_reported
# typing: loud
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
0..14 error[annotation] Unknown typing directive `loud`. Use `# typing: on`, `# typing: off`, or `# typing: strict`.

