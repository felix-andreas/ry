#==== origins
#---- unsupported_constructs_are_origins
special <- function(a, b) a %undeclared% b
formula_model <- function() y ~ x
elementwise <- function(a, b) a & b
#++++
special: <T, U> fn(a: T, b: U) -> Unknown
formula_model: fn() -> Unknown
elementwise: <T, U> fn(a: T, b: U) -> Unknown
26..42 error[strict] strict mode: this expression has an undetermined type (`Unknown`)
71..76 error[strict] strict mode: this expression has an undetermined type (`Unknown`)
107..112 error[strict] strict mode: this expression has an undetermined type (`Unknown`)

#---- a_corpus_declared_operator_is_typed_and_no_origin
member <- function(a, b) a %in% b
#++++
member: <T, U> fn(a: T, b: U) -> logical

#---- assignment_value_phrasing
f <- function(x) {
  result <- x %undeclared% letters
  result
}
#++++
f: <T> fn(x: T) -> Unknown
31..53 error[strict] strict mode: could not determine the type of `result`; add a type annotation

#---- dollar_on_an_unresolved_variable
f <- function(node) node$value
#++++
f: <T> fn(node: T) -> Unknown
20..30 error[strict] strict mode: this expression has an undetermined type (`Unknown`)

#---- combine_with_an_unresolved_argument
f <- function(x) c(x, 1L)
#++++
f: <T> fn(x: T) -> Unknown
17..25 error[strict] strict mode: this expression has an undetermined type (`Unknown`)

#---- qualified_read_with_no_known_type
f <- function() somepkg::mystery()
#++++
f: fn() -> Unknown
16..32 warning[unresolved] unknown package namespace `somepkg`.
16..32 error[strict] strict mode: could not determine the type of `mystery`; it has no known type

#---- no_origin_when_types_are_known
f <- function() {
  x <- 1L
  x + 1L
}
#++++
f: fn() -> integer

#---- one_origin_reported_once_however_many_uses
frame <- data.frame(a = 1)
value <- frame$a
first <- value
second <- value
third <- value
#++++
frame: Unknown
value: Unknown
first: Unknown
second: Unknown
third: Unknown
9..26 error[strict] strict mode: could not determine the type of `frame`; add a type annotation

#==== directives
#---- typing_comment_sets_the_mode
# typing: strict
f <- function(x) x + 1L
#++++
typing mode: Strict
f: <T: numeric> fn(x: T) -> T

#---- last_directive_wins
# typing: strict
# typing: off
f <- function(x) x
#++++
typing mode: Off
f: <T> fn(x: T) -> T

#---- strict_annotation_form
#: @strict
f <- function(x) x
#++++
typing mode: Strict
f: <T> fn(x: T) -> T

#---- unknown_value_is_reported
# typing: loud
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
0..14 error[annotation] Unknown typing directive `loud`. Use `# typing: on`, `# typing: off`, or `# typing: strict`.

#==== masking
#---- data_table_brackets_are_masked
summarize <- function(dt) {
  dt[, .(m = mean(speed)), by = cyl]
}
#++++
summarize: <T> fn(dt: T) -> Unknown

#---- data_table_column_assignment
add_column <- function(dt) {
  dt[, ratio := speed / dist]
  dt
}
#++++
add_column: <T> fn(dt: T) -> T

#---- base_masking_family
pick <- function(df) subset(df, cyl > 4)
#++++
pick: <T> fn(df: T) -> Unknown
21..40 error[strict] strict mode: this expression has an undetermined type (`Unknown`)

#---- base_indexing_keeps_checking
f <- function() {
  x <- list(1L)
  x[1L, 2L]
}
#++++
f: Unknown
36..45 error[type-mismatch] indexing with 2 indexes is not supported yet. ry does not model matrix and data.frame subsetting

#==== recursion
#---- self_recursion_is_attributed
fact <- function(n) if (n <= 1L) 1L else n * fact(n - 1L)
#++++
fact: fn(n: integer) -> integer

#---- mutual_recursion_is_attributed_per_binding
even <- function(n) if (n == 0L) TRUE else odd(n - 1L)
odd <- function(n) if (n == 0L) FALSE else even(n - 1L)
#++++
even: <T: numeric> fn(n: T) -> logical
odd: <T: numeric> fn(n: T) -> logical

#---- annotated_recursion_has_no_origin
#: fn(n: integer) -> integer
fact <- function(n) if (n <= 1L) 1L else n * fact(n - 1L)
#++++
fact: fn(n: integer) -> integer

#---- growing_recursion_is_attributed
x <- list(v = 1, w = x)
#++++
x: Unknown
0..23 error[strict] strict mode: could not determine the full type of `x`. It is defined recursively. Add a type annotation

#---- pure_self_call_is_attributed
f <- function() f()
#++++
f: fn() -> Unknown
0..19 error[strict] strict mode: could not determine the full type of `f`. It is defined recursively. Add a type annotation

#---- an_any_returning_overload_is_a_strict_origin
# The corpus ends an overload set with an `Any` fallback for the calls it cannot
# describe, and `Any` then satisfies every later check — so the call is a real
# hole. Strict mode otherwise reports only `Unknown`, which made the commonest
# hole invisible to the feature whose whole purpose is finding holes.
earliest <- function() {
  d <- as.Date("2024-01-01")
  min(d)
}
#++++
earliest: fn() -> Any
367..373 error[strict] strict mode: this expression has an undetermined type (`Unknown`)

