#==== literal_decisions
#---- c_decides_a_literal_as_r_type
grow <- function(target: double) -> double[] {
  bounds <- 1
  bounds <- c(bounds, target)
  bounds
}
#++++
grow: fn(target: double) -> double[]

#---- a_tuple_item_literal_takes_the_ry_number_beside_it
alias Move = :Buy(quantity: F64, price: F64) | :Fee(amount: F64)
spend <- function(moves: List<Move>) -> F64 {
  total <- 0.0
  for (move in moves) {
    step <- match (move) {
      :Buy(quantity = q, price = p) => (q, p)
      :Fee(amount = a) => (0, a)
    }
    total <- total + step[[1]] * step[[2]]
  }
  total
}
#++++
spend: fn(moves: List<Move>) -> F64

#---- a_tuple_item_literal_beside_an_r_double_is_a_double
alias Fill = :Buy(quantity: double, price: double) | :Sell(quantity: double, price: double) | :Fee(amount: double)
book <- function(fills: list[Fill]) -> double {
  position <- 0
  realised <- 0
  for (fill in fills) {
    step <- match (fill) {
      :Buy(quantity = q, price = p) => (q, p)
      :Sell(quantity = q, price = p) => (-q, p)
      :Fee(amount = a) => (0, a)
    }
    delta <- step[[1L]]
    if (delta == 0) {
      realised <- realised - step[[2L]]
    } else {
      position <- position + delta
    }
  }
  realised + position
}
#++++
book: fn(fills: list[Fill]) -> double

#---- a_record_field_literal_takes_the_ry_number_beside_it
alias Move = :Buy(quantity: F64, price: F64) | :Fee(amount: F64)
spend <- function(moves: List<Move>) -> F64 {
  total <- 0.0
  for (move in moves) {
    step <- match (move) {
      :Buy(quantity = q, price = p) => (size = q, price = p)
      :Fee(amount = a) => (size = 0, price = a)
    }
    total <- total + step$size * step$price
  }
  total
}
#++++
spend: fn(moves: List<Move>) -> F64

#---- a_string_item_literal_takes_the_str_beside_it
alias Move = :Buy(name: Str, price: F64) | :Fee(amount: F64)
spend <- function(moves: List<Move>) -> F64 {
  total <- 0.0
  for (move in moves) {
    step <- match (move) {
      :Buy(name = n, price = p) => (n, p)
      :Fee(amount = a) => ("fee", a)
    }
    total <- total + step[[2]]
  }
  total
}
#++++
spend: fn(moves: List<Move>) -> F64

#---- a_string_or_logical_argument_takes_the_type_a_later_argument_gives_it
joined <- function(words: List<Str>) -> Str {
  List.walk(words, "", function(text: Str, word: Str) -> Str Str.concat(text, word))
}
every <- function(flags: List<Bool>) -> Bool {
  List.walk(flags, TRUE, function(all: Bool, flag: Bool) -> Bool all && flag)
}
fallback <- function(found: Result<Str, Str>) -> Str {
  Result.with_default(found, "none")
}
#++++
joined: fn(words: List<Str>) -> Str
every: fn(flags: List<Bool>) -> Bool
fallback: fn(found: Result<Str, Str>) -> Str

#---- literals_a_call_leaves_open_take_the_declared_return_type
first_or_two <- function() -> I64 Result.with_default(:Ok(1), 2)
named <- function(n: I64) -> Str {
  found <- if (n > 2) :Ok("big") else :Err("small")
  Result.with_default(found, "none")
}
kept <- function() -> Result<I64, Str> {
  found <- :Ok(1)
  found
}
summed <- function(xs: List<F64>) -> F64 {
  total <- 0
  total <- List.walk(xs, total, function(s: F64, x: F64) -> F64 s + x)
  total
}
#++++
first_or_two: fn() -> I64
named: fn(n: I64) -> Str
kept: fn() -> Result<I64, Str>
summed: fn(xs: List<F64>) -> F64

#---- tags_inside_a_tuple_join_part_by_part_across_loop_passes_and_branches
flip <- function(xs: List<I64>) {
  state <- (:Go(0), 1i64)
  for (x in xs) state <- match (state) {
    (:Go(v), s) => (:Stop(1), s)
    (:Stop(v), s) => (:Go(v), s)
  }
  state
}
bare <- function(xs: List<I64>) {
  state <- :Go(0)
  for (x in xs) state <- match (state) {
    :Go(v) => :Stop(1)
    :Stop(v) => :Go(v)
  }
  state
}
once <- function(c: Bool) {
  state <- if (c) (:Go(0.0), 1i64) else (:Stop(1.0), 2i64)
  match (state) {
    (:Go(v), s) => (:Stop(1.0), s)
    (:Stop(v), s) => (:Go(v), s)
  }
}
#++++
flip: fn(xs: List<I64>) -> Tuple{:Go(double) | :Stop(double), I64}
bare: fn(xs: List<I64>) -> :Go(double) | :Stop(double)
once: fn(c: Bool) -> Tuple{:Stop(double) | :Go(double), I64}

