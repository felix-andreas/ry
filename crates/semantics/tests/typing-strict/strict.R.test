#---- an_any_returning_overload_is_a_strict_origin
# The corpus ends an overload set with an `Any` fallback for the calls it cannot
# describe, and `Any` then satisfies every later check — so the call is a real
# hole. Strict mode otherwise reports only `Unknown`, which made the commonest
# hole invisible to the feature whose whole purpose is finding holes.
earliest <- function() {
  d <- as.Date("2024-01-01")
  min(d)
}
#++++
earliest: fn() -> Date

#---- an_overload_left_ambiguous_by_a_declared_any_is_any
# Every `sum` candidate accepts an `Any`, and they disagree on the result. The `Any` is the
# author's own opt-out, so the call opts out too instead of becoming a strict finding; a
# forwarded `...` is `Any` the same way.
#~~~~ R/main.R
#: fn(x: Any) -> double
total <- function(x) sum(x)
#: fn(...: Any) -> Any
first <- function(...) utils::head(...)
#++++
== R/main.R
total: fn(x: Any) -> double
first: fn(...: Any) -> Any

#---- calling_a_value_declared_any_is_any
# A parameter or variable declared `Any` is the author's opt-out, so calling it is `Any`, while
# its arguments are still checked. A stub declared bare `Any` stays a strict finding.
#~~~~ R/main.R
#: fn(callback: Any) -> Any
run <- function(callback) callback(1 + "a")
#: fn(m: matrix) -> Any
joined <- function(m) merge(m, m)
#++++
== R/main.R
run: fn(callback: Any) -> Any
joined: fn(m: matrix) -> Any
