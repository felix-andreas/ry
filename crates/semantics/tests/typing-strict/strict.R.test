#==== directives
#---- typing_comment_sets_the_mode
# typing: strict
f <- function(x) x + 1L
#++++
typing mode: Strict
f: <T: arithmetic> fn(x: T) -> T

#---- last_directive_wins
# typing: strict
# typing: off
f <- function(x) x
#++++
typing mode: Off
f: <T> fn(x: T) -> T

#---- strict_annotation_form
#: @strict
f <- function(x) x
#++++
typing mode: Strict
f: <T> fn(x: T) -> T

