  x <- 1L
  x + 1L
}
#++++
f: fn() -> integer

#---- one_origin_reported_once_however_many_uses
frame <- data.frame(a = 1)
value <- frame$a
first <- value
second <- value
third <- value
#++++
frame: Unknown
value: Unknown
first: Unknown
second: Unknown
third: Unknown
