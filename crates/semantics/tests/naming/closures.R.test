#---- closure_parameter_shadows_enclosing_binding
f <- function() {
  x <- 1L
  g <- function(x) x
}
#++++
# f
  b0 x local 20..21
  b1 g local 30..31
  b2 x parameter 44..45
  b3 f top-level 0..1
  0..1 f <- b3
  20..21 x <- b0
  30..31 g <- b1
  47..48 x -> b2
