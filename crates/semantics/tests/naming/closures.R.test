  b0 x parameter 14..15
  b1 g local 21..22
  b2 f top-level 0..1
  0..1 f <- b2
  21..22 g <- b1
  37..38 x -> b0 captured
  unused g 21..22

#---- nested_function_closes_over_top_level_global
x <- 1L
f <- function() {
  g <- function() x
}
#++++
# x
  b0 x top-level 0..1
  0..1 x <- b0
# f
  b0 g local 20..21
  b1 f top-level 0..1
  0..1 f <- b1
  20..21 g <- b0
  36..37 x -> non-local deferred
  unused g 20..21

