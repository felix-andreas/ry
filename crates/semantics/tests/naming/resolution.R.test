#==== shadowing
#---- a_parameter_shadows_an_outer_binding
x <- 1L
f <- function(x) x
#++++
# x
  b0 x top-level 0..1
  0..1 x <- b0
# f
  b0 x parameter 14..15
  b1 f top-level 0..1
  0..1 f <- b1
  17..18 x -> b0

#---- an_inner_local_shadows_the_parameter_for_later_reads
f <- function(x) {
  before <- x
  x <- x + 1L
  after <- x
  before + after
}
#++++
# f
  b0 x parameter 14..15
  b1 before local 21..27
  b2 after local 49..54
  b3 f top-level 0..1
  0..1 f <- b3
  21..27 before <- b1
  31..32 x -> b0
  35..36 x <- b0
  40..41 x -> b0
  49..54 after <- b2
  58..59 x -> b0
  62..68 before -> b1
  71..76 after -> b2

#---- a_closure_capture_marks_the_slot
make <- function() {
  total <- 0L
  function(n) total + n
}
#++++
# make
  b0 total local 23..28
  b1 n parameter 46..47
  b2 make top-level 0..4
  0..4 make <- b2
  23..28 total <- b0 captured
  49..54 total -> b0 captured
  57..58 n -> b1

#---- reads_of_one_slot_before_and_after_a_rewrite_are_indistinguishable_by_type
# Both reads of `x` are integer either way, so a resolution pointing at the
# wrong occurrence changes no type and fires no diagnostic — the typing suites
# cannot see it. This suite states the binding directly, which is the whole
# reason it exists.
f <- function(x) {
  first <- x
  x <- 99L
  second <- x
  first + second
}
#++++
# f
  b0 x parameter 14..15
  b1 first local 21..26
  b2 second local 45..51
  b3 f top-level 0..1
  0..1 f <- b3
  21..26 first <- b1
  30..31 x -> b0
  34..35 x <- b0
  45..51 second <- b2
  55..56 x -> b0
  59..64 first -> b1
  67..73 second -> b2

#==== non_locals
#---- a_read_with_no_lexical_slot_is_a_non_local
f <- function() undefined_helper(1L)
#++++
# f
  b0 f top-level 0..1
  0..1 f <- b0
  16..32 undefined_helper -> non-local deferred

#---- a_read_from_inside_a_closure_is_deferred
outer <- function() {
  function() later_defined
}
#++++
# outer
  b0 outer top-level 0..5
  0..5 outer <- b0
  35..48 later_defined -> non-local deferred

#---- a_namespace_read_records_its_package
f <- function() stats::median(1:3)
#++++
# f
  b0 f top-level 0..1
  0..1 f <- b0
  16..29 stats::median -> namespace

#==== scopes
#---- a_for_variable_gets_its_own_binding_kind
f <- function(items) {
  for (element in items) print(element)
}
#++++
# f
  b0 items parameter 14..19
  b1 element for-variable 30..37
  b2 f top-level 0..1
  0..1 f <- b2
  41..46 items -> b0
  48..53 print -> non-local deferred
  54..61 element -> b1

#---- a_super_assignment_with_no_enclosing_slot_is_a_global
f <- function() {
  counter <<- 1L
}
#++++
# f
  b0 f top-level 0..1
  0..1 f <- b0
  20..27 counter -> non-local
  super-globals: counter

#---- a_local_block_scopes_its_writes
f <- function() {
  inner <- local({
    hidden <- 1L
    hidden + 1L
  })
  inner
}
#++++
# f
  b0 inner local 20..25
  b1 hidden local 41..47
  b2 f top-level 0..1
  0..1 f <- b2
  20..25 inner <- b0
  41..47 hidden <- b1
  58..64 hidden -> b1
  77..82 inner -> b0

#---- a_conditional_write_leaves_a_later_read_maybe_undefined
f <- function(flag) {
  if (flag) value <- 1L
  value
}
#++++
# f
  b0 flag parameter 14..18
  b1 value local 34..39
  b2 f top-level 0..1
  0..1 f <- b2
  28..32 flag -> b0
  34..39 value <- b1
  48..53 value -> b1 maybe-undefined

#==== reference_class_members
#---- a_method_reads_its_fields_and_sibling_methods_through_the_object
# R runs a method in the object's frame, so `name`, `.self` and `bump` resolve there;
# `nmae` is a member of nothing and stays a non-local read.
Person <- setRefClass("Person",
  fields = list(name = "character", age = "numeric"),
  methods = list(
    greet = function() {
      cat(name, .self$age)
      bump()
      nmae
    },
    bump = function() invisible(.self)
  )
)
#++++
# Person
  b0 Person top-level 0..6
  0..6 Person <- b0
  10..21 setRefClass -> non-local
  43..47 list -> non-local
  98..102 list -> non-local
  135..138 cat -> non-local deferred
  175..179 nmae -> non-local deferred
  209..218 invisible -> non-local deferred

#---- a_superclass_defined_in_the_project_lends_its_members
Base <- setRefClass("Base", fields = c(sheets = "list"))
Child <- setRefClass("Child", contains = "Base",
  methods = list(count = function() length(sheets) + callSuper())
)
#++++
# Base
  b0 Base top-level 0..4
  0..4 Base <- b0
  8..19 setRefClass -> non-local
  37..38 c -> non-local
# Child
  b0 Child top-level 0..5
  0..5 Child <- b0
  9..20 setRefClass -> non-local
  61..65 list -> non-local
  85..91 length -> non-local deferred

#---- a_superclass_from_elsewhere_hides_the_members_so_every_name_binds
Open <- setRefClass("Open", contains = "ForeignClass",
  methods = list(go = function() inherited_method())
)
#++++
# Open
  b0 Open top-level 0..4
  0..4 Open <- b0
  8..19 setRefClass -> non-local
  67..71 list -> non-local

#---- a_generator_methods_call_reads_the_members_of_its_class
Workbook <- setRefClass("Workbook", fields = c(font = "character"))
Workbook$methods(getBaseFont = function() font)
Workbook$methods(widths = function() {
  getBaseFont()
  fnot
})
#++++
# Workbook
  b0 Workbook top-level 0..8
  0..8 Workbook <- b0
  12..23 setRefClass -> non-local
  45..46 c -> non-local
# <statement>
  0..8 Workbook -> non-local
# <statement>
  0..8 Workbook -> non-local
  57..61 fnot -> non-local deferred

#---- a_shadowed_top_level_function_is_not_what_a_method_calls
getBaseFont <- function(wb) wb
Workbook <- setRefClass("Workbook",
  methods = list(getBaseFont = function() "Calibri", widths = function() getBaseFont())
)
#++++
# getBaseFont
  b0 wb parameter 24..26
  b1 getBaseFont top-level 0..11
  0..11 getBaseFont <- b1
  28..30 wb -> b0
# Workbook
  b0 Workbook top-level 0..8
  0..8 Workbook <- b0
  12..23 setRefClass -> non-local
  48..52 list -> non-local

#---- an_r6_method_added_with_set_reads_self_and_private
Acc$set("public", "reset", function() {
  private$log <- NULL
  invisible(self)
})
outside <- function() self
#++++
# <statement>
  b0 private local 42..49
  0..3 Acc -> non-local
  42..49 private -> b0
  64..73 invisible -> non-local deferred
# outside
  b0 outside top-level 0..7
  0..7 outside <- b0
  22..26 self -> non-local deferred

#==== masked_arguments
#---- an_assignment_inside_within_binds_in_the_data_not_the_caller
f <- function(d) {
  out <- within(d, {
    total <- a + b
    share <- total / 2
  })
  total
}
#++++
# f
  b0 d parameter 14..15
  b1 out local 21..24
  b2 total local 44..49
  b3 share local 63..68
  b4 f top-level 0..1
  0..1 f <- b4
  21..24 out <- b1
  28..34 within -> non-local deferred
  35..36 d -> b0
  44..49 total <- b2
  53..54 a -> quiet deferred
  57..58 b -> quiet deferred
  63..68 share <- b3
  72..77 total -> b2
  89..94 total -> non-local deferred
  unused out 21..24
