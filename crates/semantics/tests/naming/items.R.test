#==== item_firewall
# Naming runs per top-level item, so a package global is resolved by the
# cross-item layer, not here: within the item a read of another item's name has
# no lexical slot and leaves as a non-local. Every case in this suite that shows
# `non-local` for a name the file plainly defines is showing this boundary.
#---- a_read_of_another_items_top_level_name_leaves_the_item
x <- 1L
y <- x
#++++
# x
  b0 x top-level 0..1
  0..1 x <- b0
# y
  b0 y top-level 0..1
  0..1 y <- b0
  5..6 x -> non-local

#---- a_function_body_reading_another_items_name_leaves_the_item_as_deferred
x <- 1L
f <- function() x
#++++
# x
  b0 x top-level 0..1
  0..1 x <- b0
# f
  b0 f top-level 0..1
  0..1 f <- b0
  16..17 x -> non-local deferred

#---- a_read_placed_before_the_definition_leaves_the_item_the_same_way
f <- function() later_defined
later_defined <- 1L
#++++
# f
  b0 f top-level 0..1
  0..1 f <- b0
  16..29 later_defined -> non-local deferred
# later_defined
  b0 later_defined top-level 0..13
  0..13 later_defined <- b0

#---- a_self_recursive_call_is_a_non_local_inside_its_own_item
# The item's own binding is created by the assignment that wraps the closure, so
# the recursive call inside the closure is a non-local here and resolves in the
# cross-item layer. Binding the name before walking the value would make
# self-recursion resolve locally and hide that path.
factorial <- function(n) if (n <= 1L) 1L else n * factorial(n - 1L)
#++++
# factorial
  b0 n parameter 22..23
  b1 factorial top-level 0..9
  0..9 factorial <- b1
  29..30 n -> b0
  46..47 n -> b0
  50..59 factorial -> non-local deferred
  60..61 n -> b0

#---- two_items_number_their_bindings_independently
f <- function(x) x
g <- function(x) x
#++++
# f
  b0 x parameter 14..15
  b1 f top-level 0..1
  0..1 f <- b1
  17..18 x -> b0
# g
  b0 x parameter 14..15
  b1 g top-level 0..1
  0..1 g <- b1
  17..18 x -> b0

#==== top_level_statements
#---- a_bare_statement_item_has_no_name
print(1L)
#++++
# <statement>
  0..5 print -> non-local

#---- an_unterminated_string_does_not_swallow_the_statements_below_it
# A quote that never closes can only be discovered at end of file, and a token
# that ran that far took every later statement with it — one missing character
# turned the rest of the file into nothing the tools could see. The token ends
# at the line break instead, so `after` is still a binding here.
label <- "unclosed
after <- 1L
#++++
# label
  b0 label top-level 0..5
  0..5 label <- b0
# after
  b0 after top-level 0..5
  0..5 after <- b0

#---- an_unterminated_backtick_name_does_not_swallow_them_either
label <- `unclosed
after <- 1L
#++++
# label
  b0 label top-level 0..5
  0..5 label <- b0
  9..18 `unclosed -> non-local
# after
  b0 after top-level 0..5
  0..5 after <- b0

#---- a_rebinding_at_the_top_level_is_a_second_item_with_its_own_slot
x <- 1L
x <- "ok"
x
#++++
# x
  b0 x top-level 0..1
  0..1 x <- b0
# x
  b0 x top-level 0..1
  0..1 x <- b0
# <statement>
  0..1 x -> non-local

#---- a_bare_top_level_block_writes_top_level_slots
# A bare `{ }` block runs unconditionally, so its writes are the item's
# top-level slots rather than block locals.
{
  x <- 1L
  x
}
#++++
# <statement>
  b0 x top-level 4..5
  4..5 x <- b0
  14..15 x -> b0
  used top-level: x

#---- a_conditional_top_level_write_creates_a_top_level_slot
# The write is conditional and so is not package-visible, but inside the item it
# is an ordinary slot the next statement reads.
if (TRUE) {
  x <- 1L
  x
}
#++++
# <statement>
  b0 x top-level 14..15
  14..15 x <- b0
  24..25 x -> b0
  used top-level: x

#---- a_top_level_for_loop_binds_its_variable_at_the_top_level
for (item in list(1L)) {
  item
}
#++++
# <statement>
  b0 item for-variable 5..9
  13..17 list -> non-local
  27..31 item -> b0

#---- a_top_level_loop_accumulator_reads_out_of_the_item_first
# The first iteration reads the name's cross-item binding, so the read leaves
# the item while the write creates the item's own slot.
for (index in 1:3) {
  total <- total + index
}
#++++
# <statement>
  b0 index for-variable 5..10
  b1 total top-level 23..28
  23..28 total <- b1
  32..37 total -> b1 maybe-undefined
  40..45 index -> b0
  used top-level: total

#==== unresolved_reads
#---- a_bare_unresolved_read_at_the_top_level
missing_name
#++++
# <statement>
  0..12 missing_name -> non-local

#---- a_qualified_read_inside_an_opaque_operator_is_not_recorded
# A qualified read inside a construct the checker treats as opaque is not
# recorded, so nothing validates the export of a name the checker never claimed
# to understand.
f <- function(a) a & stats::median(1:3)
#++++
# f
  b0 a parameter 14..15
  b1 f top-level 0..1
  0..1 f <- b1
  17..18 a -> b0

#---- an_internal_qualified_read_records_the_triple_colon
f <- function() tools:::toHTML(1L)
#++++
# f
  b0 f top-level 0..1
  0..1 f <- b0
  16..30 tools:::toHTML -> namespace

#---- a_qualified_read_of_a_package_nothing_describes_is_still_a_namespace_read
f <- function() nosuchpkg::nosuchname(1L)
#++++
# f
  b0 f top-level 0..1
  0..1 f <- b0
  16..37 nosuchpkg::nosuchname -> namespace

#---- a_qualified_name_is_never_confused_with_a_field_access
f <- function(stats) stats$median
#++++
# f
  b0 stats parameter 14..19
  b1 f top-level 0..1
  0..1 f <- b1
  21..26 stats -> b0
