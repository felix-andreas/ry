#==== s4
#---- set_generic_defines_the_name
setClass("Account", representation(balance = "numeric"))
setGeneric("deposit", function(account, amount) standardGeneric("deposit"))
setMethod("deposit", "Account", function(account, amount) account)
use <- function(account) deposit(account, 50)
#++++
use: <T> fn(account: T) -> Unknown

#==== nominal_field_writes
#---- a_write_the_representation_admits_keeps_the_nominal
#: @type Person {list{name: character, age: integer}}

#: @new Person
ada <- list(name = "Ada", age = 36L)
ada$age <- 40L
still <- ada
#++++
ada: Person
still: Person

#---- a_write_the_representation_refuses_is_reported_at_the_value
#: @type Person {list{name: character, age: integer}}

#: @new Person
ada <- list(name = "Ada", age = 36L)
ada$age <- "not a number"
#++++
ada: Person
118..132 error[type-mismatch] expected `integer`, found `character`

#---- the_bracket_spelling_is_checked_the_same_way
#: @type Person {list{name: character, age: integer}}

#: @new Person
ada <- list(name = "Ada", age = 36L)
ada[["age"]] <- "not a number"
#++++
ada: Person
123..137 error[type-mismatch] expected `integer`, found `character`

#---- a_field_the_representation_does_not_carry_is_reported
#: @type Person {list{name: character, age: integer}}

#: @new Person
ada <- list(name = "Ada", age = 36L)
ada$email <- "ada@example.com"
#++++
ada: Person
120..137 error[type-mismatch] field `email` does not exist in `Person`

#---- a_refused_write_leaves_the_field_type_standing
#: @type Person {list{name: character, age: integer}}

#: fn(s: character) -> character
want_chr <- function(s) s

#: @new Person
ada <- list(name = "Ada", age = 36L)
reading <- want_chr(ada$age)
#++++
want_chr: fn(s: character) -> character
ada: Person
reading: Unknown
187..194 error[type-mismatch] expected `character`, found `integer`

#---- a_non_record_representation_admits_nothing_statically
#: @type Celsius {double}

#: @new Celsius
temperature <- 20.0
temperature$anything <- 1L
#++++
temperature: Celsius

#---- a_structural_record_still_retypes_its_field
# The contrast with the nominal cases above, in one item so the write and the
# read share a frame: a structural record has no declared representation to
# violate, so the write retypes the field and the later read sees the new type.
#: fn(s: character) -> character
want_chr <- function(s) s

check <- function() {
  record <- list(name = "Ada", age = 36L)
  record$age <- "now a character"
  want_chr(record$age)
}
#++++
want_chr: fn(s: character) -> character
check: fn() -> character

#==== project_operator_methods
#---- a_project_defined_operator_method_satisfies_the_numeric_constraint
# Operator dispatch resolves `+.Money` through the global scope, which includes
# the project's own sources — so the numeric constraint has to consult the same
# scope. It consulted only the standard library, and refused a class whose `+`
# the checker itself would have dispatched. R runs this: `bump(price)` is 6.
#: @type Money {double}

"+.Money" <- function(e1, e2) e1

#: @new Money
price <- 5

bump <- function(x) x + 1L
print(bump(price))
#++++
+.Money: <T, U> fn(e1: T, e2: U) -> T
price: Money
bump: <T: numeric> fn(x: T) -> T

#---- a_class_with_no_arithmetic_method_is_still_refused
# The constraint must stay discriminating: R halts on this one too.
#: @type Tag {character}

#: @new Tag
label <- "x"

bump <- function(x) x + 1L
print(bump(label))
#++++
label: Tag
bump: <T: numeric> fn(x: T) -> T
158..163 error[type-mismatch] expected a numeric value (`integer` or `double`), found `Tag`

#---- a_recursive_function_keeps_the_arithmetic_classes
# A cyclic group is checked through its own view of the world, and that view has
# to carry every fact the ordinary one does. It inherited an EMPTY arithmetic-class
# set, so `Date + 1` inside any recursive function failed the numeric constraint
# and collapsed the whole scheme to `Unknown` — while the identical
# non-recursive function typed fine. The pair is the point: they must agree.
shift <- function(x) x + 1
recursive <- function(k) {
  if (k > 0) recursive(k - 1)
  shift(Sys.Date())
}
not_recursive <- function() shift(Sys.Date())
#++++
shift: <T: numeric> fn(x: T) -> double
recursive: <T: numeric> fn(k: T) -> double
not_recursive: fn() -> double

#---- every_arithmetic_operator_method_makes_its_class_arithmetic
# Dispatch built the method name from all seven arithmetic spellings while the
# numeric constraint admitted only four, so a class declaring `^`, `%%` or `%/%`
# had its operator dispatched and the class itself refused. R runs all of these.
# `Tag` is the control: it declares no arithmetic method and stays refused.
#: @type Pow {double}
#: @type Mod {double}
#: @type Div {double}
#: @type Tag {double}

"^.Pow" <- function(e1, e2) e1
"%%.Mod" <- function(e1, e2) e1
"%/%.Div" <- function(e1, e2) e1

#: @new Pow
pw <- 5
#: @new Mod
md <- 5
#: @new Div
dv <- 5
#: @new Tag
tg <- 5

bump <- function(x) x + 1
print(bump(pw))
print(bump(md))
print(bump(dv))
print(bump(tg))
#++++
^.Pow: <T, U> fn(e1: T, e2: U) -> T
%%.Mod: <T, U> fn(e1: T, e2: U) -> T
%/%.Div: <T, U> fn(e1: T, e2: U) -> T
pw: Pow
md: Mod
dv: Div
tg: Tag
bump: <T: numeric> fn(x: T) -> double
669..671 error[type-mismatch] expected a numeric value (`integer` or `double`), found `Tag`
