x <- 1L
#~~~~ R/b.R
x
#++++
== R/a.R
x: integer
== R/b.R
integer

#---- earlier_file_uses_later_global
#~~~~ R/a.R
x
#~~~~ R/b.R
x <- 1L
#++++
== R/a.R
integer
== R/b.R
x: integer

#---- later_file_call_resolves_cross_file_callee_and_argument
#~~~~ R/a.R
value <- 1L
#~~~~ R/b.R
mirror <- function(x) x
#~~~~ R/c.R
mirror(value)
#++++
== R/a.R
value: integer
== R/b.R
mirror: <T> fn(x: T) -> T
== R/c.R
integer

