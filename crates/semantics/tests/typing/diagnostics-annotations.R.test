#++++
value: integer
32..44 warning[unresolved] I could not resolve `some_unknown` in this package, its imports, or builtins.

#---- if_unknown_on_known_type
#: @if-unknown integer
value <- 1L
#++++
value: Unknown
32..34 error[type-mismatch] `@if-unknown` applies only where the type is unknown, and this is already `integer` — drop the annotation, or use `#:` to check the type or `@trust` to override it

#---- if_unknown_on_known_matching_type
#: @if-unknown integer
value <- 5L
#++++
value: Unknown
32..34 error[type-mismatch] `@if-unknown` applies only where the type is unknown, and this is already `integer` — drop the annotation, or use `#:` to check the type or `@trust` to override it

#==== annotations_new
#---- new_compatible
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")
#++++
person: Person

#---- new_generic_fully_applied
#: @type Box<T> {list{value: T}}

#: @new Box<integer>
boxed <- list(value = 1L)
#++++
boxed: Box<integer>

#---- new_generic_infers_missing_arguments
#: @type Box<T> {list{value: T}}

#: @new Box
boxed <- list(value = 1L)
#++++
boxed: Box<integer>

#---- new_on_unknown_type
#: @new Person
person <- list(name = "bob")
#++++
person: list{name: character}
8..14 error[annotation] I do not know the type `Person`. It is not a built-in type, a declared `@type` or `@alias` name, or a class from the standard-library stubs.

#---- new_already_nominal
#: @type Person {list{name: character}}

#: @new Person
person <- list(name = "bob")

#: Person
same <- person
#++++
person: Person
same: Person

#==== annotations_functions
#---- compact_function_success
#: fn(count: integer) -> integer
double_count <- function(count) count + count
#++++
double_count: fn(count: integer) -> integer

#---- expanded_function_success
#: @param count {integer}
#: @return {integer}
double_count <- function(count) count + count
#++++
double_count: fn(count: integer) -> integer

#---- expanded_default_return_null
#: @param count {integer}
log_count <- function(count) { }
#++++
log_count: fn(count: integer) -> NULL

#---- expanded_optional_param
#: @param count {integer}
#: @param [label] {character}
#: @return {integer}
render <- function(count, label = NULL) count
#++++
render: fn(count: integer, [label]: character) -> integer
111..115 error[type-mismatch] `label` defaults to `NULL`, which its declared type `character` does not admit — a caller who omits it leaves `NULL` in the body. Declare it `character | NULL` and narrow with `is.null()`

#---- forall_identity
#: @forall T
#: @param value {T}
#: @return {T}
mirror <- function(value) value
#++++
mirror: <T> fn(value: T) -> T

#---- compact_forall_identity
#: <T> fn(value: T) -> T
mirror <- function(value) value
#++++
mirror: <T> fn(value: T) -> T

