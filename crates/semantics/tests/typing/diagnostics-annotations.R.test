#==== annotations
#---- checked_scalar_to_array_widening
#: integer[]
value <- 1L
#++++
value: integer[]

#---- checked_tuple_list_to_array_list
#: list[integer]
value <- list(1L, 2L, 3L)
#++++
value: list[integer]

#---- checked_record_list_to_array_list
#: list[integer]
value <- list(a = 1L, b = 2L)
#++++
value: list[integer]

#---- checked_record_to_map_list
#: list[named: integer]
value <- list(a = 1L, b = 2L)
#++++
value: list[named: integer]

#---- checked_scalar_into_nullable
#: integer | NULL
value <- 1L
#++++
value: integer | NULL

#---- checked_mismatch
#: integer
value <- "foo"
#++++
value: integer
20..25 error[type-mismatch] expected `integer`, found `character`

#---- checked_array_not_into_scalar
#: integer
value <- c(1L, 2L)
#++++
value: integer
20..29 error[type-mismatch] expected `integer`, found `integer[]`

#---- checked_nullable_not_into_plain
#: integer
value <- if (TRUE) 1L
#++++
value: integer
20..32 error[type-mismatch] expected `integer`, found `integer | NULL`

#---- checked_double_into_integer_rejected
#: integer
value <- 1.5
#++++
value: integer
20..23 error[type-mismatch] expected `integer`, found `double`

#==== annotations_trust
#---- trust_incompatible_value
#: @trust integer
value <- "foo"
#++++
value: integer

#---- trust_function_type
#: @trust fn(count: integer) -> character
render_count <- function(x) x
#++++
render_count: fn(count: integer) -> character

#---- trust_unknown_name
#: @trust integer
value <- some_unknown
#++++
value: integer
27..39 warning[unresolved] I could not resolve `some_unknown` in this package, its imports, or builtins.

#---- trust_on_bare_expression
#: @trust character
1L
#++++
character

#==== annotations_if_unknown
#---- if_unknown_on_unknown_value
