# The roughly 200 base, stats and utils functions that the benchmark-dependency corpus calls
# most often, each in an idiomatic call form. With typing on, none of them may report anything:
# an error here is a false positive on code every R user writes.
#==== most_used
#---- vectors_and_strings_1
xs <- c(1.5, 2, 3)
ns <- 1:10
words <- c("alpha", "beta", "gamma")
flags <- c(TRUE, FALSE, NA)
a1 <- length(xs)
a2 <- is.null(xs)
a3 <- list(a = 1, b = "x")
a4 <- names(a3)
a5 <- paste("a", words, sep = "-")
a6 <- paste0("x", seq_along(words))
a7 <- rep(0, 5)
a8 <- is.na(flags)
a9 <- as.integer("3")
a10 <- any(flags, na.rm = TRUE)
a11 <- identical(xs, ns)
a12 <- as.double(ns)
a13 <- sprintf("%d items, %.2f mean", length(xs), mean(xs))
a14 <- sum(xs, na.rm = TRUE)
a15 <- as.numeric(words)
a16 <- max(xs)
a17 <- which(flags)
a18 <- is.character(words)
a19 <- unlist(a3)
a20 <- sqrt(xs)
a21 <- is.numeric(xs)
a22 <- all(xs > 0)
a23 <- character(3)
a24 <- abs(-xs)
a25 <- seq_along(xs)
a26 <- grepl("^a", words)
#++++
