#---- control
check <- function(x, type = c("fast", "slow"), verbose = getOption("pkg.verbose", FALSE)) {
  type <- match.arg(type)
  if (missing(x)) stop("`x` is required", call. = FALSE)
  stopifnot(is.numeric(x), length(x) > 0)
  if (!inherits(x, "numeric")) warning("coercing")
  if (verbose) message("checking ", length(x), " values")
  if (isTRUE(verbose)) cat("type:", type, "\n")
  old <- options(digits = 3)
  on.exit(options(old), add = TRUE)
  invisible(x)
}
attempt <- function(expr) {
  out <- tryCatch(expr, error = function(e) conditionMessage(e), warning = function(w) NULL)
  res <- try(log(-1), silent = TRUE)
  suppressWarnings(as.numeric("x"))
  list(out, res)
}
meta <- function(x, ...) {
  cl <- match.call()
  sc <- sys.call()
  ex <- substitute(x)
  env <- parent.frame()
  fn <- match.fun("sum")
  args <- formals(check)
  b <- body(check)
  nm <- deparse(substitute(x))
  e <- eval(quote(1 + 1), envir = env)
  f <- environment(check)
  g <- get("sum", envir = baseenv())
  ok <- exists("x", inherits = FALSE)
  assign("y", 1, envir = env)
  force(x)
  rm(ok)
  list(cl, sc, ex, fn, args, b, nm, e, f, g)
}
classes <- function(x) {
  k <- class(x)
  a <- attr(x, "names")
  attr(x, "tag") <- "t"
  s <- structure(list(1), class = "myclass")
  u <- unclass(s)
  at <- attributes(x)
  oc <- oldClass(x)
  storage.mode(x) <- "double"
  nm <- as.name("x")
  list(x, k, a, u, at, oc, nm)
}
print.myclass <- function(x, ...) {
  print(unclass(x))
  invisible(x)
}
summary.myclass <- function(object, ...) NextMethod()
describe <- function(x, ...) UseMethod("describe")
describe.default <- function(x, ...) format(x)
#++++
check: <T, U, V> fn([x]: Unknown, [type]: T, [verbose]: U) -> V
attempt: <T> fn(expr: T) -> list{Any, Any}
meta: <T> fn(x: T, ...: Any) -> list{Any, Any, Any, Any, Any, Any, character, Any, environment, Any}
classes: fn(x: Unknown) -> list{Unknown, character, Any, Any, Any, Any, Unknown}
print.myclass: <T> fn(x: T, ...: Any) -> T
summary.myclass: <T> fn([object]: T, ...: Any) -> Any
describe: <T> fn([x]: T, ...: Any) -> Any
describe.default: <T> fn(x: T, ...: Any) -> character

#---- system
io <- function(dir) {
  p <- file.path(dir, "out.txt")
  if (!file.exists(p)) dir.create(dir, recursive = TRUE, showWarnings = FALSE)
  writeLines(c("a", "b"), p)
  lines <- readLines(p, warn = FALSE)
  b <- basename(p)
  d <- dirname(p)
  n <- normalizePath(p, mustWork = FALSE)
  tmp <- tempfile(fileext = ".csv")
  unlink(tmp)
  files <- list.files(dir, pattern = "\\.R$", full.names = TRUE)
  sf <- system.file("DESCRIPTION", package = "stats")
  home <- Sys.getenv("HOME", unset = "")
  now <- Sys.time()
  day <- as.Date("2024-01-01")
  stamp <- as.POSIXct("2024-01-01 10:00:00", tz = "UTC")
  wd <- getwd()
  v <- getRversion()
  ok <- requireNamespace("stats", quietly = TRUE)
  ns <- asNamespace("stats")
  e <- new.env(parent = emptyenv())
  con <- file(p, "r")
  close(con)
  i <- interactive()
  msg <- gettextf("found %d files", length(files))
  ex <- parse(text = "1 + 2")
  list(lines, b, d, n, sf, home, now, day, stamp, wd, v, ok, ns, e, i, msg, ex)
}
models <- function(df) {
  fit <- lm(y ~ x, data = df)
  cf <- coef(fit)
  fv <- fitted(fit)
  list(cf, fv)
}
#++++
io: <T> fn(dir: T) -> list{character[], character, character, character, character, character, POSIXct, Date, POSIXct, character, Any, logical, environment, environment, logical, character, Any}
models: <T> fn(df: T) -> list{Any, Any}
