#==== dependency_injection
#---- injected_behaviour_wires_a_whole_program
# Behaviour is injected as typed function parameters rather than dispatched:
# the runners take `fn(...)` parameters over nominal records, each backend
# selects a provider by name, and the entry point picks a backend. Nothing here
# is a diagnostic — the point of the case is that a whole architecture built
# this way type checks with no false positives.

#: @type Result {list{ label: character, count: integer }}
#: @type Options {list{ backend: character, variant: character }}
#: @type Item {list{ id: character, enabled: logical }}
#: @type LocalInput {list{ path: character }}
#: @type RemoteInput {list{ url: character }}

#: fn(options: Options) -> Result
run <- function(options) {
  if (options$backend == "local") {
    local_provider(LocalInput(path = "input.dat"), options)
  } else {
    remote_provider(RemoteInput(url = "https://example.com"), options)
  }
}

#: fn(input: LocalInput, options: Options) -> Result
local_provider <- function(input, options) {
  switch(options$variant,
    csv = csv_provider(input, options),
    tsv = tsv_provider(input, options),
    csv_provider(input, options)
  )
}

#: fn(input: RemoteInput, options: Options) -> Result
remote_provider <- function(input, options) {
  switch(options$variant,
    http = http_provider(input, options),
    grpc = grpc_provider(input, options),
    http_provider(input, options)
  )
}

#: fn(input: LocalInput, options: Options) -> Result
csv_provider <- function(input, options) {
  run_local(input, default_items, read_local, step_one)
}

#: fn(input: LocalInput, options: Options) -> Result
tsv_provider <- function(input, options) {
  run_local(input, default_items, read_local, step_one, identity_finalize)
}

#: fn(input: RemoteInput, options: Options) -> Result
http_provider <- function(input, options) {
  run_remote(input, default_items, eval_remote)
}

#: fn(input: RemoteInput, options: Options) -> Result
grpc_provider <- function(input, options) {
  run_remote(input, default_items, eval_remote)
}

#: @param input {LocalInput}
#: @param getItems {fn() -> list[Item]}
#: @param read {fn(LocalInput) -> Result}
#: @param step {fn(Result, Item) -> Result}
#: @param [finalize] {fn(Result) -> Result}
#: @returns {Result}
run_local <- function(input, getItems, read, step, finalize = identity_finalize) {
  result <- read(input)
  for (item in getItems()) {
    if (item$enabled) {
      result <- step(result, item)
    }
  }
  finalize(result)
}

#: @param input {RemoteInput}
#: @param getItems {fn() -> list[Item]}
#: @param evaluate {fn(RemoteInput, Item) -> Result}
#: @returns {Result}
run_remote <- function(input, getItems, evaluate) {
  result <- Result()
  for (item in getItems()) {
    result <- evaluate(input, item)
  }
  result
}

#: fn() -> list[Item]
default_items <- function() list()

#: fn(input: LocalInput) -> Result
read_local <- function(input) Result(label = input$path)

#: fn(result: Result, item: Item) -> Result
step_one <- function(result, item) result

#: fn(input: RemoteInput, item: Item) -> Result
eval_remote <- function(input, item) Result(label = input$url)

#: fn(result: Result) -> Result
identity_finalize <- function(result) result

#: @param [label] {character}
#: @param [count] {integer}
#: @returns {Result}
Result <- function(label = NA_character_, count = 0L) {
  #: @new Result
  list(label = label, count = count)
}

#: @param path {character}
#: @returns {LocalInput}
LocalInput <- function(path) {
  #: @new LocalInput
  list(path = path)
}

#: @param url {character}
#: @returns {RemoteInput}
RemoteInput <- function(url) {
  #: @new RemoteInput
  list(url = url)
}
#++++
run: fn(options: Options) -> Result
local_provider: fn(input: LocalInput, options: Options) -> Result
remote_provider: fn(input: RemoteInput, options: Options) -> Result
csv_provider: fn(input: LocalInput, options: Options) -> Result
tsv_provider: fn(input: LocalInput, options: Options) -> Result
http_provider: fn(input: RemoteInput, options: Options) -> Result
grpc_provider: fn(input: RemoteInput, options: Options) -> Result
run_local: fn(input: LocalInput, getItems: fn() -> list[Item], read: fn(LocalInput) -> Result, step: fn(Result, Item) -> Result, [finalize]: fn(Result) -> Result) -> Result
run_remote: fn(input: RemoteInput, getItems: fn() -> list[Item], evaluate: fn(RemoteInput, Item) -> Result) -> Result
default_items: fn() -> list[Item]
read_local: fn(input: LocalInput) -> Result
step_one: fn(result: Result, item: Item) -> Result
eval_remote: fn(input: RemoteInput, item: Item) -> Result
identity_finalize: fn(result: Result) -> Result
Result: fn([label]: character, [count]: integer) -> Result
LocalInput: fn(path: character) -> LocalInput
RemoteInput: fn(url: character) -> RemoteInput

#---- mis_wiring_is_reported_at_the_injection_site
# The same shape, reduced to one runner, with every way of wiring it wrongly.
# Each finding must land on the offending argument, not on the runner.

#: @type Result {list{ label: character }}
#: @type Item {list{ enabled: logical }}
#: @type LocalInput {list{ path: character }}
#: @type RemoteInput {list{ url: character }}

#: @param input {LocalInput}
#: @param getItems {fn() -> list[Item]}
#: @param read {fn(LocalInput) -> Result}
#: @param step {fn(Result, Item) -> Result}
#: @param [finalize] {fn(Result) -> Result}
#: @returns {Result}
run_local <- function(input, getItems, read, step, finalize = identity_finalize) {
  result <- read(input)
  for (item in getItems()) {
    if (item$enabled) {
      result <- step(result, item)
    }
  }
  finalize(result)
}

#: fn() -> list[Item]
default_items <- function() list()

#: fn(input: LocalInput) -> Result
read_local <- function(input) Result(label = input$path)

#: fn(result: Result, item: Item) -> Result
step_one <- function(result, item) result

#: fn(result: Result) -> Result
identity_finalize <- function(result) result

#: @param [label] {character}
#: @returns {Result}
Result <- function(label = NA_character_) {
  #: @new Result
  list(label = label)
}

#: @param path {character}
#: @returns {LocalInput}
LocalInput <- function(path) {
  #: @new LocalInput
  list(path = path)
}

#: @param url {character}
#: @returns {RemoteInput}
RemoteInput <- function(url) {
  #: @new RemoteInput
  list(url = url)
}

#: fn(input: LocalInput) -> Item
read_wrong_return <- function(input) {
  #: @new Item
  list(enabled = TRUE)
}

# A required injected function is missing.
missing_required <- function(input) run_local(input, default_items, read_local)

# The injected reader has the wrong parameter shape.
wrong_shape <- function(input) {
  run_local(input, default_items, function(a, b) Result(), step_one)
}

# The injected reader returns the wrong nominal.
wrong_return <- function(input) {
  run_local(input, default_items, read_wrong_return, step_one)
}

# The runner's own input nominal cannot be swapped for the other backend's.
wrong_nominal <- function() {
  run_local(RemoteInput(url = "u"), default_items, read_local, step_one)
}

# The optional parameter is checked like every other injected function.
wrong_optional <- function(input) {
  run_local(input, default_items, read_local, step_one, step_one)
}
#++++
run_local: fn(input: LocalInput, getItems: fn() -> list[Item], read: fn(LocalInput) -> Result, step: fn(Result, Item) -> Result, [finalize]: fn(Result) -> Result) -> Result
default_items: fn() -> list[Item]
read_local: fn(input: LocalInput) -> Result
step_one: fn(result: Result, item: Item) -> Result
identity_finalize: fn(result: Result) -> Result
Result: fn([label]: character) -> Result
LocalInput: fn(path: character) -> LocalInput
RemoteInput: fn(url: character) -> RemoteInput
read_wrong_return: fn(input: LocalInput) -> Item
missing_required: Unknown
wrong_shape: Unknown
wrong_return: Unknown
wrong_nominal: Unknown
wrong_optional: Unknown
1672..1681 error[type-mismatch] this call supplies 3 arguments, but the function requires 4, so a required argument is missing
1837..1860 error[type-mismatch] expected `fn(LocalInput) -> Result`, found `fn(a: T, b: U) -> Result`
1992..2009 error[type-mismatch] this function must return `Result`, but it returns `Item`
2142..2164 error[type-mismatch] expected `LocalInput`, found `RemoteInput`
2370..2378 error[type-mismatch] expected `fn(Result) -> Result`, found `fn(result: Result, item: Item) -> Result`

#==== top_level_rewrites
#---- a_later_top_level_write_is_visible_to_a_later_statement
# A file is sourced top-down whichever kind it is, so a statement that rewrites
# a field of a name defined above it is what the next statement reads. The
# project-wide map holds definition items only, so this write used to be
# invisible and the read answered from the pre-write type — in a package only,
# while the identical script was correct.
#: fn(s: character) -> character
want_chr <- function(s) s

#: list{name: character, age: integer}
record <- list(name = "Ada", age = 36L)

record$age <- "now a character"

reading <- want_chr(record$age)
#++++
want_chr: fn(s: character) -> character
record: list{name: character, age: integer}
reading: character

#---- a_function_body_sees_the_settled_value_not_the_pre_write_one
#: list{age: integer}
record <- list(age = 36L)

record$age <- 40L

#: fn() -> integer
reader <- function() record$age
#++++
record: list{age: integer}
reader: fn() -> integer

#---- a_forward_reference_from_a_function_body_still_resolves
# The deferred read must not be narrowed to "earlier items only": the body runs
# after the file is sourced, so a name defined below it is in scope.
#: fn() -> integer
reader <- function() helper()

#: fn() -> integer
helper <- function() 1L
#++++
reader: fn() -> integer
helper: fn() -> integer

#==== self_referential_values
#---- an_ordinary_record_of_closures_is_unaffected
# The contrast: no self-reference, so nothing grows and the fields keep their
# types.
plain <- function() {
  list(
    double_it = function(x) x + x,
    label = function(x) paste0(x, "!")
  )
}
#++++
plain: <T: numeric, U> fn() -> list{double_it: fn(x: T) -> T, label: fn(x: U) -> character}
