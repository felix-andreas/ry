#==== unused_locals
#---- unused_local_is_reported
f <- function() {
  x <- 1L
  2L
}
#++++
f: fn() -> integer
20..21 warning[unused] `x` is assigned but never used.

#---- used_local_is_not_reported
f <- function() {
  x <- 1L
  x
}
#++++
f: fn() -> integer

#---- only_final_reassignment_is_kept
f <- function() {
  x <- 1L
  x <- 2L
  x
}
#++++
f: fn() -> integer
20..21 warning[unused] `x` is assigned but never used.

#---- a_function_named_by_a_match_fun_string_is_used
f <- function(xs) {
  shout <- function(x) toupper(x)
  vapply(xs, "shout", character(1))
}
#++++
f: <T> fn(xs: list[T] | T[]) -> character[]

#==== reaching_writes
#---- conditional_update_before_read_is_used
f <- function(flag) {
  x <- 1L
  if (flag) {
    x <- 2L
  }
  x
}
#++++
f: fn(flag: logical) -> integer

#---- loop_accumulator_is_used
g <- function() {
  total <- 0L
  for (i in 1:3) {
    total <- total + i
  }
  total
}
#++++
g: fn() -> integer

#---- dead_store_before_rewrite_is_reported
f <- function() {
  x <- 1L
  x <- 2L
  y <- x
  y
}
#++++
f: fn() -> integer
20..21 warning[unused] `x` is assigned but never used.

#---- write_read_only_on_loop_back_edge_is_used
f <- function(n) {
  while (n > 0L) {
    y <- x
    x <- 1L
    n <- n - 1L
  }
}
#++++
f: <T: numeric> fn(n: T) -> NULL
42..43 warning[unused] `y` is assigned but never used.
47..48 warning[maybe-undefined] `x` is only assigned on some paths here, so this read can find nothing.

#---- conditional_write_never_read_is_reported
f <- function(flag) {
  if (flag) {
    x <- 1L
  }
  2L
}
#++++
f: fn(flag: logical) -> integer
40..41 warning[unused] `x` is assigned but never used.

#---- read_before_conditional_introduction_warns
f <- function(flag) {
  if (flag) {
    x <- 1L
  }
  x
}
#++++
f: fn(flag: logical) -> integer
54..55 warning[maybe-undefined] `x` is only assigned on some paths here, so this read can find nothing.

#---- multiple_unused_locals_each_reported
f <- function() {
  a <- 1L
  b <- 2L
  3L
}
#++++
f: fn() -> integer
20..21 warning[unused] `a` is assigned but never used.
30..31 warning[unused] `b` is assigned but never used.

#---- local_used_only_in_nested_function_is_not_reported
f <- function() {
  outer <- 1L
  function() outer
}
#++++
f: fn() -> fn() -> integer

#---- nested_unused_local_is_reported
f <- function() {
  inner <- function() {
    helper <- 1L
    2L
  }
  inner
}
#++++
f: fn() -> fn() -> integer
46..52 warning[unused] `helper` is assigned but never used.

#==== conventions
#---- dot_prefixed_local_is_ignored
f <- function() {
  .ignored <- 1L
  2L
}
#++++
f: fn() -> integer

#---- underscore_prefixed_local_is_ignored
f <- function() {
  `_ignored` <- 1L
  2L
}
#++++
f: fn() -> integer

#==== excluded_kinds
#---- top_level_assignment_is_not_reported
unused_global <- 1L
#++++
unused_global: integer

#---- unused_parameter_is_not_reported
f <- function(unused_param) 1L
#++++
f: <T> fn([unused_param]: T) -> integer

#---- unused_for_variable_is_not_reported
f <- function() {
  for (item in 1:3) {
    1L
  }
}
#++++
f: fn() -> NULL

#---- local_used_in_expression_is_not_reported
f <- function() {
  value <- 1L
  value + 1L
}
#++++
f: fn() -> integer

#---- local_read_through_a_slot_access_counts
f <- function() {
  config <- list()
  config@port
}
#++++
f: fn() -> Unknown

#---- slot_replacement_write_is_exempt
f <- function() {
  config <- list()
  config@port <- 8080L
  config
}
#++++
f: fn() -> list{}

#==== implicit_reads
# A local can be read without its name appearing as a plain read: as the
# function's value, by a method dispatch that forwards the formals, inside a
# formula, through the frame itself, or by a string naming it.
#---- an_assignment_in_tail_position_is_the_function_s_value
f <- function(x, value) {
  x <- x + value
}
h <- function(k) {
  if (k) {
    y <- 1
  } else 2
}
#++++
f: <T: numeric> fn(x: T, value: T) -> T
h: fn(k: logical) -> double

#---- an_assignment_before_the_tail_is_still_reported
f <- function(x) {
  z <- x + 1
  x
}
#++++
f: <T: numeric> fn(x: T) -> T
21..22 warning[unused] `z` is assigned but never used.

#---- next_method_forwards_a_reassigned_formal
print.myc <- function(x, ...) {
  x <- unclass(x)
  NextMethod()
}
#++++
print.myc: <T> fn(x: T, ...: Any) -> Any

#---- next_method_does_not_read_an_ordinary_local
print.myc <- function(x, ...) {
  y <- unclass(x)
  NextMethod()
}
#++++
print.myc: <T> fn(x: T, ...: Any) -> Any
34..35 warning[unused] `y` is assigned but never used.

#---- call_generic_without_arguments_forwards_the_formals
setClass("A", representation(x = "numeric"))
setGeneric("g", function(x, i) standardGeneric("g"))
setMethod("g", c("A", "missing"), function(x, i) {
  i <- 1L
  callGeneric()
})
#++++
fn(...: Any) -> Any
character
character

#---- a_formula_reads_the_locals_it_names
f <- function(a, b) {
  lx <- log(a)
  ly <- log(b)
  coef(lm(ly ~ lx))
}
#++++
f: <T, U> fn(a: T, b: U) -> Any

#---- a_captured_frame_keeps_every_local
make <- function() {
  helper <- function() 1
  counter <- 0
  structure(environment(), class = "obj")
}
mod <- local({
  util <- function() 2
  environment()
})
#++++
make: fn() -> environment
mod: environment

#---- a_frame_passed_to_an_explicit_accessor_does_not_escape
f <- function(cl) {
  a <- 1
  b <- 2
  parallel::clusterExport(cl, "a", envir = environment())
}
#++++
f: <T> fn(cl: T) -> Unknown
31..32 warning[unused] `b` is assigned but never used.

#---- get_and_exists_read_a_literal_name
f <- function() {
  tmp <- 3
  get("tmp")
}
g <- function() {
  flag <- TRUE
  exists("flag")
}
#++++
f: fn() -> Any
g: fn() -> logical

#---- parse_text_reads_the_names_in_its_code
f <- function(z) {
  m2 <- z * 2
  eval(parse(text = "plot(m2)"))
}
#++++
f: <T: numeric> fn(z: T) -> Any

#---- a_quoting_alias_quotes_its_arguments
f <- function() {
  e <- expression
  list(e(days < 30), e(hours > 2))
}
#++++
f: fn() -> list{Unknown, Unknown}
