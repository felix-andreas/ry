#==== checked
#---- a_binder_constraint_applies_to_a_value_annotation
#: <T: numeric> list{add: fn(left: T, right: T) -> T}
handlers <- list(add = function(left, right) left + right)
#++++
handlers: <T: numeric> list{add: fn(left: T, right: T) -> T}

#---- a_binder_bounded_by_a_union_returns_what_it_is_given
#: <T, U: list[T] | T[]> fn(path: U) -> U
normalize <- function(path) {
  vapply(path, nchar, 1L)
  path
}
one <- nchar(normalize("a"))
many <- normalize(list("a", "b"))
#++++
normalize: <T, U: list[T] | T[]> fn(path: U) -> U
one: integer
many: list{character, character}

#---- a_call_outside_a_binder_bound_is_reported
