#---- callback_parameter_contravariance
#: fn(callback: fn(x: integer) -> integer) -> integer
apply_it <- function(callback) callback(1L)

#: fn(x: integer | NULL) -> integer
wider <- function(x) if (is.null(x)) 0L else x
use_wider <- function() apply_it(wider)

#: fn(callback: fn(x: integer | NULL) -> integer) -> integer
apply_wide <- function(callback) callback(NULL)
#: fn(x: integer) -> integer
narrow <- function(x) x
use_narrow <- function() apply_wide(narrow)
#++++
apply_it: fn(callback: fn(x: integer) -> integer) -> integer
wider: fn(x: integer | NULL) -> integer
use_wider: fn() -> integer
apply_wide: fn(callback: fn(x: integer | NULL) -> integer) -> integer
narrow: fn(x: integer) -> integer
use_narrow: Unknown
421..427 error[type-mismatch] this function is passed `integer | NULL`, but its parameter `x` accepts `integer`

#---- variadic_and_fixed_arity_never_pair
#: fn(callback: fn(...: integer) -> integer) -> integer
apply_variadic <- function(callback) callback(1L, 2L)
#: fn(x: integer) -> integer
fixed <- function(x) x
use_fixed <- function() apply_variadic(fixed)
#++++
apply_variadic: fn(callback: fn(...: integer) -> integer) -> integer
fixed: fn(x: integer) -> integer
use_fixed: Unknown
201..206 error[type-mismatch] expected `fn(...: integer) -> integer`, found `fn(x: integer) -> integer`

#---- optionality_comes_from_the_formals_not_the_annotation
# A formal with a default is optional in R, whatever the annotation says. This
# used to be reported as a missing argument at every CALLER, which reads as "the
# tool cannot see default arguments" rather than "my annotation is wrong".
#: fn(amount: double, currency: character) -> character
label <- function(amount, currency = "EUR") paste0(currency, amount)

use <- function() label(1.0)
#++++
label: fn(amount: double, [currency]: character) -> character
use: fn() -> character
300..359 error[type-mismatch] this annotation declares `currency` as required, but the function gives it a default. Write `[currency]` to declare it optional, or drop the default

#==== null_defaults
#---- a_null_default_must_fit_the_declared_type
# `function(title = NULL)` is R's usual spelling for an optional argument, but a
# caller who omits it leaves `NULL` in the body, so a declared `character` is a
# promise the function does not keep. Exempting this let the annotation lie.
#: fn([title]: character) -> character
label <- function(title = NULL) "x"
#++++
label: fn([title]: character) -> character
303..307 error[type-mismatch] `title` defaults to `NULL`, which its declared type `character` does not admit. A caller who omits it leaves `NULL` in the body. Declare it `character | NULL` and narrow with `is.null()`

#---- a_nullable_declared_type_admits_the_null_default
#: fn([title]: character | NULL) -> character
label <- function(title = NULL) "x"
#++++
label: fn([title]: character | NULL) -> character

#---- any_admits_a_null_default
#: fn([anything]: Any) -> character
label <- function(anything = NULL) "x"
#++++
label: fn([anything]: Any) -> character

#---- an_unannotated_parameter_is_unaffected_by_its_null_default
label <- function(title = NULL) "x"
#++++
label: <T> fn([title]: T) -> character

#---- a_non_null_default_is_checked_as_before
#: fn([count]: character) -> character
label <- function(count = 42L) "x"
#++++
label: fn([count]: character) -> character
65..68 error[type-mismatch] expected `character`, found `integer`

#---- the_crash_a_lying_annotation_used_to_hide
# `if (title == "draft")` with `title` absent is `argument is of length zero` at
# run time. Declared nullable it is caught; the guarded form is clean.
#: fn([title]: character | NULL) -> character
unguarded <- function(title = NULL) {
  if (title == "draft") "D" else "F"
}

#: fn([title]: character | NULL) -> character
guarded <- function(title = NULL) {
  if (is.null(title)) "F" else if (title == "draft") "D" else "F"
}
#++++
unguarded: fn([title]: character | NULL) -> character
guarded: fn([title]: character | NULL) -> character
242..247 error[type-mismatch] expected a comparable value (numeric, `character`, or `logical`), found `character | NULL`

#==== annotations_in_argument_lists
#---- an_annotation_beside_a_lambda_argument_is_reported
# An argument is not a statement, so the block attaches to nothing. It used to
# say nothing either, which made a deliberately wrong type there invisible.
xs <- list("a")
mapped <- lapply(xs, #: fn(x: integer) -> integer
  function(v) paste0(v, "!"))
#++++
xs: list{character}
mapped: list[character]
192..220 error[annotation] A `#:` typing comment annotates the statement that follows it, and an argument is not a statement, so this one annotates nothing. Give the value its own binding and annotate that.

#---- the_same_holds_for_a_plain_value_argument
xs <- list(1L)
mapped <- lapply(xs, #: character
  1L)
#++++
xs: list{integer}
mapped: Unknown
36..48 error[annotation] A `#:` typing comment annotates the statement that follows it, and an argument is not a statement, so this one annotates nothing. Give the value its own binding and annotate that.
51..53 error[type-mismatch] expected `fn(integer) -> T`, found `integer`

#---- a_braceless_function_body_does_attach_and_is_not_reported
# The contrast, measured against a no-annotation control: these positions look
# like they might dangle and do not — reporting them would be a false positive.
annotated_body <- function(x)
  #: character
  x + 1L
#++++
annotated_body: Unknown
208..214 error[type-mismatch] expected `character`, found `T`

#---- a_parenthesised_expression_does_attach
parenthesised <- ( #: character
  1L )
#++++
parenthesised: Unknown
34..36 error[type-mismatch] expected `character`, found `integer`
