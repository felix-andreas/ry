#---- a_named_argument_takes_the_annotation
xs <- list(1, 2)
total <- vapply(xs,
  #: fn(v: double) -> double
  FUN = function(v) v * 2,
  numeric(1)
)
#++++
xs: list{double, double}
total: double[]

