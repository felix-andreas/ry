#==== declared_returns
#---- a_bad_early_return_is_blamed_at_that_return
#: fn(flag: logical) -> integer
pick <- function(flag) {
  if (flag) {
    return("wrong type")
  }
  42L
}
#++++
pick: fn(flag: logical) -> integer
82..94 error[type-mismatch] expected `integer`, found `character`

#---- a_bad_trailing_value_is_blamed_at_the_tail
#: fn(flag: logical) -> integer
pick <- function(flag) {
  if (flag) {
    return(1L)
  }
  "wrong tail"
}
#++++
pick: fn(flag: logical) -> integer
92..104 error[type-mismatch] expected `integer`, found `character`

#---- each_bad_return_reports_its_own_site
#: fn(n: integer) -> integer
grade <- function(n) {
  if (n > 10L) {
    return("high")
  }
  if (n < 0L) {
    return(NULL)
  }
  n
}
#++++
grade: fn(n: integer) -> integer
80..86 error[type-mismatch] expected `integer`, found `character`
119..123 error[type-mismatch] expected `integer`, found `NULL`

#---- an_if_else_tail_blames_the_arm_not_the_construct
# Blaming the whole `if` printed only its first line, so the offending arm was
# never rendered at all.
#: fn(flag: logical) -> integer
pick <- function(flag) {
  if (flag) {
    1L
  } else {
    "wrong"
  }
}
#++++
pick: fn(flag: logical) -> integer
197..204 error[type-mismatch] expected `integer`, found `character`

#---- each_bad_arm_reports_its_own_site
# The same rule the early returns follow.
#: fn(flag: logical) -> integer
pick <- function(flag) {
  if (flag) {
    "a"
  } else {
    "b"
  }
}
#++++
pick: fn(flag: logical) -> integer
117..120 error[type-mismatch] expected `integer`, found `character`
136..139 error[type-mismatch] expected `integer`, found `character`

#---- an_if_with_no_else_keeps_the_whole_construct
# The implicit `NULL` on the untaken path belongs to no expression, so no single
# arm is at fault and the construct keeps the one finding.
#: fn(flag: logical) -> integer
pick <- function(flag) {
  if (flag) {
    1L
  }
}
#++++
pick: fn(flag: logical) -> integer
199..221 error[type-mismatch] expected `integer`, found `integer | NULL`

#==== nested_definitions
#---- a_nested_annotation_pushes_parameter_types_into_the_body
outer <- function() {
  #: fn(x: character) -> integer
  inner <- function(x) x + 1L
  inner("a")
}
#++++
outer: Unknown
78..79 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- a_nested_annotation_checks_its_return
outer <- function() {
  #: fn(x: double[]) -> double
  inner <- function(x) "text"
  inner(c(1, 2))
}
#++++
outer: Unknown
76..82 error[type-mismatch] expected `double`, found `character`

#---- a_nested_annotation_checks_its_call_sites
outer <- function() {
  #: fn(x: double[]) -> double
  inner <- function(x) x[[1L]]
  inner("bad")
}
#++++
outer: Unknown
92..97 error[type-mismatch] expected `double[]`, found `character`

#==== unknown_only_coercions
#---- if_unknown_fills_a_genuine_gap
frame <- data.frame(a = 1)

#: @if-unknown integer
gap <- frame$a
#++++
frame: Unknown
gap: integer

#---- if_unknown_on_a_known_type_is_an_error
#: @if-unknown integer
known <- 1L
#++++
known: Unknown
32..34 error[type-mismatch] `@if-unknown` applies only where the type is unknown, and this is already `integer`. Drop the annotation, or use `#:` to check the type or `@trust` to override it

#---- the_coerced_type_is_then_enforced
frame <- data.frame(a = 1)

#: @if-unknown character
gap <- frame$a
label <- gap + 1L
#++++
frame: Unknown
gap: character
label: Unknown
77..80 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#==== checked
#---- declared_scheme_wins
#: <T> fn(x: T) -> T
id <- function(x) x
#++++
id: <T> fn(x: T) -> T

#---- return_mismatch
#: fn(x: integer) -> character
f <- function(x) x
#++++
f: fn(x: integer) -> character
48..49 error[type-mismatch] expected `character`, found `integer`

#---- parameter_name_mismatch
#: fn(x: integer) -> integer
f <- function(y) 1L
#++++
f: fn(y: Unknown) -> integer
34..48 error[type-mismatch] this annotation names a parameter `x`, but the function does not define one. An annotation parameter name must match the function's parameter name

#---- rigid_refuses_undeclared_bound
#: <T> fn(x: T) -> T
bad <- function(x) x + 1L
#++++
bad: <T> fn(x: T) -> T
40..41 error[type-mismatch] expected a numeric value (`integer` or `double`), found `T`

#---- declared_numeric_bound_admits_arithmetic
#: <T: numeric> fn(x: T) -> T
ok <- function(x) x + 1L
#++++
ok: <T: numeric> fn(x: T) -> T

#---- expanded_form
#: @forall T: numeric
#: @param x {T}
#: @return {T}
round2 <- function(x) x + 1L
#++++
round2: <T: numeric> fn(x: T) -> T

#---- a_declared_bound_survives_a_self_recursive_call
# The recursive call instantiates the scheme, producing a fresh variable with
# the declared bound, and unifies it with the rigid `T` in the argument. `T` is
# not a numeric atom, so admissibility has to read the binder's own bound —
# without that the annotation the checker itself infers turns a clean file red,
# while the non-recursive spelling right above stays clean.
#: <T: numeric> fn(n: T) -> integer
countdown <- function(n) if (n <= 0L) 0L else countdown(n - 1L)
#++++
countdown: <T: numeric> fn(n: T) -> integer

#---- an_undeclared_bound_is_still_refused_across_recursion
# The admission is the binder's bound, not "rigid types pass": the same shape
# with no declared bound must still be refused, or the check is gone.
#: <T> fn(n: T) -> integer
loose <- function(n) if (n <= 0L) 0L else loose(n - 1L)
#++++
loose: <T> fn(n: T) -> integer
200..201 error[type-mismatch] expected a numeric value (`integer` or `double`), found `T`
223..224 error[type-mismatch] expected a numeric value (`integer` or `double`), found `T`

#---- an_atomic_bound_admits_a_vector_element_across_recursion
#: <T: atomic> fn(v: T[]) -> T
head_of <- function(v) if (length(v) == 1L) v[[1L]] else head_of(v)
#++++
head_of: <T: atomic> fn(v: T[]) -> T

#---- a_scalar_numeric_bound_is_writable_as_it_renders
# `scalar numeric` is the join of the numeric and atomic bounds, and the
# checker renders it — on `1:n`, whose operand must be a scalar. A rendering
# the annotation grammar could not read would make a finding uncopyable, so
# the spelling parses back to the constraint it printed.
#: <T: scalar numeric> fn(n: T) -> double[]
seq_to <- function(n) 1:n
#++++
seq_to: <T: scalar numeric> fn(n: T) -> double[]

#---- an_unknown_constraint_names_the_ones_that_exist
#: <T: nonsense> fn(x: T) -> T
one <- function(x) x
#: <T: scalar bogus> fn(x: T) -> T
two <- function(x) x
#++++
one: <T> fn(x: T) -> T
two: <T> fn(x: T) -> T
7..15 error[annotation] unknown type-parameter constraint `nonsense`; the available constraints are `numeric`, `atomic`, or `scalar numeric`.
59..71 error[annotation] unknown type-parameter constraint `scalar bogus`; the available constraints are `numeric`, `atomic`, or `scalar numeric`.

#---- value_annotation_checks
#: integer
n <- 1L
#: character
bad <- 2L
#++++
n: integer
bad: character
39..41 error[type-mismatch] expected `character`, found `integer`

#==== trusted
#---- trust_skips_enforcement
#: @trust fn(x: integer) -> character
f <- function(x) x
#++++
f: fn(x: integer) -> character

#==== blocks
#---- definition_mixed_with_compact_is_refused
#: @type Person {list{name: character}}
#: integer
n <- 1L
#++++
n: integer
0..50 error[annotation] `@type` and `@alias` declarations need their own `#:` block. Separate them from other annotations with a blank line.

#---- definition_mixed_with_expanded_is_refused
#: @type Person {list{name: character}}
#: @param count {integer}
#: @return {Person}
make <- function(count) list(name = "a")
#++++
make: <T> fn(count: T) -> list{name: character}
0..85 error[annotation] `@type` and `@alias` declarations need their own `#:` block. Separate them from other annotations with a blank line.

#---- compact_mixed_with_expanded_is_refused
#: fn(x: integer) -> integer
#: @return {integer}
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
0..49 error[annotation] a `#:` block uses either one compact annotation or `@param`/`@return` lines, not both. Separate the two forms with a blank line.

#---- multiple_compact_annotations_are_refused
#: integer
#: double
n <- 1L
#++++
n: integer
0..20 error[annotation] only one compact annotation fits in a `#:` block. Separate the annotations with a blank line so each gets its own block.

#---- declared_return_mismatch_blames_the_tail_expression
#: fn(x: integer) -> character
f <- function(x) {
  y <- x + 1L
  y
}
#++++
f: fn(x: integer) -> character
66..67 error[type-mismatch] expected `character`, found `integer`

#---- duplicate_type_declarations_error_at_every_site
#: @type Point {list{v: double}}

#: @alias Point {integer}

#: @new Point
origin <- list(v = 1)
#++++
origin: list{v: double}
3..32 error[annotation] the type name `Point` is declared more than once. `@type` and `@alias` declarations share one project-global namespace.
37..59 error[annotation] the type name `Point` is declared more than once. `@type` and `@alias` declarations share one project-global namespace.

#==== form
#---- param_after_return_is_refused
#: @return {integer}
#: @param count {integer}
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
24..46 error[annotation] `@param` directives must appear before `@return` or `@returns` in the same `#:` block.

#---- multiple_returns_are_refused
#: @param count {integer}
#: @return {integer}
#: @returns {character}
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
50..70 error[annotation] cannot use more than one `@return` or `@returns` directive in the same `#:` block.

#---- forall_after_param_is_refused
#: @param count {integer}
#: @forall T
render <- function(count) count
#++++
render: <T> fn(count: T) -> T
29..38 error[annotation] `@forall` directives must appear before `@param`, `@return`, or `@returns` in the same `#:` block.

#---- duplicate_forall_parameter_is_refused
#: @forall T
#: @forall T
#: @param value {T}
#: @return {T}
f <- function(value) value
#++++
f: <T> fn(value: T) -> T
24..29 error[annotation] duplicate type parameter name `T` in expanded function annotation.

#---- duplicate_compact_binder_is_refused
#: <T, T> fn(x: T) -> T
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
7..8 error[annotation] duplicate type parameter name `T` in `<...>`.

#---- duplicate_definition_parameter_is_refused
#: @type Pair<T, T> {list{a: T, b: T}}
value <- 1L
#++++
value: integer
17..18 error[annotation] duplicate type parameter name `T` in named type definition.

#---- unknown_constraint_name_is_refused
#: <T: frobnicate> fn(x: T) -> T
f <- function(x) x
#++++
f: <T> fn(x: T) -> T
7..17 error[annotation] unknown type-parameter constraint `frobnicate`; the available constraints are `numeric`, `atomic`, or `scalar numeric`.

#---- a_refused_higher_rank_block_carries_no_payload
# The parser refuses the binder and reads the type as if it were absent, which
# leaves `T` with nothing to bind it. Lowering the block anyway reported `T` as
# an unknown type once per occurrence — three findings for one mistake — so a
# block holding a refused region carries no typing payload at all, and the
# definition types as though it were unannotated.
#: fn(f: <T> fn(x: T) -> T) -> integer
apply1 <- function(f) f(1L)
#++++
apply1: <T> fn(f: fn(integer) -> T) -> T
375..376 error[annotation] higher-rank polymorphism is not supported: type parameter binders may only appear at the outermost level

#---- a_form_clash_is_not_reported_for_a_line_that_merely_failed_to_parse
# `integer` is the unbraced type the `@param` could not take, not a second
# compact annotation on its own line. Counting it as one claimed the block mixed
# the two forms and told the author to add a blank line, which would not have
# helped; the parser's own report is the whole story.
#: @param count integer
#: @returns {integer}
f <- function(count) count + 1L
#++++
f: <T: numeric> fn(count: T) -> T
304..311 error[annotation] expected `{TYPE}` after `@param`

#---- applied_type_parameter_is_refused
#: @alias Wrap<T> {list{v: T}}

#: @alias Outer<Wrap> {Wrap<integer>}
value <- 1L
#++++
value: integer
55..68 error[annotation] `Wrap` is a type parameter here and takes no type arguments.

