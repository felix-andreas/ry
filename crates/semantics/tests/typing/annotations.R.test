#---- a_phantom_parameter_does_not_reach_the_call_sites
# The annotation names a parameter the function does not have. Adopting its
# arity would tell four correct calls they are missing an argument, so the
# exported signature keeps the formals and the disagreement reports once.
#: @param missing_one {integer}
#: @param x {integer}
#: @returns {integer}
f <- function(x) x + 1L
a <- f(1L)
b <- f(2L)
#++++
f: fn(x: integer) -> integer
a: integer
b: integer
306..324 error[type-mismatch] this annotation names a parameter `missing_one`, but the function does not define one. An annotation parameter name must match the function's parameter name

#---- annotating_one_parameter_of_several_is_a_partial_form
# The unannotated formal keeps the type its uses give it, and the call is
# checked against both formals rather than against the one that was declared.
#: @param x {integer}
#: @returns {integer}
f <- function(x, y) x + y
value <- f(1L, 2L)
#++++
f: fn(x: integer, y: integer) -> integer
value: integer

#---- a_surplus_declared_type_has_no_formal_to_land_on
#: fn(integer, integer) -> integer
f <- function(x) x + 1L
value <- f(1L)
#++++
f: fn(x: integer) -> integer
value: integer
40..58 error[type-mismatch] expected `fn(integer, integer) -> integer`, found `fn(x: integer) -> integer`

#---- a_formal_tested_with_missing_is_optional_whatever_the_annotation_says
#: fn([x]: integer) -> integer
f <- function(x) if (missing(x)) 0L else x
value <- f()
#++++
f: fn([x]: integer) -> integer
value: integer

