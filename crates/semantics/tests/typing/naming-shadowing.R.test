#==== nested_functions
#---- repeated_shadow_chain
#~~~~ R/main.R
x <- 1L
f <- function(x) {
  x <- "ok"
  x
}
#++++
== R/main.R
x: integer
f: <T> fn([x]: T) -> character

#==== cross_file_rebinding
#---- later_file_rebinding_wins_for_later_files
#~~~~ R/a.R
x <- 1L
#~~~~ R/b.R
x <- x
#~~~~ R/c.R
x
#++++
== R/a.R
x: integer
0..1 warning[duplicate] Top-level binding `x` is overwritten by a later top-level binding in this package.
  = 0..1 the later binding is here.
== R/b.R
x: Unknown
0..1 warning[duplicate] Top-level binding `x` overwrites an earlier top-level binding in this package.
  = 0..1 the earlier binding is here.
== R/c.R
Unknown

#==== call_heads_skip_non_functions
#---- null_global_falls_through_to_the_library
#~~~~ R/main.R
l10n_info <- NULL
utf8 <- function() l10n_info()$`UTF-8`
#++++
== R/main.R
l10n_info: NULL
utf8: fn() -> Unknown

#---- local_vector_named_like_a_function
#~~~~ R/main.R
upper_names <- function(x) {
  names <- toupper(names(x))
  names(x)
}
#++++
== R/main.R
upper_names: <T> fn(x: T) -> Any

#---- untyped_parameter_named_like_a_function
#~~~~ R/main.R
redact <- function(x, names) {
  x[names(x) %in% names] <- NA
  x
}
listing <- function(path) {
  dir <- path
  dir(dir)
}
#++++
== R/main.R
redact: <T, U> fn(x: T, names: U) -> T
listing: <T> fn(path: T) -> Unknown

#---- inner_value_skips_to_the_enclosing_function
#~~~~ R/main.R
outer <- function() {
  helper <- function(y) y + 1
  inner <- function() {
    helper <- "three"
    helper(2)
  }
  inner()
}
#++++
== R/main.R
outer: fn() -> double

#---- parameter_without_a_namesake_is_still_called
#~~~~ R/main.R
apply_to <- function(x, callback) callback(x)
#++++
== R/main.R
apply_to: <T, U> fn(x: T, callback: fn(T) -> U) -> U

#---- value_with_no_function_of_its_name_is_reported
#~~~~ R/main.R
f <- function(x) {
  nope <- 1
  nope(x)
}
#++++
== R/main.R
f: Unknown
33..37 error[type-mismatch] this has type `double`, which is not a function, so it cannot be called

#==== qualified_names_stay_in_their_namespace
#---- base_name_ignores_the_project_binding
#~~~~ R/main.R
date <- function(x) x
today <- function() base::date()
str <- "abc"
show <- function(x) utils::str(x)
#++++
== R/main.R
date: <T> fn(x: T) -> T
today: fn() -> character
str: character
show: <T> fn(x: T) -> NULL
