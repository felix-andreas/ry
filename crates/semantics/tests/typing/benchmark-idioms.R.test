#==== benchmark_idioms
#---- a_numeric_parameter_widens_from_integer_to_double
mix <- function(price, rate) price * rate
a <- mix(1L, 0.5)
b <- mix(0.5, 1L)
c <- mix(rbinom(3, 1, 0.5), 1 - rbinom(3, 1, 0.5))
#++++
mix: <T: numeric> fn(price: T, rate: T) -> T
a: double
b: double
c: double[]

#---- unchecked_argument_with_disagreeing_numeric_overloads_is_unchecked
total <- function(x, i) sum(x[[i]])
check <- function(x, i) vapply(i, function(j) sum(x[[j]]), numeric(1))
#++++
total: <T, U> fn(x: T, i: U) -> Unknown
check: <T, U> fn([x]: T, i: list[U] | U[]) -> double[]

#---- an_unknown_template_beside_an_open_callback_leaves_vapply_unchecked
#: <T> fn(x: T, template: Unknown)
apply_each <- function(x, template) vapply(seq_along(x), function(i) x[[i]], template)
#++++
apply_each: <T> fn(x: T, template: Unknown) -> Unknown

#---- a_function_joined_with_an_open_variable_is_callable
run <- function(source = NULL) {
  if (is.null(source)) {
    source <- function(a) a
  }
  source(1)
}
#++++
run: <T> fn([source]: T | NULL) -> Unknown

#---- double_and_triple_negation_are_injection_operators
inject <- function(query = list()) request(!!!query)
twice <- function(x) !!x
plain <- !!TRUE
#++++
inject: <T> fn([query]: T) -> Unknown
twice: <T> fn(x: T) -> Unknown
plain: logical
35..42 warning[unresolved] I could not resolve `request` in this package, its imports, or builtins.

#---- zeallot_destructuring_binds_the_pattern_names
span <- function(dates) {
  c(first, last) %<-% range(dates)
  list(first = first, last = last)
}
swap <- function(values) {
  range(values) %->% c(low, high)
  low
}
#++++
span: <T> fn(dates: T) -> list{first: Any, last: Any}
swap: <T> fn(values: T) -> Any

#---- zeallot_targets_take_the_types_of_their_positions
#: fn(x: double[]) -> character
spread <- function(x) {
  c(lo, hi) %<-% list(1, 2)
  hi - lo
}

#: fn() -> character
labels <- function() {
  c(name, c(code, .)) %<-% list(name = "a", pair = list("b", 1L))
  paste(name, code)
}

#: fn(values: double[]) -> double
first_of <- function(values) {
  c(head, ...rest) %<-% values
  head
}

#: fn() -> character
ends <- function() {
  c(first, ...middle, last) %<-% list(1, 2L, TRUE, "z")
  last
}

#: fn() -> double
too_many <- function() {
  c(a, b) %<-% list(1, 2, 3)
  a
}
#++++
spread: fn(x: double[]) -> character
labels: fn() -> character
first_of: fn(values: double[]) -> double
ends: fn() -> character
too_many: fn() -> double
86..93 error[type-mismatch] expected `character`, found `double`
489..496 error[type-mismatch] this pattern unpacks 2 values, but the value has 3 items, so `%<-%` stops with an error. Match the count, skip a position with `.`, or collect the rest with `...rest`

#---- widening_meets_a_scalar_and_a_vector
scale <- function(a, b) a * b
x <- scale(c(1L, 2L), 0.5)
y <- scale(1L, c(0.5, 1))
v <- function(flags) !!flags
#++++
scale: <T: numeric> fn(a: T, b: T) -> T
x: double[]
y: double[]
v: <T> fn(flags: T) -> Unknown

#---- a_matrix_meets_a_number_through_tied_operands
weigh <- function(a, H) a * H
direct <- weigh(2, matrix(1, 2, 2))
flipped <- weigh(matrix(1, 2, 2), 2)
#++++
weigh: <T: numeric> fn(a: T, H: T) -> T
direct: matrix
flipped: matrix

#---- a_literal_argument_does_not_pin_the_callers_parameter
weigh <- function(a, H) a * H
outer <- function(H) weigh(2, H)
whole <- outer(1L)
accepts <- function() {
  outer(c(1, 2))
  outer(matrix(1, 2, 2))
  NULL
}
#++++
weigh: <T: numeric> fn(a: T, H: T) -> T
outer: <T: numeric> fn(H: T) -> double
whole: double
accepts: fn() -> NULL

#---- a_splice_passes_each_element_to_the_dots
#: fn(...: character) -> character
join <- function(...) paste(...)

#: fn(parts: list[named: character]) -> character
joined <- function(parts) join(!!!parts)

#: fn(parts: list[double]) -> character
mixed <- function(parts) join(!!!parts)

#: fn() -> character
literal <- function() join(!!!list("a", "b"))
#++++
join: fn(...: character) -> character
joined: fn(parts: list[named: character]) -> character
mixed: fn(parts: list[double]) -> character
literal: fn() -> character
