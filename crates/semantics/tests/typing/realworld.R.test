#==== recursive_descent
#---- family_guarded_tree_fold_is_clean
sum_leaves <- function(node) {
  if (is.numeric(node)) {
    node
  } else {
    total <- 0
    for (child in node) {
      total <- total + sum_leaves(child)
    }
    total
  }
}

run <- function() sum_leaves(list(1, list(2, 3), list(list(4, 5), 6)))
#++++
sum_leaves: Unknown
run: fn() -> Unknown

