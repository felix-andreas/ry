#==== list_builders
#---- map_build_and_record_start_are_clean
build_totals <- function(labels) {
  totals <- list()
  for (label in labels) {
    totals[[label]] <- 0L
  }
  totals
}

first_total <- function(labels) {
  totals <- build_totals(labels)
  first <- totals[["a"]]
  if (is.null(first)) {
    0L
  } else {
    first + 1L
  }
}

new_counter <- function() {
  acc <- list()
  acc$count <- 0L
  acc$count + 1L
}
#++++
build_totals: <T> fn(labels: T) -> list{} | list[named: integer]
first_total: <T> fn(labels: T) -> integer
new_counter: fn() -> integer

