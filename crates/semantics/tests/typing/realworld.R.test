#==== option_handling
#---- config_module_is_clean
#: fn(name: character, [fallback]: character) -> character
env_or <- function(name, fallback = "") {
  value <- Sys.getenv(name)
  if (nchar(value) == 0L) {
    return(fallback)
  }
  value
}

#: fn(level: character) -> integer
log_level_rank <- function(level) {
  switch(level, debug = 1L, info = 2L, warn = 3L, error = 4L, 2L)
}

#: fn(timeout: integer | NULL) -> integer
effective_timeout <- function(timeout) {
  if (is.null(timeout)) {
    return(30L)
  }
  if (timeout < 1L) {
    stop("timeout must be positive")
  }
  timeout
}

describe_config <- function() {
  host <- env_or("SERVICE_HOST", "localhost")
  rank <- log_level_rank(env_or("LOG_LEVEL", "info"))
  timeout <- effective_timeout(NULL)
  sprintf("%s (level %d, timeout %ds)", host, rank, timeout)
}
#++++
env_or: fn(name: character, [fallback]: character) -> character
log_level_rank: fn(level: character) -> integer
effective_timeout: fn(timeout: integer | NULL) -> integer
describe_config: fn() -> character

#---- optional_without_default_via_missing_guard
settings <- list(host = "localhost", port = 8080L)

describe <- function(name, punct) {
  label <- toupper(name)
  if (missing(punct)) {
    label
  } else {
    paste0(label, punct)
  }
}

report <- function() {
  first <- settings[[1L]]
  header <- describe("connection")
  loud <- describe("connection", "!")
  paste(header, loud, first, sep = " | ")
}
#++++
settings: list{host: character, port: integer}
describe: <T, U> fn(name: T, [punct]: U) -> character
report: fn() -> character

#---- missing_guard_write_and_early_exit_are_clean
fill_default <- function(name, punct) {
  if (missing(punct)) {
    punct <- "!"
  }
  paste0(name, punct)
}

require_x <- function(x) {
  if (missing(x)) stop("x is required")
  x + 1L
}

pick <- function(x) {
  if (!missing(x)) {
    return(x + 1L)
  }
  0L
}

use_all <- function() {
  paste(fill_default("a"), require_x(1L), pick(), sep = " ")
}
#++++
fill_default: <T> fn(name: T, [punct]: character) -> character
require_x: <T: numeric> fn([x]: T) -> T
pick: <T: numeric> fn([x]: T) -> T | integer
use_all: fn() -> character

#==== control_flow
#---- while_loop_accumulator_is_clean
collatz_steps <- function(n) {
  steps <- 0L
  while (n > 1L) {
    if (n %% 2L == 0L) {
      n <- n %/% 2L
    } else {
      n <- 3L * n + 1L
    }
    steps <- steps + 1L
  }
  steps
}

run <- function() collatz_steps(27L)
#++++
collatz_steps: <T: numeric> fn(n: T) -> integer
run: fn() -> integer

#---- repeat_with_early_return_is_clean
find_index <- function(xs, target) {
  index <- 1L
  repeat {
    if (index > length(xs)) {
      return(-1L)
    }
    if (xs[[index]] == target) {
      return(index)
    }
    index <- index + 1L
  }
}

run <- function() find_index(list(10L, 20L, 30L), 20L)
#++++
find_index: <T, U> fn(xs: T, target: U) -> integer | NULL
run: fn() -> integer | NULL

