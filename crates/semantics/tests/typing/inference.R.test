#---- a_long_arithmetic_chain_checks_in_linear_time
# Both operands of an arithmetic or comparison operator infer once, at the
# operator. Inferring them again in the numeric fallback made each level of a
# nested chain re-walk both subtrees, so a chain of n operators cost 2^n, and
# machine-written symbolic derivatives in real sources reach 248 operators in a
# single statement. This case costs 0.15s with one walk and 184s with two, so a
# regression shows up as a suite that suddenly takes minutes on one case rather
# than as a failure — the hard guard belongs with the per-item scaling witness.
f <- function(x) x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
#++++
f: <T: num> fn(x: T) -> T

#---- a_fold_callback_keeps_its_accumulator_under_arithmetic
xs: List<I64> <- [1, 2, 3]
k: I64 <- 1
r1 <- Reduce(function(acc, x) acc * 2, 1:3, 1L)
r2 <- Reduce(function(acc, x) acc / x, 1:3, 1L)
r3 <- Reduce(function(acc, x) acc + 0.5, 1:3, 0L)
r4 <- Reduce(function(acc, x) acc * 2, 1:3)
r5 <- Reduce(function(acc, x) if (x > 1L) acc * 2 else acc, 1:3, 1L)
w1 <- List.walk(xs, k, function(acc, x) acc * 2)
w2 <- List.walk(["a"], 1L, function(acc, s) acc * 2)
c1 <- Reduce(function(acc, x) acc == x, c(TRUE, FALSE), TRUE)
c2 <- Reduce(function(a, b) a < b, 1:3, 0L)
walker <- function(ys, init) List.walk(ys, init, function(acc, y) acc * 2)
#++++
xs: List<I64>
k: I64
r1: double
r2: double
r3: double
r4: double
r5: double
w1: I64
w2: double
c1: logical
c2: logical | integer
walker: <T: item> fn(ys: List<T>, init: double) -> double

#---- a_fold_accumulator_takes_the_type_its_init_gives_under_arithmetic
# The callback settles the accumulator as `double`, and an init that arithmetic promotes or keeps
# rebinds it: a vector promotes to `double[]`, a `Date` stays a `Date`, as R's fold returns.
v <- Reduce(function(acc, x) acc * 2, list(1:3, 4:6), c(1L, 2L, 3L))
b <- Reduce(function(acc, x) acc * 2, 1:3, c(TRUE, FALSE))
d <- Reduce(function(acc, x) acc - 0.5, 1:3, Sys.Date())
m <- Reduce(function(acc, x) acc * 2, 1:3, matrix(1, 2, 2))
#++++
v: double[]
b: double[]
d: Date
m: matrix

#---- a_fold_accumulator_settles_at_the_first_value_that_meets_it
# A value checked against the callback's `double` settles it, so a later one of another type is
# checked against `double` too, and one rebind settles the variable for the values after it.
fold3 <- function<A>(f: fn(A, integer) -> A, a: A, b: A) -> A f(a, 1L)
t1 <- fold3(function(acc, x) acc * 2, 1.5, Sys.Date())
t2 <- fold3(function(acc, x) acc * 2, 1i64, Sys.Date())
t3 <- fold3(function(acc, x) acc * 2, c(1L, 2L), 1i64)
#++++
fold3: <A> fn(f: fn(A, integer) -> A, a: A, b: A) -> A
t1: Unknown
t2: Unknown
t3: Unknown
