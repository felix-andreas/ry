#---- a_compared_pair_checks_what_the_body_settles
# A side the body settles to a ry value takes the other side's open type, whatever the
# statement order; a side settled to an R value admits only R values. The argument that
# passed a side is found by its parameter, so another parameter of the same type is never
# blamed. A literal default adapts as a passed literal does, and any other default keeps
# its type. An annotated function keeps the check, a declared binder is as open as an
# inferred one, and an R pair stays R.
cmp <- function(a, b) a < b
same <- function(a, b) a == b
need_i <- function(v: I64) -> I64 v
need_s <- function(v: Str) -> Str v
need_d <- function(v: double) v
need_c <- function(v: character) v
k: I64 <- 1
s: Str <- "s"
f4 <- function(a) { r <- cmp(a, 2); need_i(a); r }
f6 <- function(a) { need_i(a); cmp(a, 2) }
f2 <- function(a, x, b) { r <- a < b; need_d(b); need_d(x); r }
r1 <- f2(k, 1, 2.5)
r2 <- f2(k, 2.5, 1)
d0 <- function(a, lo = 0) a < lo
d1 <- function(a, lo = 2.5) a < lo
d2 <- function(a, lo = sqrt(2)) a < lo
d3 <- function(a, lo = 0L) a < lo
x0 <- d0(k)
x1 <- d1(k)
x2 <- d2(k)
x3 <- d3(k)
g <- function(a, b, x: double) a < b
gx <- g(k, "s", 1)
g3 <- function(a, b) -> Bool a < b
g3x <- g3(k, "s")
h <- function(a, b: double) a < b
hx <- h(k, 2.5)
f1 <- function(a) { lo <- 2.5; a < lo }
f1x <- f1(k)
e5 <- function(a, b) { r <- a == b; need_s(a); need_c(b); r }
rv <- function(p, q) { r <- p < q; need_i(p); need_s(q); r }
dd <- as.Date("2020-01-01")
okd <- cmp(dd, "2019-01-01")
okr <- h(1L, 2)
#: <T: ordered> fn(a: T) -> Bool
rp <- function(a, b) a < b
rk <- rp(k, k)
rs <- rp(k, "s")
#: <T: number> fn(v: T) -> T
idn <- function(v) v
nb <- function(a) { r <- a < sqrt(2); idn(a); r }
#: <T: ordered, U: ordered> fn(a: T, b: U) -> Bool
gen2 <- function(a, b) a < b
q2 <- gen2(k, "s")
q3 <- gen2(k, 2)
bb: Bool <- TRUE
dfl <- function(a, flag = TRUE) a == flag
w1 <- dfl(bb)
w2 <- dfl(1L)
#++++
cmp: <T: comparable or ordered, U: comparable or ordered> fn(a: T, b: U) -> Compared<T>
same: <T: eq, U: eq> fn(a: T, b: U) -> Compared<T>
need_i: fn(v: I64) -> I64
need_s: fn(v: Str) -> Str
need_d: fn(v: double) -> double
need_c: fn(v: character) -> character
k: I64
s: Str
f4: fn(a: I64) -> Bool
f6: fn(a: I64) -> Bool
f2: <T: comparable> fn(a: T, x: double, b: double) -> logical
r1: Unknown
r2: Unknown
d0: <T: comparable or ordered, U: comparable or ordered> fn(a: T, [lo]: U) -> Compared<T>
d1: <T: comparable or ordered, U: comparable or ordered> fn(a: T, [lo]: U) -> Compared<T>
d2: <T: comparable or ordered, U: comparable or ordered> fn(a: T, [lo]: U) -> Compared<T>
d3: <T: comparable or ordered, U: comparable or ordered> fn(a: T, [lo]: U) -> Compared<T>
x0: Bool
x1: Unknown
x2: Unknown
x3: Bool
g: <T: comparable or ordered, U: comparable or ordered> fn(a: T, b: U, x: double) -> Compared<T>
gx: Unknown
g3: <T: ordered, U: comparable or ordered> fn(a: T, b: U) -> Bool
g3x: Unknown
h: <T: comparable> fn(a: T, b: double) -> logical
hx: Unknown
f1: <T: comparable> fn(a: T) -> logical
f1x: Unknown
e5: Unknown
rv: Unknown
dd: Date
okd: logical
okr: logical
rp: <T: ordered, U: comparable or ordered> fn(a: T, b: U) -> Bool
rk: Bool
rs: Unknown
idn: <T: number> fn(v: T) -> T
nb: Unknown
gen2: <T: ordered, U: ordered> fn(a: T, b: U) -> Bool
q2: Unknown
q3: Bool
bb: Bool
dfl: <T: eq, U: eq> fn(a: T, [flag]: U) -> Compared<T>
w1: Bool
w2: logical
