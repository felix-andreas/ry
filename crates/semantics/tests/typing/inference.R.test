#---- an_open_value_tested_for_equality_admits_complex
# R tests `complex` values for equality but has no order for them.
is_zero <- function(x) x == 0
is_a <- function(x) x != "a"
negative <- function(x) x < 0
zero <- is_zero(1i)
items <- is_a(c(1i, 2i))
ordered <- negative(1i)
#++++
is_zero: <T: equatable or number> fn(x: T) -> Compared<T>
is_a: <T: equatable or Str> fn(x: T) -> Compared<T>
negative: <T: comparable or number> fn(x: T) -> Compared<T>
