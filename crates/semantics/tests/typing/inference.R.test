359..369 error[type-mismatch] expected `I64`, found `Date`
420..424 error[type-mismatch] expected `double[]`, found `I64`

#---- arithmetic_on_an_open_operand_keeps_a_class_with_arithmetic
# A class's arithmetic methods give the class, so a generic function's arithmetic on a `Date` or a
# `matrix` returns it, and a fold whose init binds the accumulator first takes the callback. A
# difference of two values of one class keeps only a class closed under arithmetic: two dates
# subtract to a `difftime`, two `difftime`s to a `difftime`, and arithmetic on a difference stays
# a difference. A fold whose callback subtracts two accumulators cannot keep a `Date` init.
shift <- function(x) x - 0.5
twice <- function(x) x * 2
d <- shift(Sys.Date())
m <- twice(matrix(1, 2, 2))
w <- List.walk([1i64], Sys.Date(), function(acc, x) acc - 0.5)
span <- function(from, to) to - from
days <- span(Sys.Date(), Sys.Date())
lag <- Sys.Date() - Sys.Date()
lags <- span(lag, lag)
half <- function(a, b) (b - a) / 2
halved <- half(Sys.Date(), Sys.Date())
mixed <- function(a, b) (a - b) - (a - 0.5)
mixed_ry <- mixed(1.5f64, 2.5f64)
gaps <- List.walk([1i64], Sys.Date(), function(acc, x) acc - acc)
