#==== schemes
#---- an_escaping_numeric_value_defaults_to_double
increment <- function(x) x + 1L
#: Any
anything <- 1L
result <- increment(anything)
#++++
increment: <T: numeric> fn(x: T) -> T
anything: Any
result: double

#---- an_alias_inside_a_body_stays_polymorphic
f <- function() {
  mirror <- function(x) x
  alias <- mirror
  list(alias(1L), alias("a"))
}
#++++
f: fn() -> list{integer, character}

#---- identity
id <- function(x) x
#++++
id: <T> fn(x: T) -> T

#---- arithmetic_generalizes
add1 <- function(x) x + 1L
#++++
add1: <T: numeric> fn(x: T) -> T

#---- two_operands_tie
add <- function(a, b) a + b
#++++
add: <T: numeric> fn(a: T, b: T) -> T

#---- division_is_double
half <- function(x) x / 2
#++++
half: <T: numeric> fn(x: T) -> double

#---- comparison_constrains
positive <- function(x) x > 0L
#++++
positive: <T: numeric> fn(x: T) -> logical

#---- two_flexible_comparison_stays_unconstrained
cmp <- function(a, b) a < b
mixed <- cmp(1L, "s")
#++++
cmp: <T, U> fn(a: T, b: U) -> logical
mixed: logical

#---- values
n <- 1L
s <- "hi"
flag <- TRUE
#++++
n: integer
s: character
flag: logical

#---- let_polymorphism
use <- function() {
  id <- function(x) x
  id(1L)
  id("s")
}
#++++
use: fn() -> character

#---- conditional_reassignment_monomorphizes
f <- function(flag) {
  x <- 1L
  if (flag) x <- "two"
  x
}
#++++
f: fn(flag: logical) -> integer | character

#==== errors
#---- call_numeric_violation
f <- function() {
  add1 <- function(x) x + 1L
  add1("txt")
}
#++++
f: Unknown
54..59 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- forward_read_is_tolerant
f <- function() later()
later <- function() 1L
#++++
f: fn() -> integer
later: fn() -> integer

#==== interface
#---- growing_self_reference_pins_to_unknown
x <- list(v = 1, w = x)
#++++
x: Unknown

#---- occurs_check_names_the_infinite_type
f <- function(g) g(g)
#++++
f: Unknown
17..21 error[type-mismatch] I cannot construct an infinite type: T occurs inside `fn(T) -> U`.

#==== constants
#---- reserved_constants_infer_fixed_types
flag <- NA
count <- NA_integer_
amount <- NA_real_
label <- NA_character_
z <- NA_complex_
inf <- Inf
nan <- NaN
im <- 1i
#++++
flag: logical
count: integer
amount: double
label: character
z: complex
inf: double
nan: double
im: complex

#==== operators
#---- modulo_and_integer_division_follow_arithmetic
f <- function() 7L %% 2L
g <- function() 7L %/% 2.5
#++++
f: fn() -> integer
g: fn() -> double

#---- power_is_always_double
f <- function() 2L ^ 3L
g <- function() 2L ** 3L
h <- function(x) x ^ 2L
#++++
f: fn() -> double
g: fn() -> double
h: <T: numeric> fn(x: T) -> double

#---- unary_minus_keeps_the_atom_and_shape
f <- function() -1L
g <- function() -c(1L, 2L)
h <- function() -c(foo = 1L, bar = 2L)
#++++
f: fn() -> integer
g: fn() -> integer[]
h: fn() -> integer[]

#---- unary_not_coerces_numerics_and_refuses_the_rest
# `!` coerces exactly as a condition does (`!0` is TRUE, `!5` is FALSE) and
# always yields a logical.
f <- function() !TRUE
g <- function() !c(TRUE, FALSE)
h <- function() !1L
i <- function() !"a"
#++++
f: fn() -> logical
g: fn() -> logical[]
h: fn() -> logical
i: Unknown
194..197 error[type-mismatch] expected a `logical` value, found `character`

#---- comparison_families
f <- function() "a" < "b"
g <- function() c(1L, 2L) > 1L
h <- function() 1L < "a"
#++++
f: fn() -> logical
g: fn() -> logical[]
h: Unknown
78..81 error[type-mismatch] expected `integer`, found `character`

#---- logical_operands_promote_to_integer_in_arithmetic
f <- function() TRUE + TRUE
g <- function() TRUE + 1L
h <- function() TRUE + 1.5
k <- function() c(TRUE, FALSE) * 2L
#++++
f: fn() -> integer
g: fn() -> integer
h: fn() -> double
k: fn() -> integer[]

#---- logical_compares_in_the_numeric_family
f <- function() TRUE > 0
g <- function() c(TRUE, FALSE) > 0L
h <- function() TRUE == 1L
k <- function() TRUE < "a"
#++++
f: fn() -> logical
g: fn() -> logical[]
h: fn() -> logical
k: Unknown
111..114 error[type-mismatch] expected `logical`, found `character`

#---- date_arithmetic_dispatches_to_the_declared_operator_method
#: fn(from: Date, until: Date) -> difftime
elapsed <- function(from, until) until - from
#: fn(day: Date) -> Date
shifted <- function(day) day + 30L
#: fn(from: Date, until: Date) -> logical
ordered <- function(from, until) from < until
#: fn(gap: difftime) -> logical
long <- function(gap) gap > 30
#++++
elapsed: fn(from: Date, until: Date) -> difftime
shifted: fn(day: Date) -> Date
ordered: fn(from: Date, until: Date) -> logical
long: fn(gap: difftime) -> logical

#---- combining_a_class_that_declares_c_keeps_that_class
# R dispatches `c()` too, so `c(d1, d2)` on two Dates is a Date vector — and a
# real error on the result must still be caught.
#: fn(from: Date, until: Date) -> difftime
span <- function(from, until) {
  both <- c(from, until)
  both - from
}
#: fn(from: Date, until: Date) -> Unknown
broken <- function(from, until) {
  both <- c(from, until)
  both + until
}
#++++
span: fn(from: Date, until: Date) -> difftime
broken: fn(from: Date, until: Date) -> Unknown
349..361 error[type-mismatch] `+` is not defined between `Date` and `Date`

#---- combining_a_class_with_no_c_method_keeps_the_elements_not_the_class
# R's default `c()` strips the class and concatenates the underlying lists, so
# two `Widget`s combine into a plain list of their fields — the class is gone
# but the element type survives. Reporting a mismatch invented an expectation
# nothing in the call asked for.
#: @type Widget {list{id: character}}

#: fn(a: Widget, b: Widget)
pair <- function(a, b) c(a, b)
#++++
pair: fn(a: Widget, b: Widget) -> list[character]

#---- an_operand_pair_the_class_does_not_accept_reports_the_class
f <- function() as.Date("2024-01-15") + as.Date("2024-03-01")
#++++
f: Unknown
16..61 error[type-mismatch] `+` is not defined between `Date` and `Date`

#---- range_operator_shapes
f <- function() 1L:10L
g <- function() 1:10
h <- function() 1.5:3L
k <- function(n) 1:n
#++++
f: fn() -> integer[]
g: fn() -> integer[]
h: fn() -> double[]
k: <T: scalar numeric> fn(n: T) -> double[]

#---- boolean_operators_are_scalar_only
f <- function(a, b) a && b
g <- function() c(TRUE, FALSE) && TRUE
#++++
f: fn(a: logical, b: logical) -> logical
g: Unknown
43..57 error[type-mismatch] expected `logical`, found `logical[]`

#---- unary_minus_generalizes
f <- function(x) -x
#++++
f: <T: numeric> fn(x: T) -> T

#---- division_by_literal_keeps_the_parameter_numeric
f <- function(x) x / 2
#++++
f: <T: numeric> fn(x: T) -> double

#---- a_long_arithmetic_chain_checks_in_linear_time
# Both operands of an arithmetic or comparison operator infer once, at the
# operator. Inferring them again in the numeric fallback made each level of a
# nested chain re-walk both subtrees, so a chain of n operators cost 2^n, and
# machine-written symbolic derivatives in real sources reach 248 operators in a
# single statement. This case costs 0.15s with one walk and 184s with two, so a
# regression shows up as a suite that suddenly takes minutes on one case rather
# than as a failure — the hard guard belongs with the per-item scaling witness.
f <- function(x) x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
#++++
f: <T: numeric> fn(x: T) -> T
