#==== exports
#---- exports_bindings_and_aliases
#: @alias Formatter {fn(integer) -> character}
mirror <- function(x) x
render <- function(count) "ok"
#++++
mirror: <T> fn(x: T) -> T
render: <T> fn(count: T) -> character

#---- optional_parameter_export
#: fn(count: integer, [label]: character) -> integer
double_count <- function(count, label = NULL) count + count
#++++
double_count: fn(count: integer, [label]: character) -> integer
93..97 error[type-mismatch] `label` defaults to `NULL`, which its declared type `character` does not admit — a caller who omits it leaves `NULL` in the body. Declare it `character | NULL` and narrow with `is.null()`

#---- latest_function_binding_wins_with_changed_shape
render <- function(count) "ok"

#: fn(count: integer, label: character) -> character
render <- function(count, label) label
#++++
render: <T> fn(count: T) -> character
render: fn(count: integer, label: character) -> character
0..6 warning[duplicate] Top-level binding `render` is overwritten by a later top-level binding in this package.
85..91 warning[duplicate] Top-level binding `render` overwrites an earlier top-level binding in this package.

#---- exports_interleaved_with_type_definitions
#: @alias Count {integer}
first <- 1L

#: @type Person {list{name: character}}
second <- "two"
#++++
first: integer
second: character
