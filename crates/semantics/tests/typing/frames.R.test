#==== frame_constructor
#---- named_arguments_become_columns
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
#++++
prices: DataFrame{id: integer[], price: double[]}

#---- a_scalar_broadens_to_its_vector_type
labels <- DataFrame(count = 1L, label = "a")
#++++
labels: DataFrame{count: integer[], label: character[]}

#---- an_array_column_types_as_its_item_vector
prices <- DataFrame(id = [1L, 2L], price = [12.5, 9.99])
#++++
prices: DataFrame{id: integer[], price: double[]}

#---- an_array_column_reads_back_as_a_plain_vector
prices <- DataFrame(id = [1L, 2L], price = [12.5, 9.99])
by_name <- prices$price
by_string <- prices[["price"]]
checked <- as.Array(prices$price)
#++++
prices: DataFrame{id: integer[], price: double[]}
by_name: double[]
by_string: double[]
checked: Array<double>

#---- an_unnamed_variable_keeps_its_name
id <- 1:3
items <- DataFrame(id, price = c(1, 2, 3))
#++++
id: integer[]
items: DataFrame{id: integer[], price: double[]}

#---- an_unnamed_computed_argument_leaves_the_columns_unknown
items <- DataFrame(1:3, price = c(1, 2, 3))
#++++
items: DataFrame

#---- no_arguments_is_the_graphics_page
page <- DataFrame()
#++++
page: DataFrame{}

#---- a_project_definition_shadows_the_builtin
frame <- function(...) 1L
made <- DataFrame(id = 1:3)
#++++
frame: fn(...: Any) -> integer
made: DataFrame{id: integer[]}

#==== frame_annotations
#---- a_frame_type_annotates_a_parameter
#: fn(prices: DataFrame{id: integer[], price: double[]}) -> double[]
price_of <- function(prices) prices$price
#++++
price_of: fn(prices: DataFrame{id: integer[], price: double[]}) -> double[]

#---- a_frame_with_unknown_columns_is_silent
#: fn(data: DataFrame) -> DataFrame
anything <- function(data) data[score > 1, .(total = sum(score)), by = team]
#++++
anything: fn(data: DataFrame) -> DataFrame

#---- a_frame_is_no_data_frame
#: fn(data: data.frame) -> integer
count_rows <- function(data) nrow(data)
rows <- count_rows(DataFrame(id = 1:3))
#++++
count_rows: fn(data: data.frame) -> integer
rows: Unknown
94..113 error[type-mismatch] expected `data.frame`, found `DataFrame{id: integer[]}`

#---- as_frame_and_file_reads_build_frames
from_list <- as.DataFrame(list(id = 1:3))
read <- DataFrame.read_csv("prices.csv")
flag <- is.DataFrame(read)
#++++
from_list: DataFrame
read: DataFrame
flag: logical

