#==== frame_joins
#---- on_a_string_key
prices <- frame(id = 1:3, price = c(1, 2, 3))
labels <- frame(id = 1:3, label = c("a", "b", "c"))
joined <- prices[labels, on = "id"]
#++++
prices: frame{id: integer[], price: double[]}
labels: frame{id: integer[], label: character[]}
joined: frame{id: integer[], price: double[], label: character[]}

#---- on_a_dot_list_key
prices <- frame(id = 1:3, price = c(1, 2, 3))
labels <- frame(id = 1:3, label = c("a", "b", "c"))
joined <- prices[labels, on = .(id)]
#++++
prices: frame{id: integer[], price: double[]}
labels: frame{id: integer[], label: character[]}
joined: frame{id: integer[], price: double[], label: character[]}

#---- on_a_character_vector_key_with_roll
prices <- frame(id = 1:3, price = c(1, 2, 3))
labels <- frame(id = 1:3, label = c("a", "b", "c"))
joined <- prices[labels, on = c("id"), roll = TRUE]
#++++
prices: frame{id: integer[], price: double[]}
labels: frame{id: integer[], label: character[]}
joined: frame{id: integer[], price: double[], label: character[]}

#---- on_differently_named_keys
prices <- frame(id = 1:3, price = c(1, 2, 3))
labels <- frame(key = c(1L, 2L), label = c("a", "b"))
joined <- prices[labels, on = c(id = "key")]
#++++
prices: frame{id: integer[], price: double[]}
labels: frame{key: integer[], label: character[]}
joined: frame{id: integer[], price: double[], label: character[]}

