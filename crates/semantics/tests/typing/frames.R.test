#==== frame_constructor
#---- named_arguments_become_columns
prices <- frame(id = 1:3, price = c(1, 2, 3))
#++++
prices: frame{id: integer[], price: double[]}

#---- a_scalar_broadens_to_its_vector_type
labels <- frame(count = 1L, label = "a")
#++++
labels: frame{count: integer[], label: character[]}

#---- an_unnamed_variable_keeps_its_name
id <- 1:3
items <- frame(id, price = c(1, 2, 3))
#++++
id: integer[]
items: frame{id: integer[], price: double[]}

#---- an_unnamed_computed_argument_leaves_the_columns_unknown
items <- frame(1:3, price = c(1, 2, 3))
#++++
items: frame

#---- no_arguments_is_the_graphics_page
page <- frame()
#++++
page: NULL

#---- a_project_definition_shadows_the_builtin
frame <- function(...) 1L
made <- frame(id = 1:3)
#++++
frame: fn(...: Any) -> integer
made: integer

#==== frame_annotations
#---- a_frame_type_annotates_a_parameter
#: fn(prices: frame{id: integer[], price: double[]}) -> double[]
price_of <- function(prices) prices$price
#++++
price_of: fn(prices: frame{id: integer[], price: double[]}) -> double[]

#---- a_frame_with_unknown_columns_is_silent
#: fn(data: frame) -> frame
anything <- function(data) data[score > 1, .(total = sum(score)), by = team]
#++++
anything: fn(data: frame) -> frame

#---- a_frame_satisfies_data_frame
#: fn(data: data.frame) -> integer
count_rows <- function(data) nrow(data)
rows <- count_rows(frame(id = 1:3))
#++++
count_rows: fn(data: data.frame) -> integer
rows: integer

#---- a_frame_argument_checks_its_columns
#: fn(prices: frame{id: integer[], price: double[]}) -> double[]
price_of <- function(prices) prices$price
cost <- price_of(frame(id = 1:3, price = c("a", "b", "c")))
#++++
price_of: fn(prices: frame{id: integer[], price: double[]}) -> double[]
cost: Unknown
124..165 error[type-mismatch] expected `frame{id: integer[], price: double[]}`, found `frame{id: integer[], price: character[]}`

#==== frame_rows
#---- a_filter_keeps_the_frame_type
prices <- frame(id = 1:3, price = c(1, 2, 3))
expensive <- prices[price > 1]
#++++
prices: frame{id: integer[], price: double[]}
expensive: frame{id: integer[], price: double[]}

#---- an_ordering_keeps_the_frame_type
prices <- frame(id = 1:3, price = c(1, 2, 3))
sorted <- prices[order(-price)]
#++++
prices: frame{id: integer[], price: double[]}
sorted: frame{id: integer[], price: double[]}

#---- a_lexical_name_that_is_no_column_keeps_its_type
prices <- frame(id = 1:3, price = c(1, 2, 3))
threshold <- 2
expensive <- prices[price > threshold]
#++++
prices: frame{id: integer[], price: double[]}
threshold: double
expensive: frame{id: integer[], price: double[]}

#---- a_column_shadows_a_lexical_name
price <- "not a number"
prices <- frame(id = 1:3, price = c(1, 2, 3))
doubled <- prices[, price * 2]
#++++
price: character
prices: frame{id: integer[], price: double[]}
doubled: double[]

#---- a_misspelled_column_in_i_is_reported
prices <- frame(id = 1:3, price = c(1, 2, 3))
expensive <- prices[pirce > 1]
#++++
prices: frame{id: integer[], price: double[]}
expensive: frame{id: integer[], price: double[]}
