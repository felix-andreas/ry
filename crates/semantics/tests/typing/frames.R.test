taxed <- sales[, tax := amount * 0.2][, .(team, tax)]
#++++
sales: frame{team: character[], amount: double[]}
taxed: frame{team: character[], tax: double[]}

#---- a_chain_reports_a_column_its_earlier_step_dropped
