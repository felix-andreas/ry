#==== frame_j
#---- a_named_list_j_builds_a_frame
prices <- frame(id = 1:3, price = c(1, 2, 3))
summary <- prices[, .(total = sum(price), rows = .N)]
#++++
prices: frame{id: integer[], price: double[]}
summary: frame{total: double[], rows: integer[]}

#---- list_spells_the_same_j
prices <- frame(id = 1:3, price = c(1, 2, 3))
summary <- prices[, list(total = sum(price))]
#++++
prices: frame{id: integer[], price: double[]}
summary: frame{total: double[]}

#---- an_unnamed_column_keeps_its_name_and_others_are_numbered
prices <- frame(id = 1:3, price = c(1, 2, 3))
shaped <- prices[, .(id, price * 2)]
#++++
prices: frame{id: integer[], price: double[]}
shaped: frame{id: integer[], V2: double[]}

#---- a_bare_column_j_is_the_column_vector
prices <- frame(id = 1:3, price = c(1, 2, 3))
column <- prices[, price]
#++++
prices: frame{id: integer[], price: double[]}
column: double[]

#---- a_computed_j_without_by_is_its_value
prices <- frame(id = 1:3, price = c(1, 2, 3))
total <- prices[, sum(price)]
#++++
prices: frame{id: integer[], price: double[]}
total: double

#---- a_misspelled_column_in_j_is_reported
prices <- frame(id = 1:3, price = c(1, 2, 3))
total <- prices[, .(total = sum(pirce))]
#++++
prices: frame{id: integer[], price: double[]}
total: frame{total: integer[]}
78..83 warning[unresolved] the frame `prices` has no column `pirce`, and nothing else defines that name. Did you mean `price`?

#---- a_closure_parameter_in_j_stays_lexical
prices <- frame(id = 1:3, price = c(1, 2, 3))
scaled <- prices[, .(scaled = vapply(price, function(value) value * 2, numeric(1)))]
#++++
prices: frame{id: integer[], price: double[]}
scaled: frame{scaled: double[]}

#==== frame_by
#---- a_bare_name_groups_first
sales <- frame(team = c("a", "b"), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), by = team]
#++++
sales: frame{team: character[], amount: double[]}
per_team: frame{team: character[], total: double[]}

#---- a_dot_list_of_groups
sales <- frame(team = c("a", "b"), year = c(2020L, 2021L), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), by = .(team, year)]
#++++
sales: frame{team: character[], year: integer[], amount: double[]}
per_team: frame{team: character[], year: integer[], total: double[]}

#---- a_character_vector_of_groups
sales <- frame(team = c("a", "b"), year = c(2020L, 2021L), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), by = c("team", "year")]
#++++
sales: frame{team: character[], year: integer[], amount: double[]}
per_team: frame{team: character[], year: integer[], total: double[]}

#---- a_single_string_group
sales <- frame(team = c("a", "b"), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), by = "team"]
#++++
sales: frame{team: character[], amount: double[]}
per_team: frame{team: character[], total: double[]}

#---- keyby_groups_like_by
sales <- frame(team = c("a", "b"), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), keyby = team]
#++++
sales: frame{team: character[], amount: double[]}
per_team: frame{team: character[], total: double[]}

#---- a_named_computed_group
sales <- frame(team = c("a", "b"), amount = c(1, 2))
per_size <- sales[, .(rows = .N), by = .(large = amount > 1)]
#++++
sales: frame{team: character[], amount: double[]}
per_size: frame{large: logical[], rows: integer[]}

#---- an_unnamed_grouped_value_is_v1
sales <- frame(team = c("a", "b"), amount = c(1, 2))
per_team <- sales[, sum(amount), by = team]
#++++
sales: frame{team: character[], amount: double[]}
per_team: frame{team: character[], V1: double[]}

#---- a_bare_column_under_by_keeps_its_name
sales <- frame(team = c("a", "b"), amount = c(1, 2))
per_team <- sales[, amount, by = team]
#++++
sales: frame{team: character[], amount: double[]}
per_team: frame{team: character[], amount: double[]}

#---- subset_data_is_the_frame_without_its_groups
sales <- frame(team = c("a", "b"), year = c(2020L, 2021L), amount = c(1, 2))
firsts <- sales[, .SD[1], by = team]
#++++
sales: frame{team: character[], year: integer[], amount: double[]}
firsts: frame{team: character[], year: integer[], amount: double[]}

#---- a_misspelled_bare_group_is_reported
sales <- frame(team = c("a", "b"), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), by = taem]
#++++
sales: frame{team: character[], amount: double[]}
per_team: frame{taem: Unknown, total: double[]}
