expensive: DataFrame{id: integer[], price: double[]}

#---- an_ordering_keeps_the_frame_type
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
sorted <- prices[order(-price)]
#++++
prices: DataFrame{id: integer[], price: double[]}
sorted: DataFrame{id: integer[], price: double[]}

#---- a_lexical_name_that_is_no_column_keeps_its_type
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
threshold <- 2
expensive <- prices[price > threshold]
#++++
prices: DataFrame{id: integer[], price: double[]}
threshold: double
expensive: DataFrame{id: integer[], price: double[]}

#---- a_column_shadows_a_lexical_name
price <- "not a number"
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
doubled <- prices[, price * 2]
