f[, g := 3]
#++++
f: DataFrame{g: factor, v: double[]}
fa: DataFrame{g: factor, v: double[]}
fb: DataFrame{g: factor, v: double[]}
k: DataFrame{k: character[]}
j: DataFrame{g: character[], v: double[]}
m: DataFrame{k: double[]}
j2: Unknown
DataFrame{g: factor, v: double[]}
DataFrame{g: factor, v: double[]}
190..195 error[type-mismatch] the join condition `g == k` compares `factor` with `double[]`. A join matches numbers with numbers, strings with strings or factors, and logicals with logicals.
221..222 error[type-mismatch] column `g` holds `factor`, so this `double` value is read as a level's position rather than a label, and a number that is not one becomes `NA`

#==== dataframe_verbs
#---- select_computes_the_named_columns
sales <- DataFrame(region = c("eu", "us"), units = c(3L, 5L), price = c(1.5, 2))
picked <- DataFrame.select(sales, "region", revenue = col("units") * col("price"))
#++++
sales: DataFrame{region: character[], units: integer[], price: double[]}
picked: DataFrame{region: character[], revenue: double[]}

#---- unaliased_expressions_take_the_first_column_read
sales <- DataFrame(units = c(3L, 5L), price = c(1.5, 2))
picked <- sales |> DataFrame.select(col("price") * 2, col("units") > 1L, Expr.len())
#++++
sales: DataFrame{units: integer[], price: double[]}
picked: DataFrame{price: double[], units: logical[], len: integer[]}

#---- alias_renames_an_expression
sales <- DataFrame(units = c(3L, 5L), price = c(1.5, 2))
picked <- sales |> DataFrame.select(col("price") |> Expr.alias("cost"))
#++++
sales: DataFrame{units: integer[], price: double[]}
picked: DataFrame{cost: double[]}

#---- with_columns_replaces_or_appends
sales <- DataFrame(units = c(3L, 5L), price = c(1.5, 2))
wider <- sales |> DataFrame.with_columns(units = col("units") * 2.5, total = col("units") * col("price"))
#++++
sales: DataFrame{units: integer[], price: double[]}
wider: DataFrame{units: double[], price: double[], total: double[]}

#---- filter_sort_and_head_keep_the_columns
sales <- DataFrame(units = c(3L, 5L), price = c(1.5, 2))
top <- sales |>
  DataFrame.filter(col("units") > 1L) |>
  DataFrame.sort("price", descending = TRUE) |>
  DataFrame.head(1L)
#++++
sales: DataFrame{units: integer[], price: double[]}
top: DataFrame{units: integer[], price: double[]}

#---- group_by_and_agg_give_keys_then_aggregates
sales <- DataFrame(region = c("eu", "us"), units = c(3L, 5L), price = c(1.5, 2))
grouped <- DataFrame.group_by(sales, "region")
totals <- grouped |> GroupBy.agg(col("units") |> Expr.sum(), avg = col("price") |> Expr.mean(), n = Expr.len())
#++++
sales: DataFrame{region: character[], units: integer[], price: double[]}
grouped: GroupBy{region: character[]; units: integer[], price: double[]}
totals: DataFrame{region: character[], units: integer[], avg: double[], n: integer[]}

#---- join_appends_the_other_columns_with_a_suffix
left <- DataFrame(id = 1:3, score = c(1, 2, 3))
right <- DataFrame(id = 1:2, score = c(10, 20), label = c("a", "b"))
joined <- DataFrame.join(left, right, on = "id")
kept <- DataFrame.join(left, right, on = "id", how = "semi")
#++++
left: DataFrame{id: integer[], score: double[]}
right: DataFrame{id: integer[], score: double[], label: character[]}
joined: DataFrame{id: integer[], score: double[], score_right: double[], label: character[]}
kept: DataFrame{id: integer[], score: double[]}

#---- an_asof_join_matches_by_exactly_and_on_to_the_nearest_row
trades <- DataFrame(ticker = c("a", "b"), time = c(5L, 3L), size = c(10, 20))
quotes <- DataFrame(ticker = c("a", "b"), time = c(2L, 4L), price = c(1.5, 7))
joined <- DataFrame.join_asof(trades, quotes, on = "time", by = "ticker")
#++++
trades: DataFrame{ticker: character[], time: integer[], size: double[]}
quotes: DataFrame{ticker: character[], time: integer[], price: double[]}
joined: DataFrame{ticker: character[], time: integer[], size: double[], price: double[]}

#---- an_asof_join_with_by_null_has_no_equality_keys
trades <- DataFrame(time = c(5L, 3L), size = c(10, 20))
quotes <- DataFrame(time = c(2L, 4L), price = c(1.5, 7))
joined <- DataFrame.join_asof(trades, quotes, on = "time", by = NULL)
#++++
trades: DataFrame{time: integer[], size: double[]}
quotes: DataFrame{time: integer[], price: double[]}
joined: DataFrame{time: integer[], size: double[], price: double[]}

#---- head_in_agg_keeps_up_to_n_rows_per_group
x <- DataFrame(g = c("p", "q", "p"), v = c(3, 9, 7))
top <- x |> DataFrame.group_by("g") |> GroupBy.agg(top2 = col("v") |> Expr.head(2L))
#++++
x: DataFrame{g: character[], v: double[]}
top: DataFrame{g: character[], top2: double[]}

#---- lazy_frames_carry_the_schema_to_collect
sales <- DataFrame(region = c("eu", "us"), units = c(3L, 5L))
plan <- sales |>
  DataFrame.lazy() |>
  LazyFrame.group_by("region") |>
  LazyGroupBy.agg(col("units") |> Expr.max())
result <- LazyFrame.collect(plan)
#++++
sales: DataFrame{region: character[], units: integer[]}
plan: LazyFrame{region: character[], units: integer[]}
result: DataFrame{region: character[], units: integer[]}

#---- an_expression_in_a_variable_leaves_the_columns_unknown
sales <- DataFrame(units = c(3L, 5L))
doubled <- col("units") * 2
picked <- DataFrame.select(sales, doubled)
#++++
sales: DataFrame{units: integer[]}
doubled: Expr
picked: DataFrame

#==== dataframe_verb_errors
#---- a_misspelled_column_is_reported_at_its_string
sales <- DataFrame(region = c("eu", "us"), units = c(3L, 5L))
picked <- DataFrame.select(sales, "regoin", col("unit") * 2)
#++++
sales: DataFrame{region: character[], units: integer[]}
picked: Unknown
96..104 error[type-mismatch] the frame `sales` has no column `regoin`. Did you mean `region`?
110..116 error[type-mismatch] the frame `sales` has no column `unit`. Did you mean `units`?

#---- agg_needs_an_aggregation
sales <- DataFrame(region = c("eu", "us"), units = c(3L, 5L))
totals <- sales |> DataFrame.group_by("region") |> GroupBy.agg(col("units"))
#++++
sales: DataFrame{region: character[], units: integer[]}
totals: Unknown
125..137 error[type-mismatch] `units` gives one value per row, but `agg` needs one value per group. Aggregate it, for example with `Expr.sum` or `Expr.first`

#---- a_join_key_must_exist_on_both_sides
left <- DataFrame(id = 1:3)
right <- DataFrame(key = 1:3)
joined <- DataFrame.join(left, right, on = "id")
#++++
left: DataFrame{id: integer[]}
right: DataFrame{key: integer[]}
joined: Unknown
101..105 error[type-mismatch] the frame `right` has no column `id`. Its columns are `key`

#---- an_asof_join_key_must_exist_on_both_sides
trades <- DataFrame(ticker = c("a", "b"), time = c(5L, 3L))
quotes <- DataFrame(ticker = c("a", "b"), stamp = c(2L, 4L))
joined <- DataFrame.join_asof(trades, quotes, on = "time", by = "ticker")
#++++
trades: DataFrame{ticker: character[], time: integer[]}
quotes: DataFrame{ticker: character[], stamp: integer[]}
joined: Unknown
172..178 error[type-mismatch] the frame `quotes` has no column `time`. Its columns are `ticker`, `stamp`

#---- head_cannot_be_combined_inside_agg
x <- DataFrame(g = c("p", "q", "p"), v = c(3, 9, 7))
bad <- x |> DataFrame.group_by("g") |> GroupBy.agg(col("v") |> Expr.head(2L) + 1)
#++++
x: DataFrame{g: character[], v: double[]}
bad: Unknown
104..133 error[type-mismatch] `Expr.head` gives several values of `v` per group, so `agg` accepts it only as a whole item. Compute the column first, as in `(col("v") + 1) |> Expr.head(2L)`

#---- a_key_missing_from_both_sides_is_reported_once
left <- DataFrame(id = 1:3)
right <- DataFrame(id = 1:3)
joined <- DataFrame.join(left, right, on = "ids")
#++++
left: DataFrame{id: integer[]}
right: DataFrame{id: integer[]}
joined: Unknown
100..105 error[type-mismatch] the frame `left` has no column `ids`. Its columns are `id`

#==== dataframe_expression_types
#---- arithmetic_on_a_string_column_is_reported
sales <- DataFrame(region = c("eu", "us"), units = c(1L, 2L))
wider <- sales |> DataFrame.with_columns(y = col("region") * 2)
negated <- sales |> DataFrame.select(-col("region"))
#++++
sales: DataFrame{region: character[], units: integer[]}
wider: Unknown
negated: Unknown
107..120 error[type-mismatch] `*` needs numbers, but the column `region` is `character[]`
164..177 error[type-mismatch] `-` needs numbers, but the column `region` is `character[]`

#---- a_number_compared_with_a_string_column_is_reported
sales <- DataFrame(region = c("eu", "us"), units = c(1L, 2L))
kept <- sales |> DataFrame.filter(col("region") > 1L)
same <- sales |> DataFrame.filter(col("units") == col("region"))
#++++
sales: DataFrame{region: character[], units: integer[]}
kept: Unknown
same: Unknown
96..114 error[type-mismatch] `>` compares `character[]` with `integer`. An expression compares strings and factors only with strings and factors
150..179 error[type-mismatch] `==` compares `integer[]` with `character[]`. An expression compares strings and factors only with strings and factors

#---- a_numeric_aggregation_of_strings_is_reported
sales <- DataFrame(region = c("eu", "us"), units = c(1L, 2L))
totals <- sales |> DataFrame.group_by("units") |> GroupBy.agg(col("region") |> Expr.sum(), m = col("region") |> Expr.mean())
paired <- sales |> DataFrame.select(col("units") |> Expr.cor(col("region")))
#++++
sales: DataFrame{region: character[], units: integer[]}
totals: Unknown
paired: Unknown
124..137 error[type-mismatch] `Expr.sum` needs numbers, but the column `region` is `character[]`
157..170 error[type-mismatch] `Expr.mean` needs numbers, but the column `region` is `character[]`
248..261 error[type-mismatch] `Expr.cor` needs numbers, but the column `region` is `character[]`

#---- a_string_literal_in_arithmetic_is_reported
sales <- DataFrame(units = c(1L, 2L))
wider <- sales |> DataFrame.with_columns(y = col("units") * "2")
#++++
sales: DataFrame{units: integer[]}
wider: Unknown
98..101 error[type-mismatch] `*` needs numbers, but this operand is `character`

#---- logical_operators_and_if_else_tests_check_their_operands
sales <- DataFrame(region = c("eu", "us"), units = c(1L, 2L))
both <- sales |> DataFrame.filter(col("units") > 1L & col("region"))
labels <- sales |> DataFrame.select(Expr.if_else(col("units"), "big", "small"))
#++++
sales: DataFrame{region: character[], units: integer[]}
both: Unknown
labels: Unknown
116..129 error[type-mismatch] `&` needs logical values or numbers, but the column `region` is `character[]`
180..192 error[type-mismatch] `Expr.if_else` needs a `logical` test, but the column `units` is `integer[]`

#---- a_factor_column_compares_with_labels_but_takes_no_arithmetic
f <- DataFrame(g = factor(c("a", "b")), v = c(1, 2))
picked <- f |> DataFrame.select(col("g") == "a", shifted = col("g") + 1)
#++++
f: DataFrame{g: factor, v: double[]}
picked: Unknown
112..120 error[type-mismatch] `+` needs numbers, but the column `g` is `factor`

#---- well_typed_expressions_are_silent
sales <- DataFrame(region = c("eu", "us"), units = c(1L, 2L), price = c(1.5, 2), ok = c(TRUE, FALSE))
picked <- sales |> DataFrame.select(
  col("region") == "eu",
  big = col("units") > 1L & col("ok"),
  flag = !col("units"),
  bumped = col("units") + TRUE,
  label = Expr.if_else(col("ok"), "yes", "no")
)
totals <- sales |> DataFrame.group_by("region") |> GroupBy.agg(col("ok") |> Expr.sum(), top = col("region") |> Expr.max())
#++++
sales: DataFrame{region: character[], units: integer[], price: double[], ok: logical[]}
picked: DataFrame{region: logical[], big: logical[], flag: logical[], bumped: integer[], label: character[]}
totals: DataFrame{region: character[], ok: integer[], top: character[]}

#---- result_columns_follow_the_expression_types
sales <- DataFrame(region = c("eu", "us"), units = c(1L, 2L), price = c(1.5, 2))
wider <- sales |> DataFrame.with_columns(y = col("units") * 2L, z = col("units") / 2L, big = col("price") > 1)
#++++
sales: DataFrame{region: character[], units: integer[], price: double[]}
wider: DataFrame{region: character[], units: integer[], price: double[], y: integer[], z: double[], big: logical[]}

#---- a_frame_with_unknown_columns_is_silent
doubled <- function(frame) frame |> DataFrame.with_columns(y = col("region") * 2)
#++++
doubled: fn(frame: DataFrame) -> DataFrame
