#---- assigning_lapply_over_subset_data_updates_each_column
sales <- frame(team = c("a", "b"), units = c(1L, 2L), price = c(1.5, 2.5))
labelled <- sales[, c("units", "price") := lapply(.SD, as.character), .SDcols = c("units", "price")]
