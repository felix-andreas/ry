#---- a_global_that_is_no_column_is_silent
prices <- frame(id = 1:3, price = c(1, 2, 3))
scaled <- prices[price > pi]
#++++
prices: frame{id: integer[], price: double[]}
scaled: frame{id: integer[], price: double[]}

#---- a_character_row_index_is_reported
prices <- frame(id = 1:3, price = c(1, 2, 3))
picked <- prices["a"]
#++++
prices: frame{id: integer[], price: double[]}
