#==== frame_update
#---- walrus_adds_a_column_for_later_uses
prices <- frame(id = 1:3, price = c(1, 2, 3))
prices[, doubled := price * 2]
column <- prices$doubled
#++++
prices: frame{id: integer[], price: double[]}
frame{id: integer[], price: double[], doubled: double[]}
column: double[]

#---- walrus_null_removes_a_column
prices <- frame(id = 1:3, price = c(1, 2, 3))
prices[, price := NULL]
remaining <- prices
#++++
prices: frame{id: integer[], price: double[]}
frame{id: integer[]}
remaining: frame{id: integer[]}

#---- walrus_replaces_a_column_type
prices <- frame(id = 1:3, price = c(1, 2, 3))
prices[, id := as.character(id)]
ids <- prices$id
#++++
prices: frame{id: integer[], price: double[]}
frame{id: character[], price: double[]}
ids: character[]

#---- an_alias_keeps_the_old_type
prices <- frame(id = 1:3, price = c(1, 2, 3))
before <- prices
prices[, doubled := price * 2]
missing <- before$doubled
#++++
prices: frame{id: integer[], price: double[]}
before: frame{id: integer[], price: double[]}
frame{id: integer[], price: double[], doubled: double[]}
missing: Unknown
112..119 error[type-mismatch] the frame `before` has no column `doubled`. Its columns are `id`, `price`

#---- walrus_is_the_value_of_the_bracket
prices <- frame(id = 1:3, price = c(1, 2, 3))
extended <- prices[, flag := price > 1]
#++++
prices: frame{id: integer[], price: double[]}
extended: frame{id: integer[], price: double[], flag: logical[]}

#---- walrus_with_a_character_vector_of_names
prices <- frame(id = 1:3, price = c(1, 2, 3))
extended <- prices[, c("tax", "label") := list(price * 0.2, "x")]
#++++
prices: frame{id: integer[], price: double[]}
extended: frame{id: integer[], price: double[], tax: double[], label: character[]}

#---- walrus_in_functional_form
prices <- frame(id = 1:3, price = c(1, 2, 3))
extended <- prices[, `:=`(tax = price * 0.2, price = NULL)]
#++++
prices: frame{id: integer[], price: double[]}
extended: frame{id: integer[], tax: double[]}

#---- a_computed_left_side_widens_silently
prices <- frame(id = 1:3, price = c(1, 2, 3))
columns <- "tax"
prices[, (columns) := 1]
widened <- prices$anything
#++++
prices: frame{id: integer[], price: double[]}
columns: character
frame
widened: Unknown

#---- walrus_updates_a_local_frame
total_tax <- function() {
  prices <- frame(id = 1:3, price = c(1, 2, 3))
  prices[, tax := price * 0.2]
  prices$tax
}
#++++
total_tax: fn() -> double[]

#---- walrus_inside_a_function_binds_a_local_copy
prices <- frame(id = 1:3, price = c(1, 2, 3))
with_tax <- function() {
  prices[, tax := price * 0.2]
  prices$tax
}
unchanged <- prices
#++++
prices: frame{id: integer[], price: double[]}
with_tax: fn() -> double[]
unchanged: frame{id: integer[], price: double[]}

#---- walrus_with_a_misspelled_right_side_is_reported
prices <- frame(id = 1:3, price = c(1, 2, 3))
prices[, tax := pirce * 0.2]
#++++
prices: frame{id: integer[], price: double[]}
frame{id: integer[], price: double[], tax: Unknown}
