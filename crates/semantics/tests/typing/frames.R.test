#++++
prices: frame{id: integer[], price: double[]}
frame{id: integer[], price: double[]}
kept: double[]

#---- a_grouped_walrus_keeps_the_existing_column_type
prices <- frame(id = 1:3, price = c(1, 2, 3))
prices[, id := 2, by = price]
kept <- prices$id
#++++
prices: frame{id: integer[], price: double[]}
frame{id: integer[], price: double[]}
kept: integer[]

