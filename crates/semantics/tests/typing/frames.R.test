#==== frame_subset_data
#---- lapply_over_subset_data_applies_the_function_to_each_column
sales <- frame(team = c("a", "b"), units = c(1L, 2L), price = c(1.5, 2.5))
means <- sales[, lapply(.SD, mean), by = team]
#++++
sales: frame{team: character[], units: integer[], price: double[]}
means: frame{team: character[], units: double[], price: double[]}

#---- an_overloaded_function_keeps_each_column_type
sales <- frame(team = c("a", "b"), units = c(1L, 2L), price = c(1.5, 2.5))
totals <- sales[, lapply(.SD, sum), by = team]
tops <- sales[, lapply(.SD, max, na.rm = TRUE), by = team]
#++++
sales: frame{team: character[], units: integer[], price: double[]}
totals: frame{team: character[], units: integer[], price: double[]}
tops: frame{team: character[], units: integer[], price: double[]}

#---- extra_arguments_reach_the_function
sales <- frame(team = c("a", "b"), price = c(1.25, 2.5))
rounded <- sales[, lapply(.SD, round, digits = 1), .SDcols = "price"]
#++++
sales: frame{team: character[], price: double[]}
rounded: frame{price: double[]}

#---- a_function_that_does_not_fit_a_column_is_reported
