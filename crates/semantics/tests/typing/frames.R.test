#---- an_overloaded_function_keeps_each_column_type
sales <- DataFrame(team = c("a", "b"), units = c(1L, 2L), price = c(1.5, 2.5))
totals <- sales[, lapply(.SD, sum), by = team]
tops <- sales[, lapply(.SD, max, na.rm = TRUE), by = team]
#++++
sales: DataFrame{team: character[], units: integer[], price: double[]}
totals: DataFrame{team: character[], units: integer[], price: double[]}
tops: DataFrame{team: character[], units: integer[], price: double[]}

