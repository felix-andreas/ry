#---- walrus_updates_a_local_frame
total_tax <- function() {
  prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
  prices[, tax := price * 0.2]
  prices$tax
}
#++++
total_tax: fn() -> double[]

#---- walrus_updates_a_parameter
#: fn(prices: DataFrame{id: integer[], price: double[]}) -> double[]
total_tax <- function(prices) {
  prices[, tax := price * 0.2]
  prices$tax
}
#++++
total_tax: fn(prices: DataFrame{id: integer[], price: double[]}) -> double[]

#---- walrus_on_an_enclosing_frame_updates_it_without_a_local_binding
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
with_tax <- function() {
  prices[, tax := price * 0.2]
  prices
}
unchanged <- prices
#++++
prices: DataFrame{id: integer[], price: double[]}
with_tax: fn() -> DataFrame{id: integer[], price: double[], tax: double[]}
unchanged: DataFrame{id: integer[], price: double[]}

