#==== frame_chains
#---- queries_compose_left_to_right
sales <- frame(team = c("a", "b"), amount = c(1, 2))
top <- sales[amount > 0][, .(total = sum(amount)), by = team][order(-total)]
#++++
sales: frame{team: character[], amount: double[]}
top: frame{team: character[], total: double[]}

#---- a_chain_sees_columns_added_earlier_in_it
