#---- list_spells_the_same_j
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
summary <- prices[, list(total = sum(price))]
#++++
prices: DataFrame{id: integer[], price: double[]}
summary: DataFrame{total: double[]}

#---- an_unnamed_column_keeps_its_name_and_others_are_numbered
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
shaped <- prices[, .(id, price * 2)]
#++++
prices: DataFrame{id: integer[], price: double[]}
shaped: DataFrame{id: integer[], V2: double[]}

#---- a_bare_column_j_is_the_column_vector
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
column <- prices[, price]
#++++
prices: DataFrame{id: integer[], price: double[]}
column: double[]

#---- a_computed_j_without_by_is_its_value
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
total <- prices[, sum(price)]
#++++
prices: DataFrame{id: integer[], price: double[]}
total: double

#---- a_misspelled_column_in_j_is_reported
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
total <- prices[, .(total = sum(pirce))]
#++++
prices: DataFrame{id: integer[], price: double[]}
total: DataFrame{total: Unknown}
