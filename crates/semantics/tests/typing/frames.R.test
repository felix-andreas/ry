#---- a_closure_parameter_in_j_stays_lexical
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
scaled <- prices[, .(scaled = vapply(price, function(value) value * 2, numeric(1)))]
#++++
prices: DataFrame{id: integer[], price: double[]}
scaled: DataFrame{scaled: double[]}

#---- a_dot_dot_name_reads_the_enclosing_variable
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
columns <- "price"
rate <- 2
picked <- prices[, ..columns]
scaled <- prices[, .(scaled = price * ..rate)]
#++++
prices: DataFrame{id: integer[], price: double[]}
columns: character
rate: double
picked: DataFrame
scaled: DataFrame{scaled: double[]}

#==== frame_specials
#---- ngrp_is_an_integer
sales <- DataFrame(team = c("a", "b"), amount = c(1, 2))
counted <- sales[, .(groups = .NGRP, n = .N, group = .GRP), by = team]
#++++
sales: DataFrame{team: character[], amount: double[]}
counted: DataFrame{team: character[], groups: integer[], n: integer[], group: integer[]}

#==== frame_by
#---- a_bare_name_groups_first
sales <- DataFrame(team = c("a", "b"), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), by = team]
#++++
sales: DataFrame{team: character[], amount: double[]}
per_team: DataFrame{team: character[], total: double[]}

#---- a_dot_list_of_groups
sales <- DataFrame(team = c("a", "b"), year = c(2020L, 2021L), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), by = .(team, year)]
#++++
sales: DataFrame{team: character[], year: integer[], amount: double[]}
per_team: DataFrame{team: character[], year: integer[], total: double[]}

#---- a_character_vector_of_groups
sales <- DataFrame(team = c("a", "b"), year = c(2020L, 2021L), amount = c(1, 2))
per_team <- sales[, .(total = sum(amount)), by = c("team", "year")]
#++++
