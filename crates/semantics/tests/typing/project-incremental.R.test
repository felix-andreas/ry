#==== incremental_edits
#---- interface_change_creates_dependent_error
#~~~~ R/a.R
#: fn(count: integer) -> integer
double_count <- function(count) count + count
#~~~~ R/b.R
result <- double_count(2L)
#++++
== R/a.R
double_count: fn(count: integer) -> integer
== R/b.R
result: integer

#---- interface_change_creates_dependent_error_then_v1
#~~~~ R/a.R
#: fn(count: character) -> integer
count_letters <- function(count) 1L
double_count <- count_letters
#~~~~ R/b.R
result <- double_count(2L)
#++++
== R/a.R
count_letters: fn(count: character) -> integer
double_count: fn(count: character) -> integer
== R/b.R
result: Unknown
23..25 error[type-mismatch] expected `character`, found `integer`

#---- body_edit_keeps_dependents_clean_then_v1
#~~~~ R/a.R
#: fn(count: integer) -> integer
double_count <- function(count) {
  count + count
}
#~~~~ R/b.R
result <- double_count(2L)
#++++
== R/a.R
double_count: fn(count: integer) -> integer
== R/b.R
result: integer

#---- edit_fixes_dependent_error
