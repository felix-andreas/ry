#==== errors
#---- call_too_many_positional
mirror <- function(x) x
mirror(1L, 2L, 3L)
#++++
mirror: <T> fn(x: T) -> T
integer
35..37 error[type-mismatch] this call passes 3 positional arguments, but the function only takes 1

#---- call_too_few_required
#: fn(a: integer, b: integer) -> integer
add <- function(a, b) a + b
add(1L)
#++++
add: fn(a: integer, b: integer) -> integer
integer
69..72 error[type-mismatch] this call supplies 1 argument, but the function requires 2 — a required argument is missing

#---- call_named_arg_not_in_interface
