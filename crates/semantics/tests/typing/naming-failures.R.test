#==== type_conflicts
#---- duplicate_type_names_across_several_files_mark_every_conflicting_declaration
#~~~~ R/a.R
#: @type Person {integer}
#~~~~ R/b.R
#: @type Person {double}
#~~~~ R/c.R
#: @alias Person {character}
#++++
== R/a.R
3..25 error[annotation] the type name `Person` is declared more than once — `@type` and `@alias` declarations share one project-global namespace.
== R/b.R
3..24 error[annotation] the type name `Person` is declared more than once — `@type` and `@alias` declarations share one project-global namespace.
== R/c.R
3..28 error[annotation] the type name `Person` is declared more than once — `@type` and `@alias` declarations share one project-global namespace.

#==== mixed_package_failures
#---- later_package_winner_does_not_beat_local_shadow
#~~~~ R/a.R
x <- 1L
#~~~~ R/b.R
x <- 2L
#~~~~ R/c.R
f <- function() {
  x <- 3L
  x
}
#++++
== R/a.R
x: integer
0..1 warning[duplicate] Top-level binding `x` is overwritten by a later top-level binding in this package.
== R/b.R
x: integer
0..1 warning[duplicate] Top-level binding `x` overwrites an earlier top-level binding in this package.
== R/c.R
f: fn() -> integer

