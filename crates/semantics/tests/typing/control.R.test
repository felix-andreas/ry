0..1 warning[duplicate] Top-level binding `p` is overwritten by a later top-level binding in this package.
12..13 warning[duplicate] Top-level binding `p` overwrites an earlier top-level binding in this package.
17..18 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- self_referential_first_writer_stays_tolerated
x <- x + 1
#++++
x: Unknown

#---- accumulator_seeded_by_an_earlier_item
total <- 0L
for (i in 1:3) total <- total + i
report <- function() total
#++++
total: integer
report: fn() -> integer

#---- shadowed_outer_binding_is_dead_despite_the_capture
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    h <- function() x
    h
  }
  g
}
#++++
f: fn() -> fn() -> fn() -> logical
20..21 warning[unused] `x` is assigned but never used.

#---- rebinding_in_the_captured_frame_stays_alive
f <- function() {
  x <- 1L
  g <- function() x
  x <- 2L
  g
}
#++++
f: fn() -> fn() -> integer

#==== missing_formals
#---- reading_a_missing_formal_is_an_error
describe <- function(name, punct) {
  if (missing(punct)) {
    return(nchar(punct))
  }
  paste0(name, punct)
}
#++++
describe: Unknown
77..82 error[type-mismatch] reading `punct` here would fail at run time: this branch runs only when `punct` is missing, and it has no default.

#---- supplying_the_formal_on_the_missing_branch_is_fine
describe <- function(name, punct) {
  if (missing(punct)) {
    punct <- "."
  }
  paste0(name, punct)
}
#++++
describe: <T> fn(name: T, [punct]: character) -> character

#---- the_else_branch_reads_the_supplied_formal
describe <- function(name, punct) {
  if (missing(punct)) {
    return(name)
  }
  paste0(name, punct)
}
#++++
describe: <T, U> fn(name: T, [punct]: U) -> T | character
