#==== branch_unions
#---- a_concrete_branch_does_not_pin_an_unannotated_parameter
f <- function(flag, x) if (flag) x else "s"
a <- f(TRUE, 1)
b <- f(TRUE, "text")
#++++
f: <T> fn(flag: logical, x: T) -> T | character
a: double | character
b: character

#---- a_guard_branch_reading_the_guarded_parameter_does_not_pin_it
fmt <- function(x) if (is.character(x)) x else "other"
a <- fmt(1)
b <- fmt("text")
#++++
fmt: <T> fn(x: T) -> T | character
a: double | character
b: character

#---- two_open_branches_still_tie_to_each_other
coalesce <- function(value, fallback) if (is.null(value)) fallback else value
#++++
coalesce: <T> fn(value: T | NULL, fallback: T) -> T

#---- a_constrained_branch_may_unify_so_recursion_converges
fact <- function(n) if (n <= 1L) 1L else n * fact(n - 1L)
#++++
fact: fn(n: integer) -> integer

#==== joins
#---- if_unifies_or_unions
same <- function(flag) if (flag) 1L else 2L
mixed <- function(flag) if (flag) 1L else "foo"
nullable <- function(flag) if (flag) 1L else NULL
#++++
same: fn(flag: logical) -> integer
mixed: fn(flag: logical) -> integer | character
nullable: fn(flag: logical) -> integer | NULL

#---- if_without_else_is_nullable
f <- function(flag) if (flag) 1L
#++++
f: fn(flag: logical) -> integer | NULL

#---- a_numeric_condition_coerces
# R coerces a numeric condition — zero is false, anything else true — so the
# `if (length(x))` idiom is ordinary R rather than a mistake.
f <- function() if (1L) 2L
g <- function(x) if (length(x)) 1L else 2L
h <- function() {
  n <- 3L
  while (n) n <- n - 1L
  n
}
#++++
f: fn() -> integer | NULL
g: <T> fn(x: T) -> integer
h: fn() -> integer

#---- a_character_condition_is_refused
# Every string but the spellings of TRUE and FALSE raises at run time in R.
f <- function() if ("yes") 2L
#++++
f: Unknown
96..101 error[type-mismatch] expected `logical`, found `character`

#---- condition_blame_drills_through_parens
f <- function() if (("yes")) 2L
#++++
f: Unknown
21..26 error[type-mismatch] expected `logical`, found `character`

#---- condition_blame_excludes_trailing_trivia
f <- function(n) if (n %% 2L ) 2L
#++++
f: Unknown
21..28 error[type-mismatch] expected a numeric value (`integer` or `double`), found `logical`

#---- a_conditionally_reassigned_function_unions_both_signatures
# Both paths write a function, so the slot cannot stay polymorphic: its type is
# the union of the two signatures. Taking either side alone would claim a
# contract the other path does not satisfy.
pick <- function(shout) {
  fmt <- function(x) x
  if (shout) fmt <- function(x) paste0(x, "!")
  fmt
}
#++++
pick: <T, U> fn(shout: logical) -> (fn(x: T) -> T) | (fn(x: U) -> character)

#---- a_function_conditionally_replaced_by_a_non_function_unions_too
reverse <- function(flag) {
  f <- function(x) x
  if (flag) f <- 42L
  f
}
#++++
reverse: <T> fn(flag: logical) -> (fn(x: T) -> T) | integer

#---- calling_a_conditionally_reassigned_function_unions_the_returns
pick <- function(shout) {
  fmt <- function(x) x
  if (shout) fmt <- function(x) paste0(x, "!")
  fmt
}
apply_it <- function(shout) pick(shout)(1L)
#++++
pick: <T, U> fn(shout: logical) -> (fn(x: T) -> T) | (fn(x: U) -> character)
apply_it: fn(shout: logical) -> integer | character

#---- a_union_of_signatures_is_not_a_character
# The soundness half: the value may be the identity, so a character-expecting
# call must be refused. This was accepted while the slot claimed only the
# second branch's signature.
#: fn(s: character) -> character
want_chr <- function(s) s

pick <- function(shout) {
  fmt <- function(x) x
  if (shout) fmt <- function(x) paste0(x, "!")
  fmt
}
unsound <- function() want_chr(pick(FALSE)(1L))
#++++
want_chr: fn(s: character) -> character
pick: <T, U> fn(shout: logical) -> (fn(x: T) -> T) | (fn(x: U) -> character)
unsound: Unknown
376..391 error[type-mismatch] expected `character`, found `integer | character`

#---- an_unconditional_function_binding_stays_polymorphic
# The contrast: one reaching write keeps let-polymorphism.
plain <- function() {
  fmt <- function(x) x
  fmt
}
#++++
plain: <T> fn() -> fn(x: T) -> T

#---- a_function_member_of_a_union_renders_with_its_grouping_parentheses
# `->` extends over a whole union, so these are two different types and used to
# render as the same string — copying one out of a finding and back into an
# annotation silently changed it. Both annotations here are the rendered form,
# pasted back, so the case fails if either stops round-tripping.
#: (fn(integer) -> character) | NULL
nullable_callback <- NULL

#: fn(x: integer) -> character | NULL
returns_nullable <- function(x) NULL
#++++
nullable_callback: (fn(integer) -> character) | NULL
returns_nullable: fn(x: integer) -> character | NULL

#==== returns
#---- early_return_unions
f <- function(c) {
  if (c) return("foo")
  5
}
#++++
f: fn(c: logical) -> character | double

#---- diverging_branch_drops_value_and_state
f <- function(c) {
  x <- if (c) return(NULL) else 5
  x + 1
}
#++++
f: fn(c: logical) -> double | NULL

#==== guards
#---- early_exit_narrows
#: fn(x: integer | NULL) -> integer
f <- function(x) {
  if (is.null(x)) {
    return(0L)
  }
  x + 1L
}
#++++
f: fn(x: integer | NULL) -> integer

#---- coalesce_idiom_shapes
coalesce <- function(value, fallback) if (is.null(value)) fallback else value
#++++
coalesce: <T> fn(value: T | NULL, fallback: T) -> T

#---- family_guard_filters
f <- function(flag) {
  y <- if (flag) 1L else "a"
  if (is.character(y)) y else "z"
}
#++++
f: fn(flag: logical) -> character

#---- negated_guard_swaps_edges
f <- function(flag) {
  x <- if (flag) 1L else NULL
  if (!is.null(x)) x + 1L else 0L
}
#++++
f: fn(flag: logical) -> integer

#---- numeric_guard_covers_both_atoms
f <- function(flag) {
  x <- if (flag) 1L else "s"
  if (is.numeric(x)) x + 1L else 0L
}
#++++
f: fn(flag: logical) -> integer

#---- family_guard_keeps_scalar_and_vector_members
f <- function(flag) {
  x <- if (flag) "s" else c("a", "b")
  if (is.character(x)) x else "z"
}
#++++
f: fn(flag: logical) -> character | character[]

#---- function_guard_filters
f <- function(flag) {
  x <- if (flag) function() 1L else 2L
  if (is.function(x)) x() else x
}
#++++
f: fn(flag: logical) -> integer

#---- guard_without_a_null_member_does_not_fire
f <- function(flag) {
  x <- if (flag) 1L else 2L
  if (is.null(x)) x else x + 1L
}
#++++
f: fn(flag: logical) -> integer

#---- field_access_guards_do_not_narrow
f <- function(record) {
  if (is.null(record$value)) 0L else record$value
}
#++++
f: <T> fn(record: T) -> integer

#---- null_test_makes_unguarded_use_a_finding
f <- function(x) {
  if (is.null(x)) {
    print("missing")
  }
  x + 1L
}
#++++
f: Unknown
66..67 error[type-mismatch] expected a numeric value (`integer` or `double`), found `T | NULL`

#==== loops
#---- accumulator_is_stable
f <- function() {
  total <- 0L
  for (i in 1:3) {
    total <- total + i
  }
  total
}
#++++
f: fn() -> integer

#---- heterogeneous_iteration
f <- function() {
  out <- 1L
  for (item in list(2L, "a")) {
    out <- item
  }
  out
}
#++++
f: fn() -> integer | character

#---- function_is_not_iterable
f <- function() {
  g <- function() 1L
  for (i in g) i
}
#++++
f: Unknown
51..52 error[type-mismatch] this `for` sequence is `fn() -> integer`, which cannot be iterated. Expected a vector or list.

#---- repeat_applies_exit_state
f <- function() {
  repeat {
    x <- 1L
    break
  }
  x + 1L
}
#++++
f: fn() -> integer

#==== switch
#---- branches_union_with_null
f <- function(x) switch(x, a = 1L, b = "s")
#++++
f: <T> fn(x: T) -> integer | character | NULL

#---- default_removes_null
f <- function(x) switch(x, a = 1L, 2L)
#++++
f: <T> fn(x: T) -> integer

#---- branch_writes_join_instead_of_overwriting
# Exactly one alternative runs, so a write in each branch forks and joins the
# way an `if`'s arms do. Inferring the branches in sequence let the last one
# win outright, and this typed `character` — the `if` spelling of the same
# thing is directly below, and the two must agree.
f <- function(k) {
  switch(k, a = { r <- 1L }, { r <- "d" })
  r
}
#++++
f: <T> fn(k: T) -> character | integer

#---- the_if_spelling_of_the_same_branches_agrees
f <- function(k) {
  if (k == "a") { r <- 1L } else { r <- "d" }
  r
}
#++++
f: <T> fn(k: T) -> character | integer

#---- every_branch_joins_not_just_the_last_two
f <- function(k) {
  switch(k, a = { r <- 1L }, b = { r <- TRUE }, { r <- "d" })
  r
}
#++++
f: <T> fn(k: T) -> character | integer | logical

#---- a_branch_that_cannot_fall_through_contributes_no_state
# `stop()` ends the call, so the default never reaches the read and `r` keeps
# the one branch's type — the same rule a diverging `if` arm follows.
f <- function(k) {
  switch(k, a = { r <- 1L }, { stop("no") })
  r
}
#++++
f: <T> fn(k: T) -> integer

#==== maybe_undefined
#---- a_conditional_introduction_is_reported_at_the_read
# R: `object 'x' not found` when `flag` is FALSE. The read still resolves to
# the slot — this is not an unresolved name — but one path reaches it with
# nothing written.
f <- function(flag) {
  if (flag) {
    x <- 1L
  }
  x
}
#++++
f: fn(flag: logical) -> integer
229..230 warning[maybe-undefined] `x` is only assigned on some paths here, so this read can find nothing.

#---- a_switch_with_no_default_reaches_the_read_unassigned
f <- function(key) {
  switch(key, a = { r <- 1L })
  r
}
#++++
f: <T> fn(key: T) -> integer
54..55 warning[maybe-undefined] `r` is only assigned on some paths here, so this read can find nothing.

#---- a_repeat_that_always_assigns_before_breaking_is_not_reported
# R returns 1: the body runs at least once and the `break` follows the write,
# so the read cannot be reached with the name unset. Joining the loop *head*
# into the exit state instead reported this, which is why the exit state is
# built from the `break` points.
f <- function() {
  repeat {
    x <- 1L
    break
  }
  x
}
#++++
f: fn() -> integer

#---- a_break_before_the_write_does_reach_the_read_unassigned
# The precision cuts both ways: R errors here when `cond` is TRUE.
f <- function(cond) {
  repeat {
    if (cond) break
    y <- 1L
    break
  }
  y
}
#++++
f: fn(cond: logical) -> integer
148..149 warning[maybe-undefined] `y` is only assigned on some paths here, so this read can find nothing.

#---- a_loop_that_may_run_zero_times_reaches_the_read_unassigned
f <- function(cond) {
  while (cond) {
    z <- 1L
  }
  z
}
#++++
f: fn(cond: logical) -> integer
57..58 warning[maybe-undefined] `z` is only assigned on some paths here, so this read can find nothing.

#---- a_diverging_switch_branch_never_reaches_the_read
# Every key either assigns or ends the call, so nothing arrives at the read
# with `r` unset.
f <- function(k) {
  switch(k, a = { r <- 1L }, { stop("no") })
  r
}
#++++
f: <T> fn(k: T) -> integer

#---- a_top_level_unwritten_path_is_not_reported
# A top-level variable's unwritten path reaches the enclosing environment at
# run time, where the name's cross-item binding answers it, so the read is not
# a finding.
flag <- TRUE
if (flag) {
  value <- 1L
}
after <- value
#++++
flag: logical
after: integer

#==== scoping
#---- local_scopes_its_bindings
f <- function() {
  n <- local({
    y <- 1L
    y + 1L
  })
  n
}
#++++
f: fn() -> integer

#---- super_assignment_survives_the_closure
counter <- function() {
  n <- 0L
  bump <- function() {
    n <<- n + 1L
    n
  }
  bump()
  n
}
#++++
counter: fn() -> integer

#---- super_assignment_joins_as_a_union
f <- function() {
  x <- 1L
  set <- function() {
    x <<- "s"
  }
  set()
  x
}
#++++
f: fn() -> integer | character

#---- super_assignment_from_local_joins_like_the_closure_spelling
# `local()` opens a scope that is not a function, so bounding the `<<-` search
# at the nearest function boundary skipped this function's own frame and lost
# the write entirely — the type came out `integer` while R returns "two". The
# two spellings of the same thing must agree.
f <- function() {
  v <- 1L
  local({
    v <<- "two"
  })
  v
}
#++++
f: fn() -> integer | character

#---- a_super_assignment_caught_by_an_intervening_local_leaves_the_frame_alone
# R returns 1 here: the inner block's own `b` takes the write, so the
# function's `b` keeps its integer and never sees the character.
f <- function() {
  b <- 1L
  local({
    b <- 99L
    local({
      b <<- "inner"
    })
  })
  b
}
#++++
f: fn() -> integer

#---- trailing_semicolon_yields_null
f <- function() {
  1L;
}
#++++
f: fn() -> NULL

#---- forward_capture_resolves_after_repass
f <- function() {
  helper <- function() other()
  other <- function() 1L
  helper()
}
#++++
f: fn() -> integer

#---- local_mutual_recursion_is_tolerant
f <- function(n) {
  even <- function(k) if (k == 0L) TRUE else odd(k - 1L)
  odd <- function(k) if (k == 0L) FALSE else even(k - 1L)
  even(n)
}
#++++
f: <T: numeric> fn(n: T) -> logical

#---- forward_capture_sees_the_frame_write
f <- function() {
  shout <- function() toupper(word)
  word <- 1L
  shout()
}
#++++
f: fn() -> character

#---- unresolved_reference_suggests_the_nearest_stub
f <- function(x) lenght(x)
#++++
f: <T> fn(x: T) -> Unknown
17..23 warning[unresolved] I could not resolve `lenght` in this package, its imports, or builtins. Did you mean `length`?

#---- conditional_top_level_slot_resolves_a_later_read_in_this_file
for (i in 1:3) total <- i
report <- function() total
#++++
report: fn() -> integer

#---- a_few_conditional_writers_still_join
# Under the join cap the slot's type is the union of every writer, which is what
# makes a conditional default useful to a reader.
if (Sys.getenv("MODE") == "fast") mode <- 1L
if (Sys.getenv("MODE") == "named") mode <- "fast"
report <- function() mode
#++++
report: fn() -> integer | character

#---- many_conditional_writers_widen_to_unknown
# The join costs one item check per writer and is reached from a per-item read,
# so a name written at many top levels made every read of it pay for all of
# them: one real package's test suite drove this to 7.1 s of a 7.8 s run. Past
# the cap the slot is `Unknown` — a union of dozens of unrelated types is not a
# fact a diagnostic can use anyway.
flag <- TRUE
if (flag) shared <- 1L
if (flag) shared <- 2L
if (flag) shared <- 3L
if (flag) shared <- 4L
if (flag) shared <- 5L
if (flag) shared <- 6L
if (flag) shared <- 7L
if (flag) shared <- 8L
if (flag) shared <- 9L
report <- function() shared
#++++
flag: logical
report: fn() -> Unknown

#---- loop_carried_read_starts_from_the_outer_binding
p <- "word"
while (TRUE) p <- p - 1L
#++++
p: character
30..31 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- loop_carried_read_continues_the_outer_type
n <- 10L
while (n > 0L) n <- n - 1L
after <- function() n
#++++
n: integer
after: fn() -> integer

