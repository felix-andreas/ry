#---- tags_widen_through_walk_states_loops_and_branches
first_some <- function(xs: List<I64>) List.walk(xs, :None, \(acc, x) :Some(x))
keep_big <- function(xs: List<I64>) List.walk(xs, :None, \(acc, x) if (x > 3i64) :Some(x) else acc)
grow <- function(xs: List<I64>) List.walk(xs, [:A], \(acc, x) List.append(acc, :B))
best <- function(xs: List<I64>) {
  List.walk(xs, (best = :None, n = 0i64), \(acc, x) (best = :Some(x), n = acc$n + 1i64))
}
cycle <- function(xs: List<I64>) {
  List.walk(xs, :A, \(acc, x) match (acc) { :A => :B; :B => :C; :C => :A })
}
loop_grow <- function(xs: List<I64>) {
  acc <- [:A]
  for (x in xs) acc <- List.append(acc, :B)
  acc
}
branch <- function(c: Bool) if (c) [:A] else [:B]
record_branch <- function(c: Bool) if (c) (t = :A, n = 1i64) else (t = :B, n = 2i64)
tuple_branch <- function(c: Bool) if (c) (:A, 1i64) else (:B, 2i64)
payload_branch <- function(c: Bool) if (c) :Some([:A]) else :Some([:B])
numbers_never_widen <- function(c: Bool) if (c) [1i64] else [1.5f64]
stop_at <- function(xs: List<I64>) {
  List.walk_until(xs, :None, \(acc, x) if (x > 2i64) :Break(:Some(x)) else :Continue(acc))
}
front <- function(xs: List<:A>) List.prepend(xs, :B)
replace_first <- function(xs: List<:A>) List.set(xs, 1i64, :B)
latest <- function(xs: List<I64>) {
  List.walk(xs, :None, \(acc, x) {
    seen <- acc
    :Some(x)
  })
}
#++++
first_some: fn(xs: List<I64>) -> :None | :Some(I64)
keep_big: fn(xs: List<I64>) -> :None | :Some(I64)
grow: fn(xs: List<I64>) -> List<:A | :B>
best: fn(xs: List<I64>) -> Record{best: :None | :Some(I64), n: I64}
cycle: fn(xs: List<I64>) -> :A | :B | :C
loop_grow: fn(xs: List<I64>) -> List<:A | :B>
branch: fn(c: Bool) -> List<:A | :B>
record_branch: fn(c: Bool) -> Record{n: I64, t: :A | :B}
tuple_branch: fn(c: Bool) -> Tuple{:A | :B, I64}
payload_branch: fn(c: Bool) -> :Some(List<:A | :B>)
numbers_never_widen: fn(c: Bool) -> List<I64> | List<F64>
stop_at: fn(xs: List<I64>) -> :None | :Some(I64)
front: fn(xs: List<:A>) -> List<:A | :B>
replace_first: fn(xs: List<:A>) -> List<:A | :B>
latest: fn(xs: List<I64>) -> :None | :Some(I64)
1271..1275 warning[unused] `seen` is assigned but never used

#---- an_empty_list_grows_into_a_list_of_a_nominal_type
type Tree = :Leaf(I64) | :Node(List<Tree>)
grow <- function(leaf: Tree) -> Tree {
  children <- []
  children <- List.append(children, leaf)
  @Tree(:Node(children))
}
#++++
grow: fn(leaf: Tree) -> Tree

#---- a_tuple_literal_is_decided_by_a_later_use
replace_all <- function(text: Str) -> Str {
  pairs <- [("B", "(c|g|t)"), ("D", "(a|g|t)")]
  for (pair in pairs) text <- Str.replace_each(text, pair[[1]], pair[[2]])
  text
}
point <- (x = 1, y = 2.5)
#++++
replace_all: fn(text: Str) -> Str
point: Record{x: I64, y: F64}

