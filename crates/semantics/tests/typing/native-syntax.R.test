#==== number_suffixes
#---- a_suffix_names_the_exact_type
a <- 5i64
b <- 0xFFi64
c <- 1.5f64
#++++
a: I64
b: I64
c: F64

#---- a_suffixed_number_must_fit_its_type
a <- 9223372036854775808i64
b <- 1.5i64
#++++
a: Unknown
b: Unknown
5..27 error[type-mismatch] this literal does not fit `I64`, which cannot hold its value exactly
33..39 error[type-mismatch] this literal does not fit `I64`, which cannot hold its value exactly

#---- suffixed_numbers_do_not_mix
x <- 1i64 + 1.5f64
#++++
x: Unknown
5..18 error[type-mismatch] `+` is not defined between `I64` and `F64`. Number types are never converted into each other: convert one side, as in `Num.to_i64(x)`

#---- a_suffixed_number_decides_an_unsuffixed_one
x <- 1i64 + 2
#++++
x: I64

#==== format_strings
#---- a_format_string_is_a_str
name <- "Ada"
greeting <- f"hello {name}, you are {36} years old"
#++++
name: character
greeting: Str

#---- interpolations_are_checked
greeting <- f"hello {undefined_name}"
#++++
greeting: Str
21..35 warning[unresolved] I could not resolve `undefined_name` in this package, its imports, or builtins.

#==== try
#---- try_unwraps_the_ok_value_and_returns_the_error
parse_both <- function(a: Str, b: Str) {
  x <- try Str.to_i64(a)
  y <- try Str.to_i64(b)
  :Ok(x + y)
}
#++++
parse_both: fn(a: Str, b: Str) -> :Err(:InvalidNumStr) | :Ok(I64)

#---- try_joins_errors_of_different_steps
#: fn(text: Str) -> :Ok(I64) | :Err(:Negative)
positive <- function(text) {
  n <- Str.to_i64(text)
  match (n) {
    :Ok(value) => if (value < 0) :Err(:Negative) else :Ok(value),
    :Err(_) => :Ok(0)
  }
}
both <- function(text: Str) {
  n <- try Str.to_i64(text)
  p <- try positive(text)
  :Ok(n + p)
}
#++++
positive: fn(text: Str) -> :Ok(I64) | :Err(:Negative)
both: fn(text: Str) -> :Err(:InvalidNumStr | :Negative) | :Ok(I64)

#---- try_needs_a_result
f <- function(x: I64) try x
#++++
f: fn(x: I64) -> Unknown
26..27 error[type-mismatch] `try` needs a result such as `:Ok(value) | :Err(error)`, but this is `I64`

#---- try_outside_a_function
n <- try Str.to_i64("1")
#++++
n: Unknown
5..24 error[type-mismatch] `try` returns an `:Err` early from the function around it, but this one is not inside a function. Use `match` to handle the error here

#==== record_update
#---- an_update_keeps_the_record_type
p <- (x = 1.5, y = 2.5)
q <- (..p, y = 3.5)
#++++
p: Record{x: double, y: double}
q: Record{x: double, y: double}

#---- an_update_cannot_add_a_field
p <- (x = 1, y = 2)
q <- (..p, z = 3)
#++++
p: Record{x: double, y: double}
q: Unknown
31..32 error[type-mismatch] field `z` does not exist in `Record{x: double, y: double}`

#---- an_update_keeps_each_field_type
p <- (name = "Ada", age = 36)
q <- (..p, age = "old")
#++++
p: Record{age: double, name: character}
q: Unknown
47..52 error[type-mismatch] expected `double`, found `character`

#---- only_a_record_updates
n <- 1L
q <- (..n, x = 2)
#++++
n: I64
q: Unknown
16..17 error[type-mismatch] only a record can be updated with `..`, but this is `I64`

#==== list_patterns
#---- list_items_bind_the_item_type
describe <- function(xs: List<Str>) {
  match (xs) {
    [] => "empty",
    [only] => only,
    [first, ..rest] => Str.concat(first, Num.to_str(List.len(rest)))
  }
}
#++++
describe: fn(xs: List<Str>) -> Str

#---- a_list_pattern_on_a_record_never_matches
f <- function(p: Record{x: I64}) match (p) { [a] => a, _ => 0 }
#++++
f: fn(p: Record{x: I64}) -> Unknown
45..48 error[type-mismatch] this pattern can never match: the value is `Record{x: I64}`

#==== as_patterns
#---- as_binds_the_whole_value
area <- function(shape: :Circle(F64) | :Square(F64)) {
  match (shape) {
    :Circle(r) as whole => whole,
    other => other
  }
}
#++++
area: fn(shape: :Circle(F64) | :Square(F64)) -> :Circle(F64) | :Square(F64)

#==== native_list_operators
#---- a_list_beside_a_scalar_applies_the_operator_to_each_item
times <- [3i64, 1i64, 2i64]
after <- times >= 2i64
shifted <- times + 1
#++++
times: List<I64>
after: List<Bool>
shifted: List<I64>

#---- a_list_and_a_scalar_of_another_number_type_do_not_mix
xs <- [1.5, 2]
ys <- xs * 2i64
#++++
xs: List<F64>
ys: Unknown
21..30 error[type-mismatch] `*` is not defined between `List<F64>` and `I64`. Both sides must have one item type, and number types are never converted into each other

#==== declared_result_literals
#---- match_arm_literals_take_the_declared_result_type
rate <- function(region: :North | :South) -> F64 {
  match (region) {
    :North => 0.2
    :South => 0.1
  }
}
#++++
rate: fn(region: :North | :South) -> F64

#---- a_returned_literal_takes_the_declared_result_type
pick <- function(b: Bool) -> I64 {
  if (b) return(4)
  5
}
#++++
pick: fn(b: Bool) -> I64

#==== literal_uses
#---- logical_operators_on_bools_give_a_bool
both <- (1.5f64 > 1) && (2i64 < 3)
either <- TRUE || (1i64 == 2)
#++++
both: Bool
either: Bool

#---- arithmetic_on_literals_adapts_as_one_literal
circumference <- function(r: F64) -> F64 2 * 3.14159 * r
scaled <- function(n: I64) -> I64 n * (2 + 3)
#++++
circumference: fn(r: F64) -> F64
scaled: fn(n: I64) -> I64

#---- a_call_decides_a_literal_variable
half <- function(x: F64) -> F64 x / 2
f <- function() {
  rate <- 2.0
  half(rate)
}
#++++
half: fn(x: F64) -> F64
f: fn() -> F64

#---- an_annotated_binding_decides_a_string_or_logical_variable
f <- function() -> Str {
  greeting <- "hi"
  message: Str <- greeting
  message
}
g <- function() -> Bool {
  flag <- TRUE
  checked: Bool <- flag
  checked
}
#++++
f: fn() -> Str
g: fn() -> Bool

#---- a_plain_read_keeps_r_types
f <- function() {
  name <- "ry"
  paste(name, "!")
}
#++++
f: fn() -> character

#==== top_level_ry_values
#---- a_top_level_literal_in_a_ry_file_is_a_ry_value
rate <- 2.0
count <- 3
name <- "ry"
flag <- TRUE
small <- 5L
step <- 1 / 4
area <- 2 * 3
half <- function(x: F64) -> F64 x / 2
halved <- half(rate)
#++++
rate: F64
count: I64
name: Str
flag: Bool
small: I64
step: F64
area: I64
half: fn(x: F64) -> F64
halved: F64

#---- a_top_level_literal_in_a_plain_r_file_keeps_r_types
rate <- 2.0
count <- 3
name <- "ry"
flag <- TRUE
#++++
rate: double
count: double
name: character
flag: logical

#---- a_strict_file_makes_top_level_literals_ry_values
# typing: strict
count <- 3
#++++
count: I64

#---- an_i64_passed_to_an_r_function_names_num_to_r
n <- 4
inc <- function(x: I64) -> I64 x + 1
root <- sqrt(n)
#++++
n: I64
inc: fn(x: I64) -> I64
root: Unknown
57..58 error[type-mismatch] `sqrt` is an R function, and this value is a ry `I64`, not an R object. Convert it with `Num.to_r()` first

#---- a_list_of_i64_passed_to_an_r_function_names_list_to_r
counts <- [1, 2, 3]
total <- sum(counts)
#++++
counts: List<I64>
total: Unknown
33..39 error[type-mismatch] `sum` is an R function, and this value is a ry `List`, not an R object. Convert it with `List.to_r()` first

#---- shared_representation_values_pass_to_r_code
prices <- [1.5, 2.5]
average <- mean(prices)
rate <- 2.0
root <- sqrt(rate)
size <- nchar("ry")
#++++
prices: List<F64>
average: double
rate: F64
root: double
size: integer

#---- a_converted_i64_passes_to_r_code
n <- 4
inc <- function(x: I64) -> I64 x + 1
root <- sqrt(Num.to_r(n))
#++++
n: I64
inc: fn(x: I64) -> I64
root: double

#---- a_plain_r_file_passes_its_literals_to_r_code
n <- 4
root <- sqrt(n)
#++++
n: double
root: double

#---- literal_logic_and_comparisons_are_bools
both <- TRUE && !FALSE
bigger <- 7L > 2
f <- function(x: I64) -> Bool x > 0
checked: Bool <- (TRUE && FALSE) || 1.5 < 2
#++++
both: Bool
bigger: Bool
f: fn(x: I64) -> Bool
checked: Bool

#---- literals_through_if_and_braces_take_the_expected_type
same_i64 <- function(x: I64) -> I64 x
v0: List<I64> <- [9L, 5i64]
a: F64 <- if (TRUE) 0.1 else 3.0
b: List<F64> <- [if (TRUE) 0.1 else 3.0]
c: I64 <- if (TRUE) 8L else List.sum(v0)
d <- if (TRUE) 0.1 else 3.0
e <- if (TRUE) 8L else 2
f: I64 <- { 3L }
g <- (match (List.first([4L])) { :Ok(x) => x, :Err(_) => 0 }) < (0L + 3i64)
h <- Num.to_f64(6 + 7L)
k: F64 <- 3 * 2.0
m <- same_i64(if (FALSE) 7L else 0L)
n <- if (TRUE) List.sum([0.1f64, 3.0]) else (if (FALSE) 1.25 else 0.1) * (0.5 / 2)
#++++
same_i64: fn(x: I64) -> I64
v0: List<I64>
a: F64
b: List<F64>
c: I64
d: F64
e: I64
f: I64
g: Bool
h: F64
k: F64
m: I64
n: F64

#---- a_literal_beside_a_ry_value_takes_its_type
b: Bool <- 3 > 2
c: Bool <- TRUE && !(b && b)
d: Bool <- (FALSE && (List.len([1]) == 3))
e: I64 <- (match (List.first([1])) { :Ok(x) => x, :Err(_) => 7i64 }) + 9i64
#++++
b: Bool
c: Bool
d: Bool
e: I64

#---- an_annotation_decides_the_list_a_call_reads
s: F64 <- List.sum([3])
b: Bool <- TRUE
c <- !!b && b
#++++
s: F64
b: Bool
c: Bool

#---- a_top_level_accumulator_meets_the_walk_that_reads_it
total <- 0
total <- List.walk([1.5, 2.5], total, \(acc, v) acc + v)
#++++
total: I64
total: Unknown
49..66 error[type-mismatch] this function is passed `I64`, but its parameter `acc` is used as an `F64`

#---- a_literal_past_the_i64_range_is_an_f64
w <- [1]
big <- 99999999999999999999
x <- if (TRUE) 1 else 99999999999999999999
z <- (1 < 99999999999999999999) && TRUE
b: Bool <- 1 < 99999999999999999999
y <- 1e3L
items <- [99999999999999999999]
#++++
w: List<I64>
big: F64
x: F64
z: Bool
b: Bool
y: I64
items: List<F64>
