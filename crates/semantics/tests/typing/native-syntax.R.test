#---- an_if_or_match_of_literals_stays_one_open_literal
alias K = :A | :B
scored <- function(k: K, n: I64) -> I64 {
  score <- 0
  score <- score + match (k) { :A => 1, :B => 2 }
  score + n
}
picked <- function(c: Bool, n: I64) -> I64 {
  m <- if (c) 1 else 2
  m + n
}
fraction <- function(c: Bool) -> F64 {
  m <- if (c) 1 else 2.5
  m * 2
}
plain <- function(c: Bool) {
  m <- if (c) 1 else 2
  m
}
mixed <- function(c: Bool) {
  m <- if (c) 1L else 2
  m
}
type UserId = integer
takes <- function(id: UserId) -> UserId id
nominal <- function(c: Bool) {
  id <- if (c) @UserId(5L) else @UserId(6L)
  takes(id)
}
#++++
scored: fn(k: K, n: I64) -> I64
picked: fn(c: Bool, n: I64) -> I64
fraction: fn(c: Bool) -> F64
plain: fn(c: Bool) -> double
mixed: fn(c: Bool) -> integer | double
takes: fn(id: UserId) -> UserId
nominal: fn(c: Bool) -> UserId

