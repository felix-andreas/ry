#---- an_unannotated_parameter_beside_an_annotated_one_stays_generic
id <- function<T>(p: T) -> T p
passed <- function(p, flag: Bool) id(p)
returned <- function(p, flag: Bool) p
held <- function(p, flag: Bool) {
  q <- id(p)
  q
}
used <- passed(2L, TRUE) + 1L
#++++
id: <T> fn(p: T) -> T
passed: <T> fn(p: T, flag: Bool) -> T
returned: <T> fn(p: T, flag: Bool) -> T
held: <T> fn(p: T, flag: Bool) -> T
used: integer

#---- a_literal_variable_the_function_ends_with_takes_the_declared_number
start <- function(n: I64) -> F64 {
  x <- 0
  x
}
#++++
start: fn(n: I64) -> F64

#---- a_tail_if_beside_a_literal_variable_takes_the_declared_number
pick <- function(flag: Bool) -> I64 {
  y <- 5
  if (flag) y else 0
}
reversed <- function(flag: Bool) -> I64 {
  y <- 5
  if (flag) 0 else y
}
negative <- function(flag: Bool) -> I64 {
  y <- 5
  if (flag) y else -1
}
inner <- function(flag: Bool) {
  y <- 5
  z <- if (flag) y else 0
  z
}
#++++
pick: fn(flag: Bool) -> I64
reversed: fn(flag: Bool) -> I64
negative: fn(flag: Bool) -> I64
inner: fn(flag: Bool) -> double

#---- a_literal_variable_rebound_in_a_branch_stays_open_for_its_use
grow <- function(n: I64) -> F64 {
  x <- 0
  if (n > 1i64) x <- x + 1.5
  x
}
replace <- function(n: I64) -> F64 {
  x <- 0
  if (n > 1i64) x <- 2.5
  x
}
plain <- function(n) {
  x <- 0
  if (n > 1) x <- x + 1.5
  x
}
mixed <- function(n) {
  x <- 0
  if (n > 1) x <- "a"
  x
}
#++++
grow: fn(n: I64) -> F64
replace: fn(n: I64) -> F64
plain: <T> fn(n: T) -> double
mixed: <T> fn(n: T) -> double | character

#---- a_literal_variable_read_as_a_list_position_is_an_i64
leaf <- function() -> List<I64> {
  lookup <- [1i64, 2i64]
  j <- 1
  first <- lookup[[j]]
  lookup[[2i64]] <- j
  lookup
}
#++++
leaf: fn() -> List<I64>
70..75 warning[unused] `first` is assigned but never used

#---- a_number_beside_a_literal_variable_of_another_r_type_keeps_r_types
counted <- function() {
  i <- 1L
  j <- i + 1.5
  i
}
halves <- function() {
  n <- 10L
  h <- n / 2L
  n
}
joined <- function(flag) {
  x <- 1L
  if (flag) x <- x + 2.5
  x
}
#++++
counted: fn() -> integer
halves: fn() -> integer
joined: fn(flag: logical) -> integer | double
36..37 warning[unused] `j` is assigned but never used
91..92 warning[unused] `h` is assigned but never used

