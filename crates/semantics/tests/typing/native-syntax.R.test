#---- literals_in_a_nominal_constructor_take_the_representation_numbers
type Tree = :Leaf(I64) | :Node(Tree, Tree)
leaf <- function() -> Tree @Tree(:Leaf(1))
pair <- function() -> Tree @Tree(:Node(@Tree(:Leaf(1)), @Tree(:Leaf(2))))
fraction <- function() -> Tree @Tree(:Leaf(1.5))
text <- function(s: Str) -> Tree @Tree(:Leaf(s))
#++++
leaf: fn() -> Tree
pair: fn() -> Tree
fraction: fn() -> Tree
text: fn(s: Str) -> Tree
203..206 error[type-mismatch] this literal does not fit `I64`, which cannot hold its value exactly
254..255 error[type-mismatch] expected `I64`, found `Str`

#==== unannotated_arithmetic
#---- arithmetic_that_keeps_its_type_takes_ry_numbers
twice <- function(a) a + a
mul <- function(a, b) a * b
neg <- function(a) -a
n <- 3i64
xs <- [1.0, 2.0]
doubled <- twice(n)
products <- List.map2(xs, xs, mul)
negated <- neg(2.5f64)
r_sum <- twice(2L)
#++++
twice: <T: num> fn(a: T) -> T
mul: <T: num> fn(a: T, b: T) -> T
neg: <T: num> fn(a: T) -> T
n: I64
xs: List<F64>
doubled: I64
products: List<F64>
negated: F64
r_sum: integer

#---- a_literal_beside_a_parameter_takes_its_type
scale <- function(x) x * 2
inc <- function(x) x + 1L
frac <- function(x) x * 0.5
a <- scale(3i64)
b <- scale(2L)
c <- inc(2L)
d <- inc(3i64)
e <- frac(2.5f64)
f <- frac(3i64)
xs <- List.map([1.0, 2.0], scale)
#++++
scale: <T: arithmetic or number> fn(x: T) -> Promoted<T>
inc: <T: arithmetic or number> fn(x: T) -> T
frac: <T: arithmetic or F64> fn(x: T) -> Promoted<T>
