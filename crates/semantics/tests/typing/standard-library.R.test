#==== result
#---- map_binds_both_members
r <- Result.map(List.get([1, 2], 1), function(x) x * 2)
#++++
r: :Ok(I64) | :Err(:OutOfBounds)

#---- with_default_unwraps
v <- Result.with_default(List.first(["a", "b"]), "")
#++++
v: Str

#---- and_then_chains
parse <- function(text: Str) Str.to_i64(text)
n <- Result.and_then(parse("4"), function(x) if (x > 0) :Ok(x) else :Err(:InvalidNumStr))
#++++
parse: fn(text: Str) -> Result<I64, :InvalidNumStr>
n: :Ok(I64) | :Err(:InvalidNumStr)

#---- and_then_widens_the_error
n <- Result.and_then(Str.to_i64("4"), function(x) if (x > 0) :Ok(x) else :Err(:NotPositive))
#++++
n: :Ok(I64) | :Err(:InvalidNumStr | :NotPositive)

#---- and_then_with_a_step_that_never_fails
n <- Result.and_then(Str.to_i64("4"), function(x) :Ok(x + 1))
#++++
n: :Ok(I64) | :Err(:InvalidNumStr)

#---- and_then_keeps_an_outer_step_open
g <- function(r, step) Result.and_then(r, step)
#++++
g: <T, U, V, W> fn(r: :Ok(T) | :Err(U), step: fn(T) -> :Ok(V) | :Err(W)) -> :Ok(V) | :Err(U | W)

#---- an_open_parameter_filled_by_an_argument_is_kept
pick <- function(xs) Find(function(x) TRUE, xs)
v <- pick(list("a", "b"))
w <- if (!is.null(v)) trimws(v) else ""
#++++
pick: <T> fn(xs: list[T] | T[]) -> T | NULL
v: character | NULL
w: character

#---- a_return_only_parameter_is_kept
#: <T> fn(name: character) -> T | NULL
lookup <- function(name) NULL
v <- lookup("a")
w <- if (!is.null(v)) Str.trim(v) else ""
#++++
lookup: <T> fn(name: character) -> T | NULL
v: Unknown
w: Str | character

#---- and_then_meets_a_widened_annotation
#: @param text {Str}
#: @return {Result<I64, :InvalidNumStr | :NotPositive>}
positive <- function(text) {
  Result.and_then(Str.to_i64(text), function(n) if (n > 0) :Ok(n) else :Err(:NotPositive))
}
#++++
positive: fn(text: Str) -> Result<I64, :InvalidNumStr | :NotPositive>

#---- map_err_replaces_the_error
r <- Result.map_err(Str.to_f64("x"), function(e) "not a number")
#++++
r: :Ok(F64) | :Err(character)

#---- result_alias_in_an_annotation
#: @param text {Str}
#: @return {Result<I64, :InvalidNumStr>}
parse <- function(text) Str.to_i64(text)
#++++
parse: fn(text: Str) -> Result<I64, :InvalidNumStr>

#---- project_alias_shadows_the_shipped_one
#: @alias Result<T> {:Good(T) | :Bad}

#: @param x {integer}
#: @return {Result<integer>}
check <- function(x) if (x > 0L) :Good(x) else :Bad
#++++
check: fn(x: integer) -> Result<integer>

#---- map2_joins_both_errors
r <- Result.map2(Str.to_f64("2"), Str.to_f64("3"), function(a, b) a * b)
#++++
r: :Ok(F64) | :Err(:InvalidNumStr)

#==== list
#---- from_vector_keeps_the_element_type
xs <- List.from_r(c(1L, 2L, 3L))
#++++
xs: List<I32>

#---- walk_folds_to_the_state_type
total <- List.walk([1, 2], 0, function(acc, x) acc + x)
#++++
total: I64

#---- map_changes_the_element_type
names <- List.map([1, 2], function(x) Num.to_str(x))
#++++
names: List<Str>

#---- map_try_collects_results
parsed <- List.map_try(["1", "2"], Str.to_i64)
#++++
parsed: :Ok(List<I64>) | :Err(:InvalidNumStr)

#---- walk_until_stops_on_break
found <- List.walk_until([1, 5, 2], 0, function(acc, x) if (x > 3) :Break(x) else :Continue(acc))
#++++
found: I64

#---- sum_needs_scalar_numbers
s <- List.sum([1.5, 2])
bad <- List.sum([c(1, 2)])
#++++
s: F64
bad: Unknown
41..48 error[type-mismatch] a `List` cannot hold `double[]`. Its items are ry values: numbers such as `I64` and `F64`, `Bool`, `Str`, records, tuples, tags and other collections

#---- max_of_an_empty_list_checks
top <- List.max([])
#++++
top: :Ok(Unknown) | :Err(:ListWasEmpty)

#---- split_at_returns_a_record
halves <- List.split_at(["a", "b", "c"], 1)
before <- halves$before
#++++
halves: Record{before: List<Str>, others: List<Str>}
before: List<Str>

#---- vector_is_not_a_list
n <- List.len(c(1, 2))
#++++
n: Unknown
14..21 error[type-mismatch] expected `List<T>`, found `double[]`. Convert an R vector with `List.from_r()`

#---- walk_try_returns_the_state_or_the_error
r <- List.walk_try([1, 2], 0, function(s, x) if (x > 0) :Ok(s + x) else :Err(:Negative))
#++++
r: :Ok(I64) | :Err(:Negative)

#---- replace_returns_the_list_and_the_old_value
r <- List.replace(["a", "b"], 1, "z")
#++++
r: Record{list: List<Str>, value: Str}

#---- sort_asc_needs_numbers
a <- List.sort_asc([3, 1])
b <- List.sort_asc(["b", "a"])
#++++
a: List<I64>
b: Unknown
46..56 error[type-mismatch] expected `List<T>`, found `List<Str>`

#---- for_each_returns_null
n <- List.for_each([1], function(x) x)
#++++
n: NULL

#==== str
#---- split_on_returns_a_list_of_strings
words <- Str.split_on("a b", " ")
first <- Result.with_default(List.first(words), "")
#++++
words: List<Str>
first: Str

#---- split_first_returns_a_record_result
parts <- Str.split_first("key=value", "=")
#++++
parts: :Ok(Record{after: Str, before: Str}) | :Err(:NotFound)

#---- string_functions_need_strings
n <- Str.trim(1L)
#++++
n: Unknown
14..16 error[type-mismatch] expected `Str`, found `integer`

#---- walk_utf8_folds_bytes
total <- Str.walk_utf8("abc", 0, function(s, b) s + Num.to_i64(b))
#++++
total: I64

#---- utf16_and_utf32_round_trip
units <- Str.to_utf16("hi")
back <- Str.from_utf16(units)
points <- Str.to_utf32("hi")
lossy <- Str.from_utf32_lossy(points)
#++++
units: List<U16>
back: :Ok(Str) | :Err(:BadUtf16)
points: List<U32>
lossy: Str

#---- from_utf32_needs_a_list_of_integers
s <- Str.from_utf32("hi")
#++++
s: Unknown
20..24 error[type-mismatch] expected `List<U32>`, found `character`. Convert an R vector with `List.from_r()`

#==== num
#---- checked_addition_keeps_the_number_type
sum <- Num.add_checked(1, 2)
#++++
sum: :Ok(I64) | :Err(:Overflow | :Undefined)

#---- compare_returns_an_ordering
order <- Num.compare(1, 2)
#++++
order: :LT | :EQ | :GT

#---- rounding_keeps_the_number_type
a <- Num.round(2.5)
b <- Num.floor(3.7)
c <- Num.to_i64_checked(2.9)
#++++
a: I64
b: I64
c: :Ok(I64) | :Err(:OutOfBounds)

#---- approx_eq_takes_optional_tolerances
same <- Num.is_approx_eq(1, 1.05, rtol = 0.1)
#++++
same: Bool

#---- unchecked_arithmetic_keeps_the_number_type
a <- Num.add(1, 2)
b <- Num.div_trunc(7, 2)
c <- Num.div(7, 2)
d <- Num.sqrt(4.0)
total <- List.walk([1, 2], 0, Num.add)
#++++
a: I64
b: I64
c: F64
d: F64
total: I64

#---- bit_operations_take_integers
a <- Num.bitwise_and(12, 10)
b <- Num.shift_left_by(1, 4)
n <- Num.count_one_bits(a)
#++++
a: I64
b: I64
n: I64

#---- bitwise_rejects_a_string
a <- Num.bitwise_or("1", 2)
#++++
a: Unknown
20..23 error[type-mismatch] expected `T`, found `character`

#---- constants_are_doubles
area <- Num.pi * 2
#++++
area: F64

#==== bool
#---- constants_and_connectives_are_logical
t <- Bool.true
both <- Bool.and(t, Bool.not(Bool.false))
either <- Bool.or(FALSE, both)
#++++
t: Bool
both: Bool
either: Bool

#---- is_eq_compares_any_values_of_one_type
#: :Red | :Green
light <- :Red
same <- Bool.is_eq([1], [2])
red <- Bool.is_eq(light, :Red)
other <- Bool.is_not_eq(light, :Green)
#++++
light: :Red | :Green
same: Bool
red: Bool
other: Bool

#---- connectives_need_logicals
x <- Bool.not(1L)
#++++
x: Unknown
14..16 error[type-mismatch] expected `Bool`, found `integer`

#==== dict_and_set
#---- dict_from_list_infers_key_and_value
d <- Dict.from_list([("a", 1), ("b", 2)])
got <- Dict.get(d, "a")
#++++
d: Dict<character, double>
got: :Ok(double) | :Err(:KeyNotFound)

#---- dict_rejects_a_key_of_the_wrong_type
d <- Dict.single("a", 1)
got <- Dict.get(d, 1L)
#++++
d: Dict<character, double>
got: Unknown
44..46 error[type-mismatch] expected `character`, found `integer`

#---- dict_is_not_an_r_object
d <- Dict.single("a", 1)
n <- sum(d)
#++++
d: Dict<character, double>
n: Unknown
34..35 error[type-mismatch] `sum` is an R function, and this value is a ry dict, not an R object. Convert it with `as.list()` first

