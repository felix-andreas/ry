#---- set_is_not_an_r_object
s <- Set.single("a")
n <- length(s)
#++++
s: Set<character>
n: integer

#---- join_map_changes_key_and_value_types
d <- Dict.join_map(Dict.single("a", 1L), function(k, v) Dict.single(v, k))
#++++
d: Dict<integer, character>

#==== conversions
