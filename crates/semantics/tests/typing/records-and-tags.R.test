#---- record_reads_a_position_in_sorted_field_order
p <- (x = 1, y = 2L)
y <- p[[1L]]
#++++
p: record{x: double, y: integer}
y: double

#---- tuple_reads_by_literal_position
t <- (1L, "a")
a <- t[[1L]]
b <- t[[2L]]
#++++
t: tuple{integer, character}
a: integer
b: character

