#==== literals
#---- record_literal
p <- (x = 1, y = 2L)
#++++
p: record{x: double, y: integer}

#---- record_fields_print_sorted
p <- (y = 2, x = 1)
#++++
p: record{x: double, y: double}

#---- one_field_record
p <- (x = 1,)
#++++
p: record{x: double}

#---- tuple_literal
t <- (1L, "a")
#++++
t: tuple{integer, character}

#---- one_item_tuple
t <- (1L,)
#++++
t: tuple{integer}

#---- empty_tuple
t <- ()
#++++
t: tuple{}

#---- bare_tag
n <- :None
#++++
n: :None

#---- positional_tag
s <- :Some(5L)
#++++
s: :Some(integer)

#---- named_tag
r <- :Rect(width = 2, height = 3)
#++++
r: :Rect(height: double, width: double)

#---- nested_literals
v <- (point = (x = 1, y = 2), tag = :Some((1L, "a")))
#++++
v: record{point: record{x: double, y: double}, tag: :Some(tuple{integer, character})}

#==== field_access
#---- dollar_reads_an_exact_field
p <- (x = 1, y = 2L)
y <- p$y
#++++
p: record{x: double, y: integer}
y: integer

#---- unknown_field_suggests_the_nearest_name
p <- (width = 1, height = 2)
w <- p$widht
#++++
p: record{height: double, width: double}
w: Unknown
36..41 error[type-mismatch] field `widht` does not exist in `record{height: double, width: double}`. Did you mean `width`?

