y <- f(list(x = 1))
#++++
f: fn(r: record{x: double}) -> double
y: Unknown
66..77 error[type-mismatch] expected `record{x: double}`, found `list{x: double}`

#---- record_field_order_does_not_matter
#: fn(r: Record{x: double, y: double}) -> double
f <- function(r) r$x
z <- f((y = 2, x = 1))
#++++
f: fn(r: record{x: double, y: double}) -> double
z: double

#---- record_needs_every_field
#: fn(r: Record{x: double, y: double}) -> double
