z <- f((x = 1,))
#++++
f: fn(r: record{x: double, y: double}) -> double
z: Unknown
77..85 error[type-mismatch] expected `record{x: double, y: double}`, found `record{x: double}`

#---- integer_widens_into_a_double_field
