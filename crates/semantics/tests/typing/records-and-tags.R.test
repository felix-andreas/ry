#==== match_inference
#---- match_types_as_the_join_of_its_arms
#: fn(o: :Some(integer) | :None) -> integer | character
f <- function(o) {
  match (o) {
    :Some(v) => v
    :None => "none"
  }
}
#++++
f: fn(o: :Some(integer) | :None) -> integer | character

#---- binding_takes_the_payload_type
#: fn(o: :Some(integer) | :None) -> integer
f <- function(o) {
  match (o) {
    :Some(v) => v
    :None => 0L
  }
}
#++++
f: fn(o: :Some(integer) | :None) -> integer

#---- tuple_pattern_binds_each_item
#: fn(t: Tuple{integer, character}) -> character
f <- function(t) {
  match (t) {
    (n, s) => s
  }
}
#++++
f: fn(t: tuple{integer, character}) -> character

#---- record_pattern_binds_fields
#: fn(r: Record{x: double, y: integer}) -> integer
f <- function(r) {
  match (r) {
    (y = b, ..) => b
  }
}
#++++
f: fn(r: record{x: double, y: integer}) -> integer

#---- named_payload_pattern
#: fn(s: :Rect(width: double, height: double) | :Empty) -> double
area <- function(s) {
  match (s) {
    :Rect(width = w, height = h) => w * h
    :Empty => 0
  }
}
#++++
area: fn(s: :Rect(height: double, width: double) | :Empty) -> double

#---- unannotated_scrutinee_is_shaped_by_its_patterns
g <- function(r) {
  match (r) {
    :Ok(v) => v
    :Err(e) => 0
  }
}
#++++
g: <T, U> fn(r: :Ok(T) | :Err(U)) -> T | double

#---- catch_all_leaves_the_scrutinee_unshaped
g <- function(r) {
  match (r) {
    :Ok(v) => v
    _ => 0L
  }
}
#++++
g: <T> fn(r: T) -> Unknown

#---- tuple_patterns_shape_a_tuple
g <- function(pair) {
  match (pair) {
    (a, b) => a + b
  }
}
#++++
g: <T: numeric> fn(pair: tuple{T, T}) -> T

#---- binding_after_the_match_joins_the_arms
#: fn(o: :Some(integer) | :None) -> integer
f <- function(o) {
  match (o) {
    :Some(v) => total <- v
    :None => total <- 0L
  }
  total
}
#++++
f: fn(o: :Some(integer) | :None) -> integer

#---- diverging_arm_does_not_join
#: fn(o: :Some(integer) | :None) -> integer
f <- function(o) {
  match (o) {
    :Some(v) => v
    :None => stop("none")
  }
}
#++++
f: fn(o: :Some(integer) | :None) -> integer

#---- or_pattern_binds_the_union
#: fn(t: Tuple{integer, character}) -> integer | character
f <- function(t) {
  match (t) {
    (a, _) | (_, a) => a
  }
}
#++++
f: fn(t: tuple{integer, character}) -> integer | character

#---- match_value_conflicting_tag_shapes
#: fn(flag: logical) -> logical
f <- function(flag) {
  v <- match (flag) {
    TRUE => :Some(1L)
    _ => :Some(1L, 2L)
  }
  TRUE
}
#++++
f: fn(flag: logical) -> logical
56..57 warning[unused] `v` is assigned but never used.
61..124 error[type-mismatch] these branches build `:Some(integer)` and `:Some(integer, integer)`, one tag with two payload shapes. Within a union a tag has one shape, so that a `match` can tell its cases apart

