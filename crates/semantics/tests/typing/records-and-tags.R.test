z <- f((x = 1L,))
#++++
f: fn(r: record{x: double}) -> double
z: double

#==== tag_unions
#---- tag_fits_a_union_listing_it
#: fn(o: :Some(integer) | :None) -> logical
f <- function(o) TRUE
a <- f(:Some(1L))
b <- f(:None)
#++++
f: fn(o: :Some(integer) | :None) -> logical
a: logical
b: logical

#---- tag_payload_mismatch
#: fn(o: :Some(integer) | :None) -> logical
