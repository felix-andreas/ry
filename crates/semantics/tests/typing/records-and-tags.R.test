#---- if_joins_tags_into_a_union
f <- function(flag) if (flag) :Some(1L) else :None
#++++
f: fn(flag: logical) -> :Some(integer) | :None

#---- if_merges_one_tag_payloads
f <- function(flag) if (flag) :Some(1L) else :Some("a")
#++++
f: fn(flag: logical) -> :Some(integer | character)

#---- if_with_two_payload_shapes_conflicts
