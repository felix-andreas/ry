#==== conditional_top_level_globals
#---- if_body_binding_is_package_global
#~~~~ R/a.R
if (TRUE) {
  x <- 1L
}
#~~~~ R/b.R
x
#++++
== R/a.R
integer | NULL
== R/b.R
integer

#---- else_body_binding_is_package_global
#~~~~ R/a.R
if (FALSE) {
  1L
} else {
  x <- 1L
}
#~~~~ R/b.R
x
#++++
== R/a.R
integer
== R/b.R
integer

#---- else_if_body_binding_is_package_global
#~~~~ R/a.R
if (FALSE) {
  1L
} else if (TRUE) {
  x <- 1L
}
#~~~~ R/b.R
x
#++++
== R/a.R
integer | NULL
== R/b.R
integer

#---- for_body_binding_is_package_global
