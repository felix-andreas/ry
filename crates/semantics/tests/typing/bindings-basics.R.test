#==== basics
#---- rebinding_updates_binding_shape
value <- 1L
value <- "ok"
#++++
value: integer
value: character
0..5 warning[duplicate] Top-level binding `value` is overwritten by a later top-level binding in this package.
12..17 warning[duplicate] Top-level binding `value` overwrites an earlier top-level binding in this package.

#---- reserved_atomic_constants
na <- NA
na_int <- NA_integer_
na_real <- NA_real_
na_char <- NA_character_
infinity <- Inf
not_a_number <- NaN
imaginary <- 1i
#++++
na: logical
na_int: integer
na_real: double
na_char: character
infinity: double
not_a_number: double
imaginary: complex
