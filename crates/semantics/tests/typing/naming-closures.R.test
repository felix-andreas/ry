#==== function_globals
#---- top_level_binding_used_inside_function
#~~~~ R/main.R
x <- 1L
f <- function() x
#++++
== R/main.R
x: integer
f: fn() -> integer

#==== nested_functions
#---- nested_function_closes_over_outer_local
#~~~~ R/main.R
f <- function() {
  x <- 1L
  g <- function() x
}
#++++
== R/main.R
f: fn() -> fn() -> integer
30..31 warning[unused] `g` is assigned but never used.

#---- nested_function_closes_over_outer_parameter
#~~~~ R/main.R
f <- function(x) {
  g <- function() x
}
#++++
== R/main.R
f: <T> fn(x: T) -> fn() -> T
21..22 warning[unused] `g` is assigned but never used.

#---- nested_function_closes_over_top_level_global
#~~~~ R/main.R
x <- 1L
f <- function() {
  g <- function() x
}
#++++
== R/main.R
x: integer
f: fn() -> fn() -> integer
28..29 warning[unused] `g` is assigned but never used.

#---- multi_hop_nested_function_closes_over_outer_local
#~~~~ R/main.R
f <- function() {
  x <- 1L
  g <- function() {
    h <- function() x
  }
}
#++++
== R/main.R
f: fn() -> fn() -> fn() -> integer
30..31 warning[unused] `g` is assigned but never used.
52..53 warning[unused] `h` is assigned but never used.

#---- closure_parameter_shadows_enclosing_binding
#~~~~ R/main.R
f <- function() {
  x <- 1L
  g <- function(x) x
}
#++++
== R/main.R
f: <T> fn() -> fn(x: T) -> T
20..21 warning[unused] `x` is assigned but never used.
30..31 warning[unused] `g` is assigned but never used.

#---- closure_local_shadows_enclosing_binding
#~~~~ R/main.R
f <- function(x) {
  g <- function() {
    x <- "ok"
    x
  }
}
#++++
== R/main.R
f: <T> fn(x: T) -> fn() -> character
21..22 warning[unused] `g` is assigned but never used.

#---- closure_uses_nearest_shadowing_binding_across_hops
#~~~~ R/main.R
x <- 1L
f <- function() {
  x <- "outer"
  g <- function() {
    x <- TRUE
    h <- function() x
  }
}
#++++
== R/main.R
x: integer
f: fn() -> fn() -> fn() -> logical
28..29 warning[unused] `x` is assigned but never used.
43..44 warning[unused] `g` is assigned but never used.
79..80 warning[unused] `h` is assigned but never used.

#==== cross_file_globals
#---- nested_function_closes_over_global_from_other_file
#~~~~ R/a.R
x <- 1L
#~~~~ R/b.R
f <- function() {
  g <- function() x
}
#++++
== R/a.R
x: integer
== R/b.R
f: fn() -> fn() -> integer
20..21 warning[unused] `g` is assigned but never used.

#---- nested_function_local_shadow_ignores_cross_file_final_winner
#~~~~ R/a.R
x <- 1L
#~~~~ R/b.R
x <- 2L
#~~~~ R/c.R
f <- function() {
  x <- 3L
  g <- function() x
}
#++++
== R/a.R
x: integer
0..1 warning[duplicate] Top-level binding `x` is overwritten by a later top-level binding in this package.
== R/b.R
x: integer
0..1 warning[duplicate] Top-level binding `x` overwrites an earlier top-level binding in this package.
== R/c.R
f: fn() -> fn() -> integer
30..31 warning[unused] `g` is assigned but never used.
