#==== calls
#---- polymorphic_identity_multiple_types
mirror <- function(x) x
mirror(1L)
mirror("oops")
#++++
mirror: <T> fn(x: T) -> T
integer
character

#---- polymorphic_assignment_multiple_types
mirror <- function(x) x
first <- mirror(1L)
second <- mirror("ok")
#++++
mirror: <T> fn(x: T) -> T
first: integer
second: character

#---- polymorphic_repeated_independent_uses
mirror <- function(x) x
first <- mirror(1L)
second <- mirror("ok")
third <- mirror(2L)
#++++
mirror: <T> fn(x: T) -> T
first: integer
second: character
third: integer

#---- polymorphic_arity_after_valid_use
mirror <- function(x) x
mirror(1L)
mirror(1L, 2L)
#++++
mirror: <T> fn(x: T) -> T
integer
integer
46..48 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

#---- call_arity_after_polymorphic_assignment
mirror <- function(x) x
first <- mirror(1L)
mirror("ok", "extra")
#++++
mirror: <T> fn(x: T) -> T
first: integer
character
57..64 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

#---- polymorphic_higher_order_apply
invoke <- function(f) function(x) f(x)
mirror <- function(x) x
int_apply <- invoke(mirror)
first <- int_apply(1L)
second <- int_apply("ok")
#++++
invoke: <T, U> fn(f: fn(T) -> U) -> fn(x: T) -> U
mirror: <T> fn(x: T) -> T
int_apply: <T> fn(x: T) -> T
first: integer
second: character

#---- polymorphic_higher_order_conflict
invoke <- function(f) function(x) f(x + 1L)
mirror <- function(x) x
mixed_apply <- invoke(mirror)
mixed_apply("ok")
#++++
invoke: <T: numeric, U> fn(f: fn(T) -> U) -> fn(x: T) -> U
mirror: <T> fn(x: T) -> T
mixed_apply: <T: numeric> fn(x: T) -> T
T
110..114 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- numeric_polymorphic_accepts_integer_and_double
increment <- function(x) x + 1L
a <- increment(2L)
b <- increment(2.5)
#++++
increment: <T: numeric> fn(x: T) -> T
a: integer
b: double

#---- numeric_polymorphic_rejects_character
increment <- function(x) x + 1L
bad <- increment("oops")
#++++
increment: <T: numeric> fn(x: T) -> T
bad: Unknown
49..55 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- a_shared_parameter_joins_tags_in_either_order
#: :Red | :Green
light <- :Red
first <- Bool.is_eq(light, :Red)
second <- Bool.is_eq(:Red, light)
#++++
light: :Red | :Green
first: Bool
second: Bool

#---- a_shared_parameter_returns_the_joined_tags
#: <T> fn(a: T, b: T) -> T
pick <- function(a, b) if (runif(1) < 0.5) a else b
color <- pick(:Red, :Green)
result <- pick(:Ok(1L), :Err(:Missing))
#++++
pick: <T> fn(a: T, b: T) -> T
color: :Red | :Green
result: :Ok(integer) | :Err(:Missing)

#---- a_shared_parameter_promotes_numbers_like_r
add <- function(a, b) a + b
a <- add(1L, 1.5)
b <- add(1.5, 1L)
c <- Num.add(1, 2)
d <- Num.max(1, 2.5)
#++++
add: <T: numeric> fn(a: T, b: T) -> T
a: double
b: double
c: I64
d: F64

#---- a_shared_item_parameter_promotes_numbers
both <- List.concat([1], [2.5])
#++++
both: List<F64>

#---- a_shared_parameter_still_rejects_unrelated_types
same <- Bool.is_eq(1L, "one")
mixed <- List.concat([1], ["a"])
#++++
same: Unknown
mixed: Unknown
23..28 error[type-mismatch] expected `integer`, found `character`
56..61 error[type-mismatch] expected `List<I64>`, found `List<Str>`

#---- a_joined_parameter_checks_a_callback_against_the_join
#: <T> fn(f: fn(T) -> logical, a: T, b: T) -> logical
both_hold <- function(f, a, b) f(a) && f(b)
#: fn(x: :Red) -> logical
is_red <- function(x) TRUE
checked <- both_hold(is_red, :Red, :Green)
#++++
both_hold: <T> fn(f: fn(T) -> logical, a: T, b: T) -> logical
is_red: fn(x: :Red) -> logical
checked: Unknown
172..178 error[type-mismatch] this function is passed `:Red | :Green`, but its parameter `x` accepts `:Red`
