#==== calls
#---- polymorphic_identity_multiple_types
mirror <- function(x) x
mirror(1L)
mirror("oops")
#++++
mirror: <T> fn(x: T) -> T
integer
character

#---- polymorphic_assignment_multiple_types
mirror <- function(x) x
first <- mirror(1L)
second <- mirror("ok")
#++++
mirror: <T> fn(x: T) -> T
first: integer
second: character

#---- polymorphic_repeated_independent_uses
mirror <- function(x) x
first <- mirror(1L)
second <- mirror("ok")
third <- mirror(2L)
#++++
mirror: <T> fn(x: T) -> T
first: integer
second: character
third: integer

#---- polymorphic_arity_after_valid_use
mirror <- function(x) x
mirror(1L)
mirror(1L, 2L)
#++++
mirror: <T> fn(x: T) -> T
integer
integer
46..48 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

#---- call_arity_after_polymorphic_assignment
mirror <- function(x) x
first <- mirror(1L)
mirror("ok", "extra")
#++++
mirror: <T> fn(x: T) -> T
first: integer
character
57..64 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

#---- polymorphic_higher_order_apply
invoke <- function(f) function(x) f(x)
mirror <- function(x) x
int_apply <- invoke(mirror)
first <- int_apply(1L)
second <- int_apply("ok")
#++++
invoke: <T, U> fn(f: fn(T) -> U) -> fn(x: T) -> U
mirror: <T> fn(x: T) -> T
int_apply: <T> fn(x: T) -> T
first: integer
second: character

#---- polymorphic_higher_order_conflict
invoke <- function(f) function(x) f(x + 1L)
mirror <- function(x) x
mixed_apply <- invoke(mirror)
mixed_apply("ok")
#++++
invoke: <T: arithmetic or number, U> fn(f: fn(T) -> U) -> fn(x: T) -> U
mirror: <T> fn(x: T) -> T
mixed_apply: <T: arithmetic or number> fn(x: T) -> T
Unknown
110..114 error[type-mismatch] expected a number (`integer`, `double`, `I64` or `F64`) or a class with arithmetic, found `character`

#---- numeric_polymorphic_accepts_integer_and_double
increment <- function(x) x + 1L
a <- increment(2L)
b <- increment(2.5)
#++++
increment: <T: arithmetic or number> fn(x: T) -> T
a: integer
b: double

#---- numeric_polymorphic_rejects_character
increment <- function(x) x + 1L
bad <- increment("oops")
#++++
increment: <T: arithmetic or number> fn(x: T) -> T
bad: Unknown
49..55 error[type-mismatch] expected a number (`integer`, `double`, `I64` or `F64`) or a class with arithmetic, found `character`

#---- arithmetic_on_two_declared_numeric_parameters_is_double
#: <T: numeric, U: numeric> fn(a: T, b: U) -> double
ratio <- function(a, b) a / b
#: <T, U: numeric> fn(a: T, b: U) -> double
untyped <- function(a, b) a / b
#++++
ratio: <T: numeric, U: numeric> fn(a: T, b: U) -> double
untyped: <T, U: numeric> fn(a: T, b: U) -> double
153..154 error[type-mismatch] expected a numeric value (`integer` or `double`), found `T`

#---- a_shared_parameter_joins_tags_in_either_order
#: :Red | :Green
light <- :Red
first <- Bool.is_eq(light, :Red)
second <- Bool.is_eq(:Red, light)
#++++
light: :Red | :Green
first: Bool
second: Bool

#---- a_shared_parameter_returns_the_joined_tags
#: <T> fn(a: T, b: T) -> T
pick <- function(a, b) if (runif(1) < 0.5) a else b
color <- pick(:Red, :Green)
result <- pick(:Ok(1L), :Err(:Missing))
#++++
pick: <T> fn(a: T, b: T) -> T
color: :Red | :Green
result: :Ok(integer) | :Err(:Missing)

#---- a_difference_of_two_values_of_one_class_is_a_double
# Two dates subtract to a `difftime`, not a date, so a generic difference claims the representation.
span <- function(from, to) to - from
day <- as.Date("2024-01-02")
gap <- span(day, day)
#++++
span: <T: arithmetic or number> fn(from: T, to: T) -> Promoted<T>
day: Date
gap: double

#---- a_class_without_arithmetic_is_told_what_it_lacks
# A class could satisfy `x + 1` with an operator method, so the message names that way out.
shift <- function(x) x + 1
levels <- shift(factor("a"))
#++++
shift: <T: arithmetic or number> fn(x: T) -> Promoted<T>
levels: Unknown
135..146 error[type-mismatch] expected a number (`integer`, `double`, `I64` or `F64`) or a class with arithmetic, found `factor`

#---- a_class_negates_only_with_arithmetic_between_its_values
# R stops on `-day` (`-.Date` needs two operands), and a `difftime` negates to itself.
day <- as.Date("2024-01-02")
back <- -day
gap <- day - day
ahead <- -gap
#++++
day: Date
back: Unknown
gap: difftime
ahead: difftime
125..128 error[type-mismatch] expected a numeric value (`integer` or `double`), found `Date`

#---- a_numeric_bound_needs_arithmetic_between_two_of_the_class
# `Date + 1` is legal R and `Date + Date` is not, so `x + 1` asks only `arithmetic` of
# `x`, while `a + b` on two values of one type asks `numeric`, which `Date` lacks and
# `difftime` (`gap + gap`) has. A one-line helper must not launder the direct error.
#: <T: numeric> fn(a: T, b: T) -> T
add_them <- function(a, b) a + b
add_inferred <- function(a, b) a + b
shift <- function(x) x + 1
negate <- function(x) -x
#: <T: arithmetic> fn(x: T) -> T
twice <- function(x) x + x
day <- as.Date("2024-01-02")
dates <- add_them(day, day)
inferred <- add_inferred(day, day)
gaps <- add_them(day - day, day - day)
shifted <- shift(day)
negated <- negate(day)
#++++
add_them: <T: numeric> fn(a: T, b: T) -> T
add_inferred: <T: num> fn(a: T, b: T) -> T
shift: <T: arithmetic or number> fn(x: T) -> Promoted<T>
negate: <T: num> fn(x: T) -> T
twice: <T: arithmetic> fn(x: T) -> T
day: Date
dates: Unknown
inferred: Unknown
gaps: difftime
shifted: double
negated: Unknown
470..475 error[type-mismatch] expected a number (`integer`, `double`, `I64` or `F64`), found `T`. Declare `<T: num>` to combine two of its values, because `arithmetic` admits classes such as `Date` that only add a number
523..526 error[type-mismatch] expected a numeric value (`integer` or `double`) or a class with arithmetic between two of its values, found `Date`
528..531 error[type-mismatch] expected a numeric value (`integer` or `double`) or a class with arithmetic between two of its values, found `Date`
558..561 error[type-mismatch] expected a number (`integer`, `double`, `I64` or `F64`) or a class with arithmetic between two of its values, found `Date`
563..566 error[type-mismatch] expected a number (`integer`, `double`, `I64` or `F64`) or a class with arithmetic between two of its values, found `Date`
647..650 error[type-mismatch] expected a number (`integer`, `double`, `I64` or `F64`) or a class with arithmetic between two of its values, found `Date`

#---- a_difference_of_two_values_asks_only_arithmetic
# R subtracts two dates or two times, and testthat compares them with `abs(x - y) < tol`.
near <- function(x, y, tolerance = 1e-8) abs(x - y) < tolerance
times <- near(Sys.time(), Sys.time())
days <- near(Sys.Date(), Sys.Date())
#++++
near: <T: arithmetic, U> fn(x: T, y: T, [tolerance]: U) -> logical
times: logical
days: logical

#---- a_shared_parameter_promotes_numbers_like_r
add <- function(a, b) a + b
a <- add(1L, 1.5)
b <- add(1.5, 1L)
c <- Num.add(1, 2)
d <- Num.max(1, 2.5)
#++++
add: <T: num> fn(a: T, b: T) -> T
a: double
b: double
c: I64
d: F64

#---- a_shared_item_parameter_promotes_numbers
both <- List.concat([1], [2.5])
#++++
both: List<F64>

#---- a_shared_parameter_still_rejects_unrelated_types
same <- Bool.is_eq(1i64, "one")
mixed <- List.concat([1], ["a"])
r_values <- Bool.is_eq(1L, "one")
#++++
same: Unknown
mixed: Unknown
r_values: Bool
25..30 error[type-mismatch] expected `I64`, found `character`
58..63 error[type-mismatch] expected `List<I64>`, found `List<Str>`

#---- a_joined_parameter_checks_a_callback_against_the_join
#: <T> fn(f: fn(T) -> logical, a: T, b: T) -> logical
both_hold <- function(f, a, b) f(a) && f(b)
#: fn(x: :Red) -> logical
is_red <- function(x) TRUE
checked <- both_hold(is_red, :Red, :Green)
#++++
both_hold: <T> fn(f: fn(T) -> logical, a: T, b: T) -> logical
is_red: fn(x: :Red) -> logical
checked: Unknown
172..178 error[type-mismatch] this function is passed `:Red | :Green`, but its parameter `x` accepts `:Red`

#---- a_body_annotation_names_the_signatures_type_parameter
#: <T: numeric> fn(y: T) -> T
twice <- function(y) {
  #: T
  doubled <- y + y
  doubled
}
#++++
twice: <T: numeric> fn(y: T) -> T

#---- an_inline_body_annotation_names_the_inline_type_parameter
twice <- function<T: numeric>(y: T) -> T {
  doubled: T <- y + y
  doubled
}
#++++
twice: <T: numeric> fn(y: T) -> T

#---- a_body_annotation_holds_the_parameter_to_its_signature
#: <T, U> fn(x: T, y: U) -> T
first <- function(x, y) {
  #: T
  kept <- y
  x
}
#++++
first: <T, U> fn(x: T, y: U) -> T
65..69 warning[unused] `kept` is assigned but never used
73..74 error[type-mismatch] expected `T`, found `U`

#---- a_nested_function_reads_the_outer_type_parameter
#: <T> fn(x: T) -> fn() -> T
constant <- function(x) {
  #: fn() -> T
  get <- function() x
  get
}
#++++
constant: <T> fn(x: T) -> fn() -> T

#---- a_body_annotation_outside_any_signature_does_not_know_t
twice <- function(y) {
  #: T
  doubled <- y + y
  doubled
}
#++++
twice: <T: num> fn(y: T) -> T
28..29 error[annotation] I do not know the type `T`. It is not a built-in type, a type defined with `type`, `alias`, `@type` or `@alias`, or a class from the standard-library stubs

#---- a_body_annotation_widens_the_signatures_type_parameter
#: <T> fn(fn: fn() -> T) -> T | NULL
attempt <- function(fn) {
  #: T | NULL
  result <- tryCatch(fn(), error = function(e) NULL)
  result
}
#++++
attempt: <T> fn(fn: fn() -> T) -> T | NULL
