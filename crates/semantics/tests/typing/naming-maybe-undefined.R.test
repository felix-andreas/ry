#---- a_closure_reads_the_enclosing_value_on_paths_that_skip_its_superassignment
#~~~~ R/main.R
f <- function(fun) {
  cache <- NULL
  function() {
    if (is.null(cache)) cache <<- fun()
    cache
  }
}
#++++
== R/main.R
f: <T> fn([fun]: fn() -> T) -> fn() -> T

#---- a_closure_local_assigned_on_one_path_might_be_undefined
