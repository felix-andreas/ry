#==== loops
#---- for_body_introduction_might_be_undefined_after_loop
#~~~~ R/main.R
f <- function() {
  for (item in list(1L)) {
    value <- 1L
  }
  value
}
#++++
== R/main.R
f: fn() -> integer
67..72 warning[maybe-undefined] `value` is only assigned on some paths here, so this read can find nothing.

