f <- function(flag) {
  function() {
    if (flag) cache <- 1L
    cache
  }
}
#++++
== R/main.R
f: fn(flag: logical) -> fn() -> integer
67..72 warning[maybe-undefined] `cache` is only assigned on some paths here, so this read can find nothing.

#==== outer_bindings
#---- a_top_level_binding_serves_the_unassigned_path
#~~~~ R/main.R
limit <- "all"
f <- function(ok) {
  if (ok) limit <- 5L
  limit
}
#++++
== R/main.R
limit: character
f: fn(ok: logical) -> integer | character

#---- a_binding_in_another_file_serves_the_unassigned_path
#~~~~ R/main.R
f <- function(ok) {
  if (ok) limit <- 5L
  limit
}
#~~~~ R/other.R
limit <- "all"
#++++
== R/main.R
f: fn(ok: logical) -> integer | character
== R/other.R
limit: character

#---- an_enclosing_function_binding_serves_the_unassigned_path
#~~~~ R/main.R
f <- function() {
  inner <- "start"
  function(flag) {
    if (flag) inner <- 2L
    inner
  }
}
#++++
== R/main.R
f: fn() -> fn(flag: logical) -> integer | character

#---- a_base_binding_serves_the_unassigned_path
#~~~~ R/main.R
