  if (ok) pi <- 3L
  pi
}
#++++
== R/main.R
f: fn(ok: logical) -> integer | double

#---- a_library_function_under_a_local_variable_is_left_out
#~~~~ R/main.R
g <- function(ok: logical) -> double {
  if (ok) max <- 3
  if (ok) return(max)
  0
}
#++++
== R/main.R
g: fn(ok: logical) -> double

#---- a_package_function_under_a_local_variable_is_left_out
# mgcv's timing: the read is guarded like the write, so it never reaches the
# package's own `t2`.
#~~~~ R/main.R
fit <- function(trace: logical) {
  if (trace) t2 <- proc.time()
  if (trace) print(proc.time() - t2)
  invisible(NULL)
}
#~~~~ R/smooth.R
t2 <- function(..., k = NA) list(k = k)
#++++
== R/main.R
fit: fn(trace: logical) -> NULL
== R/smooth.R
t2: <T> fn(...: Any, [k]: T) -> list{k: T}

#---- an_enclosing_function_under_a_local_variable_is_left_out
# mgcv's Newton loop: `ls` is bound by every iteration, and the enclosing
# function's `ls` is a different thing that shares the name.
#~~~~ R/main.R
family <- function() {
  ls <- function(y) list(ls = 0)
  saturated <- function(y) {
    for (i in 1:200) ls <- list(l = y)
    ls$l
  }
  list(ls = ls, saturated = saturated)
}
#++++
== R/main.R
family: <T, U> fn() -> list{ls: fn([y]: T) -> list{ls: double}, saturated: fn([y]: U) -> U}

#---- an_exit_handler_reads_a_name_written_after_it
# R runs the `on.exit` expression when the function returns, after the write.
#~~~~ R/main.R
read_file <- function(path: character) {
  on.exit(close(con))
  con <- file(path)
  readLines(con)
}
#++++
== R/main.R
read_file: fn(path: character) -> character[]

