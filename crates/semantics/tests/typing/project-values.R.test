#==== top_level_recursion
#---- self_recursive_top_level_function_stays_tolerant
#~~~~ R/fact.R
# A package-level self-recursive function keeps the fixed point's Unknown return on purpose:
# heterogeneous self-recursion (the tree fold T = double | list[T]) is untypeable in HM, and
# pinning the parameter through the recursive call manufactures call-site false positives.
# Unannotated consumers tolerate the Unknown; the mutual case below shows the typed contrast.
top_fact <- function(k) {
  if (k <= 1L) 1L else k * top_fact(k - 1L)
}
#~~~~ R/use.R
total <- top_fact(4L) + 1L
#++++
== R/fact.R
top_fact: fn(k: integer) -> integer
== R/use.R
total: integer

#---- mutual_top_level_recursion_types_through
#~~~~ R/pair.R
is_even <- function(n) if (n == 0L) TRUE else is_odd(n - 1L)
is_odd <- function(n) if (n == 0L) FALSE else is_even(n - 1L)
#~~~~ R/use.R
#: logical
check <- is_even(4L)
#++++
== R/pair.R
is_even: <T: numeric> fn(n: T) -> logical
is_odd: <T: numeric> fn(n: T) -> logical
== R/use.R
check: logical
