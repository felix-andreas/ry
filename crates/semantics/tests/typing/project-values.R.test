#==== data_masking
#---- data_table_syntax_produces_no_noise
#~~~~ R/dt.R
summarize_sales <- function(dt) {
  dt[region == "west", .(total = sum(amount)), by = product]
}
add_revenue <- function(dt) {
  dt[, revenue := price * quantity]
}
peek <- function(dt) {
  with(dt, mean(score_col))
}
#++++
== R/dt.R
summarize_sales: <T> fn(dt: T) -> Unknown
add_revenue: <T> fn(dt: T) -> Unknown
peek: <T> fn(dt: T) -> Unknown

