#---- a_script_sees_its_own_opaque_type
opaque Meters = list{value: double}

length <- @Meters(list(value = 1))
length$value
#++++
length: Meters
double

#---- an_inline_opaque_paired_with_a_comment_type_disagrees
#: @type Meters {double}
opaque Meters = double
#++++
32..38 warning[annotation-mismatch] the inline definition makes `Meters` an opaque type, but the `#:` comment declares it with `@type`. ry uses the inline definition; make the two agree, or delete one
  = 3..24 the `#:` comment's definition is here

#---- r_functions_still_reach_the_value
#~~~~ R/units.R
opaque Meters = list{value: double}

#: fn(value: double) -> Meters
meters <- function(value) @Meters(list(value = value))
#~~~~ R/use.R
#: fn(length: Meters) -> integer
size <- function(length) length(length)

#: fn(length: Meters) -> Meters
with_unit <- function(length) {
  attr(length, "unit") <- "m"
  length
}

#: fn(length: Meters) -> Any
peek <- function(length) unclass(length)$value
#++++
== R/units.R
meters: fn(value: double) -> Meters
== R/use.R
size: fn(length: Meters) -> integer
with_unit: fn(length: Meters) -> Meters
peek: fn(length: Meters) -> Any
