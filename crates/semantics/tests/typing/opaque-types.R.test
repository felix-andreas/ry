#==== opaque_types
#---- the_home_file_sees_the_representation
#~~~~ R/units.R
opaque Meters = list{value: double}

#: fn(value: double) -> Meters
meters <- function(value) {
  if (value < 0) stop("negative length")
  @Meters(list(value = value))
}

#: fn(length: Meters) -> double
in_feet <- function(length) length$value * 3.28

#: fn(length: Meters, by: double) -> Meters
stretch <- function(length, by) {
  length$value <- length$value * by
  length
}
#++++
== R/units.R
meters: fn(value: double) -> Meters
in_feet: fn(length: Meters) -> double
stretch: fn(length: Meters, by: double) -> Meters

#---- another_file_uses_the_type_through_its_functions
#~~~~ R/units.R
opaque Meters = list{value: double}

#: fn(value: double) -> Meters
meters <- function(value) @Meters(list(value = value))

#: fn(length: Meters) -> double
in_feet <- function(length) length$value * 3.28
#~~~~ R/use.R
#: fn(lengths: list[Meters]) -> double[]
all_in_feet <- function(lengths) vapply(lengths, in_feet, double(1))

kept <- meters(2)
in_feet(kept)
#++++
== R/units.R
meters: fn(value: double) -> Meters
in_feet: fn(length: Meters) -> double
== R/use.R
all_in_feet: fn(lengths: list[Meters]) -> double[]
kept: Meters
double

#---- another_file_cannot_create_one
#~~~~ R/units.R
opaque Meters = list{value: double}
#~~~~ R/use.R
forged <- @Meters(list(value = -1))

#: @new Meters
forged_comment <- list(value = -1)
#++++
== R/units.R
== R/use.R
forged: Unknown
forged_comment: Unknown
18..34 error[type-mismatch] `Meters` is opaque, so only the file that declares it can create one
  = 0..35 the type is declared opaque here
70..86 error[type-mismatch] `Meters` is opaque, so only the file that declares it can create one
  = 0..35 the type is declared opaque here

#---- another_file_cannot_read_or_write_the_representation
#~~~~ R/units.R
opaque Meters = list{value: double}
#~~~~ R/use.R
#: fn(length: Meters) -> double
read_field <- function(length) length$value

#: fn(length: Meters) -> double
read_element <- function(length) length[["value"]]

#: fn(length: Meters) -> Meters
overwrite <- function(length) {
  length$value <- -1
  length
}

#: fn(length: Meters) -> NULL
walk <- function(length) {
  for (item in length) print(item)
  NULL
}
#++++
== R/units.R
== R/use.R
read_field: fn(length: Meters) -> double
read_element: fn(length: Meters) -> double
overwrite: fn(length: Meters) -> Meters
walk: fn(length: Meters) -> NULL
