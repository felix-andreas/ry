#---- an_optional_opaque_value_is_still_opaque
#~~~~ R/units.R
opaque Meters = list{value: double}
#~~~~ R/use.R
#: fn(length: Meters | NULL) -> double
read_field <- function(length) if (is.null(length)) 0 else length$value
#++++
== R/units.R
== R/use.R
read_field: fn(length: Meters | NULL) -> double
98..104 error[type-mismatch] `Meters` is opaque, so its representation is hidden outside the file that declares it. Use that file's functions instead
  = 0..35 the type is declared opaque here

#---- another_file_cannot_match_an_opaque_union
#~~~~ R/shapes.R
opaque Shape = :Circle(radius: double) | :Square(side: double)

#: fn(radius: double) -> Shape
circle <- function(radius) @Shape(:Circle(radius = radius))
#~~~~ R/use.R
#: fn(shape: Shape) -> double
area <- function(shape) match (shape) {
  :Circle(radius = r) => 3.14 * r * r
  :Square(side = s) => s * s
}
#++++
== R/shapes.R
circle: fn(radius: double) -> Shape
== R/use.R
area: fn(shape: Shape) -> double
61..66 error[type-mismatch] `Shape` is opaque, so its representation is hidden outside the file that declares it. Use that file's functions instead
  = 0..62 the type is declared opaque here

#---- a_generic_opaque_type_is_applied_anywhere
#~~~~ R/stack.R
opaque Stack<T> = list{items: T[]}

#: <T> fn(items: T[]) -> Stack<T>
stack <- function(items) @Stack(list(items = items))
#~~~~ R/use.R
numbers <- stack(c(1, 2))

#: fn(numbers: Stack<double>) -> Stack<double>
keep <- function(numbers) numbers
#++++
== R/stack.R
stack: <T> fn(items: T[]) -> Stack<T>
== R/use.R
numbers: Stack<double>
keep: fn(numbers: Stack<double>) -> Stack<double>

