#==== list_shapes
#---- c_over_lists_appends
a <- list(1L, 2L)
b <- list(3L)
joined <- c(a, b)
appended <- c(a, list("x"))
#++++
a: list{integer, integer}
b: list{integer}
joined: list[integer]
appended: list[integer | character]

#---- a_fixed_shape_list_joins_into_an_open_element
mixed <- lapply(list(1L, "a"), function(x) x)
named <- lapply(list(a = 1L, b = "x"), function(x) x)
#++++
mixed: list[integer | character]
named: list[named: integer | character]

#---- a_partially_named_list_keeps_its_element_types
options <- list(1L, retries = 2L)
#++++
options: list[integer]

#---- an_empty_list_default_satisfies_a_named_list_parameter
#: fn([options]: list[named: integer]) -> integer
count <- function(options = list()) length(options)
#++++
count: fn([options]: list[named: integer]) -> integer

#==== construction
#---- combine_promotes
ints <- c(1L, 2L)
doubles <- c(1L, 2.5)
chars <- c(1L, "a")
named <- c(a = 1L, b = 2L)
empty <- c()
dropped <- c(1L, NULL)
#++++
ints: integer[]
doubles: double[]
chars: character[]
named: integer[named]
empty: NULL
dropped: integer[]

#---- list_shapes
tuple <- list(1L, "a")
record <- list(a = 1L, b = "s")
empty <- list()
#++++
tuple: list{integer, character}
record: list{a: integer, b: character}
empty: list{}

#---- a_partially_named_list_joins_its_element_types
f <- function() list(1L, b = 2L)
#++++
f: fn() -> list[integer]

#==== extraction
#---- tuple_literal_position
f <- function() {
  x <- list(1L, "a")
  x[[1L]]
}
#++++
f: fn() -> integer

#---- record_field
f <- function() {
  p <- list(a = 1L, b = "s")
  p$b
}
#++++
f: fn() -> character

#---- computed_index_unions
f <- function(i) {
  x <- list(1L, "a")
  x[[i]]
}
#++++
f: <T> fn(i: T) -> integer | character

#---- named_vector_by_name_is_nullable
f <- function() {
  v <- c(a = 1L)
  v[["a"]]
}
#++++
f: fn() -> integer | NULL

#---- slice_is_a_sub_list
f <- function() {
  x <- list(1L, "a")
  x[1L]
}
#++++
f: fn() -> list[integer | character]

#---- element_extraction_on_vectors
f <- function() c(1L, 2L)[[1L]]
g <- function() 5L[[1L]]
#++++
f: fn() -> integer
g: fn() -> integer

#---- map_like_list_positional_extraction_is_precise
#: list[named: integer]
scores <- list(a = 1L, b = 2L)
f <- function() scores[["a"]]
g <- function() scores[[1L]]
#++++
scores: list[named: integer]
f: fn() -> integer | NULL
g: fn() -> integer

#---- record_extraction_by_literal_position
person <- list(name = "ada", age = 36L)
f <- function() person[[1L]]
g <- function() person[[2L]]
#++++
person: list{name: character, age: integer}
f: fn() -> character
g: fn() -> integer

#---- backtick_field_follows_dollar_rules
config <- list(`max size` = 10L)
f <- function() config$`max size`
#++++
config: list{`max size`: integer}
f: fn() -> integer

#---- record_slice_unions_field_types
person <- list(name = "ada", age = 36L)
f <- function() person[1L]
#++++
person: list{name: character, age: integer}
f: fn() -> list[named: character | integer]

#---- indexing_an_unpinned_parameter_stays_unknown
f <- function(node) node$value
g <- function(x) x[[1L]]
h <- function(x) x[1L]
#++++
f: <T> fn(node: T) -> Unknown
g: <T> fn(x: T) -> Unknown
h: <T> fn(x: T) -> Unknown

#==== record_mismatch
#---- one_bad_field_names_the_field_not_both_types
# Both types printed side by side are long near-identical strings the reader has
# to diff by eye; the field that failed is the whole finding.
#: fn(row: list{id: integer, label: character, amount: double, active: logical}) -> integer
row_id <- function(row) row$id
print(row_id(list(id = 1L, label = "a", amount = 2, active = "yes")))
#++++
row_id: fn(row: list{id: integer, label: character, amount: double, active: logical}) -> integer
327..332 error[type-mismatch] expected `logical` for field `active`, found `character`

#---- a_nested_field_names_the_path
#: fn(settings: list{name: character, retry: list{count: integer, delay: double}}) -> integer
tries <- function(settings) settings$retry$count
print(tries(list(name = "job", retry = list(count = "3", delay = 0.5))))
#++++
tries: fn(settings: list{name: character, retry: list{count: integer, delay: double}}) -> integer
195..198 error[type-mismatch] expected `integer` for field `retry.count`, found `character`

#---- a_renamed_field_reads_as_the_typo_it_is
# A rename goes missing and turns up misspelled at once, so the finding names
# both rather than reporting the absence alone.
#: fn(row: list{identifier: integer, label: character}) -> integer
row_id <- function(row) row$identifier
print(row_id(list(idenifier = 1L, label = "a")))
#++++
row_id: fn(row: list{identifier: integer, label: character}) -> integer
245..278 error[type-mismatch] expected a field `identifier` here, and this list has `idenifier` instead. Check the spelling

#---- a_missing_field_with_no_near_miss_says_so
#: fn(row: list{id: integer, label: character}) -> integer
row_id <- function(row) row$id
print(row_id(list(id = 1L)))
#++++
row_id: fn(row: list{id: integer, label: character}) -> integer
103..116 error[type-mismatch] expected a field `label` here, which this list does not have

#---- a_surplus_field_is_reported_after_the_paired_ones
#: fn(row: list{id: integer}) -> integer
row_id <- function(row) row$id
print(row_id(list(id = 1L, extra = 2L)))
#++++
row_id: fn(row: list{id: integer}) -> integer
99..104 error[type-mismatch] this list has a field `extra`, which is not expected here

#---- fields_pair_by_name_so_order_does_not_matter
#: fn(row: list{id: integer, label: character}) -> integer
row_id <- function(row) row$id
print(row_id(list(label = "a", id = 1L)))
#++++
row_id: fn(row: list{id: integer, label: character}) -> integer

#---- the_caret_falls_back_to_the_value_when_there_is_no_field_to_point_at
# The path is walked against the expression that BUILT the record, so a variable
# holding one has no field expression to underline and the whole value stays the
# blame. The message still names the field.
#: fn(row: list{id: integer, label: character}) -> integer
row_id <- function(row) row$id
built <- list(id = 1L, label = 7L)
print(row_id(built))
#++++
row_id: fn(row: list{id: integer, label: character}) -> integer
built: list{id: integer, label: integer}
344..349 error[type-mismatch] expected `character` for field `label`, found `integer`

#---- a_new_nominal_narrows_to_the_field_too
# `@new` checks the value against the representation, so it is the same
# comparison and gets the same caret.
#: @type Person {list{name: character, age: integer}}

#: @new Person
who <- list(name = "Ada", age = "36")
print(who)
#++++
who: Unknown
212..216 error[type-mismatch] expected `integer` for field `age`, found `character`

#---- a_record_against_a_non_record_keeps_both_types
# Not a failure about one field, so the whole types are what explain it.
#: fn(row: list{id: integer}) -> integer
row_id <- function(row) row$id
print(row_id(42L))
#++++
row_id: fn(row: list{id: integer}) -> integer
158..161 error[type-mismatch] expected `list{id: integer}`, found `integer`

#---- a_record_against_an_array_like_list_keeps_both_types
#: fn(xs: list[integer]) -> integer
first <- function(xs) xs[[1]]
print(first(list(a = 1L, b = "two")))
#++++
first: fn(xs: list[integer]) -> integer
78..101 error[type-mismatch] expected `list[integer]`, found `list{a: integer, b: character}`

#==== errors
#---- position_out_of_range
f <- function() {
  x <- list(1L, "a")
  x[[3L]]
}
#++++
f: Unknown
41..48 error[type-mismatch] position 3 does not exist in `list{integer, character}`

#---- field_does_not_exist
f <- function() {
  p <- list(a = 1L)
  p$oops
}
#++++
f: Unknown
42..46 error[type-mismatch] field `oops` does not exist in `list{a: integer}`

#---- a_field_only_some_shapes_carry_reads_as_nullable
# The accumulator idiom: R answers NULL for a name a list does not carry, so a
# field present in one branch's shape and absent in the other's is `T | NULL`,
# not an error.
build <- function(escape) {
  args <- list()
  if (escape) args$escape <- TRUE
  args$escape
}
#++++
build: fn(escape: logical) -> logical | NULL

#---- a_field_no_shape_carries_is_still_a_typo
# The same union, misspelled: absent from every shape stays an error, which is
# the check worth having.
build <- function(escape) {
  args <- list()
  if (escape) args$escape <- TRUE
  args$escpae
}
#++++
build: Unknown
191..197 error[type-mismatch] field `escpae` does not exist in `list{} | list{escape: logical}`. Did you mean `escape`?

#---- dollar_on_atomic_vector
f <- function() {
  v <- c(a = 1L)
  v$a
}
#++++
f: Unknown
37..40 error[type-mismatch] R's `$` operator is invalid on atomic vectors, and this value is `integer[named]`. Extract an element with `[[` instead.

#---- matrix_indexing_unsupported
f <- function() {
  x <- list(1L)
  x[1L, 2L]
}
#++++
f: Unknown
36..45 error[type-mismatch] indexing with 2 indexes is not supported yet. ry does not model matrix and data.frame subsetting

#==== replacement
#---- known_field_write
f <- function() {
  p <- list(a = 1L)
  p$a <- "s"
  p$a
}
#++++
f: fn() -> character

#---- computed_key_builds_a_map
f <- function(key) {
  m <- list()
  m[[key]] <- 1L
  m[[key]]
}
#++++
f: <T> fn(key: T) -> integer

#---- replacement_call_keeps_the_type
f <- function() {
  v <- c(1L, 2L)
  names(v) <- c("a", "b")
  v + 1L
}
#++++
f: fn() -> integer[]

#---- matrix_style_single_selection_refuses_silently
pick <- function(m, i) m[, i]
#++++
pick: <T, U> fn(m: T, i: U) -> Unknown

#---- two_filled_indexes_report_the_filled_count
cell <- function(m, k) m[k, , drop = FALSE]
#++++
cell: <T, U> fn(m: T, k: U) -> Unknown

#==== vector_subsetting
#---- scalar_index_selects_one_element
f <- function() c(1L, 2L, 3L)[2L]
g <- function() c("a", "b")[1]
h <- function() 5L[1L]
#++++
f: fn() -> integer
g: fn() -> character
h: fn() -> integer

#---- vector_index_selects_a_sub_vector
f <- function() c(1L, 2L, 3L)[c(1L, 3L)]
g <- function() c(1L, 2L, 3L)[1:2]
h <- function() 5L[c(1L, 2L)]
#++++
f: fn() -> integer[]
g: fn() -> integer[]
h: fn() -> integer[]

#---- logical_mask_keeps_the_vector_shape
#: double[]
values <- c(1.5, -2.0, 3.0)
f <- function() values[values > 0]
g <- function() values[TRUE]
#++++
values: double[]
f: fn() -> double[]
g: fn() -> double[]

#---- named_subject_keeps_names_under_vector_indexes
#: integer[named]
scores <- c(a = 1L, b = 2L)
f <- function() scores[c("a", "b")]
g <- function() scores["a"]
h <- function() scores[c(TRUE, FALSE)]
#++++
scores: integer[named]
f: fn() -> integer[named]
g: fn() -> integer
h: fn() -> integer[named]

#---- character_index_is_allowed_on_unnamed_vectors
f <- function() c(1L, 2L)["a"]
#++++
f: fn() -> integer

#---- undetermined_index_claims_a_scalar
f <- function(x, i) {
  #: integer[]
  values <- c(1L, 2L)
  values[i]
}
#++++
f: <T, U> fn(x: T, i: U) -> integer

#---- invalid_vector_indexes_error
f <- function() c(1L, 2L)[list(1)]
g <- function() c(1L, 2L)[sum]
#++++
f: Unknown
g: Unknown
16..34 error[type-mismatch] a vector cannot be indexed by `list{double}`. Expected a numeric, logical, or character index
51..65 error[type-mismatch] a vector cannot be indexed by `fn(...: Any, [na.rm]: logical) -> Any`. Expected a numeric, logical, or character index
