#---- arithmetic_on_a_list_may_dispatch_to_a_project_method
"+.string" <- function(x, y) {
  x$text <- paste(x$text, as.character(y), sep = "")
  x
}
string <- function(text) {
  x <- list(text = text)
  class(x) <- "string"
  x
}
render <- function(label) {
  result <- string("")
  result <- result + label + " and " + "more"
  result$text
}
#++++
