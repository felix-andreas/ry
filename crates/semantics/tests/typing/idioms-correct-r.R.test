#---- a_function_or_a_value_is_called_as_the_function
prefixer <- function(namespace, id) {
  f <- function(id) paste(namespace, id, sep = "-")
  if (missing(id)) f else f(id)
}
scoped <- function(namespace, name) {
  ns <- prefixer(namespace)
  ns(name)
}
#++++
