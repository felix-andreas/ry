#---- a_discarded_if_does_not_tie_its_branches_together
nm <- function(x, v) { names(x) <- paste0(v, "a"); x }
sa <- function(x, name, value) {
  if (name == "names" && length(x) && !is.null(value))
    nm(x, value)
  else
    attr(x, name) <- value
  invisible(x)
}
sa(1, "names", NULL)
#++++
nm: <T, U> fn(x: T, v: U) -> T
sa: <T, U, V> fn(x: T, name: U, value: V | NULL) -> T
double

#---- a_branch_that_rebinds_a_parameter_does_not_pin_its_type
lookup <- function(repo = NULL) {
  if (is.null(repo) || identical(repo, ".")) {
    repo <- getwd()
  } else if (inherits(repo, "git_repository")) {
    return(repo)
  }
  structure(list(path = repo), class = "git_repository")
}
lookup(lookup("."))
#++++
lookup: fn([repo]: Unknown) -> Unknown
Unknown

