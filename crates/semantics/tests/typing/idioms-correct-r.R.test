#---- a_formal_tested_by_an_rlang_type_predicate_takes_any_type
is_string <- function(x) is.character(x) && length(x) == 1
as_function <- function(x) {
  if (is_string(x)) return(get(x, mode = "function"))
  x
}
map <- function(.x, .f, ...) {
  .f <- as_function(.f)
  lapply(.x, .f, ...)
}
g <- function(xs) map(xs, function(d) d + 1)
h <- function(xs) map(xs, "identity")
