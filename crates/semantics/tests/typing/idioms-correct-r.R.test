#---- negating_a_parameter_shaped_by_an_is_null_test
fifo_mode <- function(read = NULL, write = NULL) {
  if (is.null(read) && is.null(write)) {
    read <- TRUE
    write <- FALSE
  }
  if (is.null(read)) read <- !write
  if (is.null(write)) write <- !read
  read && write
}
#++++
fifo_mode: fn([read]: logical | NULL, [write]: logical | NULL) -> logical

#---- a_formal_passed_to_a_parameter_base_r_tests_with_missing_is_optional
reduce <- function(.x, .f, ..., .init) {
  f <- function(x, y) .f(x, y, ...)
  Reduce(f, .x, init = .init)
}
total <- function(values) reduce(values, `+`)
guarded <- function(expr, ..., finally) {
  base::tryCatch(expr, ..., finally = finally)
}
run <- function() guarded(1 + 1)
#++++
reduce: <T, U> fn(.x: list[T] | T[], .f: fn(U, T, ...: Any) -> U, ...: Any, [.init]: U) -> U
total: <T, U> fn(values: list[T] | T[]) -> U
guarded: <T, U> fn(expr: T, ...: Any, [finally]: U) -> Unknown
run: fn() -> Unknown

