#==== chained_definitions
#---- every_target_of_a_chain_is_a_top_level_function
#~~~~ R/memo.R
memoise <- memoize <- function(f, cache = NULL) f
#~~~~ R/use.R
a <- memoise(abs)
b <- memoize(abs)
c <- memoize(abs, 1, 2)
#++++
== R/memo.R
memoise: <T, U> fn(f: T, [cache]: U) -> T
== R/use.R
a: fn(x: Any) -> Any
b: fn(x: Any) -> Any
c: Unknown
57..58 error[type-mismatch] this call passes 3 positional arguments, but the function only takes 2

#==== dispatch_variables
#---- a_method_reads_the_dispatch_variables
#~~~~ R/ops.R
Ops.money <- function(e1, e2) {
  if (.Generic %in% c("+", "-")) NextMethod() else stop(.Generic, " is not supported")
}
print.money <- function(x, ...) {
  cat(.Class[1], .Method, "\n")
  invisible(x)
}
#++++
== R/ops.R
Ops.money: <T, U> fn([e1]: T, [e2]: U) -> Any
print.money: <T> fn(x: T, ...: Any) -> T

