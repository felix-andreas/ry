#==== top_level
#---- top_level_reference
#~~~~ R/main.R
x <- 1L
x
#++++
== R/main.R
x: integer
integer

#---- top_level_reference_before_first_binding
#~~~~ R/main.R
x
x <- 1L
#++++
== R/main.R
integer
x: integer

#---- top_level_call_resolves_callee_and_argument
#~~~~ R/main.R
value <- 1L
mirror <- function(x) x
mirror(value)
#++++
== R/main.R
value: integer
mirror: <T> fn(x: T) -> T
integer

#---- distinct_top_level_bindings_have_distinct_uses
#~~~~ R/main.R
x <- 1L
y <- "ok"
x
y
#++++
== R/main.R
x: integer
y: character
integer
character

#==== rebinding
#---- top_level_rebinding_creates_fresh_binding
#~~~~ R/main.R
x <- 1L
x <- "ok"
x
#++++
== R/main.R
x: integer
x: character
character
0..1 warning[duplicate] Top-level binding `x` is overwritten by a later top-level binding in this package.
  = 8..9 the later binding is here.
8..9 warning[duplicate] Top-level binding `x` overwrites an earlier top-level binding in this package.
  = 0..1 the earlier binding is here.

#---- earlier_use_resolves_to_final_global_binding
#~~~~ R/main.R
x <- 1L
x
x <- "ok"
x
#++++
== R/main.R
x: integer
integer
x: character
character

#---- assignment_rhs_resolves_to_the_earlier_binding
#~~~~ R/main.R
x <- 1L
x <- x
x
#++++
== R/main.R
x: integer
x: integer
integer

#==== read_between_definitions
# A rebinding whose earlier value is read in between is a deliberate update,
# not a lost definition, so neither binding is reported as a duplicate.
#---- an_update_that_reads_the_earlier_value_is_not_a_duplicate
#~~~~ R/main.R
x <- c(1, 2)
x <- c(x, 3)
helper <- function() x
#++++
== R/main.R
x: double[]
x: double[]
helper: fn() -> double[]

#---- a_temporary_read_between_rebindings_is_not_a_duplicate
#~~~~ R/main.R
tmp <- 1
first <- tmp * 2
tmp <- 5
second <- tmp * 2
#++++
== R/main.R
tmp: double
first: double
tmp: double
second: double

#---- a_read_only_inside_a_function_does_not_count
# The function body runs later, after the second binding replaced the first.
#~~~~ R/main.R
tmp <- 1
f <- function() tmp
tmp <- 5
#++++
== R/main.R
tmp: double
f: fn() -> double
tmp: double
0..3 warning[duplicate] Top-level binding `tmp` is overwritten by a later top-level binding in this package.
  = 29..32 the later binding is here.
29..32 warning[duplicate] Top-level binding `tmp` overwrites an earlier top-level binding in this package.
  = 0..3 the earlier binding is here.

#---- a_loop_that_updates_the_binding_reads_it
#~~~~ R/main.R
rownum <- 0
for (i in 1:3) rownum <- rownum + 1
rownum <- 10
#++++
== R/main.R
rownum: double
NULL
rownum: double

#---- set_generic_turns_the_existing_function_into_the_generic
#~~~~ R/main.R
area <- function(shape) 0
setGeneric("area")
#++++
== R/main.R
area: <T> fn([shape]: T) -> double
character

#---- set_generic_with_a_def_keeps_the_existing_function_as_default
#~~~~ R/main.R
area <- function(shape) 0
setGeneric("area", function(shape) standardGeneric("area"))
#++++
== R/main.R
area: <T> fn([shape]: T) -> double
character

#==== chained_definitions
#---- every_target_of_a_chain_is_a_top_level_function
#~~~~ R/memo.R
memoise <- memoize <- function(f, cache = NULL) f
#~~~~ R/use.R
a <- memoise(abs)
b <- memoize(abs)
c <- memoize(abs, 1, 2)
#++++
== R/memo.R
memoise: <T, U> fn(f: T, [cache]: U) -> T
== R/use.R
a: fn(x: Any) -> Any
b: fn(x: Any) -> Any
c: Unknown
57..58 error[type-mismatch] this call passes 3 positional arguments, but the function only takes 2

#==== dispatch_variables
#---- a_method_reads_the_dispatch_variables
#~~~~ R/ops.R
Ops.money <- function(e1, e2) {
  if (.Generic %in% c("+", "-")) NextMethod() else stop(.Generic, " is not supported")
}
print.money <- function(x, ...) {
  cat(.Class[1], .Method, "\n")
  invisible(x)
}
#++++
== R/ops.R
Ops.money: <T, U> fn([e1]: T, [e2]: U) -> Any
print.money: <T> fn(x: T, ...: Any) -> T

#---- the_top_level_does_not_see_them
#~~~~ R/ops.R
generic <- .Generic
#++++
== R/ops.R
generic: Unknown
