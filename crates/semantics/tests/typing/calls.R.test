f <- function(x) grepl(1L, x)
#++++
f: Unknown
23..25 error[type-mismatch] expected `character`, found `integer`

#---- namespace_access
f <- function(x) base::length(x)
#++++
f: <T> fn(x: T) -> integer

#==== matching
#---- named_arguments_match_formals
f <- function() {
  g <- function(x, y) x
  g(y = 1L, x = "a")
}
#++++
f: fn() -> character

#---- unknown_named_argument
f <- function() {
  g <- function(x) x
  g(z = 1)
}
#++++
f: Unknown
43..44 error[type-mismatch] this function has no parameter `z` — its named parameter is `x`

#---- surplus_positional
f <- function() {
  g <- function(x) x
  g(1, 2)
}
#++++
f: Unknown
46..47 error[type-mismatch] this call passes 2 positional arguments, but the function only takes 1

#---- missing_required
f <- function() {
  g <- function(x, y) x
  g(1L)
}
#++++
f: Unknown
44..45 error[type-mismatch] this call supplies 1 argument, but the function requires 2 — a required argument is missing

#---- defaulted_formal_may_stay_unfilled
f <- function() {
  g <- function(x, y = 2L) x
  g(1L)
}
#++++
f: fn() -> integer

#---- a_name_claims_its_formal_before_positionals_are_placed
# R matches exact names first and only then fills positionals around them, so
# `TRUE` lands on `c` rather than colliding with the named `b`.
#: fn(a: integer, b: character, c: logical) -> integer
three <- function(a, b, c) a

use <- function() three(1L, TRUE, b = "x")
#++++
three: fn(a: integer, b: character, c: logical) -> integer
use: fn() -> integer

#---- a_named_callback_lets_a_positional_reach_the_later_formal
# The real-world shape: `FUN` is given by name, so `character(1)` fills
# `FUN.VALUE` instead of being matched against `FUN`.
label <- function(xs) vapply(xs, character(1), FUN = as.character)
#++++
label: <T> fn(xs: list[T] | T[]) -> character[]

#==== omitted_defaults
#---- an_omitted_argument_takes_the_defaults_type
# R evaluates the default in the function's own frame, so `lucky()` is the
# double 1. Leaving the parameter a free variable made the result `Any`, which
# is compatible with everything and silenced every check below it.
lucky <- function(x = 1) x
omitted <- lucky()
supplied <- lucky("text")
#++++
lucky: <T> fn([x]: T) -> T
omitted: double
supplied: character

#---- the_silence_that_cost_is_now_a_finding
# `shout(lucky())` is `nchar(1)` at run time. It reported nothing while the
# omitted argument yielded `Any`.
#: fn(s: character) -> integer
shout <- function(s) nchar(s)

lucky <- function(x = 1) x
caught <- shout(lucky())
ok <- shout(lucky("text"))
#++++
shout: fn(s: character) -> integer
lucky: <T> fn([x]: T) -> T
caught: Unknown
ok: integer
215..222 error[type-mismatch] expected `character`, found `double`

#---- a_default_reading_an_earlier_parameter_flows_through
pair <- function(x, y = x) y
from_pair <- pair(1L)
#++++
pair: <T, U> fn(x: T, [y]: U) -> U
from_pair: integer

#---- a_default_closes_at_the_item_boundary_like_the_parameter_it_belongs_to
# A default's type is part of the exported signature, and while the item is
# being checked it may be an inference variable of THAT item's table. Reaching
# a reader unclosed, the id either points past the end of the reader's own
# table or names an unrelated variable of it — here every parameter but `i` is
# pinned by its use, so the reader's table is smaller than the id the default
# carried.
choose <- function(a, b, c, d, e, g, h, i, j = i) {
  if (a) 1L
  if (b) 1L
  if (c) 1L
  if (d) 1L
  if (e) 1L
  if (g) 1L
  if (h) 1L
  j
}
picked <- choose(TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, 1L)
#++++
choose: <T, U> fn(a: logical, b: logical, c: logical, d: logical, e: logical, g: logical, h: logical, i: T, [j]: U) -> U
picked: integer

#---- a_declared_binder_admits_its_own_default
# The scheme the checker infers for this shape is writable as an annotation:
# a binder is the caller's choice, and omitting the argument is the one call
# where the default makes that choice.
#: <T> fn([x]: T) -> T
fine <- function(x = 1) x
#++++
fine: <T> fn([x]: T) -> T

#---- a_constrained_binder_still_refuses_a_default_outside_its_bound
#: <T: numeric> fn([x]: T) -> T
bad <- function(x = "text") x
#++++
bad: <T: numeric> fn([x]: T) -> T
52..58 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- a_concrete_declared_type_still_refuses_a_null_default
#: fn([title]: character) -> character
label <- function(title = NULL) "x"
#++++
label: fn([title]: character) -> character
65..69 error[type-mismatch] `title` defaults to `NULL`, which its declared type `character` does not admit — a caller who omits it leaves `NULL` in the body. Declare it `character | NULL` and narrow with `is.null()`

#==== union_commit
#---- flexible_argument_commits_to_the_union_at_first_use
#: fn(x: integer | character) -> logical
first <- function(x) TRUE
#: fn(x: logical | character) -> logical
second <- function(x) TRUE
both <- function(v) {
  first(v)
  second(v)
}
#++++
first: fn(x: integer | character) -> logical
second: fn(x: logical | character) -> logical
both: Unknown
177..178 error[type-mismatch] expected `logical | character`, found `integer | character`

#---- union_commit_blames_the_later_conflicting_use
#: fn(x: integer | logical) -> logical
first <- function(x) TRUE
#: fn(x: character | logical) -> logical
second <- function(x) TRUE
both <- function(v) {
  second(v)
  first(v)
}
#++++
first: fn(x: integer | logical) -> logical
second: fn(x: character | logical) -> logical
both: Unknown
175..176 error[type-mismatch] expected `integer | logical`, found `character | logical`

#---- a_logical_member_promotes_into_an_integer_member
#: fn(x: integer | character) -> logical
first <- function(x) TRUE
#: fn(x: logical | character) -> logical
second <- function(x) TRUE
both <- function(v) {
  second(v)
  first(v)
}
#++++
first: fn(x: integer | character) -> logical
second: fn(x: logical | character) -> logical
both: fn(v: logical | character) -> logical

#---- vapply_checks_the_callback_against_its_template
xs <- c(1, 2, 3)
labels <- vapply(xs, function(v) as.character(v), character(1))
wrong <- vapply(xs, function(v) as.character(v), numeric(1))
#++++
xs: double[]
labels: character[]
wrong: Unknown
130..140 error[type-mismatch] expected `character[] | character`, found `double[]`

#---- a_switch_result_that_may_be_null_reports_the_nullability
pick <- function(kind) {
  fn <- switch(kind, upper = toupper, lower = tolower)
  fn("Text")
}
#++++
pick: Unknown
82..84 error[type-mismatch] this may be `NULL` here, so calling it is not safe — its type is `(fn(x: Any) -> character) | NULL`. Guard it with `is.null()`, or give the `switch` a default branch

#---- a_default_branch_makes_the_switch_result_callable
pick <- function(kind) {
  fn <- switch(kind, upper = toupper, tolower)
  fn("Text")
}
#++++
pick: <T> fn(kind: T) -> character

#==== higher_order
#---- callback_pairs_positionally
apply1 <- function() {
  call_with <- function(f) f(1L)
  call_with(function(x) x + 1L)
}
#++++
apply1: fn() -> integer

#---- dispatch_table_union
f <- function(flag) {
  h <- if (flag) function(x) 1L else function(x) "a"
  h(2L)
}
#++++
f: fn(flag: logical) -> integer | character

#---- lapply_maps_the_element_type
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, nchar)
}
#++++
f: fn() -> list[integer]

#---- lapply_keeps_its_input_names
# "named list in, named list out" — and a plain list or a vector still comes back
# unnamed.
f <- function() lapply(list(a = 1L, b = 2L), function(v) v + 1L)
g <- function() lapply(list(1L, 2L), function(v) v + 1L)
h <- function() lapply(c(1L, 2L), function(v) v + 1L)
#++++
f: fn() -> list[named: integer]
g: fn() -> list[integer]
h: fn() -> list[integer]

#---- filter_hands_back_the_shape_it_was_given
# `Filter` selects with `[`, so an atomic vector stays an atomic vector — typing
# it as a list would reject the arithmetic below, which R runs happily.
f <- function() Filter(function(v) v > 1, c(1, 2, 3)) + 1
g <- function() Filter(function(v) v > 1, list(a = 1, b = 2))
h <- function() Filter(function(v) v > 1, list(1, 2))
#++++
f: fn() -> double[]
g: fn() -> list[named: double]
h: fn() -> list[double]

#---- selecting_and_reordering_a_list_keeps_its_names
# A field read on the result is the point: without the names these are
# missing-field errors against code R runs. The read is `T | NULL` because the
# result is a name-keyed list whose key set is not statically known — selecting
# (`head`, `Filter`) really can drop a name. A record-in/record-out claim would
# be exact for `rev` alone, and the type language cannot state it for a stub.
opts <- list(a = 1, b = 2)
reversed <- rev(opts)$a
deduplicated <- unique(opts)$b
first <- utils::head(opts, 1L)$a
last <- utils::tail(opts, 1L)$b
#++++
opts: list{a: double, b: double}
reversed: double | NULL
deduplicated: double | NULL
first: double | NULL
last: double | NULL

#---- lapply_forwards_extra_arguments
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, gsub, pattern = "a", replacement = "o")
}
#++++
f: fn() -> list[character]

#---- lapply_rejects_a_wrong_callback
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, function(a, b) a)
}
#++++
f: Unknown
64..80 error[type-mismatch] expected `fn(character) -> T`, found `fn(a: U, b: V) -> U`

#---- a_function_with_spare_optionals_serves_a_narrower_interface
# An interface promises a range of call shapes; a function serves it when it
# accepts all of them. Extra parameters are fine when they default.
#: fn(callback: fn(integer) -> integer) -> integer
run_one <- function(callback) callback(1L)

#: fn(a: integer, [b]: integer) -> integer
one_plus_optional <- function(a, b = 2L) a + b

use <- function() run_one(one_plus_optional)
#++++
run_one: fn(callback: fn(integer) -> integer) -> integer
one_plus_optional: fn(a: integer, [b]: integer) -> integer
use: fn() -> integer

#---- an_interface_still_refuses_what_it_cannot_call
# The relaxation is one-directional: requiring more than the interface passes,
# or accepting fewer arguments than it sends, are both still errors.
#: fn(callback: fn(integer) -> integer) -> integer
run_one <- function(callback) callback(1L)

#: fn(a: integer, b: integer) -> integer
needs_two <- function(a, b) a + b

#: fn() -> integer
takes_none <- function() 1L

too_many <- function() run_one(needs_two)
too_few <- function() run_one(takes_none)
#++++
run_one: fn(callback: fn(integer) -> integer) -> integer
needs_two: fn(a: integer, b: integer) -> integer
takes_none: fn() -> integer
too_many: Unknown
too_few: Unknown
398..407 error[type-mismatch] expected `fn(integer) -> integer`, found `fn(a: integer, b: integer) -> integer`
439..449 error[type-mismatch] expected `fn(integer) -> integer`, found `fn() -> integer`

#---- a_list_of_functions_maps
# Every member of the element union must serve the callback interface; the
# stdlib reductions do, despite their optional parameters.
f <- function() lapply(list(mean, sd), function(g) g(1:3))
#++++
f: fn() -> list[double]

#---- missing_tested_formal_is_optional
f <- function() {
  g <- function(x, tag) {
    if (missing(tag)) x else tag
  }
  g(1L)
}
#++++
f: fn() -> integer

#---- unknown_typed_parameter_accepts_anything
user <- function(w) helper("text")
helper <- function(r) {
  if (!isRestart(r)) r <- findRestart(r)
  r
}
#++++
user: <T> fn(w: T) -> Unknown
helper: fn(r: Unknown) -> Unknown

#---- walrus_outside_masked_brackets_is_an_operator_call
f <- function(a, b) quo(a := b)
#++++
f: <T, U> fn(a: T, b: U) -> Unknown
20..23 warning[unresolved] I could not resolve `quo` in this package, its imports, or builtins.
26..28 warning[unresolved] I could not resolve ``:=`` in this package, its imports, or builtins.

#---- any_callee_arguments_are_not_checked
fail_with <- function(x) stop(paste0("bad: ", class(x)[1]))
checked <- function(x) paste0("bad: ", class(x)[1])
#++++
fail_with: <T> fn(x: T) -> Unknown
checked: <T> fn(x: T) -> character

#---- a_callback_names_the_parameter_that_refuses_the_element
# The two whole signatures cannot say this: the lambda's parameter is a
# constrained variable, and a constraint does not survive into a rendered type,
# so `fn(s: U) -> U` prints the same whether `U` takes anything or only numbers
# — against `fn(character) -> T` it reads as a call that should have fit.
f <- function() {
  words <- list("a", "b")
  lapply(words, function(s) s + 1L)
}
#++++
f: Unknown
368..386 error[type-mismatch] this function is passed `character`, but its parameter `s` is used as a numeric value (`integer` or `double`)

#---- a_callback_names_the_return_that_the_interface_refuses
f <- function() {
  words <- list("a", "b")
  Filter(function(s) s + 1L, words)
}
#++++
f: Unknown
53..71 error[type-mismatch] this function must return `logical`, but its body produces a numeric value (`integer` or `double`)

#---- a_named_callback_parameter_reports_its_own_type
#: fn(cb: fn(integer) -> integer) -> integer
run <- function(cb) cb(1L)

#: fn(s: character) -> integer
bad <- function(s) nchar(s)

out <- run(bad)
#++++
run: fn(cb: fn(integer) -> integer) -> integer
bad: fn(s: character) -> integer
out: Unknown
144..147 error[type-mismatch] this function is passed `integer`, but its parameter `s` accepts `character`

#---- a_shape_disagreement_still_shows_both_signatures
# Arity is the one disagreement the two whole signatures do explain, so it keeps
# the mismatch rather than naming a position that does not pair.
#: fn(cb: fn(integer) -> integer) -> integer
run <- function(cb) cb(1L)

#: fn(a: integer, b: integer) -> integer
two <- function(a, b) a + b

out <- run(two)
#++++
run: fn(cb: fn(integer) -> integer) -> integer
two: fn(a: integer, b: integer) -> integer
out: Unknown
300..303 error[type-mismatch] expected `fn(integer) -> integer`, found `fn(a: integer, b: integer) -> integer`

#==== exported_constraints
#---- higher_order_result_keeps_its_constraint_across_items
invoke <- function(f) function(x) f(x + 1L)
mirror <- function(x) x
mixed_apply <- invoke(mirror)
bad <- mixed_apply("ok")
ok <- mixed_apply(2L)
#++++
invoke: <T: numeric, U> fn(f: fn(T) -> U) -> fn(x: T) -> U
mirror: <T> fn(x: T) -> T
mixed_apply: <T: numeric> fn(x: T) -> T
bad: Unknown
ok: integer
117..121 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- undetermined_argument_uses_the_general_candidate
wrap <- function(x) sum(x)
#++++
wrap: <T> fn(x: T) -> Any

#---- corpus_overload_sets_end_in_a_general_candidate
f <- function() cumsum("word")
#++++
f: fn() -> Any

#---- overloaded_name_as_a_value_sees_the_first_declaration
folder <- cumsum
#++++
folder: fn(x: Any) -> Any

#---- local_binding_disables_the_overload_set
cumsum <- function(x) "shadowed"
f <- function() cumsum(1L)
#++++
cumsum: <T> fn(x: T) -> character
f: fn() -> character

#---- optional_display_formals_work_directly_and_as_callbacks
f <- function() nchar("word", type = "bytes")
g <- function() lapply(list("a", "bb"), nchar)
#++++
f: fn() -> integer
g: fn() -> list[integer]

#---- forwarded_dots_disable_arity_checking
two <- function(a, b) a + b
wrap <- function(...) two(...)
partial <- function(x, ...) two(x, ...)
#++++
two: <T: numeric> fn(a: T, b: T) -> T
wrap: <T: numeric> fn(...: Any) -> T
partial: <T: numeric> fn(x: T, ...: Any) -> T

#==== pipes
#---- pipe_lowers_to_first_argument_call
f <- function(x) x |> length()
#++++
f: <T> fn(x: T) -> integer

#---- pipe_chains_type_end_to_end
f <- function(x) x |> length() |> sqrt()
#++++
f: <T> fn(x: T) -> double

#---- pipe_argument_errors_blame_the_piped_value
half <- function(n) n / 2
f <- function() "text" |> half()
#++++
half: <T: numeric> fn(n: T) -> double
f: Unknown
42..48 error[type-mismatch] expected a numeric value (`integer` or `double`), found `character`

#---- pipe_named_placeholder_receives_the_value
scale_by <- function(value, factor) value * factor
f <- function(x) x |> scale_by(2, factor = _)
#++++
scale_by: <T: numeric> fn(value: T, factor: T) -> T
f: fn(x: double) -> double

#---- placeholder_without_the_piped_first_argument_is_missing_an_argument
scale_by <- function(value, factor) value * factor
f <- function() 2 |> scale_by(factor = _)
#++++
scale_by: <T: numeric> fn(value: T, factor: T) -> T
f: Unknown
72..80 error[type-mismatch] this call supplies 1 argument, but the function requires 2 — a required argument is missing

#---- pipe_into_a_namespaced_callee
f <- function(x) x |> stats::sd()
#++++
f: <T> fn(x: T) -> double

#---- non_call_pipe_stays_opaque
f <- function(x, g) x |> g
#++++
f: <T, U> fn(x: T, g: U) -> Unknown

#---- positional_placeholder_stays_opaque
f <- function(x) x |> paste(_, "a")
#++++
