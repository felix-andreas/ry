#---- dispatch_table_union
f <- function(flag) {
  h <- if (flag) function(x) 1L else function(x) "a"
  h(2L)
}
#++++
f: fn(flag: logical) -> integer | character

#---- lapply_maps_the_element_type
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, nchar)
}
#++++
f: fn() -> list[integer]

#---- lapply_keeps_its_input_names
# "named list in, named list out" — and a plain list or a vector still comes back
# unnamed.
f <- function() lapply(list(a = 1L, b = 2L), function(v) v + 1L)
g <- function() lapply(list(1L, 2L), function(v) v + 1L)
h <- function() lapply(c(1L, 2L), function(v) v + 1L)
#++++
f: fn() -> list[named: integer]
g: fn() -> list[integer]
h: fn() -> list[integer]

#---- filter_hands_back_the_shape_it_was_given
# `Filter` selects with `[`, so an atomic vector stays an atomic vector — typing
# it as a list would reject the arithmetic below, which R runs happily.
f <- function() Filter(function(v) v > 1, c(1, 2, 3)) + 1
g <- function() Filter(function(v) v > 1, list(a = 1, b = 2))
h <- function() Filter(function(v) v > 1, list(1, 2))
#++++
f: fn() -> double[]
g: fn() -> list[named: double]
h: fn() -> list[double]

#---- selecting_and_reordering_a_list_keeps_its_names
# A field read on the result is the point: without the names these are
# missing-field errors against code R runs. The read is `T | NULL` because the
# result is a name-keyed list whose key set is not statically known — selecting
# (`head`, `Filter`) really can drop a name. A record-in/record-out claim would
# be exact for `rev` alone, and the type language cannot state it for a stub.
opts <- list(a = 1, b = 2)
reversed <- rev(opts)$a
deduplicated <- unique(opts)$b
first <- utils::head(opts, 1L)$a
last <- utils::tail(opts, 1L)$b
#++++
opts: list{a: double, b: double}
reversed: double | NULL
deduplicated: double | NULL
first: double | NULL
last: double | NULL

#---- lapply_forwards_extra_arguments
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, gsub, pattern = "a", replacement = "o")
}
#++++
f: fn() -> list[character]

#---- lapply_rejects_a_wrong_callback
f <- function() {
  words <- c("alpha", "beta")
  lapply(words, function(a, b) paste(a, b))
}
#++++
f: Unknown
64..90 error[type-mismatch] expected `fn(character) -> T`, found `fn(a: U, b: V) -> character`

#---- a_function_with_spare_optionals_serves_a_narrower_interface
# An interface promises a range of call shapes; a function serves it when it
# accepts all of them. Extra parameters are fine when they default.
#: fn(callback: fn(integer) -> integer) -> integer
run_one <- function(callback) callback(1L)

#: fn(a: integer, [b]: integer) -> integer
one_plus_optional <- function(a, b = 2L) a + b

use <- function() run_one(one_plus_optional)
#++++
run_one: fn(callback: fn(integer) -> integer) -> integer
one_plus_optional: fn(a: integer, [b]: integer) -> integer
use: fn() -> integer

#---- an_interface_still_refuses_what_it_cannot_call
# The relaxation is one-directional: requiring more than the interface passes,
# or accepting fewer arguments than it sends, are both still errors.
#: fn(callback: fn(integer) -> integer) -> integer
run_one <- function(callback) callback(1L)

#: fn(a: integer, b: integer) -> integer
needs_two <- function(a, b) a + b

#: fn() -> integer
takes_none <- function() 1L

too_many <- function() run_one(needs_two)
too_few <- function() run_one(takes_none)
#++++
run_one: fn(callback: fn(integer) -> integer) -> integer
needs_two: fn(a: integer, b: integer) -> integer
takes_none: fn() -> integer
too_many: Unknown
too_few: Unknown
398..407 error[type-mismatch] expected `fn(integer) -> integer`, found `fn(a: integer, b: integer) -> integer`
439..449 error[type-mismatch] expected `fn(integer) -> integer`, found `fn() -> integer`

#---- a_list_of_functions_maps
# Every member of the element union must serve the callback interface; the
# stdlib reductions do, despite their optional parameters.
f <- function() lapply(list(mean, sd), function(g) g(1:3))
#++++
f: fn() -> list[double]

