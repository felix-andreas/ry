#---- a_local_closure_forces_where_it_is_called
g <- function(items, x) {
  run <- function() x
  run()
}
h <- function(items, x) {
  run <- function() x
  if (length(items)) run()
}
f <- function(items) g(items)
k <- function(items) h(items)
#++++
g: <T, U> fn([items]: T, x: U) -> U
h: <T, U> fn(items: T, [x]: U) -> U | NULL
f: Unknown
k: <T> fn(items: T) -> Unknown
156..157 error[type-mismatch] this call leaves out `x`, which the function requires

#---- a_rebound_local_no_longer_runs_the_closure
# Every form of write rebinds the local, and `local()` binds in its own frame.
in_local <- function(x) {
  run <- function() 1
  local({
    run <- function() x
  })
  run()
}
in_loop <- function(x, fs) {
  run <- function() x
  for (run in fs) NULL
  run()
}
f1 <- function(fs) in_local()
f2 <- function(fs) in_loop(fs = fs)
#++++
in_local: <T> fn([x]: T) -> double
in_loop: <T, U> fn([x]: T, fs: U) -> Unknown
f1: <T> fn([fs]: T) -> double
f2: <T> fn([fs]: T) -> Unknown
141..144 warning[unused] `run` is assigned but never used
207..210 warning[unused] `run` is assigned but never used

