#---- a_callback_names_the_parameter_that_refuses_the_element
# The lambda's parameter takes `character` from `words` before its body is
# checked, so the finding lands on the use that refuses it and names the
# parameter and the call that supplied its type.
f <- function() {
  words <- list("a", "b")
  lapply(words, function(s) s + 1L)
}
#++++
f: Unknown
