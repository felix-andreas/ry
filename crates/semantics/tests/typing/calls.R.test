#---- a_function_with_spare_optionals_serves_a_narrower_interface
# An interface promises a range of call shapes; a function serves it when it
# accepts all of them. Extra parameters are fine when they default.
#: fn(callback: fn(integer) -> integer) -> integer
run_one <- function(callback) callback(1L)

#: fn(a: integer, [b]: integer) -> integer
one_plus_optional <- function(a, b = 2L) a + b

use <- function() run_one(one_plus_optional)
#++++
run_one: fn(callback: fn(integer) -> integer) -> integer
one_plus_optional: fn(a: integer, [b]: integer) -> integer
use: fn() -> integer

#---- an_interface_still_refuses_what_it_cannot_call
# The relaxation is one-directional: requiring more than the interface passes,
# or accepting fewer arguments than it sends, are both still errors.
#: fn(callback: fn(integer) -> integer) -> integer
run_one <- function(callback) callback(1L)

#: fn(a: integer, b: integer) -> integer
needs_two <- function(a, b) a + b

#: fn() -> integer
takes_none <- function() 1L

too_many <- function() run_one(needs_two)
too_few <- function() run_one(takes_none)
#++++
run_one: fn(callback: fn(integer) -> integer) -> integer
needs_two: fn(a: integer, b: integer) -> integer
takes_none: fn() -> integer
too_many: Unknown
too_few: Unknown
398..407 error[type-mismatch] expected `fn(integer) -> integer`, found `fn(a: integer, b: integer) -> integer`
439..449 error[type-mismatch] expected `fn(integer) -> integer`, found `fn() -> integer`

#---- match_fun_passes_over_a_local_list_named_like_the_function
f <- function(data, groups) {
  prod <- groups
  out <- numeric(length(prod))
  for (i in seq_along(prod)) out[i] <- sum(apply(data[, prod[[i]]], 1, prod))
  out
}
#++++
f: <T, U> fn([data]: T, groups: U) -> double[]

#---- match_fun_takes_a_local_holding_one_of_two_functions
f <- function(wrap) {
  F <- if (wrap) function(i) list(i) else function(i) i + 1
  lapply(1:3, F)
}
#++++
f: fn(wrap: logical) -> list[list{integer} | double]

#---- a_local_holding_one_of_two_functions_takes_forwarded_arguments
# `lapply(x, update, new = NULL)` calls whichever function `update` holds with the extra
# argument, as it would call either one alone.
up_a <- function(geom, new) list(geom, new)
up_b <- function(stat, new) list(stat, new)
both <- function(type, names) {
  update <- switch(type, geom = up_a, up_b)
  lapply(names, update, new = NULL)
}
apply_at <- function(func, x, ...) func(x, ...)
pick <- function(type, object) {
  if (type == "a") f <- function(x, model, ...) x else f <- function(x, model, table) x
  apply_at(func = f, x = 1, model = object)
}
#++++
up_a: <T, U> fn(geom: T, new: U) -> list{T, U}
up_b: <T, U> fn(stat: T, new: U) -> list{T, U}
both: <T> fn(type: T, names: Unknown) -> Unknown
apply_at: <T, U> fn(func: fn(T, ...: Any) -> U, x: T, ...: Any) -> U
pick: <T: comparable or Str, U> fn(type: T, object: U) -> double

