#---- a_summary_method_on_the_first_argument_takes_over_the_generic
#: @type money {list{cents: integer}}

#: fn(cents: integer) -> money
money <- function(cents) {
  #: @new money
  structure(list(cents = cents), class = "money")
}
#: fn(..., [na.rm]: logical) -> money
Summary.money <- function(..., na.rm = FALSE) money(1L)
m <- money(1L)
a <- sum(m)
b <- max(m, m)
d <- sum(1L, m)
#++++
money: fn(cents: integer) -> money
