#==== stubs
#---- resolves_cleanly
total <- function(x) sum(x, na.rm = TRUE)
size <- function(x) length(x)
#++++
total: <T> fn(x: T) -> Any
size: <T> fn(x: T) -> integer

#---- debugging_family_resolves
f <- function(choices) {
  debug(sum)
  selected <- menu(choices)
  confirmed <- askYesNo("proceed?")
  if (confirmed) selected else 0L
}
#++++
f: fn(choices: character | character[]) -> integer

#---- error_handler_stubs_resolve
options(error = recover)
handler <- function() traceback()
#++++
handler: fn() -> Any

#---- manifest_only_exports_resolve
f <- function(x, y) bitwAnd(x, y)
g <- function(path) utils::aspell(path)
#++++
f: <T, U> fn(x: T, y: U) -> Unknown
g: <T> fn(path: T) -> Unknown

#---- qualified_only_namespace_resolves
extension <- function(path) tools::file_ext(path)
#++++
extension: <T> fn(path: T) -> Unknown

#---- datasets_type_through_stubs
measurements <- function() iris
#++++
measurements: fn() -> data.frame

#---- overload_picks_specific
f <- function() cumsum(1L)
#++++
f: fn() -> integer[]

#---- strict_round_keeps_double
f <- function() sum(1, 2)
#++++
f: fn() -> double

#---- literal_courtesy
f <- function() seq_len(10)
#++++
f: fn() -> integer[]

