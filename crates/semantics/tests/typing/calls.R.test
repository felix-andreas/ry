#---- a_numeric_wrapper_takes_what_arithmetic_takes
# `cumsum` takes `NULL` as an empty vector, so its wrapper imposes no bound. A
# data frame has arithmetic methods, so it satisfies the bound as it does for `-`.
magnitude <- function(x) abs(x)
running <- function(x) cumsum(x)
empty <- running(NULL)
frame <- magnitude(data.frame(a = 1))
negated <- -data.frame(a = 1)
#++++
magnitude: <T: arithmetic> fn(x: T) -> T
running: <T> fn(x: T) -> Any
empty: Any
frame: data.frame{a: double[]}
negated: data.frame{a: double[]}

#---- a_union_member_beside_a_vector_takes_no_numeric_bound
# mclust's plotting helper: `unique(x)` with `x: T | double[]` fits only the
# `T[]` candidate, because the `double[]` member rules out the `factor` one. A
# `factor` for `T` still fits the fallback, so `T` takes no numeric bound.
plot1 <- function(z = NULL, x = NULL) {
  if (is.null(x) && !is.null(z)) x <- numeric(3)
  if (!is.null(x)) length(unique(x))
  x
}
grouped <- plot1(x = factor("a"))
#++++
plot1: <T, U> fn([z]: T | NULL, [x]: U | NULL) -> U | double[] | NULL
grouped: double[] | factor

