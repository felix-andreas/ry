#---- a_name_claims_its_formal_before_positionals_are_placed
# R matches exact names first and only then fills positionals around them, so
# `TRUE` lands on `c` rather than colliding with the named `b`.
#: fn(a: integer, b: character, c: logical) -> integer
three <- function(a, b, c) a

use <- function() three(1L, TRUE, b = "x")
#++++
three: fn(a: integer, b: character, c: logical) -> integer
use: fn() -> integer

#---- a_declared_required_formal_stays_required_when_unread
