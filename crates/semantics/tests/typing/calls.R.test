t <- vapply(list(1L, 2L), sum, integer(1))
u <- Reduce(sum, list(1L, 2L))
v <- Reduce(sum, list(1L, 2L), 0.5)
w <- lapply(list("a"), sum)
x <- sapply(1:3, range)
y <- lapply(list(1.5), round, digits = 1L)
