#---- a_data_frame_passes_through_a_shape_preserving_wrapper
first_rows <- function(rows) head(rows, 2L)
numeric_columns <- function(frame) Filter(is.numeric, frame)
#: fn(frame: data.frame) -> data.frame
top <- function(frame) first_rows(numeric_columns(frame))
#++++
first_rows: <T> fn(rows: T) -> T
numeric_columns: <T> fn(frame: T) -> T
top: fn(frame: data.frame) -> data.frame

