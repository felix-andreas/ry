f: fn() -> character

#---- forwarded_dots_beside_a_named_argument_demand_no_callback_parameter
convert <- function(x, converter, ...) converter(x = x, ...)
f <- function() convert("a", toupper)
#++++
convert: <T, U> fn([x]: T, converter: fn(...: Any, x: T) -> U, ...: Any) -> U
f: fn() -> character

#---- a_lowercase_name_goes_to_the_dots_not_to_X
fmt <- function(i, x) x[[i]]
f <- function() lapply(1:2, fmt, x = list(1, 2))
#++++
fmt: <T, U> fn(i: T, x: U) -> Unknown
f: <T> fn() -> list[T]

#---- a_variadic_function_serves_a_fixed_interface
f <- function() lapply(list(mean, sd), function(g) g(1:3))
#++++
f: fn() -> list[double]

#==== exported_constraints
#---- higher_order_result_keeps_its_constraint_across_items
invoke <- function(f) function(x) f(x + 1L)
mirror <- function(x) x
mixed_apply <- invoke(mirror)
bad <- mixed_apply("ok")
ok <- mixed_apply(2L)
#++++
invoke: <T: numeric, U> fn(f: fn(T) -> U) -> fn(x: T) -> U
mirror: <T> fn(x: T) -> T
mixed_apply: <T: numeric> fn(x: T) -> T
bad: Unknown
ok: integer
