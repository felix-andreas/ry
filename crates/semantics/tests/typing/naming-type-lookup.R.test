#==== nominal_introduction
#---- nominal_introduction_accepts_nominal_type
#~~~~ R/main.R
#: @type Person {list{name: character}}

#: @new Person
value <- list(name = "bob")
#++++
== R/main.R
value: Person

#---- nominal_introduction_uses_type_from_other_file
#~~~~ R/a.R
#: @type Person {list{name: character}}
#~~~~ R/b.R
#: @new Person
value <- list(name = "bob")
#++++
== R/a.R
== R/b.R
value: Person

#---- nominal_introduction_accepts_fully_applied_generic_type
#~~~~ R/main.R
#: @type Person<T> {list{value: T}}

#: @new Person<integer>
value <- list(value = 1L)
#++++
== R/main.R
value: Person<integer>
