#==== definitions
#---- definition_can_reference_previous_definition
#~~~~ R/main.R
#: @type Person {list{name: character}}
#: @type Team {list{owner: Person}}
value <- 1L
#++++
== R/main.R
value: integer

#---- definition_forward_reference_same_file
#~~~~ R/main.R
#: @type Team {list{owner: Person}}
#: @type Person {list{name: character}}
value <- 1L
#++++
== R/main.R
value: integer

#---- definition_forward_reference_resolves_across_files
#~~~~ R/a.R
#: @type Team {list{owner: Person}}
#~~~~ R/b.R
#: @type Person {list{name: character}}
#~~~~ R/c.R
value <- 1L
#++++
== R/a.R
== R/b.R
== R/c.R
value: integer

#---- alias_can_reference_nominal_from_other_file
#~~~~ R/a.R
#: @type Person {list{name: character}}
#~~~~ R/b.R
#: @alias TeamOwner {Person}
#++++
== R/a.R
== R/b.R

