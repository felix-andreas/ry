#==== setnames
#---- renaming_some_columns_changes_the_binding
library(data.table)
prices <- frame(id = 1:3, price = c(1, 2, 3))
setnames(prices, "price", "close")
closing <- prices$close
#++++
Any
prices: frame{id: integer[], price: double[]}
frame{id: integer[], close: double[]}
closing: double[]
101..108 warning[unused] `closing` is assigned but never used.

