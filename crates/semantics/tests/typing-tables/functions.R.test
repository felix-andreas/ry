#==== setnames
#---- renaming_some_columns_changes_the_binding
library(data.table)
prices <- DataFrame(id = 1:3, price = c(1, 2, 3))
setnames(prices, "price", "close")
closing <- prices$close
#++++
Any
prices: DataFrame{id: integer[], price: double[]}
DataFrame{id: integer[], close: double[]}
closing: double[]
105..112 warning[unused] `closing` is assigned but never used.

