#==== melt_and_dcast
#---- measures_stack_under_variable_and_value
library(data.table)
wide <- DataFrame(id = 1:2, low = c(1L, 2L), high = c(1.5, 2.5))
long <- melt(wide, id.vars = "id", measure.vars = c("low", "high"))
#++++
Any
wide: DataFrame{id: integer[], low: integer[], high: double[]}
long: data.table{id: integer[], variable: factor, value: double[]}
85..89 warning[unused] `long` is assigned but never used.

