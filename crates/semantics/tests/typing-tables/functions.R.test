#==== rbindlist
#---- pieces_stack_by_position_and_widen
library(data.table)
first <- frame(id = 1:2, value = 1:2)
second <- frame(key = 3:4, amount = c(0.5, 1.5))
stacked <- rbindlist(list(first, second))
#++++
Any
first: frame{id: integer[], value: integer[]}
second: frame{key: integer[], amount: double[]}
stacked: frame{id: integer[], value: double[]}
107..114 warning[unused] `stacked` is assigned but never used.

#---- use_names_matches_columns_by_name
library(data.table)
first <- frame(id = 1:2, label = c("a", "b"))
second <- frame(label = c("c", "d"), id = 3:4)
stacked <- rbindlist(list(first, second), use.names = TRUE)
#++++
