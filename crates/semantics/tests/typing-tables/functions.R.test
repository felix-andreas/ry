#==== vector_helpers
#---- helpers_keep_or_report_their_element_types
library(data.table)
x <- c(1L, NA, 3L)
lagged <- shift(x)
led <- shift(x, 1, type = "lead")
chosen <- fifelse(x > 1L, "big", "small")
filled <- fcoalesce(x, 0L)
carried <- nafill(x, "locf")
runs <- rleid(c("a", "a", "b"))
found <- c("a", "z") %chin% c("a", "b")
parts <- tstrsplit(c("a-b", "c-d"), "-")
inside <- between(c(1, 5), 2, 4)
distinct <- uniqueN(x)
#++++
Any
x: integer[]
lagged: integer[]
led: integer[]
chosen: character[]
filled: integer[]
carried: integer[]
runs: integer[]
found: logical[]
parts: list[character[]]
inside: logical[]
distinct: integer
