#---- strict_mode_reports_unknown_columns_where_a_type_lists_columns
# typing: strict
# A conversion keeps the source's columns, and a `data.frame` lists none, so the
# result would pass as any frame type; strict mode reports it at each place a type
# that lists columns takes it: a return, an argument and an annotated binding.
alias Rows = DataFrame{a: character, n: double}
load <- function(frame: data.frame) -> Rows {
  as.DataFrame(frame)
}
count_rows <- function(rows: Rows) -> integer DataFrame.height(rows)
count_raw <- function(raw: DataFrame) -> integer count_rows(raw)
keep <- function(frame: data.frame) -> integer {
  rows: Rows <- frame |> as.DataFrame() |> DataFrame.head(5L)
  DataFrame.height(rows)
}
#++++
load: fn(frame: data.frame) -> Rows
count_rows: fn(rows: Rows) -> integer
count_raw: fn(raw: DataFrame) -> integer
keep: fn(frame: data.frame) -> integer
308..312 warning[unused] `load` is assigned but never used
447..456 warning[unused] `count_raw` is assigned but never used
512..516 warning[unused] `keep` is assigned but never used
356..375 error[strict] strict mode: the columns of `frame` are unknown, so nothing checks them against the columns this type lists. Give `frame` a type that lists its columns, as in `frame: data.frame{a: TYPE}`
507..510 error[strict] strict mode: the columns of `raw` are unknown, so nothing checks them against the columns this type lists. Give `raw` a type that lists its columns, as in `raw: DataFrame{a: TYPE}`
