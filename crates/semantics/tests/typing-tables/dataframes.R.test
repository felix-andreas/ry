#---- the_body_keeps_the_other_columns
# typing: strict
closed <- function<R>(data: DataFrame{code: character[], ..R}) -> DataFrame{code: character[]} data
filtered <- function<R>(data: DataFrame{code: character[], ..R}) -> DataFrame{code: character[], ..R} {
  DataFrame.filter(data, Expr.col("code") == "a")
}
sorted <- function<R>(data: DataFrame{code: character[], ..R}) -> LazyFrame{code: character[], ..R} {
  DataFrame.lazy(DataFrame.sort(data, "code"))
}
dropped <- function<R>(data: DataFrame{code: character[], ..R}) -> DataFrame{..R} {
  DataFrame.drop(data, "code")
}
selected <- function<R>(data: DataFrame{code: character[], ..R}) -> DataFrame{code: character[]} {
  DataFrame.select(data, Expr.col("code"))
}
