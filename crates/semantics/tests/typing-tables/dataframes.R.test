typo <- sales |> DataFrame.filter(col("unit") > 1L)
text <- sales |> DataFrame.with_columns(bumped = col("region") + 1)
factors <- DataFrame.read_csv("data/sales.csv", strings_as_factors = TRUE)
level <- factors |> DataFrame.select(col("region") * 2)
