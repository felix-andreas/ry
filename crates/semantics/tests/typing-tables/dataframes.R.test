#==== schema_flow
#---- the_schema_flows_through_filter_mutate_group_by_and_join
#~~~~ data/sales.csv
region,units,price
eu,3,1.5
us,5,2
#~~~~ data/regions.csv
region,price,zone
eu,9.5,north
#~~~~ main.R
sales <- DataFrame.read_csv("data/sales.csv")
regions <- DataFrame.read_csv("data/regions.csv")
wider <- sales |>
  DataFrame.filter(col("units") > 1L) |>
  DataFrame.with_columns(revenue = col("units") * col("price"))
joined <- DataFrame.join(wider, regions, on = "region", how = "left")
totals <- joined |>
  DataFrame.group_by("zone") |>
  GroupBy.agg(revenue = col("revenue") |> Expr.sum(), top = col("price_right") |> Expr.max())
#++++
sales: DataFrame{region: character[], units: integer[], price: double[]}
regions: DataFrame{region: character[], price: double[], zone: character[]}
wider: DataFrame{region: character[], units: integer[], price: double[], revenue: double[]}
joined: DataFrame{region: character[], units: integer[], price: double[], revenue: double[], price_right: double[], zone: character[]}
totals: DataFrame{zone: character[], revenue: double[], top: double[]}
289..295 warning[unused] `totals` is assigned but never used.

#---- a_lazy_scan_carries_the_schema_to_collect
#~~~~ data/sales.csv
region,units
eu,3
#~~~~ main.R
result <- LazyFrame.scan_csv("data/sales.csv") |>
  LazyFrame.filter(col("units") > 1L) |>
  LazyFrame.select("region") |>
  LazyFrame.collect()
#++++
result: DataFrame{region: character[]}
0..6 warning[unused] `result` is assigned but never used.

