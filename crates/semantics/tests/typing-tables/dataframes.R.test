#==== tag_columns
#---- a_list_of_bare_tags_builds_a_tag_column_that_r_reads_as_text
# typing: strict
alias Rows = DataFrame{kind: :Bond | :Cash, v: double}
kinds: List<:Bond | :Cash> <- [:Bond, :Cash]
rows: Rows <- DataFrame(kind = kinds, v = c(1, 2))
bonds: Rows <- DataFrame.filter(rows, Expr.col("kind") == :Bond)
cash: Rows <- DataFrame.filter(rows, Expr.is_in(Expr.col("kind"), [:Cash]))
names <- rows$kind
first <- rows[["kind"]]
#++++
