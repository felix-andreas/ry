#---- strict_mode_reports_a_chain_whose_first_steps_name_no_column
# typing: strict
path <- file.path("data", "sales.csv")
sales <- DataFrame.read_csv(path)
kept <- sales |>
  DataFrame.head(5L) |>
  DataFrame.lazy() |>
  LazyFrame.filter(col("units") > 1L) |>
  LazyFrame.select("units")
#++++

