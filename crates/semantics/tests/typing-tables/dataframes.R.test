#---- an_open_table_passes_through_another_function
# typing: strict
add_id <- function<R>(data: DataFrame{code: character[], ..R}) -> DataFrame{code: character[], id: double[], ..R} {
  DataFrame.with_columns(data, id = Expr.rank(Expr.col("code")))
}
twice <- function<S>(data: DataFrame{code: character[], ..S}) -> DataFrame{code: character[], id: double[], ..S} {
  add_id(data)
}
out <- twice(DataFrame(code = "a", flag = TRUE))
#++++
add_id: <R> fn(data: DataFrame{code: character[], ..R}) -> DataFrame{code: character[], id: double[], ..R}
twice: <S> fn(data: DataFrame{code: character[], ..S}) -> DataFrame{code: character[], id: double[], ..S}
out: DataFrame{code: character[], id: double[], flag: logical[]}
