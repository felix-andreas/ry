#==== positional_table
#---- a_named_argument_after_the_table_is_a_column
# typing: on
x <- DataFrame(a = c(1, 2), b = c("p", "q"))
grouped <- DataFrame.group_by(x, "b")
picked <- DataFrame.select(x, d = Expr.col("a"), df = Expr.col("b"))
widened <- DataFrame.with_columns(x, dx = Expr.col("a") * 2)
totals <- GroupBy.agg(grouped, g = Expr.sum(Expr.col("a")), group = Expr.max(Expr.col("a")), n = Expr.len())
#++++
