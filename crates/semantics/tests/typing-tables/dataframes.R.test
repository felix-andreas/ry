#---- strict_mode_names_the_side_of_a_join_whose_columns_are_unknown
# typing: strict
# The left side lists its columns, so the unknown ones come from the right side,
# which is not a variable. An expected union that holds a frame type is checked too.
alias Rows = DataFrame{a: character, n: double}
join_raw <- function(frame: data.frame, other: Rows) -> Rows {
  DataFrame.join(other, as.DataFrame(frame), on = "a")
}
maybe <- function(frame: data.frame) -> Rows | NULL {
  as.DataFrame(frame)
}
#++++
join_raw: fn(frame: data.frame, other: Rows) -> Rows
maybe: fn(frame: data.frame) -> Rows | NULL
