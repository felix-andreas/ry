#==== strict_columns
#---- strict_mode_reports_a_query_on_unknown_columns
# typing: strict
path <- file.path("data", "sales.csv")
sales <- DataFrame.read_csv(path)
kept <- sales |>
  DataFrame.filter(col("units") > 1L) |>
  DataFrame.group_by("region") |>
  GroupBy.agg(total = col("units") |> Expr.sum())
first <- sales |> DataFrame.head(2L)
#++++
path: character
sales: DataFrame
kept: DataFrame
first: DataFrame
