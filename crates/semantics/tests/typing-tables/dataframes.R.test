#---- joins_and_groups_on_an_open_table
# typing: strict
codes <- DataFrame(code = c("a", "b"), id = c(1, 2))
joined <- function<R>(data: DataFrame{code: character[], ..R}) -> DataFrame{code: character[], id: double[], ..R} {
  DataFrame.join(data, codes, on = "code")
}
right_open <- function<R>(data: DataFrame{code: character[], ..R}) {
  DataFrame.join(codes, data, on = "code")
}
kept <- function<R>(data: DataFrame{code: character[], ..R}) -> DataFrame{code: character[], ..R} {
  DataFrame.join(data, codes, on = "code", how = "semi")
}
counted <- function<R>(data: DataFrame{code: character[], ..R}) {
  GroupBy.agg(DataFrame.group_by(data, "code"), n = Expr.len())
}
