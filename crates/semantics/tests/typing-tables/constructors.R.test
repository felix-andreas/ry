#==== data_frame
#---- named_arguments_become_columns
frame <- data.frame(id = 1:3, price = c(1, 2, 3), label = c("a", "b", "c"))
prices <- frame$price
#++++
frame: data.frame{id: integer[], price: double[], label: character[]}
prices: double[]
76..82 warning[unused] `prices` is assigned but never used

#---- a_bare_variable_names_its_column
id <- 1:3
frame <- data.frame(id, price = c(1, 2, 3), stringsAsFactors = FALSE)
#++++
id: integer[]
frame: data.frame{id: integer[], price: double[]}
10..15 warning[unused] `frame` is assigned but never used

#---- a_missing_column_is_reported
frame <- data.frame(id = 1:3)
frame$price
#++++
frame: data.frame{id: integer[]}
Unknown
36..41 error[type-mismatch] the frame `frame` has no column `price`. Its columns are `id`

#---- a_written_column_joins_the_frame
frame <- data.frame(id = 1:3)
frame$price <- c(1, 2, 3)
frame[["volume"]] <- 10L
frame
#++++
frame: data.frame{id: integer[]}
double[]
integer
data.frame{id: integer[], price: double[], volume: integer[]}

#---- a_write_that_may_rename_columns_forgets_them
frame <- data.frame(id = 1:3, price = c(1, 2, 3))
names(frame) <- c("key", "close")
frame$close
#++++
frame: data.frame{id: integer[], price: double[]}
character[]
Unknown

#---- a_subset_write_forgets_the_columns
frame <- data.frame(id = 1:3)
frame[, "price"] <- 1
frame$price
#++++
frame: data.frame{id: integer[]}
double
Unknown

#---- arguments_that_spread_into_several_columns_leave_them_unknown
m <- matrix(1:4, 2)
a <- data.frame(m)
b <- data.frame(x = m)
c <- data.frame(list(x = 1, y = 2))
d <- data.frame(x = 1, x = 2)
e <- data.frame(`a b` = 1)
f <- data.frame(x = 1, stringsAsFactors = TRUE)
list(a, b, c, d, e, f)
#++++
m: matrix
a: data.frame
b: data.frame
c: data.frame
d: data.frame
e: data.frame
f: data.frame
list{data.frame, data.frame, data.frame, data.frame, data.frame, data.frame}

#---- a_value_of_unknown_type_leaves_the_columns_unknown
f <- function(parts) data.frame(parts, total = 1)
#++++
f: <T> fn(parts: T) -> data.frame
0..1 warning[unused] `f` is assigned but never used
14..19 error[strict] strict mode: parameter `parts` has no type. How the function uses it does not determine one, so any value is accepted unchecked. Annotate it, as in `parts: TYPE`

#---- a_null_argument_adds_no_column
frame <- data.frame(id = 1:3, note = NULL)
#++++
frame: data.frame{id: integer[]}
0..5 warning[unused] `frame` is assigned but never used

#---- the_frame_is_still_a_data_frame
frame <- data.frame(id = 1:3, price = c(1, 2, 3))
rows <- nrow(frame)
both <- merge(frame, frame)
total <- sum(frame)
scaled <- frame * 2
first <- frame[1, ]
column <- frame[["price"]]
lengths <- vapply(frame, length, integer(1))
list(rows, both, total, scaled, first, column, lengths)
#++++
frame: data.frame{id: integer[], price: double[]}
rows: Any
both: data.frame
total: double
scaled: data.frame
first: Any
column: double[]
lengths: integer[]
list{Any, data.frame, double, data.frame, Any, double[], integer[]}

#---- a_namespaced_constructor_tracks_columns
frame <- base::data.frame(id = 1:3)
frame$id
#++++
frame: data.frame{id: integer[]}
integer[]

#---- an_annotation_names_the_columns
#: fn(frame: data.frame{id: integer[]}) -> integer[]
ids <- function(frame) frame$id
ids(data.frame(id = 1:3))
ids(data.frame(key = 1:3))
#++++
ids: fn(frame: data.frame{id: integer[]}) -> integer[]
integer[]
integer[]
115..136 error[type-mismatch] expected `data.frame{id: integer[]}`, found `data.frame{key: integer[]}`

#---- a_project_data_frame_is_an_ordinary_call
data.frame <- function(...) list(...)
frame <- data.frame(id = 1:3)
#++++
data.frame: fn(...: Any) -> list[named: Unknown]
frame: list[named: Unknown]
38..43 warning[unused] `frame` is assigned but never used

#==== data_table
#---- named_arguments_become_columns
library(data.table)
table <- data.table(id = 1:3, price = c(1, 2, 3), key = "id")
table$price
#++++
Any
table: data.table{id: integer[], price: double[]}
double[]

#---- the_namespaced_constructor
library(data.table)
table <- data.table::data.table(pnl = c(1, 2))
total <- sum(table$pnl)
#++++
Any
table: data.table{pnl: double[]}
total: double
67..72 warning[unused] `total` is assigned but never used

#---- keep_rownames_adds_a_column
library(data.table)
table <- data.table(x = 1, keep.rownames = TRUE)
#++++
Any
table: data.table
20..25 warning[unused] `table` is assigned but never used

#---- the_table_is_queried_as_a_data_table
library(data.table)
table <- data.table(id = 1:3, price = c(1, 2, 3))
table[price > 1, .(total = sum(price))]
#++++
Any
table: data.table{id: integer[], price: double[]}
data.table{total: double[]}

#---- set_dt_makes_a_data_frame_a_data_table
library(data.table)
frame <- data.frame(id = 1:3)
setDT(frame)
frame[, id2 := id * 2L]
frame$id2
#++++
Any
frame: data.frame{id: integer[]}
data.table{id: integer[]}
data.table{id: integer[], id2: integer[]}
integer[]

#---- set_df_makes_a_data_table_a_data_frame
library(data.table)
table <- data.table(id = 1:3)
setDF(table)
table$id
#++++
Any
table: data.table{id: integer[]}
data.frame{id: integer[]}
integer[]

#---- set_forgets_the_columns
library(data.table)
table <- data.table(id = 1:3)
set(table, j = "price", value = 1)
table$price
#++++
Any
table: data.table{id: integer[]}
data.table
Unknown

#---- a_column_read_in_an_annotated_function_has_its_type
library(data.table)
#: fn() -> double
total_pnl <- function() {
  table <- data.table::data.table(pnl = c(1, 2))
  sum(table$pnl)
}
total_pnl()
#++++
Any
total_pnl: fn() -> double
double
