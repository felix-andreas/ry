#==== nullable_primitives
#---- nullable_integer
integer | NULL
#++++
integer | NULL

#---- nullable_logical
logical|NULL
#++++
logical | NULL

#---- nullable_character_with_lowercase_null
character | null
#++++
character | NULL

#---- nullable_integer_with_null_on_left
NULL | integer
#++++
integer | NULL

#==== nullable_vectors
#---- nullable_integer_vector
integer[] | NULL
#++++
integer[] | NULL

#---- nullable_named_character_vector
character[named]|NULL
#++++
character[named] | NULL

#---- nullable_logical_vector_with_lowercase_null
logical[] | null
#++++
logical[] | NULL

#==== nullable_lists
#---- nullable_named_list_item
list[named: character | NULL]
#++++
list[named: character | NULL]

#---- nullable_record_field
list{value:integer|NULL}
#++++
list{value: integer | NULL}

#==== nullable_functions
#---- nullable_function_return
fn(integer)->character|NULL
#++++
fn(integer) -> character | NULL

#---- nullable_function_parameter
fn(integer|NULL)->character
#++++
fn(integer | NULL) -> character

#---- nullable_function_return_with_null_on_left
fn(integer)->NULL | character
#++++
fn(integer) -> character | NULL

#---- nullable_function_inside_list
list[fn(integer)->NULL]
#++++
list[fn(integer) -> NULL]

#==== nested_nullable_forms
#---- nested_nullable_special_record
list{value:integer|NULL,meta:list{missing:Unknown,default:Any}}
#++++
list{value: integer | NULL, meta: list{missing: Unknown, default: Any}}

#---- special_forms_in_higher_order_function
fn(handler:fn(Unknown)->Any)->list{result:Any,missing:Unknown|NULL}
#++++
fn(handler: fn(Unknown) -> Any) -> list{result: Any, missing: Unknown}

#==== multi_member_unions
#---- two_members
integer | character
#++++
integer | character

#---- three_members
integer | character | logical
#++++
integer | character | logical

#---- multi_member_with_null
integer | character | NULL
#++++
integer | character | NULL

#---- null_moves_last
NULL | integer | character
#++++
integer | character | NULL

#---- duplicate_members_collapse
integer | character | integer
#++++
integer | character

#---- duplicate_null_members_collapse
integer | NULL | character | NULL
#++++
integer | character | NULL

#---- any_member_absorbs_union
integer | Any | character
#++++
Any

#---- unknown_member_absorbs_union
integer | Unknown
#++++
Unknown

#---- multi_member_function_parameter
fn(integer | character) -> integer
#++++
fn(integer | character) -> integer

#---- multi_member_function_return
fn(integer) -> integer | character
#++++
fn(integer) -> integer | character

#---- multi_member_list_item
list[integer | character]
#++++
list[integer | character]

#---- multi_member_record_field
list{value: integer | character}
#++++
list{value: integer | character}

#---- multi_member_vector_members
integer[] | character[] | NULL
#++++
integer[] | character[] | NULL

#==== grouped_unions
#---- function_member_union
(fn() -> integer) | NULL
#++++
(fn() -> integer) | NULL

#---- function_member_union_with_parameters
(fn(x: integer) -> character) | NULL
#++++
(fn(x: integer) -> character) | NULL

#---- two_function_members
(fn() -> integer) | (fn() -> character)
#++++
(fn() -> integer) | (fn() -> character)

#---- redundant_group_collapses
(integer)
#++++
integer

#---- grouped_union_flattens
(integer | character) | NULL
#++++
integer | character | NULL

#---- group_in_parameter_position
fn(callback: (fn() -> integer) | NULL) -> integer
#++++
fn(callback: (fn() -> integer) | NULL) -> integer

#---- group_as_list_item
list[(fn() -> integer) | NULL]
#++++
list[(fn() -> integer) | NULL]

#---- unclosed_group
(integer
#++++
integer
syntax error: unclosed `(` in this type; expected a matching `)`

#---- empty_group
()
#++++
Unknown
syntax error: expected a type, found `)`

#---- binder_inside_group_rejected
(<T> fn(x: T) -> T) | NULL
#++++
syntax error: higher-rank polymorphism is not supported: type parameter binders may only appear at the outermost level

#==== invalid_unions
#---- null_null_union_is_null
NULL | NULL
#++++
NULL
