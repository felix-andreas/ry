#==== named_type_definitions
#---- nominal_type_definition
@type Person {list{name: character, age: double}}
#++++
type Person = list{name: character, age: double}

#---- nominal_type_definition_with_whitespace
@type   Person   { list{ name: character, age: double } }
#++++
type Person = list{name: character, age: double}

#---- alias_definition
@alias PersonShape {list{name: character, age: double}}
#++++
alias PersonShape = list{name: character, age: double}

#---- alias_definition_with_nested_function
@alias Formatter {fn(count: integer) -> character}
#++++
alias Formatter = fn(count: integer) -> character

#---- multiline_definition_block
@type Person {list{name: character, age: double}}
@alias Team {list{owner: Person}}
#++++
type Person = list{name: character, age: double}
alias Team = list{owner: Person}

#==== nominal_introduction
#---- nominal_introduction
@new Person
#++++
new Person

#---- nominal_introduction_with_whitespace
@new   Person
#++++
new Person

#---- generic_nominal_introduction
@new Person<integer>
#++++
new Person<integer>

#---- nested_generic_nominal_introduction
@new Result<Person<integer>>
#++++
new Result<Person<integer>>

#---- invalid_nominal_introduction_missing_name
@new
#++++
syntax error: expected a type after `@new`
error: expected a nominal type reference after `@new`.

#---- invalid_nominal_introduction_scalar_payload
@new integer
#++++
error: expected a nominal type reference after `@new`.

#---- invalid_nominal_introduction_structural_payload
@new list{name: character}
#++++
error: expected a nominal type reference after `@new`.

#---- invalid_nominal_introduction_nullable_payload
@new Person | NULL
#++++
error: expected a nominal type reference after `@new`.

#---- invalid_nominal_introduction_function_payload
@new fn(integer) -> integer
#++++
error: expected a nominal type reference after `@new`.

#==== named_type_references
#---- bare_named_type_reference
Person
#++++
Person

#---- alias_name_reference
PersonShape
#++++
PersonShape

#---- nullable_named_type_reference
Person | NULL
#++++
Person | NULL

#---- list_of_named_type
list[Person]
#++++
list[Person]

#---- named_list_of_named_type
list[named: Person]
#++++
list[named: Person]

#---- tuple_with_named_type
list{Person, integer}
#++++
list{Person, integer}

#---- record_with_named_type
list{owner: Person}
#++++
list{owner: Person}

#---- function_with_named_type_parameter_and_return
fn(Person) -> Person
#++++
fn(Person) -> Person

#---- function_with_nullable_named_type_parameter_and_named_list_return
fn(Person | NULL) -> list[named: Person]
#++++
fn(Person | NULL) -> list[named: Person]

#==== named_type_definition_errors
#---- invalid_type_definition_missing_name
@type {list{name: character}}
#++++
syntax error: expected a type name after `@type`

#---- invalid_alias_definition_missing_body
@alias Person
#++++
alias Person = Unknown
syntax error: expected `{TYPE}` after `@alias`

#---- invalid_type_definition_with_trailing_text
@type Person {list{name: character}} extra
#++++
type Person = list{name: character}
syntax error: unexpected text after the `@type` definition

#---- mixed_definition_and_compact_annotation_block
@type Person {list{name: character}}
integer
#++++
error: `@type` and `@alias` declarations need their own `#:` block — separate them from other annotations with a blank line.

#---- mixed_definition_and_expanded_annotation_block
@type Person {list{name: character}}
@param count {integer}
@return {Person}
#++++
error: `@type` and `@alias` declarations need their own `#:` block — separate them from other annotations with a blank line.
