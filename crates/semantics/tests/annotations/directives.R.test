#==== compact_directives
#---- if_unknown_annotation_type
@if-unknown integer
#++++
if-unknown integer

#---- trust_annotation_type
@trust list[integer]
#++++
trust list[integer]

#---- trust_annotation_function_type
@trust fn(count: integer) -> character
#++++
trust fn(count: integer) -> character

#---- if_unknown_annotation_named_type
@if-unknown Person
#++++
if-unknown Person

#---- trust_annotation_named_type
@trust Person
#++++
trust Person

#---- trust_annotation_nullable_type
@trust integer | NULL
#++++
trust integer | NULL

