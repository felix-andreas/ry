#==== generic_syntax_failures
#---- square_bracket_named_generic_definition
@type Person[T] {list{value: T}}
#++++
type Person = Unknown
syntax error: expected `{TYPE}` after `@type`

#---- square_bracket_named_generic_alias_definition
@alias Box[T] {list{value: T}}
#++++
alias Box = Unknown
syntax error: expected `{TYPE}` after `@alias`

#---- misplaced_binder_inside_named_type_body
@type Person {<T> list{value: T}}
#++++
syntax error: higher-rank polymorphism is not supported: type parameter binders may only appear at the outermost level

#---- misplaced_binder_inside_named_alias_body
@alias Box {<T> list{value: T}}
#++++
syntax error: higher-rank polymorphism is not supported: type parameter binders may only appear at the outermost level

#---- attached_function_binder_not_supported
fn<T>(T) -> T
#++++
syntax error: expected a type, found `->`

#---- attached_named_type_application_not_supported
Person[T]
#++++
syntax error: expected a type, found `[`

#---- bare_forall_without_type
<T>
#++++
syntax error: expected a type

#---- empty_forall_parameter_list
<> fn(integer) -> integer
#++++
fn(integer) -> integer
syntax error: expected a type parameter name in `<...>`

#---- trailing_comma_in_forall
<T,> fn(T) -> T
#++++
<T> fn(T) -> T
syntax error: expected a type parameter name in `<...>`

#---- repeated_comma_in_forall
<T,,U> fn(T) -> U
#++++
syntax error: expected a type parameter name in `<...>`

#---- malformed_expanded_forall_trailing_comma
@forall T,
#++++
syntax error: expected a type parameter name after `@forall`

#---- malformed_expanded_forall_double_comma
@forall T,,U
#++++
syntax error: expected a type parameter name after `@forall`

#---- unclosed_universal_binder
<T fn(T) -> T
#++++
<T> fn(T) -> T
syntax error: expected `,` or `>` in the type parameter list

#---- unclosed_named_generic_application
Person<integer
#++++
Person<integer>
syntax error: expected `,` or `>` in the type argument list

#---- empty_named_generic_application
Person<>
#++++
Person

#---- trailing_comma_in_named_generic_application
