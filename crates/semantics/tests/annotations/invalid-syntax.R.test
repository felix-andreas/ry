#==== directive_failures
#---- bare_at_sign
@
#++++
syntax error: expected a directive name after `@`

#---- unknown_directive_without_payload
@unknown
#++++
syntax error: unknown annotation directive `@unknown`

#---- unknown_directive_with_payload
@unknown integer
#++++
syntax error: unknown annotation directive `@unknown`

#==== incomplete_forms
#---- bare_list_keyword
list
#++++
list

#---- bare_function_keyword
fn
#++++
fn

#---- empty_list_brackets
list[]
#++++
list[Unknown]
syntax error: expected a type, found `]`

#---- empty_named_list_value
list[named:]
#++++
list[named: Unknown]
syntax error: expected a type, found `]`

#==== unexpected_closing_delimiters
#---- bare_closing_brace
}
#++++
syntax error: expected a type, found `}`

#---- bare_closing_bracket
]
#++++
syntax error: expected a type, found `]`

#---- bare_closing_paren
)
#++++
syntax error: expected a type, found `)`

#==== missing_closing_delimiters
#---- unclosed_list_bracket
list[integer
#++++
list[integer]
syntax error: unclosed `[` in this list type; expected a matching `]`

#---- unclosed_list_brace
list{integer
#++++
list{integer}
syntax error: expected `,` or `}` in this list type

#---- unclosed_function_parameters
fn(integer
#++++
fn(integer) -> Unknown
syntax error: expected `,` or `)` in this function type's parameters

#---- unclosed_named_list
list[named: integer
#++++
list[named: integer]
syntax error: unclosed `[` in this list type; expected a matching `]`

#==== malformed_separators
#---- double_comma_in_function_parameters
fn(integer,,character)
#++++
fn(integer, Unknown, character) -> Unknown
syntax error: expected a type, found `,`

#---- double_comma_in_tuple_items
list{integer,,character}
#++++
list{integer, character}
syntax error: expected a type, found `,`

#---- semicolon_in_function_parameters
fn(integer;character)
#++++
syntax error: expected `,` or `)` in this function type's parameters

#---- semicolon_in_tuple_items
list{integer;character}
#++++
syntax error: expected `,` or `}` in this list type

