#---- the_commonest_step_wins
f <- function(x) {
    a <- 1
    b <- 2
}
g <- function(x) {
  c<-3$0
}
#++++
edit 6:1-7:1
----
f <- function(x) {
    a <- 1
    b <- 2
}
g <- function(x) {
«    c <- 3»
}

#---- a_fmt_off_region_does_not_vote
# fmt: off
f <- function(x) {
  a <- 1
  b <- 2
  c <- 3
}
# fmt: on
g <- function(x) {
    d<-4$0
}
#++++
