#==== directives
#---- inside_a_formatting_off_region
before<-1
# fmt: off
weird   <-  $01
# fmt: on
after<-1
#++++
no edits

#---- from_inside_a_formatting_off_region_to_outside_it
before<-1
# fmt: off
weird $0  <-  1
# fmt: on
after<-1$0
#++++
edit 5:1-6:1
----
before<-1
# fmt: off
weird   <-  1
# fmt: on
«after <- 1»

#---- across_a_formatting_off_region
$0before<-1
# fmt: off
weird   <-  1
# fmt: on
after<-1$0
#++++
edit 1:1-2:1
edit 5:1-6:1
----
«before <- 1»
# fmt: off
weird   <-  1
# fmt: on
«after <- 1»

#---- a_statement_marked_skip
before<-1
m <- rbind(c(1,  2),
           c(30, 4)) # fmt: skip
after$0<-1
#++++
edit 4:1-5:1
----
before<-1
m <- rbind(c(1,  2),
           c(30, 4)) # fmt: skip
«after <- 1»

#---- the_skipped_statement_itself
before<-1
m <- rbind(c(1,  2),
           c(30, $04)) # fmt: skip
after<-1
#++++
no edits

#---- a_file_marked_skip
# fmt: skip-file
before  <-  1
after$0  <-  2
#++++
no edits

#==== annotations
#---- the_annotated_statement
#: integer
x$0<-1L
#++++
edit 2:1-3:1
----
#: integer
«x <- 1L»

#---- the_statement_below_an_annotation
#: @type   Person   {list[double]}
$0p<-list(1,2)
#++++
edit 2:1-3:1
----
#: @type   Person   {list[double]}
«p <- list(1, 2)»

#---- the_annotation_above_a_statement
#: @type   Person   {list[double]}$0
p<-list(1,2)
#++++
edit 1:1-2:1
----
«#: @type Person {list[double]}»
p<-list(1,2)

#---- one_line_of_a_multiline_annotation
#: list{
#: a$0 : integer
#: }
x<-list(a=1L)
#++++
edit 2:1-3:1
----
#: list{
«#:   a: integer»
#: }
x<-list(a=1L)

#---- a_trailing_annotation
before<-1
x<-1 #:$0 integer
after<-1
#++++
edit 2:1-3:1
----
before<-1
«x <- 1 #: integer»
after<-1

#==== comments
#---- a_comment_that_normalizes
before<-1
#a note$0
after<-1
#++++
edit 2:1-3:1
----
before<-1
«# a note»
after<-1

#---- a_roxygen_block
#'Title
#'@param x thing$0
f<-function(x) x
#++++
edit 2:1-3:1
----
#'Title
«#' @param x thing»
f<-function(x) x

#---- a_trailing_comment_on_the_selected_line
before<-1
x<-1   # a note$0
after<-1
#++++
edit 2:1-3:1
----
before<-1
«x <- 1 # a note»
after<-1

#---- a_file_that_is_only_comments
#one
#two$0
#three
#++++
edit 2:1-3:1
----
#one
«# two»
#three
