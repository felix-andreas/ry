#==== granularity
#---- one_statement_of_a_function_body
f<-function(x){
  a<-1
  b$0<-2
  c<-3
}
#++++
edit 3:1-4:1
----
f<-function(x){
  a<-1
«  b <- 2»
  c<-3
}

#---- a_statement_nested_three_deep
f<-function(){
  for(i in 1:3){
    if(i>1){
      x<-i
      y$0<-2
    }
  }
}
