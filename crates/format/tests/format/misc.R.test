#==== complex_data_manipulation
#---- nested_data_pipeline
# Complex data manipulation with nested function calls and pipeline operators
result <- raw_data %>%
    filter(
        !is.na(value) &
        year >= 2020 &
        category %in% c("A", "B", "C")
    ) %>%
    group_by(
        region,
        quarter = paste0("Q", ceiling(month(date) / 3))
    ) %>%
    summarise(
        mean_value = mean(value, na.rm = TRUE),
        count = n(),
        .groups = "drop"
    ) %>%
    mutate(
        status = case_when(
            mean_value > 100 ~ "high",
            mean_value > 50 ~ "medium",
            TRUE ~ "low"
        )
    )
#++++
# Complex data manipulation with nested function calls and pipeline operators
result <- raw_data %>%
  filter(
    !is.na(value) &
      year >= 2020 &
      category %in% c("A", "B", "C")
  ) %>%
  group_by(
    region,
    quarter = paste0("Q", ceiling(month(date) / 3))
  ) %>%
  summarise(
    mean_value = mean(value, na.rm = TRUE),
    count = n(),
    .groups = "drop"
  ) %>%
  mutate(
    status = case_when(
      mean_value > 100 ~ "high",
      mean_value > 50 ~ "medium",
      TRUE ~ "low"
    )
  )

#==== statistical_modeling
#---- complex_regression_analysis
# Advanced statistical modeling with complex nested expressions
model <- lmer(
    response ~ 
        poly(time, 3) * treatment +
        I(log(baseline_measure + 1)) +
        scale(covariate1) +
        (1 + time | subject_id) +
        (1 | site_id/clinic_id),
    data = analysis_data,
    control = lmerControl(
        optimizer = "bobyqa",
        optCtrl = list(maxfun = 100000)
    )
)
#++++
# Advanced statistical modeling with complex nested expressions
model <- lmer(
  response ~
    poly(time, 3) * treatment +
      I(log(baseline_measure + 1)) +
      scale(covariate1) +
      (1 + time | subject_id) +
      (1 | site_id / clinic_id),
  data = analysis_data,
  control = lmerControl(
    optimizer = "bobyqa",
    optCtrl = list(maxfun = 100000)
  )
)

#==== complex_control_flow
#---- nested_error_handling_validation
# Complex control flow with nested conditionals and error handling
process_data <- function(data_list, strict = FALSE) {
    tryCatch({
        if (is.null(data_list) || length(data_list) == 0) {
            stop("Input cannot be NULL or empty")
        }
        
        for (i in seq_along(data_list)) {
            current_data <- data_list[[i]]
            
            if (!is.data.frame(current_data)) {
                if (strict) {
                    stop(paste("Element", i, "is not a data frame"))
                } else {
                    warning(paste("Skipping element", i))
                    next
                }
            }
            
            # Complex data transformation
            processed <- current_data %>%
                filter(!is.na(value)) %>%
                mutate(
                    normalized = case_when(
                        value >= 0 ~ (value - min(value)) / (max(value) - min(value)),
                        value < 0 ~ pmax(-1, value / abs(min(value))),
                        TRUE ~ NA_real_
                    ),
                    quality = ifelse(
                        abs(scale(value)[, 1]) > 3,
                        "outlier",
                        "valid"
                    )
                )
            
            data_list[[i]] <- processed
        }
        
        return(data_list)
        
    }, error = function(e) {
        stop(paste("Error in process_data:", e$message))
    })
}
#++++
# Complex control flow with nested conditionals and error handling
process_data <- function(data_list, strict = FALSE) {
  tryCatch(
    {
      if (is.null(data_list) || length(data_list) == 0) {
        stop("Input cannot be NULL or empty")
      }

      for (i in seq_along(data_list)) {
        current_data <- data_list[[i]]

        if (!is.data.frame(current_data)) {
          if (strict) {
            stop(paste("Element", i, "is not a data frame"))
          } else {
            warning(paste("Skipping element", i))
            next
          }
        }

        # Complex data transformation
        processed <- current_data %>%
          filter(!is.na(value)) %>%
          mutate(
            normalized = case_when(
              value >= 0 ~ (value - min(value)) / (max(value) - min(value)),
              value < 0 ~ pmax(-1, value / abs(min(value))),
              TRUE ~ NA_real_
            ),
            quality = ifelse(
              abs(scale(value)[, 1]) > 3,
              "outlier",
              "valid"
            )
          )

        data_list[[i]] <- processed
      }

      return(data_list)
    },
    error = function(e) {
      stop(paste("Error in process_data:", e$message))
    }
  )
}

#---- semicolon_only_block_collapses_to_empty
{
  ;
}
#++++
{}

#---- empty_trailing_argument_keeps_comma_space
f((f
),)
#++++
f((f), )

#---- inline_loop_body_expands_enclosing_if
if (1)E else repeat 4
#++++
if (1) {
  E
} else {
  repeat {
    4
  }
}

#---- brace_hug_releases_inline_loop
{ repeat 4 }
#++++
{
  repeat {
    4
  }
}

#---- trailing_directive_after_semicolon_is_plain_comment
y = 6;# fmt: off
weird  <-  1
#++++
y = 6 # fmt: off
weird <- 1
