#==== annotation_compact
#---- atomic
#:integer
#++++
#: integer

#---- collapse_spaces
#:    integer
#++++
#: integer

#---- already_canonical
#: integer
#++++
#: integer

#---- vector
#: integer [ ]
#++++
#: integer[]

#---- named_vector
#: double [ named ]
#++++
#: double[named]

#---- union_null
#: character|NULL
#++++
#: character | NULL

#---- nullable_already_canonical
#: integer | NULL
#++++
#: integer | NULL

#==== annotation_lists
#---- list_array
#: list [ integer ]
#++++
#: list[integer]

#---- list_named
#: list[ named : character ]
#++++
#: list[named: character]

#---- record
#: list{ name : character , age : double }
#++++
#: list{name: character, age: double}

#---- tuple
#: list{ integer , double }
#++++
#: list{integer, double}

#---- nested
#: list[ list{ x : integer } ]
#++++
#: list[list{x: integer}]

#==== annotation_functions
#---- positional
#: fn(integer,double)->character
#++++
#: fn(integer, double) -> character

#---- named_params
#: fn( a : integer , b : double )->logical
#++++
#: fn(a: integer, b: double) -> logical

#---- no_return
#: fn( x : integer )
#++++
#: fn(x: integer)

#---- optional_param
#: fn( [ x ] : integer )->logical
#++++
#: fn([x]: integer) -> logical

#---- nested_function
#: fn( cb : fn(integer)->character )->integer
#++++
#: fn(cb: fn(integer) -> character) -> integer

#---- dotted_member_names
#: fn( na.rm : logical , data.frame : integer )->double
#++++
#: fn(na.rm: logical, data.frame: integer) -> double

#---- variadic_rest
#: fn( x : integer , ... : character )->character
#++++
#: fn(x: integer, ...: character) -> character

#---- variadic_named_rest
#: fn( ...args : integer )->NULL
#++++
#: fn(...args: integer) -> NULL

#==== annotation_generics_binders
#---- generic
#: Map< K , V >
#++++
#: Map<K, V>

#---- nested_generic
#: Map< K , List< V > >
#++++
#: Map<K, List<V>>

#---- generic_vector_suffix_formats
#: Foo< A > [ ]
#++++
#: Foo<A>[]

#---- binder
#: < T >fn( x : T )->T
#++++
#: <T> fn(x: T) -> T

#---- binder_multi
#: <T,U> fn(a: T, b: U) -> T
#++++
#: <T, U> fn(a: T, b: U) -> T

#==== annotation_directives
#---- trust
#:@trust integer
#++++
#: @trust integer

#---- if_unknown
#: @if-unknown   character
#++++
#: @if-unknown character

#---- new
#:@new Person
#++++
#: @new Person

#---- new_generic
#: @new Person< T >
#++++
#: @new Person<T>

#---- type_definition
#: @type Person { list{ name : character } }
#++++
#: @type Person {list{name: character}}

#---- alias_definition
#: @alias Id { integer }
#++++
#: @alias Id {integer}

#---- type_parameters
#: @type Box< T > { list{ value : T } }
#++++
#: @type Box<T> {list{value: T}}

#==== annotation_expanded
#---- params_and_return
#: @param count { integer }
#: @param render { fn(integer)->character }
#: @returns { character }
#++++
#: @param count {integer}
#: @param render {fn(integer) -> character}
#: @returns {character}

#---- optional_param
#: @param [ label ] { character }
#++++
#: @param [label] {character}

#---- forall
#: @forall T , U
#: @param a { T }
#: @return { U }
#++++
#: @forall T, U
#: @param a {T}
#: @return {U}

#==== annotation_multiline_compact
#---- function_across_lines
#: fn(
#:   a : integer ,
#:   b : double
#: )->logical
#++++
#: fn(
#:   a: integer,
#:   b: double
#: ) -> logical

#---- overindented_continuation_normalized
#: fn(
#:     a: integer,
#:     b: double
#: ) -> logical
#++++
#: fn(
#:   a: integer,
#:   b: double
#: ) -> logical

#---- already_indented_is_stable
#: fn(
#:   a: integer,
#:   b: double
#: ) -> logical
#++++
#: fn(
#:   a: integer,
#:   b: double
#: ) -> logical

#==== annotation_multiline_nested
#---- record_across_lines
#: list{
#: name : character ,
#: age : double
#: }
#++++
#: list{
#:   name: character,
#:   age: double
#: }

#---- nested_record_two_levels
#: list{
#: user: list{
#: name: character,
#: age: double
#: },
#: active: logical
#: }
#++++
#: list{
#:   user: list{
#:     name: character,
#:     age: double
#:   },
#:   active: logical
#: }

#---- nullable_union_inside_record
#: list{
#: value: integer |
#: NULL,
#: flag: logical
#: }
#++++
#: list{
#:   value: integer |
#:   NULL,
#:   flag: logical
#: }

#---- array_of_records_across_lines
#: list[ list{
#: id : integer ,
#: name : character
#: } ]
#++++
#: list[list{
#:   id: integer,
#:   name: character
#: }]

#==== annotation_multiline_expanded
#---- param_type_wraps_across_lines
#: @param callback {fn(
#: integer,
#: character
#: ) -> double}
#: @return {logical}
#++++
#: @param callback {fn(
#:   integer,
#:   character
#: ) -> double}
#: @return {logical}

#---- forall_then_wrapped_param
#: @forall T
#: @param box {list{
#: value: T
#: }}
#: @return {T}
#++++
#: @forall T
#: @param box {list{
#:   value: T
#: }}
#: @return {T}

#---- balanced_params_stay_flat
#: @param count {integer}
#: @param label {character}
#: @return {integer}
#++++
#: @param count {integer}
#: @param label {character}
#: @return {integer}

#==== annotation_multiline_definitions
#---- type_definition_across_lines
#: @type Person {
#: list{
#: name : character ,
#: age : double
#: }
#: }
#++++
#: @type Person {
#:   list{
#:     name: character,
#:     age: double
#:   }
#: }

#---- invalid_definition_body_verbatim
#: @type Person {
#: name : character ,
#: age : double
#: }
#++++
#: @type Person {
#: name : character ,
#: age : double
#: }

#---- generic_alias_across_lines
#: @alias Pair<A, B> {
#: list{
#: first: A,
#: second: B
#: }
#: }
#++++
#: @alias Pair<A, B> {
#:   list{
#:     first: A,
#:     second: B
#:   }
#: }

#---- type_definition_hugs_nested_list
#: @type Instrument {list{
#: id : integer ,
#: name : character
#: }}
#++++
#: @type Instrument {list{
#:   id: integer,
#:   name: character
#: }}

#---- definition_block_two_lines
#: @type Cat { list{ name : character } }
#: @type Dog { list{ name : character } }
#++++
#: @type Cat {list{name: character}}
#: @type Dog {list{name: character}}

#---- definition_block_interior_gap_kept
#: @type Cat {integer}
#:
#: @type Dog {integer}
#++++
#: @type Cat {integer}
#:
#: @type Dog {integer}

#==== annotation_gate_verbatim
#---- prose_after_unsupported_prefix_verbatim
#: T[] not supported, see docs (someday)
#++++
#: T[] not supported, see docs (someday)

#---- param_description_verbatim
#: @param x {integer} (defaults to one)
#++++
#: @param x {integer} (defaults to one)

#---- interior_empty_line_before_closer_kept
#: list{a: integer,
#:
#: b: double}
#++++
#: list{a: integer,
#:
#: b: double}

#==== annotation_block_normalization
#---- expanded_closers_move_to_own_lines
#: @type Future {
#:     list{
#:         instrument: Instrument,
#:         maturity: integer
#:     }}
#:
#++++
#: @type Future {
#:   list{
#:     instrument: Instrument,
#:     maturity: integer
#:   }
#: }

