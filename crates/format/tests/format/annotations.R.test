#: @type Future {list{
#:   id: integer
#: }
#: }
#++++
#: @type Future {list{
#:   id: integer
#: }}

#---- trailing_empty_line_dropped
#: integer
#:
x <- 1L
#++++
#: integer
x <- 1L

#==== annotation_multiline_hug
#---- record_value_across_lines
#: list{
#: name : character ,
#: age : double
#: }
#++++
#: list{
#:   name: character,
#:   age: double
#: }

#---- nested_list_hugs_to_one_level
#: list{list{
#: x : integer ,
#: y : integer
#: }}
#++++
#: list{list{
