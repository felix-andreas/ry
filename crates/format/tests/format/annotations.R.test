#:   y: integer
#: }}

#==== annotation_preserve
#---- empty
#:
#++++
#:

#---- prose_leading_space
#: this is not a type
#++++
#: this is not a type

#---- dotted_name_verbatim
#: data.frame
#++++
#: data.frame

#---- dotted_name_no_space
#:data.frame
#++++
#: data.frame

#---- bare_minus_verbatim
#: a - b
#++++
#: a - b

#---- url_verbatim
#: see http://example.com
#++++
#: see http://example.com

#---- double_colon_verbatim
#: a::b
#++++
#: a::b

#---- prose_comparison_verbatim
#: value < ten
#++++
#: value < ten

#---- prose_namespace_verbatim
#: see base::sum for details
#++++
#: see base::sum for details

#---- multiline_prose_verbatim
#: this block explains the code below
#: and continues here
#++++
#: this block explains the code below
#: and continues here

#---- prose_missing_space_gets_prefix
#:not a type!
#++++
#: not a type!

#---- unbalanced_block_verbatim
#: fn(integer
#: -> double
#++++
#: fn(integer
#: -> double

#==== annotation_inline
#---- after_assignment
x <- 1L #:integer
#++++
x <- 1L #: integer

#---- after_call
foo(bar) #:  list[ integer ]
#++++
foo(bar) #: list[integer]

#---- own_line_annotation_survives_expression_join
(r
#:
-a)
#++++
(r
  #:
  - a)

#---- midline_annotation_interrupting_expression_refused
x <- #: integer
1L
#++++
ERROR: Syntax error: a `#:` annotation cannot interrupt an expression. Move it to its own line at line 1, column 6
