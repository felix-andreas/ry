#==== functions
#---- editing_a_body_rebinds_only_that_function
#~~~~ before R/a.R
first <- function() 1
second <- function() 2
#~~~~ after R/a.R
first <- function() 10
second <- function() 2
#++++
source R/a.R
bind first from R/a.R:1:9
keeps names

#---- a_function_that_moved_is_rebound_but_nothing_reruns
#~~~~ before R/a.R
value <- helper()
helper <- function() 1
#~~~~ after R/a.R
value <- helper()

helper <- function() 1
#++++
source R/a.R
bind helper from R/a.R:3:10
keeps names
affects callers value

#---- a_deleted_function_is_removed
#~~~~ before R/a.R
kept <- function() 1
gone <- function() 2
#~~~~ after R/a.R
kept <- function() 1
#++++
source R/a.R
remove gone

#---- a_function_moved_to_another_file_is_rebound_not_removed
#~~~~ before R/a.R
travels <- function() 1
#~~~~ before R/b.R
other <- function() 2
#~~~~ after R/a.R
#~~~~ after R/b.R
other <- function() 2
travels <- function() 1
#++++
source R/a.R
source R/b.R
bind travels from R/b.R:2:11
keeps names

#---- a_deleted_file_drops_its_bindings_and_source
#~~~~ R/a.R
kept <- function() 1
#~~~~ before R/b.R
temporary <- function() 2
#++++
drop source R/b.R
remove temporary

#---- an_unchanged_package_needs_nothing
#~~~~ R/a.R
f <- function() 1
x <- 1
#++++
rebuild imports (0 directives)
source R/a.R
bind f from R/a.R:1:5
run R/a.R:2 x <- 1
sync exports
run .onLoad

#==== statements
#---- an_inserted_statement_runs_alone
#~~~~ before R/a.R
a <- 1
b <- 2
#~~~~ after R/a.R
a <- 1
inserted <- 3
b <- 2
#++++
source R/a.R
run R/a.R:2 inserted <- 3

#---- a_statement_reading_a_changed_function_reruns
#~~~~ before R/a.R
helper <- function() 1
cached <- helper()
untouched <- 5
#~~~~ after R/a.R
helper <- function() 2
cached <- helper()
untouched <- 5
#++++
source R/a.R
bind helper from R/a.R:1:10
run R/a.R:2 cached <- helper()

#---- reruns_cascade_forward_through_statements
#~~~~ before R/a.R
base <- function() 1
level_one <- base()
level_two <- level_one + 1
unrelated <- 3
#~~~~ after R/a.R
base <- function() 2
level_one <- base()
level_two <- level_one + 1
unrelated <- 3
#++++
source R/a.R
bind base from R/a.R:1:8
run R/a.R:2 level_one <- base()
run R/a.R:3 level_two <- level_one + 1

#---- a_read_inside_a_function_body_does_not_rerun
#~~~~ before R/a.R
helper <- function() 1
Class <- list(method = function() helper())
#~~~~ after R/a.R
helper <- function() 2
Class <- list(method = function() helper())
#++++
source R/a.R
bind helper from R/a.R:1:10
keeps names
affects callers Class

#---- a_deleted_statement_removes_what_only_it_bound
#~~~~ before R/a.R
shared <- 1
shared <- shared + 1
alone <- 2
#~~~~ after R/a.R
shared <- 1
#++++
source R/a.R
remove alone
run R/a.R:1 shared <- 1

#==== laziness_flips
#---- a_second_writer_turns_a_lazy_function_eager
#~~~~ R/a.R
cache <- function(x) x
#~~~~ after R/b.R
cache <- memoise::memoise(cache)
#++++
source R/b.R
run R/a.R:1 cache <- function(x) x
run R/b.R:1 cache <- memoise::memoise(cache)

#---- removing_the_second_writer_turns_it_lazy_again
#~~~~ R/a.R
cache <- function(x) x
#~~~~ before R/b.R
cache <- memoise::memoise(cache)
#++++
drop source R/b.R
bind cache from R/a.R:1:9
keeps names

#==== registrations
#---- a_deleted_s4_method_is_unregistered
#~~~~ before R/a.R
setClass("Point", representation(x = "numeric"))
setMethod("show", "Point", function(object) cat("point"))
#~~~~ after R/a.R
setClass("Point", representation(x = "numeric"))
#++++
source R/a.R
unregister S4Method { generic: "show", signature: ["Point"] }

#---- a_changed_s4_method_reruns_without_unregistering
#~~~~ before R/a.R
setMethod("show", "Point", function(object) cat("point"))
#~~~~ after R/a.R
setMethod("show", "Point", function(object) cat("POINT"))
#++++
source R/a.R
run R/a.R:1 setMethod("show", "Point", function(object) cat("POINT"))

#---- a_rebound_s3_method_is_registered_again
#~~~~ NAMESPACE
S3method(print, money)
#~~~~ before R/a.R
print.money <- function(x, ...) cat("money")
#~~~~ after R/a.R
print.money <- function(x, ...) cat("MONEY")
#++++
source R/a.R
bind print.money from R/a.R:1:15
register S3 print.money as print.money
keeps names

#---- a_new_s3method_directive_registers_and_a_dropped_one_unregisters
#~~~~ before NAMESPACE
S3method(print, money)
#~~~~ after NAMESPACE
S3method(format, money)
#~~~~ R/a.R
print.money <- function(x, ...) cat("money")
format.money <- function(x, ...) "money"
#++++
unregister S3 print.money
register S3 format.money as format.money
keeps names

#---- dropping_the_earlier_of_two_directives_for_a_method_changes_nothing
#~~~~ before NAMESPACE
S3method(summary, widget, summarise_widget)
S3method(summary, widget, describe_widget)
#~~~~ after NAMESPACE
S3method(summary, widget, describe_widget)
#~~~~ R/a.R
summarise_widget <- function(object, ...) "summary"
describe_widget <- function(object, ...) "description"
#++++
nothing to do

#---- dropping_the_later_of_two_directives_for_a_method_registers_the_earlier
#~~~~ before NAMESPACE
S3method(summary, widget, summarise_widget)
S3method(summary, widget, describe_widget)
#~~~~ after NAMESPACE
S3method(summary, widget, summarise_widget)
#~~~~ R/a.R
summarise_widget <- function(object, ...) "summary"
describe_widget <- function(object, ...) "description"
#++++
register S3 summary.widget as summarise_widget
keeps names

#---- rebinding_the_losing_function_of_two_directives_registers_nothing
#~~~~ NAMESPACE
S3method(summary, widget, summarise_widget)
S3method(summary, widget, describe_widget)
#~~~~ before R/a.R
summarise_widget <- function(object, ...) "summary"
#~~~~ after R/a.R
summarise_widget <- function(object, ...) "changed"
#~~~~ R/b.R
describe_widget <- function(object, ...) "description"
#++++
source R/a.R
bind summarise_widget from R/a.R:1:20
keeps names

#---- a_rerun_statement_writing_only_known_names_keeps_them
#~~~~ R/a.R
f <- function() 1
#~~~~ before R/b.R
x <- 1
y <- f()
#~~~~ after R/b.R
x <- 2
y <- f()
#++++
source R/b.R
run R/b.R:1 x <- 2

#==== namespace
#---- a_changed_import_rebuilds_the_imports
#~~~~ before NAMESPACE
importFrom(stats, median)
#~~~~ after NAMESPACE
importFrom(stats, median, sd)
#~~~~ R/a.R
f <- function() 1
#++++
rebuild imports (1 directives)
keeps names

#---- an_export_change_needs_no_rebinding
#~~~~ before NAMESPACE
export(f)
#~~~~ after NAMESPACE
export(f, g)
#~~~~ R/a.R
f <- function() 1
g <- function() 2
#++++
sync exports

#==== hooks
#---- editing_onload_runs_it_again
#~~~~ before R/zzz.R
.onLoad <- function(libname, pkgname) options(demo.level = 1)
#~~~~ after R/zzz.R
.onLoad <- function(libname, pkgname) options(demo.level = 2)
#++++
source R/zzz.R
bind .onLoad from R/zzz.R:1:11
keeps names
run .onLoad

#==== ordering
#---- rerunning_a_writer_reruns_the_later_writers_of_its_name
#~~~~ before R/a.R
level <- 1
level <- 2
#~~~~ after R/a.R
level <- 10
level <- 2
#++++
source R/a.R
run R/a.R:1 level <- 10
run R/a.R:2 level <- 2

#---- deleting_the_last_writer_reruns_the_one_before
#~~~~ before R/a.R
level <- 1
level <- 2
#~~~~ after R/a.R
level <- 1
#++++
source R/a.R
run R/a.R:1 level <- 1

#---- editing_a_self_wrapping_statement_reruns_the_definition_first
#~~~~ before R/a.R
compute <- function(x) x
compute <- memoise::memoise(compute)
#~~~~ after R/a.R
compute <- function(x) x
compute <- memoise::memoise(compute, cache = cachem::cache_mem())
#++++
source R/a.R
run R/a.R:1 compute <- function(x) x
run R/a.R:2 compute <- memoise::memoise(compute, cache = cachem::cache_mem())

#---- a_statement_that_called_through_a_changed_function_reruns
#~~~~ before R/a.R
deepest <- function() 1
middle <- function() deepest()
cached <- middle()
#~~~~ after R/a.R
deepest <- function() 2
middle <- function() deepest()
cached <- middle()
#++++
source R/a.R
bind deepest from R/a.R:1:11
run R/a.R:3 cached <- middle()

#==== strict_constants
#---- editing_a_pure_function_rebinds_the_constants_that_call_it
#~~~~ before R/a.R
# typing: strict
#: @pure
twice <- function(x) x * 2
doubled <- twice(21)
label <- "fixed"
#~~~~ after R/a.R
# typing: strict
#: @pure
twice <- function(x) x * 3
doubled <- twice(21)
label <- "fixed"
#++++
source R/a.R
bind twice from R/a.R:3:9
bind doubled from R/a.R:4:11
keeps names

#---- a_statement_reading_a_rebound_constant_reruns
#~~~~ before R/a.R
# typing: strict
#: @pure
twice <- function(x) x * 2
doubled <- twice(21)
#~~~~ after R/a.R
# typing: strict
#: @pure
twice <- function(x) x * 3
doubled <- twice(21)
#~~~~ R/b.R
.onLoad <- function(libname, pkgname) NULL
setClass("Box", representation(size = "numeric"), prototype(size = doubled))
#++++
source R/a.R
bind twice from R/a.R:3:9
bind doubled from R/a.R:4:11
run R/b.R:2 setClass("Box", representation(size = "numeric"), prototype(size = doubled))

#---- a_constant_that_became_impure_runs_eagerly
#~~~~ before R/a.R
# typing: strict
version <- "1.0"
#~~~~ after R/a.R
# typing: strict
version <- Sys.getenv("VERSION")
#++++
source R/a.R
run R/a.R:2 version <- Sys.getenv("VERSION")

#---- a_constant_reading_a_name_written_again_later_turns_eager
#~~~~ R/a.R
# typing: strict
z <- 1
#~~~~ R/b.R
# typing: strict
y <- z + 1
#~~~~ before R/c.R
# typing: strict
w <- 3
#~~~~ after R/c.R
# typing: strict
z <- 2
#++++
source R/c.R
remove w
run R/a.R:2 z <- 1
run R/b.R:2 y <- z + 1
run R/c.R:2 z <- 2

#---- a_constant_reading_a_name_on_load_writes_turns_eager
#~~~~ R/a.R
# typing: strict
z <- 1
#~~~~ before R/b.R
# typing: strict
y <- z + 1
.onLoad <- function(libname, pkgname) NULL
#~~~~ after R/b.R
# typing: strict
y <- z + 1
.onLoad <- function(libname, pkgname) z <<- 5
#++++
source R/b.R
bind .onLoad from R/b.R:3:11
run R/b.R:2 y <- z + 1
keeps names
run .onLoad

#---- a_constant_calling_a_pure_function_of_an_imported_package_stays_lazy
#~~~~ DESCRIPTION
Package: demo
Version: 0.1.0
Imports: tools
#~~~~ before R/a.R
# typing: strict
extension <- tools::file_ext("data.csv")
#~~~~ after R/a.R
# typing: strict
extension <- tools::file_ext("data.tsv")
#++++
source R/a.R
bind extension from R/a.R:2:13
keeps names

#==== r6_generators
#---- an_edited_generator_is_rebound_lazily_outside_strict_mode
#~~~~ before R/a.R
Counter <- R6::R6Class("Counter", public = list(n = 0, add = function() self$n + 1))
#~~~~ after R/a.R
Counter <- R6::R6Class("Counter", public = list(n = 1, add = function() self$n + 1))
#++++
source R/a.R
bind Counter from R/a.R:1:11
keeps names

#---- a_generator_whose_methods_call_a_later_function_stays_lazy
#~~~~ before R/a.R
Counter <- R6::R6Class("Counter", public = list(add = function() step()))
#~~~~ after R/a.R
Counter <- R6::R6Class("Counter", public = list(add = function() step() + 1))
#~~~~ R/b.R
step <- function() 1
#++++
source R/a.R
bind Counter from R/a.R:1:11
keeps names

#---- a_generator_with_an_effect_in_its_arguments_runs_eagerly
#~~~~ before R/a.R
Counter <- R6::R6Class("Counter", public = list(n = 0))
#~~~~ after R/a.R
Counter <- R6::R6Class("Counter", public = list(n = Sys.time()))
#++++
source R/a.R
run R/a.R:1 Counter <- R6::R6Class("Counter", public = list(n = Sys.time()))

#---- a_generator_inheriting_from_a_later_class_runs_eagerly
#~~~~ before R/a.R
Child <- R6::R6Class("Child", inherit = Base, public = list(n = 0))
#~~~~ after R/a.R
Child <- R6::R6Class("Child", inherit = Base, public = list(n = 1))
#~~~~ R/b.R
Base <- R6::R6Class("Base")
#++++
source R/a.R
run R/a.R:1 Child <- R6::R6Class("Child", inherit = Base, public = list(n = 1))

#==== os_subdirectories
#---- an_os_file_runs_after_the_files_of_r
#~~~~ R/z.R
level <- 1
#~~~~ after R/unix/a.R
level <- 2
#++++
source R/unix/a.R
run R/z.R:1 level <- 1
run R/unix/a.R:1 level <- 2

#---- the_os_collation_field_wins_over_collate_and_reordering_reloads_in_full
#~~~~ before DESCRIPTION
Package: demo
Version: 0.1.0
Collate: 'b.R' 'unix/a.R'
#~~~~ after DESCRIPTION
Package: demo
Version: 0.1.0
Collate: 'b.R' 'unix/a.R'
Collate.unix: 'unix/a.R' 'b.R'
#~~~~ R/b.R
level <- 1
#~~~~ R/unix/a.R
level <- 2
#++++
rebuild imports (0 directives)
source R/unix/a.R
source R/b.R
run R/unix/a.R:1 level <- 2
run R/b.R:1 level <- 1
sync exports
run .onLoad

#==== datasets
#---- an_added_dataset_loads_every_dataset
#~~~~ R/a.R
f <- function() 1
#~~~~ data/prices.R
prices <- c(1, 2)
#~~~~ after data/rates.rda
binary
#++++
load datasets data/prices.R data/rates.rda
keeps names

#---- a_changed_dataset_reloads_the_datasets
#~~~~ R/a.R
f <- function() 1
#~~~~ before data/prices.R
prices <- c(1, 2)
#~~~~ after data/prices.R
prices <- c(1, 2, 3)
#++++
load datasets data/prices.R
keeps names

#---- removing_the_last_dataset_clears_them
#~~~~ R/a.R
f <- function() 1
#~~~~ before data/prices.R
prices <- c(1, 2)
#++++
clear datasets
keeps names

#---- a_fresh_load_reads_every_dataset
#~~~~ R/a.R
f <- function() 1
#~~~~ data/prices.R
prices <- c(1, 2)
#~~~~ data/rates.csv
rate
1
#++++
rebuild imports (0 directives)
source R/a.R
bind f from R/a.R:1:5
load datasets data/prices.R data/rates.csv
sync exports
run .onLoad

#==== callers
#---- an_edit_reaches_the_functions_that_call_it_transitively
#~~~~ before R/a.R
helper <- function() 1
middle <- function() helper() + 1
outer <- function() middle() * 2
unrelated <- function() 3
#~~~~ after R/a.R
helper <- function() 10
middle <- function() helper() + 1
outer <- function() middle() * 2
unrelated <- function() 3
#++++
source R/a.R
bind helper from R/a.R:1:10
keeps names
affects callers middle, outer
