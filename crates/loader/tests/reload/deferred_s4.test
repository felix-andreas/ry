hold back R/a.R:4 setGeneric("area", function(shape) standardGeneric("area"))
hold back R/a.R:5 setMethod("area", signature("Sq"), function(shape) shape@side^2)
placeholders .__C__Sq .__T__area:demo Sq area
generics run on first use area
sync exports
run .onLoad

