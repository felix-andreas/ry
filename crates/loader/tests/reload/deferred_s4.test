#==== deferred_s4
#---- a_package_s4_model_is_held_back
#~~~~ R/a.R
SIDES <- 4
Sq <- setClass("Sq", representation(side = "numeric"))
setValidity("Sq", function(object) TRUE)
setGeneric("area", function(shape) standardGeneric("area"))
setMethod("area", signature("Sq"), function(shape) shape@side^2)
#++++
rebuild imports (0 directives)
source R/a.R
run R/a.R:1 SIDES <- 4
hold back R/a.R:2 Sq <- setClass("Sq", representation(side = "numeric"))
hold back R/a.R:3 setValidity("Sq", function(object) TRUE)
hold back R/a.R:4 setGeneric("area", function(shape) standardGeneric("area"))
hold back R/a.R:5 setMethod("area", signature("Sq"), function(shape) shape@side^2)
placeholders .__C__Sq .__T__area:demo Sq area
sync exports
run .onLoad

