#---- values.R__R/fact.R
# A package-level self-recursive function keeps the fixed point's Unknown return on purpose:
# heterogeneous self-recursion (the tree fold T = double | list[T]) is untypeable in HM, and
# pinning the parameter through the recursive call manufactures call-site false positives.
# Unannotated consumers tolerate the Unknown; the mutual case below shows the typed contrast.
top_fact <- function(k) {
  if (k <= 1L) 1L else k * top_fact(k - 1L)
}
