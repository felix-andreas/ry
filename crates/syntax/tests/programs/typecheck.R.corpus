#---- recursion.R__mutual_local_recursion_stays_refused
# Letrec visibility is per binding: `is_even`'s body references `is_odd` before any binding for
# it exists, which stays a loud refusal rather than a silent mistype. Top-level mutual recursion
# resolves through the package interface instead.
pair <- function() {
  is_even <- function(n) if (n == 0L) TRUE else is_odd(n - 1L)
  is_odd <- function(n) if (n == 0L) FALSE else is_even(n - 1L)
  is_even(4L)
}
#---- recursion.R__mutual_top_level_pair_schemes
is_even <- function(n) if (n == 0L) TRUE else is_odd(n - 1L)
is_odd <- function(n) if (n == 0L) FALSE else is_even(n - 1L)
is_even(4L)
#---- recursion.R__mutual_pair_without_in_file_call
even2 <- function(n) if (n == 0L) TRUE else odd2(n - 1L)
odd2 <- function(n) if (n == 0L) FALSE else even2(n - 1L)
