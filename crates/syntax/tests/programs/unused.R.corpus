#---- basics.R__unused_local_is_reported
f <- function() {
  x <- 1L
  2L
}
#---- basics.R__used_local_is_not_reported
f <- function() {
  x <- 1L
  x
}
#---- basics.R__only_final_reassignment_is_kept
f <- function() {
  x <- 1L
  x <- 2L
  x
}
#---- basics.R__loop_accumulator_is_used
g <- function() {
  total <- 0L
  for (i in 1:3) {
    total <- total + i
  }
  total
}
#---- basics.R__dead_store_before_rewrite_is_reported
f <- function() {
  x <- 1L
  x <- 2L
  y <- x
  y
}
#---- basics.R__write_read_only_on_loop_back_edge_is_used
f <- function(n) {
  while (n > 0L) {
    y <- x
    x <- 1L
    n <- n - 1L
  }
}
#---- basics.R__conditional_write_never_read_is_reported
f <- function(flag) {
  if (flag) {
    x <- 1L
  }
  2L
}
#---- basics.R__read_before_conditional_introduction_warns
f <- function(flag) {
  if (flag) {
    x <- 1L
  }
  x
}
#---- basics.R__multiple_unused_locals_each_reported
f <- function() {
  a <- 1L
  b <- 2L
  3L
}
#---- basics.R__local_used_only_in_nested_function_is_not_reported
f <- function() {
  outer <- 1L
  function() outer
}
#---- basics.R__nested_unused_local_is_reported
f <- function() {
  inner <- function() {
    helper <- 1L
    2L
  }
  inner
}
#---- basics.R__dot_prefixed_local_is_ignored
f <- function() {
  .ignored <- 1L
  2L
}
#---- basics.R__underscore_prefixed_local_is_ignored
f <- function() {
  `_ignored` <- 1L
  2L
}
#---- basics.R__top_level_assignment_is_not_reported
unused_global <- 1L
#---- basics.R__unused_parameter_is_not_reported
f <- function(unused_param) 1L
#---- basics.R__unused_for_variable_is_not_reported
f <- function() {
  for (item in 1:3) {
    1L
  }
}
#---- basics.R__local_used_in_expression_is_not_reported
f <- function() {
  value <- 1L
  value + 1L
}
#---- basics.R__local_read_through_a_slot_access_counts
f <- function() {
  config <- list()
  config@port
}
#---- basics.R__slot_replacement_write_is_exempt
f <- function() {
  config <- list()
  config@port <- 8080L
  config
}
