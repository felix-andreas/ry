#==== lexical
#---- keywords_and_constants
if (TRUE) NULL else for (i in NA_integer_) next
#++++
0..2 "if" Keyword
4..8 "TRUE" Constant
10..14 "NULL" Constant
15..19 "else" Keyword
20..23 "for" Keyword
27..29 "in" Keyword
30..41 "NA_integer_" Constant
43..47 "next" Keyword

#---- numbers
c(1L, 0x1F, 1e-3, 1i, 2)
#++++
0..1 "c" Function
2..4 "1L" Number
6..10 "0x1F" Number
12..16 "1e-3" Number
18..20 "1i" Number
22..23 "2" Number

#---- strings
x <- "a" ; y <- r"(b\c)" ; z <- 'q'
#++++
2..4 "<-" Operator
5..8 "\"a\"" String
13..15 "<-" Operator
16..24 "r\"(b\\c)\"" String
29..31 "<-" Operator
32..35 "'q'" String

#---- comments
x # trailing comment
#++++
2..20 "# trailing comment" Comment

#---- operators
a |> f() %in% b -> d
x = 1
#++++
2..4 "|>" Operator
5..6 "f" Function
9..13 "%in%" Operator
16..18 "->" Operator
23..24 "=" Operator
25..26 "1" Number

#---- quoted_name
`my var` <- 1
#++++
0..8 "`my var`" QuotedName
9..11 "<-" Operator
12..13 "1" Number

#==== names
#---- function_call_and_namespace
stats::sd(x) + base:::f(y)
#++++
0..5 "stats" Namespace
5..7 "::" Namespace
7..9 "sd" Function
15..19 "base" Namespace
19..22 ":::" Namespace
22..23 "f" Function

#---- named_argument_is_a_parameter
f(x, n = 2)
#++++
0..1 "f" Function
5..6 "n" Parameter
9..10 "2" Number

#---- function_parameters
g <- function(a, b = 1) a + b
#++++
0..1 "g" Function
2..4 "<-" Operator
5..13 "function" Keyword
14..15 "a" Parameter
17..18 "b" Parameter
21..22 "1" Number

#==== annotations
#---- comment_annotation
#: @param x {integer}
f <- function(x) x
#++++
0..2 "#:" Annotation
2..3 " " Annotation
3..4 "@" Annotation
4..9 "param" Annotation
9..10 " " Annotation
10..11 "x" Annotation
11..12 " " Annotation
12..13 "{" Annotation
13..20 "integer" Annotation
20..21 "}" Annotation
22..23 "f" Function
24..26 "<-" Operator
27..35 "function" Keyword
36..37 "x" Parameter

#---- inline_annotation
count: integer <- 0L
#++++
5..6 ":" Annotation
6..7 " " Annotation
7..14 "integer" Annotation
15..17 "<-" Operator
18..20 "0L" Number

#---- records_and_tags
p <- (x = 1, y = 2)
s <- :Circle(1)
#++++
2..4 "<-" Operator
6..7 "x" Property
10..11 "1" Number
13..14 "y" Property
17..18 "2" Number
22..24 "<-" Operator
25..26 ":" Tag
26..32 "Circle" Tag
33..34 "1" Number

#==== brackets
#---- unmatched_closer
f(x))
#++++
0..1 "f" Function
4..5 ")" Error

#---- mismatched_closer
(x]
#++++
2..3 "]" Error

#---- double_bracket_closes_whole
x[[1]]
#++++
3..4 "1" Number
