  |     ^

#---- empty_string_as_function_name
""(1)
#++++
error: a function's name cannot be empty: this call names its function with an empty string
 --> 1:1
  | ""(1)
  | ^^

#---- empty_raw_string_as_function_name
r"()"(1)
#++++
error: a function's name cannot be empty: this call names its function with an empty string
 --> 1:1
  | r"()"(1)
  | ^^^^^

#---- empty_string_as_argument_name
c("" = 1, b = 2)
#++++
error: an argument's name cannot be empty: name the argument, or drop the empty string and its `=`
 --> 1:3
  | c("" = 1, b = 2)
  |   ^^

#---- empty_string_as_a_value_is_fine
x$""
f("")
"" <- 1
#++++
no errors

#==== pipes
#---- pipe_into_a_name
x |> f
#++++
error: the right side of `|>` must be a function call, such as `f()`
 --> 1:6
  | x |> f
  |      ^

#---- pipe_into_a_constant
x |> 1
#++++
error: the right side of `|>` must be a function call, such as `f()`
 --> 1:6
  | x |> 1
  |      ^

#---- pipe_into_an_operator_call
x |> -y
#++++
error: R's pipe cannot call `-`: the right side of `|>` must call an ordinary function, such as `f()`
 --> 1:6
  | x |> -y
  |      ^^

#---- pipe_into_a_keyword_call
x |> `if`(a, b)
#++++
error: R's pipe cannot call `if`: the right side of `|>` must call an ordinary function, such as `f()`
 --> 1:6
  | x |> `if`(a, b)
  |      ^^^^^^^^^^

#---- pipe_placeholder_without_a_name
x |> f(1, _)
#++++
error: the pipe placeholder `_` must be passed as a named argument, as in `f(data = _)`
 --> 1:11
  | x |> f(1, _)
  |           ^

#---- pipe_placeholder_twice
x |> f(a = _, b = _)
#++++
error: the pipe placeholder `_` may appear only once in the right side of a `|>`
 --> 1:19
  | x |> f(a = _, b = _)
  |                   ^

#---- pipe_placeholder_in_the_called_function
x |> _$f(a = _)
#++++
error: the pipe placeholder `_` cannot be part of the function a `|>` calls
 --> 1:6
  | x |> _$f(a = _)
  |      ^

#---- pipe_placeholder_nested_in_an_argument
x |> f(g(_))
#++++
error: `_` is the pipe placeholder: it can only be a named argument of the call on the right side of `|>`, as in `x |> f(data = _)`
 --> 1:10
  | x |> f(g(_))
  |          ^

#---- placeholder_outside_a_pipe
y <- _ + 1
#++++
error: `_` is the pipe placeholder: it can only be a named argument of the call on the right side of `|>`, as in `x |> f(data = _)`
 --> 1:6
  | y <- _ + 1
  |      ^

#---- placeholder_reported_once_per_statement
f(_, _)
g(_)
#++++
error: `_` is the pipe placeholder: it can only be a named argument of the call on the right side of `|>`, as in `x |> f(data = _)`
 --> 1:3
  | f(_, _)
  |   ^
error: `_` is the pipe placeholder: it can only be a named argument of the call on the right side of `|>`, as in `x |> f(data = _)`
 --> 2:3
  | g(_)
  |   ^

#---- pipe_placeholder_shapes_r_accepts
x |> f(data = _)
x |> _$a[[1]]
x |> f(y = 1)
function(a = _) 1
#++++
no errors
