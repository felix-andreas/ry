{pkg::
#++++
error: unclosed `{`; expected a matching `}`
 --> 1:1
  | {pkg::
  | ^
error: expected a name after `::`, found end of line
 --> 1:6
  | {pkg::
  |      ^

#---- namespace_name_at_end_of_input_in_call
f(pkg::
#++++
error: unclosed `(`; expected `)` to close it
 --> 1:2
  | f(pkg::
  |  ^
error: expected a name after `::`, found end of file
 --> 1:8
  | f(pkg::
  |        ^

#---- member_name_at_end_of_input
x$
#++++
error: expected a name after `$`, found end of file
 --> 1:3
  | x$
  |   ^

#---- lambda_across_lines_after_operator
x <- \
(y) y + 1
{
  \
  (y) y
}
#++++
no errors

#---- namespace_name_on_next_line
pkg::
name
#++++
error: expected a name after `::`, found end of line
 --> 1:5
