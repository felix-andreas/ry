#==== strings
#---- unterminated_string
x <- "abc
#++++
error: unterminated string; expected a closing quote
 --> 1:6
  | x <- "abc
  |      ^^^^

#---- unterminated_string_single_quote
x <- 'abc
#++++
error: unterminated string; expected a closing quote
 --> 1:6
  | x <- 'abc
  |      ^^^^

#---- unterminated_raw_string
x <- r"(abc
#++++
error: unterminated raw string; expected `)"`
 --> 1:6
  | x <- r"(abc
  |      ^^^^^^

#---- malformed_raw_string
x <- r"abc"
#++++
error: malformed raw string: expected `(`, `[`, or `{` after the quote
 --> 1:6
  | x <- r"abc"
  |      ^^
error: unterminated string; expected a closing quote
 --> 1:11
  | x <- r"abc"
  |           ^

#---- unterminated_backtick_name
`weird name <- 1
#++++
error: unterminated backtick name; expected a closing `` ` ``
 --> 1:1
  | `weird name <- 1
  | ^^^^^^^^^^^^^^^^

#==== numbers
#---- missing_hex_digits
mask <- 0x
#++++
error: missing digits after `0x`
 --> 1:9
  | mask <- 0x
  |         ^^

#==== operators
#---- unterminated_percent_operator
z <- 1 %o 2
#++++
error: unterminated `%` operator; expected a closing `%`
 --> 1:8
  | z <- 1 %o 2
  |        ^^^^

#==== characters
#---- unexpected_character
x <- 1 ; §
#++++
error: unexpected character `§`
 --> 1:10
  | x <- 1 ; §
  |          ^

#---- a_typographic_quote_names_the_ascii_it_replaces
# These arrive by paste, from a document or an editor with smart quotes on, and
# the lexer knows exactly which character was meant.
greeting <- “hello”
#++++
error: `“` is a typographic quote, not R syntax. Use `"` instead
 --> 3:13
  | greeting <- “hello”
  |             ^
error: `”` is a typographic quote, not R syntax. Use `"` instead
 --> 3:19
  | greeting <- “hello”
  |                   ^

#---- an_en_dash_names_the_minus_it_replaces
n <- 5 – 1
#++++
error: `–` is an en dash, not R syntax. Use `-` instead
 --> 1:8
  | n <- 5 – 1
  |        ^

#---- an_invisible_space_is_described_rather_than_quoted
# Quoting it would print an empty pair of backticks and a caret over nothing.
n <- 5 + 1
#++++
error: this is a non-breaking space, not an ordinary space. R needs a plain space here
 --> 2:7
  | n <- 5 + 1
  |       ^

#---- a_zero_width_character_says_to_delete_it
x <- 1​
#++++
error: there is an invisible character here, a zero-width space. Delete it
 --> 1:7
  | x <- 1​
  |       ^
