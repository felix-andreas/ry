#==== strings
#---- unterminated_string
x <- "abc
#++++
error: unterminated string; expected a closing quote
 --> 1:6
  | x <- "abc
  |      ^^^^

#---- unterminated_string_single_quote
x <- 'abc
#++++
error: unterminated string; expected a closing quote
 --> 1:6
  | x <- 'abc
  |      ^^^^

#---- unterminated_raw_string
x <- r"(abc
#++++
error: unterminated raw string; expected `)"`
 --> 1:6
  | x <- r"(abc
  |      ^^^^^^

#---- malformed_raw_string
x <- r"abc"
#++++
error: malformed raw string: expected `(`, `[`, or `{` after the quote
 --> 1:6
  | x <- r"abc"
  |      ^^
error: unterminated string; expected a closing quote
 --> 1:11
  | x <- r"abc"
  |           ^

#---- unterminated_backtick_name
`weird name <- 1
#++++
error: unterminated backtick name; expected a closing `` ` ``
 --> 1:1
  | `weird name <- 1
  | ^^^^^^^^^^^^^^^^

#---- unrecognized_escape
x <- 'a\qb'
#++++
error: `\q` is not an escape R knows. Write `\\` for a backslash
 --> 1:8
  | x <- 'a\qb'
  |        ^^

#---- hex_escape_without_digits
x <- "\x"
#++++
error: `\x` needs a hex digit after it
 --> 1:7
  | x <- "\x"
  |       ^^

#---- octal_escape_too_large
x <- '\400'
#++++
error: `\400` is above `\377`, the largest octal escape
 --> 1:7
  | x <- '\400'
  |       ^^^^

#---- nul_escape
x <- "a\0b"
#++++
error: this escape names the NUL character, which an R string cannot hold
 --> 1:8
  | x <- "a\0b"
  |        ^^

#---- unicode_escape_without_digits
x <- '\u'
#++++
error: `\u` needs a hex digit after it
 --> 1:7
  | x <- '\u'
  |       ^^

#---- unicode_escape_unclosed
x <- '\u{e4'
#++++
error: `\u{` needs a closing `}` after its digits
 --> 1:7
  | x <- '\u{e4'
  |       ^^^^^

#---- unicode_escape_out_of_range
x <- '\U{110000}'
#++++
error: `110000` is not a Unicode code point; the largest is `10ffff`
 --> 1:7
  | x <- '\U{110000}'
  |       ^^^^^^^^^^

#---- unicode_and_byte_escapes_mixed
x <- '\x41\u00e4'
#++++
error: a string cannot mix `\u` or `\U` escapes with octal or `\x` escapes
 --> 1:6
  | x <- '\x41\u00e4'
  |      ^^^^^^^^^^^^

#---- escape_in_a_backtick_name
`a\qb` <- 1
#++++
error: `\q` is not an escape R knows. Write `\\` for a backslash
 --> 1:3
  | `a\qb` <- 1
  |   ^^

#---- empty_backtick_name
`` <- 1
#++++
error: a name cannot be empty: write at least one character between the backquotes
 --> 1:1
  | `` <- 1
  | ^^

#==== numbers
#---- missing_hex_digits
mask <- 0x
#++++
error: missing digits after `0x`
 --> 1:9
  | mask <- 0x
  |         ^^

#---- fraction_after_leading_dot_number
ratio <- .5.5
#++++
error: unexpected number after this expression; expected a newline or `;`
 --> 1:12
  | ratio <- .5.5
  |            ^^

#---- hex_second_dot
ratio <- 0x1.8.2
#++++
error: a hex literal has at most one `.`
 --> 1:10
  | ratio <- 0x1.8.2
  |          ^^^^^

#---- hex_exponent_without_digits
scale <- 0x1.8p
#++++
error: missing digits after the exponent's `p`
 --> 1:10
  | scale <- 0x1.8p
  |          ^^^^^^

#---- exponent_without_digits
rate <- 1e+
#++++
error: missing digits after the exponent's `e`
 --> 1:9
  | rate <- 1e+
  |         ^^^

#---- exponent_runs_into_a_name
if (flag) 1else 2
#++++
error: missing digits after the exponent's `e`
 --> 1:11
  | if (flag) 1else 2
  |           ^^

#==== operators
#---- unterminated_percent_operator
z <- 1 %o 2
#++++
error: unterminated `%` operator; expected a closing `%`
 --> 1:8
  | z <- 1 %o 2
  |        ^^^^

#==== characters
#---- unexpected_character
x <- 1 ; §
#++++
error: unexpected character `§`
 --> 1:10
  | x <- 1 ; §
  |          ^

#---- a_typographic_quote_names_the_ascii_it_replaces
# These arrive by paste, from a document or an editor with smart quotes on, and
# the lexer knows exactly which character was meant.
greeting <- “hello”
#++++
error: `“` is a typographic quote, not R syntax. Use `"` instead
 --> 3:13
  | greeting <- “hello”
  |             ^
error: `”` is a typographic quote, not R syntax. Use `"` instead
 --> 3:19
  | greeting <- “hello”
  |                   ^

#---- an_en_dash_names_the_minus_it_replaces
n <- 5 – 1
#++++
error: `–` is an en dash, not R syntax. Use `-` instead
 --> 1:8
  | n <- 5 – 1
  |        ^

#---- an_invisible_space_is_described_rather_than_quoted
# Quoting it would print an empty pair of backticks and a caret over nothing.
n <- 5 + 1
#++++
error: this is a non-breaking space, not an ordinary space. R needs a plain space here
 --> 2:7
  | n <- 5 + 1
  |       ^

#---- a_zero_width_character_says_to_delete_it
x <- 1​
#++++
error: there is an invisible character here, a zero-width space. Delete it
 --> 1:7
  | x <- 1​
  |       ^
