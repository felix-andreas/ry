#==== function_types
#---- unclosed_function_type_paren
#: fn(x: integer -> double
half <- function(x) x / 2
#++++
error: expected `,` or `)` in this function type's parameters
 --> 1:18
  | #: fn(x: integer -> double
  |                  ^^

#---- function_type_parameter_separator
#: fn(x: integer y: double) -> double
mix <- function(x, y) x + y
#++++
error: expected `,` or `)` in this function type's parameters
 --> 1:18
  | #: fn(x: integer y: double) -> double
  |                  ^

#---- missing_return_type
#: fn(x: integer) ->
step <- function(x) x
#++++
error: expected a return type after `->`
 --> 1:20
  | #: fn(x: integer) ->
  |                    ^

#==== containers
#---- unclosed_record_brace
#: list{a: integer
box <- list(a = 1L)
#++++
error: expected `,` or `}` in this list type
 --> 1:18
  | #: list{a: integer
  |                  ^

#---- record_field_separator
#: list{a: integer b: double}
box <- list(a = 1L, b = 2)
#++++
error: expected `,` or `}` in this list type
 --> 1:20
  | #: list{a: integer b: double}
  |                    ^

#---- unclosed_list_bracket
#: list[integer
items <- list(1L)
#++++
error: unclosed `[` in this list type; expected a matching `]`
 --> 1:8
  | #: list[integer
  |        ^

#==== unions
#---- union_missing_member
#: integer |
value <- 1L
#++++
error: expected a type
 --> 1:12
  | #: integer |
  |            ^

#==== binders
#---- unclosed_binder_list
#: <T fn(x: T) -> T
id <- function(x) x
#++++
error: expected `,` or `>` in the type parameter list
 --> 1:7
  | #: <T fn(x: T) -> T
  |       ^^

#---- empty_binder_list
#: <> fn(x: integer) -> integer
id <- function(x) x
#++++
error: expected a type parameter name in `<...>`
 --> 1:5
  | #: <> fn(x: integer) -> integer
  |     ^

#---- binder_missing_constraint
#: <T: > fn(x: T) -> T
id <- function(x) x
#++++
error: expected a constraint name after `:`
 --> 1:8
  | #: <T: > fn(x: T) -> T
  |        ^

#---- higher_rank_refused
# One finding, not four: recovery reads the type as if the binder were absent.
#: fn(f: <T> fn(x: T) -> T) -> integer
apply1 <- function(f) f(1L)
#++++
error: higher-rank polymorphism is not supported: type parameter binders may only appear at the outermost level
 --> 2:10
  | #: fn(f: <T> fn(x: T) -> T) -> integer
  |          ^

#---- higher_rank_refused_in_a_return
#: fn(n: integer) -> <T> fn(x: T) -> T
make <- function(n) function(x) x
#++++
error: higher-rank polymorphism is not supported: type parameter binders may only appear at the outermost level
 --> 1:22
  | #: fn(n: integer) -> <T> fn(x: T) -> T
  |                      ^

#---- higher_rank_refused_in_a_directive_payload
# A directive payload is not the outermost level; this was silently accepted.
#: @param f {<T> fn(x: T) -> T}
#: @returns {integer}
apply1 <- function(f) f(1L)
#++++
error: higher-rank polymorphism is not supported: type parameter binders may only appear at the outermost level
 --> 2:14
  | #: @param f {<T> fn(x: T) -> T}
  |              ^

#==== type_arguments
#---- trailing_comma_in_type_arguments
#: Box<integer,>
x <- NULL
#++++
error: expected a type in the type argument list
 --> 1:16
  | #: Box<integer,>
  |                ^

#---- unclosed_type_arguments
#: Box<integer
wrapped <- make_box(1L)
#++++
error: expected `,` or `>` in the type argument list
 --> 1:14
  | #: Box<integer
  |              ^

#==== optional_parameters
#---- optional_missing_colon
#: fn([x] integer) -> integer
f <- function(x = 1L) x
#++++
error: expected `:` after `[name]` in an optional parameter
 --> 1:11
  | #: fn([x] integer) -> integer
  |           ^^^^^^^

#---- optional_bad_name
#: fn([1]: integer) -> integer
f <- function(x = 1L) x
#++++
error: expected `[name]: TYPE` for an optional parameter
 --> 1:8
  | #: fn([1]: integer) -> integer
  |        ^

#---- optional_unclosed_bracket
#: fn([x: integer) -> integer
f <- function(x = 1L) x
#++++
error: expected `]` after the optional parameter name
 --> 1:9
  | #: fn([x: integer) -> integer
  |         ^
