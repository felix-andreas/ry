|  [5] "eval(quote({     .oracle_observe_limit <- 96L     .oracle_observe_strict <- identical(Sys.getenv(\"ORACLE_OBSERVE\"),          \"strict\")     .oracle_observe <- function(value) {         lines <- character()         emit <- function(depth, ...) lines[[length(lines) + 1L]] <<- paste0(strrep(\"  \",              depth), ...)         hex <- function(bytes) paste(as.character(bytes), collapse = \"\")         string_token <- function(text) {             if (is.na(text)) return(\"NA\")             mark <- switch(Encoding(text), `UTF-8` = \"U\", latin1 = \"L\",                  bytes = \"B\", \"-\")             bytes <- charToRaw(text)             plain <- all(bytes >= as.raw(32) & bytes < as.raw(127)) &&                  !any(bytes == as.raw(34) | bytes == as.raw(92))             if (plain) return(paste0(mark, \"\\\"\", rawToChar(bytes),                  \"\\\"\"))             if (!.oracle_observe_strict && mark %in% c(\"U\", \"-\") &&                  validUTF8(text)) mark <- \"u\"             paste0(mark, \"<\", hex(bytes), \">\")         }         double_tokens <- function(x) {             tokens <- character(length(x))             missing <- is.na(x)             nan <- is.nan(x)             tokens[missing & !nan] <- \"NA\"             tokens[nan] <- \"NaN\"             rest <- !missing             if (any(rest)) {                 bits <- matrix(as.character(writeBin(as.double(x[rest]),                    raw(), endian = \"big\")), nrow = 8L)                 bits <- vapply(seq_len(ncol(bits)), function(column) paste(bits[,                    column], collapse = \"\"), \"\")                 tokens[rest] <- paste0(sprintf(\"%.17g\", x[rest]),                    \":\", bits)             }             tokens         }         tokens_of <- function(x) {             switch(typeof(x), logical = ifelse(is.na(x), \"NA\",                  ifelse(x, \"T\", \"F\")), integer = ifelse(is.na(x),                  \"NA\", format(x, trim = TRUE, scientific = FALSE)),           