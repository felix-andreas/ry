|  [1] "local({     .oracle_observe_limit <- 96L     .oracle_observe_strict <- identical(Sys.getenv(\"ORACLE_OBSERVE\"),          \"strict\")     .oracle_observe <- function(value) {         lines <- character()         emit <- function(depth, ...) lines[[length(lines) + 1L]] <<- paste0(strrep(\"  \",              depth), ...)         hex <- function(bytes) paste(as.character(bytes), collapse = \"\")         string_token <- function(text) {             if (is.na(text))                  return(\"NA\")             mark <- switch(Encoding(text), `UTF-8` = \"U\", latin1 = \"L\",                  bytes = \"B\", \"-\")             bytes <- charToRaw(text)             plain <- all(bytes >= as.raw(32) & bytes < as.raw(127)) &&                  !any(bytes == as.raw(34) | bytes == as.raw(92))             if (plain)                  return(paste0(mark, \"\\\"\", rawToChar(bytes), \"\\\"\"))             if (!.oracle_observe_strict && mark %in% c(\"U\", \"-\") &&                  validUTF8(text))                  mark <- \"u\"             paste0(mark, \"<\", hex(bytes), \">\")         }         double_tokens <- function(x) {             tokens <- character(length(x))             missing <- is.na(x)             nan <- is.nan(x)             tokens[missing & !nan] <- \"NA\"             tokens[nan] <- \"NaN\"             rest <- !missing             if (any(rest)) {                 bits <- matrix(as.character(writeBin(as.double(x[rest]),                    raw(), endian = \"big\")), nrow = 8L)                 bits <- vapply(seq_len(ncol(bits)), function(column) paste(bits[,                    column], collapse = \"\"), \"\")                 tokens[rest] <- paste0(sprintf(\"%.17g\", x[rest]),                    \":\", bits)             }             tokens         }         tokens_of <- function(x) {             switch(typeof(x), logical = ifelse(is.na(x), \"NA\",                  ifelse(x, \"T\", \"F\")), integer = ifelse(is.na(x),                  \"NA\", format(x, trim = TRUE, scientific = FALSE)),                  double = double_tokens(x), complex = paste0(\"(\",                    double_tokens(Re(x)), \" \", double_tokens(Im(x)),                    \")\"), character = vapply(x, string_token, \"\",                    USE.NAMES = FALSE), raw = as.character(x))         }         weigh <- function(values) {             values <- as.double(values)             index <- seq_along(values)             paste0(sprintf(\"%.0f\", sum(values * (index%%251 +                  1))), \"/\", sprintf(\"%.0f\", sum(values * (index%%65521 +                  1))))         }         double_summary <- function(x) {             nan <- is.nan(x)             missing <- is.na(x) & !nan             x[nan | missing] <- 0             paste0(\"na=\", weigh(missing), \" nan=\", weigh(nan),                  \" bits=\", weigh(as.integer(writeBin(x, raw(),                    endian = \"big\"))))         }         atomic_line <- function(x) {             x <- as.vector(unclass(x))             count <- length(x)             if (count <= .oracle_observe_limit)                  return(paste(tokens_of(x), collapse = \" \"))             head_count <- .oracle_observe_limit%/%2L             middle <- x[(head_count + 1L):(count - head_count)]             summary <- switch(typeof(x), character = {                 present <- !is.na(middle)                 bytes <- lapply(middle[present], charToRaw)                 marks <- Encoding(middle[present])                 if (!.oracle_observe_strict) {                   wide <- vapply(bytes, function(text) any(text >=                      as.raw(128)), NA)                   marks[wide & marks %in% c(\"UTF-8\", \"unknown\") &                      validUTF8(middle[present])] <- \"u\"                 }                 paste0(\"na=\", weigh(!present), \" lengths=\", weigh(lengths(bytes)),                    \" bytes=\", weigh(as.integer(unlist(bytes))),                    \" marks=\", weigh(match(marks, c(\"unknown\",                      \"u\", \"UTF-8\", \"latin1\", \"bytes\"))))             }, raw = paste0(\"bytes=\", weigh(as.integer(middle))),                  complex = paste0(\"re \", double_summary(Re(middle)),                    \" im \", double_summary(Im(middle))), double_summary(as.double(middle)))             paste(c(tokens_of(x[seq_len(head_count)]), paste0(\"...[\",                  summary, \"]\"), tokens_of(x[(count - head_count +                  1L):count])), collapse = \" \")         }         environment_line <- function(env) {             if (identical(env, globalenv()))                  return(\"<global>\")             if (identical(env, baseenv()))                  return(\"<base>\")             if (identical(env, emptyenv()))                  return(\"<empty>\")             name <- environmentName(env)             if (nzchar(name))                  return(paste0(\"<\", if (isNamespace(env)) \"namespace:\" else \"\",                    name, \">\"))             names <- sort(ls(env, all.names = TRUE), method = \"radix\")             paste0(\"<env\", if (environmentIsLocked(env))                  \" locked\", \" [\", paste(vapply(names, string_token,                  \"\"), collapse = \" \"), \"]>\")         }         walk <- function(x, depth, label) {             if (depth > 40L) {                 emit(depth, label, \"<too deep>\")                 return(invisible())             }             kind <- typeof(x)             flags <- paste0(if (is.object(x))                  \" obj\", if (isS4(x))                  \" S4\")             switch(kind, `NULL` = emit(depth, label, \"NULL\"),                  logical = , integer = , double = , complex = ,                  character = , raw = emit(depth, label, kind,                    \"[\", length(x), \"]\", flags, \" \", atomic_line(x)),                  list = , expression = {                   emit(depth, label, kind, \"[\", length(x), \"]\",                      flags)                   items <- unclass(x)                   attributes(items) <- NULL                   for (index in seq_along(items)) {                     if (identical(items[[index]], quote(expr = ))) emit(depth +                        1L, index, \": symbol <empty>\") else walk(items[[index]],                        depth + 1L, paste0(index, \": \"))                   }                 }, symbol = emit(depth, label, \"symbol \", if (identical(x,                    quote(expr = ))) \"<empty>\" else string_token(as.character(x))),                  language = , pairlist = {                   emit(depth, label, kind, \"[\", length(x), \"]\",                      flags)                   tags <- names(x)                   items <- as.list(unclass(x))                   for (index in seq_along(items)) {                     tag <- if (!is.null(tags) && nzchar(tags[[index]])) paste0(string_token(tags[[index]]),                        \" = \") else \"\"                     if (identical(items[[index]], quote(expr = ))) emit(depth +                        1L, index, \": \", tag, \"symbol <empty>\") else walk(items[[index]],                        depth + 1L, paste0(index, \": \", tag))                   }                 }, closure = {                   emit(depth, label, \"closure\", flags, \" in \",                      environment_line(environment(x)))                   walk(formals(x), depth + 1L, \"formals: \")                   walk(body(x), depth + 1L, \"body: \")                 }, builtin = , special = emit(depth, label, kind,                    \" \", paste(deparse(x), collapse = \"\")), environment = emit(depth,                    label, \"environment\", flags, \" \", environment_line(x)),                  S4 = emit(depth, label, \"S4\", flags), emit(depth,                    label, kind, flags))             if (kind %in% c(\"symbol\", \"builtin\", \"special\", \"NULL\"))                  return(invisible())             attrs <- attributes(x)             attrs <- attrs[!names(attrs) %in% c(\"srcref\", \"srcfile\",                  \"wholeSrcref\", if (kind == \"pairlist\") \"names\")]             for (name in names(attrs)) {                 value <- attrs[[name]]                 if (identical(name, \"row.names\") && is.data.frame(x))                    value <- .row_names_info(x, 0L)                 walk(value, depth + 1L, paste0(\"@\", string_token(name),                    \": \"))             }             invisible()         }         if (missing(value))              return(\"symbol <empty>\")         walk(value, 0L, \"\")         paste(lines, collapse = \"\\n\")     }     .oracle_observe_condition <- function(kind, condition) {         paste0(kind, \" <\", paste(class(condition), collapse = \"/\"),              \">\")     }     observing <- nzchar(Sys.getenv(\"ORACLE_OBSERVE\"))     observed <- character()     observe_value <- function(result) {         dump <- tryCatch(.oracle_observe(result$value), error = function(condition) {             paste(\"the observer failed:\", conditionMessage(condition))         })         observe_note(paste0(if (result$visible)              \"visible \"         else \"invisible \", dump))     }     position <- 0L     observe_note <- function(text) observed <<- c(observed, paste0(\"[\",          position, \"] \", text))     observe_condition <- function(kind, condition) {         observe_note(paste0(.oracle_observe_condition(kind, condition),              \" \", describe(condition)))     }     argv <- commandArgs(trailingOnly = TRUE)     script <- argv[1L]     report <- argv[2L]     messages <- character()     warnings <- character()     errors <- character()     last <- NULL     top_level <- quote(eval(expression, globalenv()))     describe <- function(condition) {         call <- conditionCall(condition)         if (identical(call, top_level))              call <- NULL         text <- conditionMessage(condition)         if (is.null(call))              text         else paste0(text, \" (in \", deparse(call, nlines = 1L),              \")\")     }     json_string <- function(text) {         text <- gsub(\"\\\\\", \"\\\\\\\\\", text, fixed = TRUE)         text <- gsub(\"\\\"\", \"\\\\\\\"\", text, fixed = TRUE)         text <- gsub(\"\\n\", \"\\\\n\", text, fixed = TRUE)         text <- gsub(\"\\r\", \"\\\\r\", text, fixed = TRUE)         text <- gsub(\"\\t\", \"\\\\t\", text, fixed = TRUE)         for (code in setdiff(1:31, c(9L, 10L, 13L))) {             text <- gsub(rawToChar(as.raw(code)), sprintf(\"\\\\u%04x\",                  code), text, fixed = TRUE, useBytes = TRUE)         }         paste0(\"\\\"\", text, \"\\\"\")     }     json_array <- function(items) paste0(\"[\", paste(vapply(items,          json_string, \"\"), collapse = \",\"), \"]\")     report_text <- function() {         value <- \"null\"         if (!is.null(last)) {             deparsed <- paste(deparse(last$value, control = c(\"keepNA\",                  \"keepInteger\", \"niceNames\", \"showAttributes\")),                  collapse = \"\\n\")             value <- sprintf(\"{\\\"kind\\\":%s,\\\"deparsed\\\":%s}\",                  json_string(typeof(last$value)), json_string(deparsed))         }         sprintf(\"{\\\"messages\\\":%s,\\\"warnings\\\":%s,\\\"errors\\\":%s,\\\"value\\\":%s,\\\"libraries\\\":%s,\\\"observed\\\":%s}\\n\",              json_array(messages), json_array(warnings), json_array(errors),              value, json_string(Sys.getenv(\"R_LIBS\")), json_array(observed))     }     expressions <- tryCatch(parse(script, keep.source = FALSE,          encoding = \"UTF-8\"), error = function(condition) {         errors <<- c(errors, paste0(\"parse error: \", conditionMessage(condition)))         NULL     })     for (expression in expressions) {         position <- position + 1L         failed <- FALSE         withCallingHandlers(tryCatch({             result <- withVisible(eval(expression, globalenv()))             last <- list(value = result$value)             if (observing)                  observe_value(result)             if (result$visible) {                 frame <- new.env(parent = globalenv())                 frame$x <- result$value                 eval(as.call(list(print, quote(x))), frame)             }         }, error = function(condition) {             if (observing)                  observe_condition(\"error\", condition)             errors <<- c(errors, describe(condition))             last <<- NULL             failed <<- TRUE         }), warning = function(condition) {             if (observing)                  observe_condition(\"warning\", condition)             warnings <<- c(warnings, describe(condition))             if (isTRUE(getOption(\"warn\") >= 2))                  return(invisible())             invokeRestart(\"muffleWarning\")         }, message = function(condition) {             if (observing)                  observe_condition(\"message\", condition)             messages <<- c(messages, sub(\"\\n$\", \"\", conditionMessage(condition)))             invokeRestart(\"muffleMessage\")         })         if (failed)              break     }     body <- report_text()     passes <- suppressWarnings(as.integer(Sys.getenv(\"ORACLE_PASSES\",          \"1\")))     if (!is.na(passes) && passes > 1L) {         for (pass in 2:passes) {             cat(\"\\001oracle: pass \", pass, \"\\001\\n\", sep = \"\")             for (expression in expressions) {                 failed <- FALSE                 withCallingHandlers(tryCatch({                   result <- withVisible(eval(expression, globalenv()))                   if (result$visible) {                     frame <- new.env(parent = globalenv())                     frame$x <- result$value                     eval(as.call(list(print, quote(x))), frame)                   }                 }, error = function(condition) failed <<- TRUE),                    warning = function(condition) {                     if (isTRUE(getOption(\"warn\") >= 2))                        return(invisible())                     invokeRestart(\"muffleWarning\")                   }, message = function(condition) invokeRestart(\"muffleMessage\"))                 if (failed)                    break             }         }     }     writeLines(body, report, useBytes = TRUE) }, envir = new.env(parent = baseenv()))"
