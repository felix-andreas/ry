ixed = TRUE)         text <- gsub(\"\\r\", \"\\\\r\", text, fixed = TRUE)         text <- gsub(\"\\t\", \"\\\\t\", text, fixed = TRUE)         for (code in setdiff(1:31, c(9L, 10L, 13L))) {             text <- gsub(rawToChar(as.raw(code)), sprintf(\"\\\\u%04x\",                  code), text, fixed = TRUE, useBytes = TRUE)         }         paste0(\"\\\"\", text, \"\\\"\")     }     json_array <- function(items) paste0(\"[\", paste(vapply(items,          json_string, \"\"), collapse = \",\"), \"]\")     report_text <- function() {         value <- \"null\"         if (!is.null(last)) {             deparsed <- paste(deparse(last$value, control = c(\"keepNA\",                  \"keepInteger\", \"niceNames\", \"showAttributes\")),                  collapse = \"\\n\")             value <- sprintf(\"{\\\"kind\\\":%s,\\\"deparsed\\\":%s}\",                  json_string(typeof(last$value)), json_string(deparsed))         }         sprintf(\"{\\\"messages\\\":%s,\\\"warnings\\\":%s,\\\"errors\\\":%s,\\\"value\\\":%s,\\\"libraries\\\":%s,\\\"observed\\\":%s}\\n\",              json_array(messages), json_array(warnings), json_array(errors),              value, json_string(Sys.getenv(\"R_LIBS\")), json_array(observed))     }     expressions <- tryCatch(parse(script, keep.source = FALSE,          encoding = \"UTF-8\"), error = function(condition) {         errors <<- c(errors, paste0(\"parse error: \", conditionMessage(condition)))         NULL     })     for (expression in expressions) {         position <- position + 1L         failed <- FALSE         withCallingHandlers(tryCatch({             result <- withVisible(eval(expression, globalenv()))             last <- list(value = result$value)             if (observing) observe_value(result)             if (result$visible) {                 frame <- new.env(parent = globalenv())                 frame$x <- result$value                 eval(as.call(list(print, quote(x))), frame)             }         }, error = function(condition)