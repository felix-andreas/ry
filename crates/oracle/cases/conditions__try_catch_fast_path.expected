|  [5] "eval(quote({     .oracle_observe_limit <- 96L     .oracle_observe_strict <- identical(Sys.getenv(\"ORACLE_OBSERVE\"),          \"strict\")     .oracle_observe <- function(value) {         lines <- character()         emit <- function(depth, ...) lines[[length(lines) + 1L]] <<- paste0(strrep(\"  \",              depth), ...)         hex <- function(bytes) paste(as.character(bytes), collapse = \"\")         string_token <- function(text) {             if (is.na(text)) return(\"NA\")             mark <- switch(Encoding(text), `UTF-8` = \"U\", latin1 = \"L\",                  bytes = \"B\", \"-\")             bytes <- charToRaw(text)             plain <- all(bytes >= as.raw(32) & bytes < as.raw(127)) &&                  !any(bytes == as.raw(34) | bytes == as.raw(92))             if (plain) return(paste0(mark, \"\\\"\", rawToChar(bytes),                  \"\\\"\"))             if (!.oracle_observe_strict && mark %in% c(\"U\", \"-\") &&                  validUTF8(text)) mark <- \"u\"             paste0(mark, \"<\", hex(bytes), \">\")         }         double_tokens <- function(x) {             tokens <- character(length(x))             missing <- is.na(x)             nan <- is.nan(x)             tokens[missing & !nan] <- \"NA\"             tokens[nan] <- \"NaN\"             rest <- !missing             if (any(rest)) {                 bits <- matrix(as.character(writeBin(as.double(x[rest]),                    raw(), endian = \"big\")), nrow = 8L)                 bits <- vapply(seq_len(ncol(bits)), function(column) paste(bits[,                    column], collapse = \"\"), \"\")                 tokens[rest] <- paste0(sprintf(\"%.17g\", x[rest]),                    \":\", bits)             }             tokens         }         tokens_of <- function(x) {             switch(typeof(x), logical = ifelse(is.na(x), \"NA\",                  ifelse(x, \"T\", \"F\")), integer = ifelse(is.na(x),                  \"NA\", format(x, trim = TRUE, scientific = FALSE)),                  double = double_tokens(x), complex = paste0(\"(\",                    double_tokens(Re(x)), \" \", double_tokens(Im(x)),                    \")\"), character = vapply(x, string_token, \"\",                    USE.NAMES = FALSE), raw = as.character(x))         }         weigh <- function(values) {             values <- as.double(values)             index <- seq_along(values)             paste0(sprintf(\"%.0f\", sum(values * (index%%251 +                  1))), \"/\", sprintf(\"%.0f\", sum(values * (index%%65521 +                  1))))         }         double_summary <- function(x) {             nan <- is.nan(x)             missing <- is.na(x) & !nan             x[nan | missing] <- 0             paste0(\"na=\", weigh(missing), \" nan=\", weigh(nan),                  \" bits=\", weigh(as.integer(writeBin(x, raw(),                    endian = \"big\"))))         }         atomic_line <- function(x) {             x <- as.vector(unclass(x))             count <- length(x)             if (count <= .oracle_observe_limit) return(paste(tokens_of(x),                  collapse = \" \"))             head_count <- .oracle_observe_limit%/%2L             middle <- x[(head_count + 1L):(count - head_count)]             summary <- switch(typeof(x), character = {                 present <- !is.na(middle)                 bytes <- lapply(middle[present], charToRaw)                 marks <- Encoding(middle[present])                 if (!.oracle_observe_strict) {                   wide <- vapply(bytes, function(text) any(text >=                      as.raw(128)), NA)                   marks[wide & marks %in% c(\"UTF-8\", \"unknown\") &                      validUTF8(middle[present])] <- \"u\"                 }                 paste0(\"na=\", weigh(!present), \" lengths=\", weigh(lengths(bytes)),                    \" bytes=\", weigh(as.integer(unlist(bytes))),                    \" marks=\", weigh(match(marks, c(\"unknown\",                      \"u\", \"UTF-8\", \"latin1\", \"byte