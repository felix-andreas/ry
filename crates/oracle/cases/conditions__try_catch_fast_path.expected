 writeLines(body, report, useBytes = TRUE)     }     expressions <- tryCatch(parse(script, keep.source = FALSE,          encoding = \"UTF-8\"), error = function(condition) {         errors <<- c(errors, paste0(\"parse error: \", conditionMessage(condition)))         NULL     })     for (expression in expressions) {         failed <- FALSE         withCallingHandlers(tryCatch({             result <- withVisible(eval(expression, globalenv()))             last <- list(value = result$value)             if (result$visible)                  print(result$value)         }, error = function(condition) {             errors <<- c(errors, describe(condition))             last <<- NULL             failed <<- TRUE         }), warning = function(condition) {             warnings <<- c(warnings, describe(condition))             if (isTRUE(getOption(\"warn\") >= 2))                  return(invisible())             invokeRestart(\"muffleWarning\")         }, message = function(condition) {             messages <<- c(messages, sub(\"\\n$\", \"\", conditionMessage(condition)))             invokeRestart(\"muffleMessage\")         })         if (failed)              break     }     write_report() })"
