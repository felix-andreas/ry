| expression({
|     .value <- x * y
|     .grad <- array(0, c(length(.value), 2L), list(NULL, c("x", 
|         "y")))
|     .hessian <- array(0, c(length(.value), 2L, 2L), list(NULL, 
|         c("x", "y"), c("x", "y")))
|     .grad[, "x"] <- y
|     .hessian[, "x", "y"] <- .hessian[, "y", "x"] <- 1
|     .grad[, "y"] <- x
|     attr(.value, "gradient") <- .grad
|     attr(.value, "hessian") <- .hessian
|     .value
| })
| function (m, s) 
| {
|     .expr1 <- x - m
|     .expr2 <- .expr1^2
|     .expr4 <- 2 * s^2
|     .value <- .expr2/.expr4 + log(s)
|     .grad <- array(0, c(length(.value), 2L), list(NULL, c("m", 
|         "s")))
|     .grad[, "m"] <- -(2 * .expr1/.expr4)
|     .grad[, "s"] <- 1/s - .expr2 * (2 * (2 * s))/.expr4^2
|     attr(.value, "gradient") <- .grad
|     .value
| }
