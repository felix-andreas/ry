[stdout]
| x^2  =>  *{2,x} 
| x^n  =>  *{^{x,P[-{n,1}]},n} 
| n^x  =>  *{^{n,x},log{n}} 
| exp(2*x)  =>  *{exp{*{2,x}},2} 
| log(x)  =>  /{1,x} 
| log(x, 2)  =>  "only single-argument calls to log() are supported;\n  maybe use log(x,a) = log(x)/log(a)" 
| cos(x)  =>  -{sin{x}} 
| sin(x)  =>  cos{x} 
| tan(x)  =>  /{1,^{cos{x},2}} 
| cosh(x)  =>  sinh{x} 
| sinh(x)  =>  cosh{x} 
| tanh(x)  =>  /{1,^{cosh{x},2}} 
| sqrt(x)  =>  *{0.5,^{x,-0.5}} 
| pnorm(x)  =>  dnorm{x} 
| dnorm(x)  =>  -{*{x,dnorm{x}}} 
| asin(x)  =>  /{1,sqrt{-{1,^{x,2}}}} 
| acos(x)  =>  -{/{1,sqrt{-{1,^{x,2}}}}} 
| atan(x)  =>  /{1,P[+{1,^{x,2}}]} 
| gamma(x)  =>  *{gamma{x},digamma{x}} 
| lgamma(x)  =>  digamma{x} 
| digamma(x)  =>  trigamma{x} 
| trigamma(x)  =>  psigamma{x,2L} 
| psigamma(x)  =>  psigamma{x,1L} 
| psigamma(x, 2)  =>  psigamma{x,3L} 
| log1p(x)  =>  /{1,P[+{1,x}]} 
| expm1(x)  =>  exp{x} 
| log2(x)  =>  /{1,P[*{x,log{2}}]} 
| log10(x)  =>  /{1,P[*{x,log{10}}]} 
| cospi(x)  =>  -{*{sinpi{x},pi}} 
| sinpi(x)  =>  *{cospi{x},pi} 
| tanpi(x)  =>  /{pi,^{cospi{x},2}} 
| abs(x)  =>  "Function 'abs' is not in the derivatives table" 
| -x  =>  -{1} 
| x-y  =>  1 
| -x*y  =>  -{y} 
| x/y  =>  /{1,y} 
| y/x  =>  -{/{y,^{x,2}}} 
| (x+1)^3  =>  *{3,^{P[+{x,1}],2}} 
| x*y*x  =>  +{*{y,x},*{x,y}} 
| 1/x  =>  -{/{1,^{x,2}}} 
| 2/x^2  =>  -{/{*{2,P[*{2,x}]},^{P[^{x,2}],2}}} 
| -(x^2)  =>  -{*{2,x}} 
| x^-1  =>  -{^{x,-{+{1,1}}}} 
| exp(-x^2/2)  =>  -{*{exp{/{-{^{x,2}},2}},P[/{*{2,x},2}]}} 
| factorial(x)  =>  *{factorial{x},digamma{+{x,1L}}} 
| lfactorial(x)  =>  digamma{+{x,1L}} 
| +x  =>  1 
| (x)  =>  1 
| a*x+b  =>  a 
| x^y  =>  *{^{x,P[-{y,1}]},y} 
| x^(a+b)  =>  *{^{x,P[-{P[+{a,b}],1}]},P[+{a,b}]} 
| x^(a-b)  =>  *{^{x,P[-{P[-{a,b}],1}]},P[-{a,b}]} 
| x^(a*b)  =>  *{^{x,P[-{P[*{a,b}],1}]},P[*{a,b}]} 
| x^(a/b)  =>  *{^{x,P[-{P[/{a,b}],1}]},P[/{a,b}]} 
| x^(a^b)  =>  *{^{x,P[-{P[^{a,b}],1}]},P[^{a,b}]} 
| x^(-a)  =>  *{^{x,P[-{P[-{a}],1}]},P[-{a}]} 
| (x+y)^z  =>  *{^{P[+{x,y}],P[-{z,1}]},z} 
| (x-y)^z  =>  *{^{P[-{x,y}],P[-{z,1}]},z} 
| (x*y)^z  =>  *{^{P[*{x,y}],P[-{z,1}]},P[*{z,y}]} 
| (x/y)^z  =>  *{^{P[/{x,y}],P[-{z,1}]},P[*{z,P[/{1,y}]}]} 
| (x^y)^z  =>  *{^{P[^{x,y}],P[-{z,1}]},P[*{z,P[*{^{x,P[-{y,1}]},y}]}]} 
| (-x)^z  =>  -{*{^{P[-{x}],P[-{z,1}]},z}} 
| (x+y)^(a+b)  =>  *{^{P[+{x,y}],P[-{P[+{a,b}],1}]},P[+{a,b}]} 
| x^(x*a)  =>  +{*{^{x,P[-{P[*{x,a}],1}]},P[*{x,a}]},*{^{x,P[*{x,a}]},P[*{log{x},a}]}} 
| (x*a)^x  =>  +{*{^{P[*{x,a}],P[-{x,1}]},P[*{x,a}]},*{^{P[*{x,a}],x},log{P[*{x,a}]}}} 
| (x*a)^(x*b)  =>  +{*{^{P[*{x,a}],P[-{P[*{x,b}],1}]},P[*{P[*{x,b}],a}]},*{^{P[*{x,a}],P[*{x,b}]},P[*{log{P[*{x,a}]},b}]}} 
| (x+y)*(x-y)  =>  +{P[-{x,y}],P[+{x,y}]} 
| x*y*z  =>  *{y,z} 
| (x+1)/(x-1)  =>  -{/{1,P[-{x,1}]},/{P[+{x,1}],^{P[-{x,1}],2}}} 
| x/(y*z)  =>  /{1,P[*{y,z}]} 
| -x^2  =>  -{*{2,x}} 
| exp(x)/(1+exp(x))  =>  -{/{exp{x},P[+{1,exp{x}}]},/{*{exp{x},exp{x}},^{P[+{1,exp{x}}],2}}} 
| a/(1+b*exp(-c*x))  =>  /{*{a,P[*{b,P[*{exp{*{-{c},x}},c}]}]},^{P[+{1,*{b,exp{*{-{c},x}}}}],2}} 
| sin(x)*cos(x)/x  =>  -{/{P[-{*{cos{x},cos{x}},*{sin{x},sin{x}}}],x},/{*{sin{x},cos{x}},^{x,2}}} 
| x/0  =>  NA_real_ 
| 0^x  =>  0 
| TRUE*x  =>  1 
| 2L*x  =>  2L 
| x^2L  =>  *{2L,x} 
| psigamma(2*x, k)  =>  *{2,psigamma{*{2,x},+{k,1L}}} 
| sin(x)^2 + cos(x)*exp(x)  =>  +{*{2,P[*{cos{x},sin{x}}]},-{*{cos{x},exp{x}},*{sin{x},exp{x}}}} 
| 2 * x
| [1] 0
| expression({
|     .value <- x^2
|     .grad <- array(0, c(length(.value), 1L), list(NULL, c("x")))
|     .grad[, "x"] <- 2 * x
|     attr(.value, "gradient") <- .grad
|     .value
| })
| function (x, y) 
| {
|     .expr1 <- cos(x)
|     .expr2 <- .expr1 * y
|     .expr4 <- cos(.expr2)
|     .value <- sin(.expr2)
|     .grad <- array(0, c(length(.value), 2L), list(NULL, c("x", 
|         "y")))
|     .grad[, "x"] <- -(.expr4 * (sin(x) * y))
|     .grad[, "y"] <- .expr4 * .expr1
|     attr(.value, "gradient") <- .grad
|     .value
| }
| expression({
|     .expr4 <- exp(-x^2/2)
|     .expr7 <- 2 * x/2
|     .expr8 <- .expr4 * .expr7
|     .value <- .expr4 * a
|     .grad <- array(0, c(length(.value), 2L), list(NULL, c("x", 
|         "a")))
|     .hessian <- array(0, c(length(.value), 2L, 2L), list(NULL, 
|         c("x", "a"), c("x", "a")))
|     .grad[, "x"] <- -(.expr8 * a)
|     .hessian[, "x", "x"] <- -((.expr4 * (2/2) - .expr8 * .expr7) * 
|         a)
|     .hessian[, "x", "a"] <- .hessian[, "a", "x"] <- -.expr8
|     .grad[, "a"] <- .expr4
|     .hessian[, "a", "a"] <- 0
|     attr(.value, "gradient") <- .grad
|     attr(.value, "hessian") <- .hessian
|     .value
| })
| function (a, b, t) 
| {
|     .expr3 <- exp(-b * t)
|     .value <- a * .expr3
|     .grad <- array(0, c(length(.value), 2L), list(NULL, c("a", 
|         "b")))
|     .grad[, "a"] <- .expr3
|     .grad[, "b"] <- -(a * (.expr3 * t))
|     attr(.value, "gradient") <- .grad
|     .value
| }
