# Native code checks at each call that every function and value it was compiled against is still
# what its name finds, so rebinding one after many calls switches to the new one, as in the
# interpreter: a global function, a global value, one rebound by `assign` from inside a function,
# and a function an enclosing function's frame binds after the first calls.

requires ry-runtime

file ry.toml
| [check]
| strict = false

file rebind.R
| h <- function(v: F64) -> F64 v + 1
| g <- function(x: F64) -> F64 h(x)
| for (i in 1:3) print(g(1))
| h <- function(v: F64) -> F64 v + 100
| print(g(1))
| k <- 2.5
| m <- function(x: F64) -> F64 x * k
| for (i in 1:3) print(m(1))
| k <- 5.5
| print(m(1))
| swap <- function() assign("h", function(v: F64) -> F64 v + 7, envir = globalenv())
| swap()
| print(g(1))
| outer <- function() {
|   inner <- function(x: F64) -> F64 late(x)
|   out <- c(inner(1), inner(1), inner(1))
|   late <- function(v: F64) -> F64 v * 1000
|   c(out, inner(1))
| }
| late <- function(v: F64) -> F64 v * 10
| print(outer())

env RY_TYPED_LOG 1
run ry run --runtime ry rebind.R
expect exit 0
expect stdout "[1] 2\n[1] 2\n[1] 2\n[1] 101\n"
expect stdout "[1] 2.5\n[1] 2.5\n[1] 2.5\n[1] 5.5\n[1] 8\n"
expect stdout "[1]   10   10   10 1000"
expect stderr "typed: compiled for [Dbl] -> Dbl"
