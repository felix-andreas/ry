# Typed code that builds a record or a tag only to read its fields runs without allocating the
# box, and a small typed function is compiled into its caller. Neither changes a result: each
# function below is a shape where reading the field's source instead of the box would go wrong
# if done carelessly (a variable reassigned after the record was built, a record carried around
# a loop, a record stored in a list, a record built on two branches), next to the plain shapes
# the optimizations are for.

requires ry-runtime

file ry.toml
| [check]
| typing = true
| strict = true

file records.R
| alias Shape =
|   | :Circle(radius: F64)
|   | :Rect(width: F64, height: F64)
| alias Point = Record{x: F64, y: F64}
|
| later <- function(a: F64) -> F64 {
|   x <- a
|   point <- (x = x, y = 2.0)
|   x <- x + 100.0
|   point$x + x
| }
| carry <- function(n: I64) -> F64 {
|   acc: Record{sum: F64, count: I64} <- (sum = 0.0, count = 0)
|   for (i in List.range(1, n)) acc <- (sum = acc$sum + Num.to_f64(i), count = acc$count + 1)
|   acc$sum / Num.to_f64(acc$count)
| }
| make <- function(a: F64) -> Record{inner: Point, w: F64} (inner = (x = a, y = a + 1.0), w = a * 2.0)
| nested <- function(a: F64) -> F64 {
|   r <- make(a)
|   r$inner$x + r$inner$y + r$w
| }
| escape <- function(a: F64) -> F64 {
|   p <- (x = a, y = a + 1.0)
|   ps <- [p, p]
|   ps[[2]]$x + p$y
| }
| named <- function(name: Str) -> Str {
|   r <- (name = name, tags = [name, "b"])
|   Str.concat(r$name, r$tags[[2]])
| }
| pick <- function(flag: Bool, a: F64) -> F64 {
|   p <- if (flag) (x = a, y = a + 1.0) else (x = a + 2.0, y = a + 3.0)
|   p$x + p$y
| }
| area <- function(s: Shape) -> F64 {
|   match (s) {
|     :Circle(radius = r) => 3.0 * r * r
|     :Rect(width = w, height = h) => w * h
|   }
| }
| areas <- function(r: F64) -> F64 area(:Circle(radius = r)) + area(:Rect(width = r, height = 2.0))
| each <- function(n: I64) -> F64 {
|   total: F64 <- 0.0
|   for (i in List.range(1, n)) {
|     p <- (x = Num.to_f64(i), y = total)
|     total <- total + p$x
|     total <- total + p$y
|   }
|   total
| }
| print(later(1.0))
| print(carry(4))
| print(nested(1.0))
| print(escape(1.0))
| print(named("a"))
| print(pick(TRUE, 1.0))
| print(pick(FALSE, 1.0))
| print(areas(2.0))
| print(each(4))

env RY_TYPED_LOG 1
run ry run --runtime ry records.R
expect exit 0
expect stdout "[1] 102\n[1] 2.5\n[1] 5\n[1] 3\n[1] \"ab\"\n[1] 3\n[1] 7\n[1] 16\n[1] 26\n"
expect stderr lacks "runs in the interpreter"
