# A user profiles a private script to share where the time goes: the summary splits the time by
# activity and counts calls, and it names no function, variable or private package of the script.

requires ry-runtime

file secret.R
| secret_scoring_model <- function(confidential_input, weight = 2) confidential_input * weight + 1
| classify_customer <- function(x) UseMethod("classify_customer")
| classify_customer.default <- function(x) secret_scoring_model(x)
| total <- 0
| for (i in 1:20000) total <- total + classify_customer(i)
| r <- tryCatch(stop("hidden failure text"), error = function(e) 0)
| cat("done\n")

run ry run --profile-summary summary.md secret.R
expect exit 0
expect stdout "done"
expect file summary.md "## Time split"
expect file summary.md "closure calls"
expect file summary.md "S3 dispatches"
expect file summary.md "| `UseMethod` |"
expect file summary.md lacks "secret_scoring_model"
expect file summary.md lacks "classify_customer"
expect file summary.md lacks "confidential_input"
expect file summary.md lacks "hidden failure text"
expect file summary.md "Private package names are hashed with your key for code outside projects."

# A summarized run takes the paths any other run takes, so the element reads of a hot loop stay
# inline: the summary counts `[` calls only for the few the rest of the session makes.
file inline.R
| values <- as.double(1:20000)
| total <- 0
| walk <- function() for (i in 1:20000) total <<- total + values[i]
| walk()
| cat(total, "\n")
run ry run --profile-summary inline.md inline.R
expect exit 0
expect stdout "200010000"
expect file inline.md "closure calls"
file inline-calls.R
| text <- readLines("inline.md")
| counted <- grep("^[|] `\\[` [|] [0-9]+ [|]$", text, value = TRUE)
| calls <- if (length(counted)) as.integer(gsub("[^0-9]", "", counted)) else 0L
| stopifnot(length(calls) == 1L, calls < 1000L)
| cat("element reads stayed inline\n")
run ry run inline-calls.R
expect exit 0
expect stdout "element reads stayed inline"

# A summarized session can fork. The children run on without a sampling thread, their results
# come back, and the parent writes the summary.
file forked.R
| add_one <- function(x) x + 1
| count <- function(seed) { total <- 0; for (i in 1:20000) total <- add_one(total); total }
| sums <- parallel::mclapply(1:4, count, mc.cores = 2)
| cat(sum(unlist(sums)), "\n")
run ry run --profile-summary forked.md forked.R
expect exit 0
expect stdout "80000"
expect file forked.md "## Time split"

# The sampled call stacks hold an S4 method's frame under its generic's, so the time of the code a
# method calls is filed below both.
file method.R
| setClass("Shape", representation(size = "numeric"))
| setGeneric("area", function(shape, ...) standardGeneric("area"))
| spin <- function(n) { total <- 0; for (i in 1:n) total <- total + sqrt(i); total }
| setMethod("area", "Shape", function(shape, ...) spin(shape@size))
| cat(area(new("Shape", size = 3e7)) > 0, "\n")
env RY_PROFILE_STACKS method-stacks.txt
run ry run --profile-summary method.md method.R
unset RY_PROFILE_STACKS
expect exit 0
expect stdout "TRUE"
expect file method-stacks.txt "R_GlobalEnv::area;R_GlobalEnv::area;R_GlobalEnv::spin"

# A run whose hot function is too small to compile says so: the events count compiled bodies and
# refused compile attempts apart, and a table counts the refusals by the reason `RY_JIT_LOG=1`
# prints for each.
file tiny.R
| add_one <- function(x) x + 1
| for (i in 1:20000) add_one(i)
run ry run --profile-summary tiny.md tiny.R
expect exit 0
expect file tiny.md "| JIT compilations | 0 |"
expect file tiny.md "| JIT compile attempts refused | 1 |"
expect file tiny.md "## JIT compile attempts refused, by reason"
expect file tiny.md "| the body does too little natively to repay entering compiled code | 1 |"

# The same summary covers a package load and the code run after it, as a CI job that runs its
# test suite through `ry load -e` would.
file DESCRIPTION
| Package: privatepkg
| Version: 0.1.0
file NAMESPACE
| export(secret_pricing_rule)
file R/pricing.R
| secret_pricing_rule <- function(confidential_amount) confidential_amount * 1.07

run ry load --profile-summary load-summary.md -e "for (i in 1:200000) secret_pricing_rule(i)" -e "cat('loaded\n')"
expect exit 0
expect stdout "loaded"
expect file load-summary.md "## Time split"
expect file load-summary.md "closure calls"
expect file load-summary.md lacks "secret_pricing_rule"
expect file load-summary.md lacks "confidential_amount"
expect file load-summary.md lacks "privatepkg"
expect file load-summary.md "Private package names are hashed with this project's key."

# A private package's label is a hash keyed with a secret that ry keeps for the project in the
# user's cache directory, outside the project. Two summaries of the project agree, so they can be
# compared, but someone who guesses the name cannot confirm the guess by hashing it. A key in
# `RY_PROFILE_KEY` replaces the project's.
run ry load --profile-summary load-again.md -e "for (i in 1:200000) secret_pricing_rule(i)"
expect exit 0
env RY_PROFILE_KEY 000102030405060708090a0b0c0d0e0f
run ry load --profile-summary load-keyed.md -e "for (i in 1:200000) secret_pricing_rule(i)"
expect exit 0
expect file load-keyed.md "Private package names are hashed with the key in RY_PROFILE_KEY."
unset RY_PROFILE_KEY
file labels.R
| label <- function(file) {
|   text <- readLines(file)
|   unique(regmatches(text, regexpr("private-[0-9a-f]{8}", text)))
| }
| project <- label("load-summary.md")
| stopifnot(length(project) == 1L)
| stopifnot(identical(project, label("load-again.md")))
| stopifnot(length(label("load-keyed.md")) == 1L, !identical(project, label("load-keyed.md")))
| cat(sort(list.files(".cache/ry/profile-keys")), sep = "\n")
run ry run labels.R
expect exit 0
expect stdout "outside-projects"

# A directory in the environment gives every session its own summary, child processes included,
# so the workers a test suite starts are profiled too. A relative directory is taken from where
# the session started, so the parent's summary does not follow it into the temporary directory
# the session deletes when it ends.
# The child must be ry's own Rscript: an `R_HOME` naming a GNU R makes `R.home()` that R's.
hide gnu-r
env RY_PROFILE_SUMMARY_DIR profiles
run ry load -e "status <- system2(file.path(R.home('bin'), 'Rscript'), c('-e', shQuote('cat(\"child\\n\")'))); stopifnot(status == 0L); setwd(tempdir())"
expect exit 0
expect stdout "child"

env RY_PROFILE_SUMMARY_DIR $ROOT/unused
file count.R
| summaries <- list.files("profiles", pattern = "^ry-profile-.*[.]md$", full.names = TRUE)
| cat(length(summaries), "summaries\n")
| text <- unlist(lapply(summaries, readLines))
| stopifnot(any(grepl("## Time split", text)), !any(grepl("secret_pricing_rule", text)))
run ry run count.R
expect exit 0
expect stdout "2 summaries"
