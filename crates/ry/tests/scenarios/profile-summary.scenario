# A user profiles a private script to share where the time goes: the summary splits the time by
# activity and counts calls, and it names no function, variable or private package of the script.

requires ry-runtime

file secret.R
| secret_scoring_model <- function(confidential_input, weight = 2) confidential_input * weight + 1
| classify_customer <- function(x) UseMethod("classify_customer")
| classify_customer.default <- function(x) secret_scoring_model(x)
| total <- 0
| for (i in 1:20000) total <- total + classify_customer(i)
| r <- tryCatch(stop("hidden failure text"), error = function(e) 0)
| cat("done\n")

run ry run --profile-summary summary.md secret.R
expect exit 0
expect stdout "done"
expect file summary.md "## Time split"
expect file summary.md "closure calls"
expect file summary.md "S3 dispatches"
expect file summary.md "| `UseMethod` |"
expect file summary.md lacks "secret_scoring_model"
expect file summary.md lacks "classify_customer"
expect file summary.md lacks "confidential_input"
expect file summary.md lacks "hidden failure text"
