# `ry run --aot` compiles a script's typed functions before the script starts. A user who wants
# no pause for compilation in the middle of a run passes the flag and gets the same output, with
# every function ready before the first line runs: `total`, which is called first, and `square`,
# which is defined after its caller. The typed core's log shows that both compiled before the
# script wrote `started`, and that the call after it compiled nothing.

requires ry-runtime

file main.R
| total <- function(n: I64) -> I64 {
|   sum <- 0
|   for (i in List.range(1, n)) sum <- sum + square(i)
|   sum
| }
| square <- function(x: I64) -> I64 x * x
| cat("started\n", file = stderr())
| print(Num.to_f64(total(10)))

run ry run --runtime ry main.R
expect exit 0
expect stdout "[1] 385\n"

env RY_TYPED_LOG 1
run ry run --runtime ry --aot main.R
expect exit 0
expect stdout "[1] 385\n"
expect stderr "typed: compiled 2 functions ahead of time in "
expect stderr " us\nstarted\n"
expect stderr lacks "started\ntyped: compiled"

# A name the script binds to another function later is not what the code was compiled for. The
# function that calls it compiles again when it is next called, and the script means the same.

file rebound.R
| total <- function(n: I64) -> I64 {
|   sum <- 0
|   for (i in List.range(1, n)) sum <- sum + square(i)
|   sum
| }
| square <- function(x: I64) -> I64 x * x
| print(Num.to_f64(total(10)))
| square <- function(x: I64) -> I64 x + 1
| cat("rebound\n", file = stderr())
| print(Num.to_f64(total(10)))

run ry run --runtime ry --aot rebound.R
expect exit 0
expect stdout "[1] 385\n[1] 65\n"
expect stderr "rebound\ntyped: compiled for [I64] -> I64"

# A literal such as `1.5L` warns when its expression is lowered. Lowering the script up front
# must not signal the warning before the statements ahead of it ran: here `options(warn = 2)`
# turns it into the error that stops the script, with `--aot` as without.

file literal.R
| cat("first\n")
| options(warn = 2)
| half <- function(x: F64) -> F64 x / 2
| x <- 1.5L
| cat("second\n")

run ry run --runtime ry --aot literal.R
expect exit 1
expect stdout "first\n"
expect stdout lacks "second"
expect stderr "typed: compiled 1 function ahead of time in "
expect stderr "(converted from warning) integer literal 1.5L contains decimal; using numeric value"

run ry run --runtime ry literal.R
expect exit 1
expect stdout lacks "second"
expect stderr "(converted from warning) integer literal 1.5L contains decimal; using numeric value"

# A table parameter that spells out its columns compiles ahead like a bare `DataFrame`.

file table.R
| rows <- function(sales: DataFrame{price: double[]}, extra: I64) -> I64 {
|   prices <- List.from_r(sales$price)
|   List.len(prices) + extra
| }
| sales <- DataFrame(price = c(1.5, 2.5))
| print(Num.to_f64(rows(sales, 1)))

run ry run --runtime ry --aot table.R
expect exit 0
expect stdout "[1] 3\n"
expect stderr "typed: compiled for [Table, I64] -> I64 in"
expect stderr "typed: compiled 1 function ahead of time in "
expect stderr lacks "runs in the interpreter"

# A statement stays alive while it runs: the collection in its first argument must not free the
# arguments after it.

file collect.R
| half <- function(x: F64) -> F64 x / 2
| churn <- function() {
|   gc()
|   for (k in 1:5000) x <- list(k, "s")
|   1
| }
| z <- list(a = half(churn()), b = "text here", c = c(1.5, 2.5))
| str(z)

run ry run --runtime ry --aot collect.R
expect exit 0
expect stdout " $ b: chr \"text here\""
expect stdout " $ c: num [1:2] 1.5 2.5"

# The flag is for a script, and for ry's runtime.

unset RY_TYPED_LOG
run ry run --runtime ry --aot
expect exit 2
expect stderr "--aot"

run ry run --runtime gnu-r --aot main.R
expect exit 2
expect stderr "`--aot` compiles with ry's runtime, which `--runtime gnu-r` does not start"
