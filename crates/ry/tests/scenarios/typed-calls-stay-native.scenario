# A user's strict typed function runs on native code however it is called: from the top level,
# or again and again from an interpreted wrapper whose arguments are promises over its variables.
# `RY_TYPED_LOG` names every typed function a call of falls back to the interpreter, so a kernel
# that left native code shows up here and not only as lost time.

requires ry-runtime

file ry.toml
| [check]
| typing = true
| strict = true

file calls.R
| dot <- function(x: List<F64>, y: List<F64>) -> F64 {
|   total: F64 <- 0
|   for (i in List.range(1, List.len(x))) total <- total + x[[i]] * y[[i]]
|   total
| }
| clock <- function() -> F64 Num.from_r(proc.time()[[3]])
| x <- [1.0, 2.0, 3.0]
| wrap <- function() {
|   clock()
|   dot(x, x)
| }
| for (k in List.range(1, 4)) print(wrap())

run ry run --runtime ry calls.R
expect exit 0
expect stdout "14"
expect stderr "typed: `wrap` runs in the interpreter"
expect stderr lacks "`dot` runs in the interpreter"
