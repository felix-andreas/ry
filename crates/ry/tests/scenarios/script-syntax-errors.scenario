# A script with a syntax error runs like GNU R's `Rscript`, which reads the script as console
# input: every expression a newline or `;` ends before the error runs first, a lexer error
# counts its line and column from the end of the expression before it, input that ends inside
# a string or an open bracket is an unexpected end of input, and a NUL ends its line, the
# newline included, so the next line joins it.

requires ry-runtime

file same-line.R
| cat("first\n"); cat("second\n") # runs
|   cat("third\n"); x <- 1 2

file empty-statement.R
| cat("first\n");;cat("second\n")

file escape.R
| cat("first\n")
|
| cat("second\n"); "\q"

file open-string.R
| cat("first\n"); x <- "abc
| print(3)

file open-bracket.R
| cat("first\n"); x <- c(1,

file make-nul.R
| writeBin(c(charToRaw("cat('first\\n')\nx <- 1"), as.raw(0), charToRaw("2\ncat('second\\n')\n")), "nul.R")
| writeBin(c(charToRaw("cat('first\\n') # "), as.raw(0), charToRaw(" x\ncat('second\\n')\ncat('third\\n')\n")), "nul-comment.R")

run ry run --runtime ry same-line.R
expect exit 1
expect stdout "first"
expect stdout "second"
expect stdout "third"
expect stderr "Error: unexpected numeric constant in \" x <- 1 2\""
expect stderr "Execution halted"

run ry run --runtime ry empty-statement.R
expect exit 1
expect stdout "first"
expect stdout lacks "second"
expect stderr "Error: unexpected ';' in \";\""

run ry run --runtime ry escape.R
expect exit 1
expect stdout "second"
expect stderr "Error: '\\q' is an unrecognized escape in character string (<input>:1:4)"

run ry run --runtime ry open-string.R
expect exit 1
expect stdout "first"
expect stdout lacks "[1] 3"
expect stderr "Error: unexpected end of input"

run ry run --runtime ry open-bracket.R
expect exit 1
expect stdout "first"
expect stderr "Error: unexpected end of input"

run ry run --runtime ry make-nul.R
expect exit 0

run ry run --runtime ry nul.R
expect exit 1
expect stdout "first"
expect stdout lacks "second"
expect stderr "Error: unexpected symbol in \"x <- 1cat\""

run ry run --runtime ry nul-comment.R
expect exit 0
expect stdout "first"
expect stdout lacks "second"
expect stdout "third"
