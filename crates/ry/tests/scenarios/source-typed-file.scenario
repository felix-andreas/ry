# A script that `source()`s a typed file runs that file as the checker elaborated it, the same as
# `ry run` on the file itself: an unsuffixed literal the checker typed `I64` is an `I64`, a record
# literal holds ry numbers, an empty `List.map` result keeps its item type, an aliased signature
# checks its arguments, and the file's annotation warnings print. `sys.source()` with its default
# `keep.source = FALSE` parses without a source reference, so it runs the text as written.

requires ry-runtime

file ry.toml
| [check]
file helpers.R
| #: @alias Scaler {fn(values: double, by: double) -> double}
|
| double_it <- function(n: I64) -> I64 n * 2
| print(double_it(21))
| point <- (x = 1, y = 2)
| print(point)
| print(List.sum(List.map(List.range(3, 1), \(v) v * 2)))
|
| #: Scaler
| scale <- function(values, by) values * by
| print(tryCatch(scale("a", 3), error = function(e) conditionMessage(e)))
file ks.R
| k <- (a = 1, b = 2); g <- function(x: I64) -> I64 x + 2
file plain.R
| print(1 + 1)
file warn.R
| #: @param n {double}
| f <- function(n: I64) -> I64 n
file main.R
| source("helpers.R")
| options(keep.source = TRUE)
| source("helpers.R", local = new.env())
| source("ks.R")
| print(g)
| source("plain.R")
| source("warn.R")
| sys.source("helpers.R", envir = new.env())

run ry run main.R
expect exit 0
expect stdout "42i64\n(x = 1i64, y = 2i64)\n0i64\n[1] \"argument `values` must be `double`, not `character`\"\n42i64\n(x = 1i64, y = 2i64)\n0i64\n[1] \"argument `values` must be `double`, not `character`\"\nfunction(x: I64) -> I64 x + 2i64\n[1] 2\n42i64\n(x = 1, y = 2)\n[1] 0\n[1] \"non-numeric argument to binary operator\""
expect stderr "the inline annotation gives parameter `n` the type `I64`, but the `#:` comment gives it `double`"

# A file sourced again with the same text prints its warnings only the first time, because a
# script that sources a helper in a loop would repeat them.

file again.R
| source("warn.R")
| message("again")
| source("./warn.R")
| print(f(2))

run ry run again.R
expect exit 0
expect stdout "2i64"
expect stderr "the inline annotation gives parameter `n` the type `I64`"
expect stderr "again\n"
expect stderr lacks "again\nannotation-mismatch"

# A plain R file is not checked, so a broken `ry.toml` beside it says nothing, while a typed file
# beside it runs as written after one report of the broken configuration.

file sub/ry.toml
| [check
file sub/plain.R
| print(1 + 1)
file sub/warn.R
| #: @param n {double}
| f <- function(n: I64) -> I64 n
file broken.R
| source("sub/plain.R")
| message("plain")
| source("sub/warn.R")
| source("sub/warn.R")
| print(f(2))
run ry run --runtime ry broken.R
expect exit 0
expect stdout "[1] 2\n2i64\n"
expect stderr "plain\nconfig\n"
expect stderr "invalid config"
expect stderr lacks "^\nconfig"

# A strict project's mode belongs to the script: a plain R file it sources keeps R's types.
file ry.toml
| [check]
| strict = true
file lit.R
| y <- 1
| print(class(y))
| print(y / 3)
file strict.R
| source("lit.R")
run ry run strict.R
expect exit 0
expect stdout "[1] \"numeric\"\n[1] 0.3333333"

# A strict script may call what a file it `source()`s by a literal path defines, as `ry check`
# lets it, also through a file that file sources. R resolves the path against the working
# directory. The checker reads the sourced signature, so a wrong argument is refused before
# anything runs.
file lib/util.R
| triple <- function(x: I64) -> I64 x * 3i64
file lib/api.R
| source("lib/util.R")
| six_of <- function(x: I64) -> I64 triple(x) * 2i64
file calls.R
| source("lib/api.R")
| print(six_of(7i64))
run ry run calls.R
expect exit 0
expect stdout "42i64"

file wrong.R
| source("lib/api.R")
| cat("started\n")
| print(six_of(2.5))
run ry run wrong.R
expect exit 1
expect stderr "does not fit `I64`"
expect stdout lacks "started"

# A console command sees what an earlier command's `source()` defined.
file console.txt
| source("lib/api.R")
| print(six_of(1i64))
stdin console.txt
run ry run --runtime ry
expect exit 0
expect stdout "6i64"

# A console command binds what the file read as when it ran: editing the file and sourcing it
# again in a command strict mode refuses leaves the earlier `six` the one that runs. Plain input
# before the first typed command sources too, and a file sourced into another environment
# defines nothing a later command sees.
file lib/six.R
| six <- function(x: I64) -> I64 x * 6i64
file edit.txt
| source("lib/six.R")
| writeLines("six <- function(x: Str) -> Str x", "lib/six.R")
| { source("lib/six.R"); y: Str <- 1i64 }
| print(six(1i64))
stdin edit.txt
run ry run --runtime ry
expect exit 0
expect stdout "6i64"

file lib/six.R
| six <- function(x: I64) -> I64 x * 6i64
file local.R
| source("lib/six.R", local = new.env())
| print(six(1i64))
run ry run local.R
expect exit 1
expect stderr "six"

# An earlier command's own values keep the types the file it sourced gave them, even after a
# later command's check reads the edited file.
file lib/six.R
| six <- function(x: I64) -> I64 x * 6i64
file reload.txt
| source("lib/six.R"); x <- six(1i64)
| writeLines("six <- function(x: I64) -> Str \"s\"", "lib/six.R")
| reload <- function() source("lib/six.R")
| z: Str <- x
stdin reload.txt
run ry run --runtime ry
expect stderr "expected `Str`, found `I64`"

# The last file to run defines a name, though an earlier file sources the other definition.
file order/a1.R
| f <- function(x: I64) -> I64 x
file order/a.R
| source("order/a1.R")
file order/b.R
| f <- function(x: I64) -> Str "s"
file order.R
| source("order/a.R")
| source("order/b.R")
| y: I64 <- f(1i64)
run ry run order.R
expect exit 1
expect stderr "expected `I64`, found `Str`"
