# Typed code calls an R function on native code when it uses the call as a statement or converts
# its value with `Num.from_r`, `Str.from_r`, `Bool.from_r` or `List.from_r`. The checker knows
# that `stats::rnorm` gives doubles, so `List.from_r` needs no interpreted call to learn its item
# type, and the function a lazy-loaded namespace binds is read from the package database when the
# code compiles. Every call runs natively, the first included, with R's random number generator
# giving what it gives the interpreter.

requires ry-runtime

file ry.toml
| [check]
| typing = true
| strict = true

file paths.R
| walk <- function(n: I64, seed: I64) -> F64 {
|   set.seed(Num.to_r(seed))
|   shocks <- List.from_r(stats::rnorm(Num.to_r(n)))
|   label <- Str.from_r(format(Num.to_r(n)))
|   cat("sum of", label, "\n")
|   List.sum(shocks)
| }
| print(walk(5, 1))
| print(walk(5, 1))
| print(walk(5, 2))

env RY_TYPED_LOG 1
run ry run --runtime ry paths.R
expect exit 0
expect stdout "sum of 5 \n[1] 0.6463495"
expect stdout "sum of 5 \n[1] 0.6463495"
expect stdout "sum of 5 \n[1] -0.3348475"
expect stderr "typed: compiled for [I64, I64] -> Dbl"
expect stderr lacks "runs in the interpreter"

# A conversion whose type the checker does not know waits for the interpreter to run the call
# once: `Num.from_r` of a call into R code that declares no result type.

file scale.R
| factor <- function() 2.5
| scale <- function(x: F64) -> F64 {
|   x * Num.from_r(factor())
| }
| print(scale(2))
| print(scale(4))

run ry run --runtime ry scale.R
expect exit 0
expect stdout "[1] 5\n[1] 10"
expect stderr "typed: `scale` runs in the interpreter: no code for [Dbl]: it waits on the interpreter to run `"
expect stderr "typed: compiled for [Dbl] -> Dbl"

# The checker reads `prices` and types the conversion as a `List<F64>`. R code can still rebind
# the function before the call, which no check sees, so the conversion compares what R gave with
# the checker's type and stops. The interpreter and compiled code stop with the same error.

file rebound.R
| prices <- function() c(1.5, 2.5)
| count <- function(extra: F64) -> F64 {
|   listed <- List.from_r(prices())
|   Num.to_f64(List.len(listed)) + extra
| }
| assign("prices", function() 1:2)
| print(count(3))

run ry run --runtime ry rebound.R
expect exit 1
expect stderr "`List.from_r(prices())` gave a `List<I64>`, and the type checker typed it as a `List<F64>` from the R code it read"

env RY_JIT off
run ry run --runtime ry rebound.R
expect exit 1
expect stderr "`List.from_r(prices())` gave a `List<I64>`, and the type checker typed it as a `List<F64>` from the R code it read"
