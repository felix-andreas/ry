# Closures keep their locals in register slots and build an environment only when something asks
# for one. Each line below either reads the frame without an environment (missing, substitute,
# the dots accessors, a forced promise) or forces one (environment, sys.frame, parent.frame,
# match.arg, eval in the caller, a capturing closure, S3 and S4 dispatch), and the environment a
# frame hands out is the same object every time it is asked.

requires ry-runtime

file frames.R
| f <- function(x, y = 2) { z <- x + y; z * 2 }
| print(f(1))
| g <- function(a) { e <- environment(); identical(e, environment()) && identical(e, sys.frame(sys.nframe())) }
| print(g(1))
| nm <- function(a) environmentName(environment())
| print(nm(1))
| h <- function(a, b) c(missing(a), missing(b))
| print(h(1))
| fw <- function(a) h(a, a)
| print(fw())
| k <- function(val) deparse(substitute(val))
| print(k(foo + bar))
| s <- function(x) substitute(x)
| print(s(a * b))
| d <- function(...) c(...length(), ..1, ...elt(2))
| dc <- function(x) d(x, 7)
| print(dc(3))
| p <- function() parent.frame()
| q <- function() { e <- p(); identical(e, environment()) && identical(e, p()) }
| print(q())
| ma <- function(type = c("one", "two")) match.arg(type)
| print(c(ma(), ma("two")))
| ev <- function(x) { y <- 10; w <- function() eval(quote(y), parent.frame()); w() }
| print(ev(1))
| lazy <- function(v) { y <- 5; v }
| lc <- function() { y <- 1; lazy(y + 1) }
| print(lc())
| mk <- function(n) function() n
| print(mk(3)())
| gen <- function(x, ...) UseMethod("gen")
| gen.default <- function(x, ...) "default"
| gen.foo <- function(x, ...) c("foo", NextMethod())
| caller <- function(v) gen(v)
| print(caller(structure(1, class = "foo")))
| setGeneric("area", function(shape) standardGeneric("area"))
| setClass("Square", representation(side = "numeric"))
| setMethod("area", "Square", function(shape) shape@side^2)
| s4 <- function(side) area(new("Square", side = side))
| print(s4(3))
| loop <- function(n) { s <- 0; for (i in seq_len(n)) s <- s + i; s }
| print(loop(100))
| st <- function() stop("boom")
| print(tryCatch(st(), error = function(e) conditionMessage(e)))
| # A closure called while a promise runs on a slot frame's slots, from a call site that has
| # made its direct-call plan (the third call), sees that slot frame as its parent.
| pick <- function(type = c("gzip", "xz", "none")) match(match.arg(type), c("none", "gzip", "xz"))
| for (t in c("gzip", "xz", "none", "xz")) cat(pick(t), "")
| cat("\n")

run ry run --runtime ry frames.R
expect exit 0
expect stdout "[1] 6"
expect stdout "[1] TRUE"
expect stdout "[1] \"\""
expect stdout "[1] FALSE  TRUE"
expect stdout "[1] TRUE TRUE"
expect stdout "[1] \"foo + bar\""
expect stdout "a * b"
expect stdout "[1] 2 3 7"
expect stdout "[1] TRUE"
expect stdout "[1] \"one\" \"two\""
expect stdout "[1] 10"
expect stdout "[1] 2"
expect stdout "[1] 3"
expect stdout "[1] \"foo\"     \"default\""
expect stdout "[1] \"area\""
expect stdout "[1] 9"
expect stdout "[1] 5050"
expect stdout "[1] \"boom\""
expect stdout "2 3 1 3"
