# A package author moves a file to strict mode: `ry check --annotate` writes the types inference
# already knows, inline by default, and what is left is the code a person has to type.

file ry.toml
| [check]
| strict = true
file DESCRIPTION
| Package: shapes
| Version: 0.1.0
file R/area.R
| area <- function(width, height = 1) width * height
| unit <- 1L
| label <- function(shape) shape$name

run ry check
expect exit 1
expect stderr "parameter `shape` has no type"

run ry check --annotate
expect exit 1
expect stdout "added 2 inferred annotations"
expect file R/area.R "area <- function<T: num>(width: T, height: T = 1) -> T width * height"
expect file R/area.R "unit: I64 <- 1L"
expect stderr "parameter `shape` has no type"

# Annotating again finds nothing new to write.
run ry check --annotate
expect exit 1
expect stdout "2 problems in 1 file"

# With inline annotations off, the same types go into `#:` comments.
file ry.toml
| [check]
| strict = true
| inline-annotations = false
file R/area.R
| area <- function(width, height = 1) width * height

run ry check --annotate
expect exit 0
expect stdout "added 1 inferred annotation"
expect file R/area.R "#: <T: num> fn(width: T, [height]: T) -> T"

# A function passed as an argument gets the signature the call fixes for it, in a `#:` line above
# the argument when it starts its own line.
file R/scale.R
| #: fn(values: double[]) -> double[]
| scaled <- function(values) vapply(
|   values,
|   FUN = function(v) v * 2,
|   numeric(1)
| )

run ry check --annotate R/scale.R
expect exit 0
expect stdout "added 1 inferred annotation"
expect file R/scale.R "  #: fn(v: double) -> double"

# Inline, the signature goes into the lambda's header.
file ry.toml
| [check]
| strict = true
file R/scale.R
| scaled <- function(values: double[]) vapply(values, function(v) v * 2, numeric(1))

run ry check --annotate R/scale.R
expect exit 0
expect stdout "added 1 inferred annotation"
expect file R/scale.R "vapply(values, function(v: double) -> double v * 2, numeric(1))"
