# A record field or a list item can itself be a list, and typed code builds and updates such
# values natively. Updating a field copies the list only while another record still holds it,
# so `original` keeps its empty list while `column` grows. `grow` is small, so it is compiled
# into `total` and no code for it alone appears in the log.

requires ry-runtime

file fields.R
| alias Column = Record{name: Str, values: List<I64>}
| grow <- function(column: Column, value: I64) -> Column
|   (..column, values = List.append(column$values, value))
| total <- function(n: I64) -> I64 {
|   column: Column <- (name = "a", values = [])
|   original <- column
|   for (i in List.range(1, n)) column <- grow(column, i)
|   List.sum(column$values) + List.sum(original$values) + List.len(original$values)
| }
| nested <- function(n: I64) -> List<List<I64>> {
|   rows <- [[n], [n, n]]
|   List.append(rows, List.repeat(0i64, 2))
| }
| shown <- function(n: I64) -> Column (name = "b", values = [n, n + 1])
| print(total(100))
| print(nested(7))
| print(shown(1))

env RY_TYPED_LOG 1
run ry run --runtime ry fields.R
expect exit 0
expect stdout "5050i64\n[[7i64], [7i64, 7i64], [0i64, 0i64]]\n(name = \"b\", values = [1i64, 2i64])\n"
expect stderr "typed: compiled for [I64] -> I64"
expect stderr lacks "runs in the interpreter"
expect stderr "typed: compiled for [I64] -> Vector { item: Array(0), array: true }"
