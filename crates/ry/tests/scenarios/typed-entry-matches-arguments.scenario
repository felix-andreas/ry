# R code calls typed functions with named, partly named and out-of-order arguments and leaves out
# parameters whose defaults compute from other parameters, before or after the parameters it
# passes. The native entry matches the arguments as R does and the compiled code computes the
# defaults, so these calls run natively and print what the interpreter prints. Three calls run in
# the interpreter: one R rejects, one whose R call changes a variable a default reads before the
# body reads the parameter, which the interpreter runs again, and one whose default calls a
# function the body redefines.

requires ry-runtime

file ry.toml
| [check]
| typing = true

file calls.R
| scale <- function(a: F64, n: F64 = a * 2.0) -> F64 a * n
| print(scale(n = 1.5, a = 2.0))
| print(scale(3.0))
| pre <- function(alpha: F64, beta: F64 = 1.0) -> F64 alpha - beta
| print(pre(be = 10.0, al = 3.0))
| mid <- function(a: F64, k: F64 = 5.0, b: F64 = a + k) -> F64 a + k + b
| print(mid(b = 7.0, a = 1.0))
| print(mid(1.0))
| late <- function(a: F64, k: F64 = a + 1.0, b: F64 = 3.0) -> F64 a + k + b
| print(late(1.0, b = 10.0))
| gap <- function(a: F64, k: F64 = b * 2.0, j: F64 = 7.0, m: F64 = k + j, b: F64 = 2.0, n: I64 = 1i64) -> F64 a + k + j + m + b + Num.to_f64(n)
| print(gap(1.0, b = 10.0, n = 3))
| twice <- function(value: F64, verbose: F64 = 0.0) -> F64 value + verbose
| print(tryCatch(twice(v = 1.0), error = function(e) conditionMessage(e)))
| y <- 1.0
| rebind <- function() y <<- 100.0
| watched <- function(a: F64, n: F64 = a + 1.0) -> F64 { rebind(); n }
| keep <- function() watched(a = y)
| print(keep())
| shadowed <- function(a: F64, n: F64 = Num.abs(a)) -> F64 { Num.abs <- function(x: F64) -> F64 x * 10.0; n }
| print(shadowed(-1.0))

env RY_TYPED_LOG 1
run ry run --runtime ry calls.R
expect exit 0
expect stdout "[1] 3\n[1] 18\n[1] -7\n[1] 13\n[1] 12\n[1] 13\n[1] 68\n[1] \"argument 1 matches multiple formal arguments\"\n[1] 101\n[1] -10"
expect stderr lacks "`scale` runs in the interpreter"
expect stderr lacks "`pre` runs in the interpreter"
expect stderr "`watched` runs in the interpreter: an R call it made changed a variable"
expect stderr lacks "`mid` runs in the interpreter"
expect stderr lacks "`late` runs in the interpreter"
expect stderr "typed: compiled for [Dbl, Absent, Dbl] -> Dbl"
expect stderr lacks "`gap` runs in the interpreter"
expect stderr "`twice` runs in the interpreter"
expect stderr "`shadowed` runs in the interpreter: no code for [Dbl]: the default of `n`"

env RY_JIT off
run ry run --runtime ry calls.R
expect exit 0
expect stdout "[1] 3\n[1] 18\n[1] -7\n[1] 13\n[1] 12\n[1] 13\n[1] 68\n[1] \"argument 1 matches multiple formal arguments\"\n[1] 101\n[1] -10"
