# R code calls typed functions with named, partly named and out-of-order arguments and leaves out
# parameters whose defaults compute from other parameters. The native entry matches the arguments
# as R does and the compiled code computes the defaults, so these calls run natively and print what
# the interpreter prints. Three calls run in the interpreter: one that leaves out a computed default
# before a parameter it passes, one R rejects, and one whose R call changes a variable a default
# reads before the body reads the parameter, which the interpreter runs again.

requires ry-runtime

file ry.toml
| [check]
| typing = true

file calls.R
| scale <- function(a: F64, n: F64 = a * 2.0) -> F64 a * n
| print(scale(n = 1.5, a = 2.0))
| print(scale(3.0))
| pre <- function(alpha: F64, beta: F64 = 1.0) -> F64 alpha - beta
| print(pre(be = 10.0, al = 3.0))
| mid <- function(a: F64, k: F64 = 5.0, b: F64 = a + k) -> F64 a + k + b
| print(mid(b = 7.0, a = 1.0))
| print(mid(1.0))
| late <- function(a: F64, k: F64 = a + 1.0, b: F64 = 3.0) -> F64 a + k + b
| print(late(1.0, b = 10.0))
| twice <- function(value: F64, verbose: F64 = 0.0) -> F64 value + verbose
| print(tryCatch(twice(v = 1.0), error = function(e) conditionMessage(e)))
| y <- 1.0
| rebind <- function() y <<- 100.0
| watched <- function(a: F64, n: F64 = a + 1.0) -> F64 { rebind(); n }
| keep <- function() watched(a = y)
| print(keep())

env RY_TYPED_LOG 1
run ry run --runtime ry calls.R
expect exit 0
expect stdout "[1] 3\n[1] 18\n[1] -7\n[1] 13\n[1] 12\n[1] 13\n[1] \"argument 1 matches multiple formal arguments\"\n[1] 101"
expect stderr lacks "`scale` runs in the interpreter"
expect stderr lacks "`pre` runs in the interpreter"
expect stderr "`watched` runs in the interpreter: an R call it made changed a variable"
expect stderr lacks "`mid` runs in the interpreter"
expect stderr "`late` runs in the interpreter: the call leaves out `k`"
expect stderr "`twice` runs in the interpreter"

env RY_JIT off
run ry run --runtime ry calls.R
expect exit 0
expect stdout "[1] 3\n[1] 18\n[1] -7\n[1] 13\n[1] 12\n[1] 13\n[1] \"argument 1 matches multiple formal arguments\"\n[1] 101"
