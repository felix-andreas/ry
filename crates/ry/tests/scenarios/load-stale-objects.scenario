# A package author upgrades ry over a source tree that an older ry compiled in place. make would
# keep the objects, whose inline accessors come from the old headers, so ry deletes the objects
# and shared libraries that headers other than its own compiled, and both `ry load` and
# `ry install` rebuild them. The planted files stand in for those objects: written after the
# sources, they look up to date to make, and they are not valid object code.

requires ry-runtime

file pkg/DESCRIPTION
| Package: tally
| Version: 1.0.0
| Title: Sums numbers in C
| Description: A small package with compiled code.
| License: MIT
file pkg/NAMESPACE
| useDynLib(tally, .registration = TRUE)
| export(tally)
file pkg/R/tally.R
| tally <- function(values) .Call(tally_sum, as.double(values))
file pkg/src/tally.c
| #include <R.h>
| #include <Rinternals.h>
| #include <R_ext/Rdynload.h>
|
| SEXP tally_sum(SEXP values)
| {
|     double total = 0;
|     const double *data = REAL(values);
|     for (R_xlen_t i = 0; i < XLENGTH(values); i++)
|         total += data[i];
|     return ScalarReal(total);
| }
|
| static const R_CallMethodDef calls[] = {
|     {"tally_sum", (DL_FUNC) &tally_sum, 1},
|     {NULL, NULL, 0}
| };
|
| void R_init_tally(DllInfo *info)
| {
|     R_registerRoutines(info, NULL, calls, NULL, NULL);
|     R_useDynamicSymbols(info, FALSE);
| }

file pkg/src/tally.o
| compiled by ry 0.4.5
file pkg/src/tally.so
| compiled by ry 0.4.5

run ry load pkg -e "print(tally(c(1, 2, 3.5)))"
expect exit 0
expect stdout "[1] 6.5"
expect file pkg/src/.ry-abi "1"

file pkg/src/tally.o
| compiled by ry 0.4.5
file pkg/src/tally.so
| compiled by ry 0.4.5
remove pkg/src/.ry-abi

run ry install pkg -l library
expect exit 0
expect file library/tally/DESCRIPTION "RyAbi: 1"

file use.R
| library(tally, lib.loc = "library")
| print(tally(c(1, 2, 3.5)))

run ry run --runtime ry use.R
expect exit 0
expect stdout "[1] 6.5"
