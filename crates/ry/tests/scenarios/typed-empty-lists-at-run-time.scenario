# A user maps over a list that turns out empty: the result keeps the item type the checker gave
# it, so `List.sum` of it is that type's zero and a typed binding holds what it declares.

requires ry-runtime

file empty.R
| v0: List<I64> <- List.map(List.range(6i64, 3), \(v) v * 0L)
| v1: List<I64> <- List.map(List.range(8L, 5), \(v) v * 6)
| print(c(typeof(v0), typeof(v1), typeof(List.sum(v1))))
| empty: List<F64> <- []
| halves <- List.range(7L, 6) |> List.map(\(v) 0.5f64)
| nested <- List.map(List.map(List.range(3L, 1), \(v) v + 1), \(v) v * 2)
| print(c(typeof(empty), typeof(halves), typeof(List.sum(halves)), typeof(nested)))
| points <- List.map(List.range(3L, 1), \(v) :Point(v))
| print(typeof(points))
| print(List.map([1, 2], \(v) v * 2))
| xs <- List.range(1L, 3L)
| none <- List.keep_if(xs, \(v) v > 5L)
| print(c("kept", typeof(none), typeof(List.sublist(xs, 1, 0)), typeof(List.drop_first(xs, 3))))
| print(none == [])

run ry run --runtime ry empty.R
expect exit 0
expect stdout "[1] \"I64\" \"I64\" \"I64\""
expect stdout "[1] \"double\" \"double\" \"double\" \"I64\""
expect stdout "[1] \"list\""
expect stdout "[2i64, 4i64]"
expect stdout "[1] \"kept\" \"I64\"  \"I64\"  \"I64\" "
expect stdout "[]"

# A typed function that maps an empty list runs on native code: the checker gives the result's
# item type, so both tiers build the same empty list and no call falls back to the interpreter.
file mapped.R
| doubled <- function(xs: List<I64>) -> List<I64> List.map(xs, \(x) x * 2i64)
| halves <- function(xs: List<I64>) -> List<F64> List.map_with_index(xs, \(x, i) Num.to_f64(x) / 2.0)
| words <- function(xs: List<I64>) -> List<Str> List.map2(xs, xs, \(a, b) Str.concat("a", "b"))
| points <- function(xs: List<I64>) -> List<Record{x: I64}> List.map3(xs, xs, xs, \(a, b, c) (x = a,))
| pieces <- function(xs: List<I64>) -> List<F64> List.join_map(xs, \(x) [Num.to_f64(x)])
| xs <- List.from_r(integer(0))
| print(c(typeof(doubled(xs)), typeof(halves(xs)), typeof(words(xs)), typeof(points(xs)), typeof(pieces(xs))))

run ry run --runtime ry mapped.R
env RY_TYPED_LOG 1
expect exit 0
expect stdout "[1] \"I64\"       \"double\"    \"character\" \"list\"      \"double\"   "
expect stderr lacks "runs in the interpreter"
