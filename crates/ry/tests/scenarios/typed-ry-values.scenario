# Typed code works on ry's own values natively. A nominal record updates with `..` and stays its
# nominal type, and `==` compares records, tuples, tags and lists of them structurally, so loops
# over them compile as native functions, with `--aot` as without, and the interpreter gives the
# same answers.

requires ry-runtime

file update.R
| # typing: strict
| type Point = Record{x: F64, y: F64}
| moved <- function(point: Point) -> Point {
|   (..point, y = point$y + 1)
| }
| walk <- function(n: I64) -> F64 {
|   point <- @Point(x = 1, y = 2)
|   for (i in List.range(1, n)) point <- moved(point)
|   point$x + point$y
| }
| print(walk(10))
| print(moved(@Point(x = 1, y = 2)))

run ry check update.R
expect exit 0

env RY_TYPED_LOG 1
run ry run --runtime ry update.R
expect exit 0
expect stdout "[1] 13\n(x = 1, y = 3)\n"
expect stderr "typed: compiled for [I64] -> Dbl"

run ry run --runtime ry --aot update.R
expect exit 0
expect stdout "[1] 13\n(x = 1, y = 3)\n"
expect stderr "typed: compiled 1 function ahead of time in "

unset RY_TYPED_LOG
env RY_JIT off
run ry run --runtime ry update.R
expect exit 0
expect stdout "[1] 13\n(x = 1, y = 3)\n"

file equal.R
| # typing: strict
| type Point = Record{x: F64, y: F64}
| isBond <- function(kind: :Bond | :Cash) -> Bool {
|   kind == :Bond
| }
| count <- function(n: I64) -> I64 {
|   total <- 0i64
|   for (i in List.range(1, n)) {
|     kind <- if (i %% 2i64 == 0i64) :Bond else :Cash
|     if (isBond(kind)) total <- total + 1i64
|     if (@Point(x = 1, y = 2) == @Point(x = 1, y = 2)) total <- total + 10i64
|     if ((1i64, "a") != (1i64, "b")) total <- total + 100i64
|   }
|   total
| }
| points <- function(n: I64) -> List<Bool> {
|   p <- @Point(x = 1, y = 2)
|   q <- @Point(x = Num.to_f64(n), y = 2)
|   [p, q, p] == [p, p, q]
| }
| print(count(4))
| print(points(3))
| print(Str.from_r("a") == "a")

run ry check equal.R
expect exit 0

unset RY_JIT
env RY_TYPED_LOG 1
run ry run --runtime ry equal.R
expect exit 0
expect stdout "442i64\n[TRUE, FALSE, FALSE]\n[1] TRUE\n"
expect stderr "typed: compiled for [I64] -> I64"
expect stderr lacks "runs in the interpreter"

run ry run --runtime ry --aot equal.R
expect exit 0
expect stdout "442i64\n[TRUE, FALSE, FALSE]\n[1] TRUE\n"
expect stderr "typed: compiled 3 functions ahead of time in "
expect stderr lacks "runs in the interpreter"

unset RY_TYPED_LOG
env RY_JIT off
run ry run --runtime ry equal.R
expect exit 0
expect stdout "442i64\n[TRUE, FALSE, FALSE]\n[1] TRUE\n"
