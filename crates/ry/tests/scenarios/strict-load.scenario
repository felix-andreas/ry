# A package author in strict mode loads the package, fixes what strict mode refuses, and loads
# again. A clean verdict is remembered, so the next load skips the check, but an edit that
# breaks strict mode is still refused.

requires ry-runtime

file ry.toml
| [check]
| strict = true
file DESCRIPTION
| Package: shapes
| Version: 0.1.0
file R/area.R
| area <- function(width, height) width$value * height

run ry load -e "print(area(2, 3))"
expect exit 1
expect stderr "parameter `width` has no type"
expect stderr "so this code does not run"

file R/area.R
| #: fn(width: double, height: double) -> double
| area <- function(width, height) width * height

run ry load -e "print(area(2, 3))"
expect exit 0
expect stdout "[1] 6"

run ry load -e "print(area(2, 3))"
expect exit 0
expect stdout "[1] 6"

file R/value.R
| value <- function(x) x$value

run ry load -e "print(area(2, 3))"
expect exit 1
expect stderr "strict mode found 2 errors, so this code does not run"

# The check runs while the runtime starts, but nothing with an effect runs before its verdict, so
# a refused package never runs a top-level call, `.onLoad`, or the user's code.
file R/value.R
| #: fn(x: list) -> double
| value <- function(x) x$value
| cat("top-level call ran\n")
file R/zzz.R
| #: fn(libname: character, pkgname: character) -> NULL
| .onLoad <- function(libname, pkgname) {
|   cat("onLoad ran\n")
| }

run ry load -e "cat('user code ran\n')"
expect exit 1
expect stderr "so this code does not run"
expect stdout lacks "ran"
