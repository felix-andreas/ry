# A package author runs the suite on several cores with `ry test --jobs`. Each test file runs in a
# worker process forked from `ry test` after it loaded the package, so the run needs no callr
# session and not the package's uninstalled import, and the project's `ry.toml` holds in the
# workers. Each worker runs the setup files, and their teardown once every file has run, so a
# worker that finishes early does not tear down what a slower one still uses. What a file prints
# reaches the report, and what the setup prints does not. A process that may have started a thread
# pool, which a fork cannot carry, runs callr workers instead.

requires ry-runtime r-package:testthat>=3.3.0 r-package:callr

file DESCRIPTION
| Package: shapes
| Version: 0.1.0
| Imports: notinstalledanywhere
| Config/testthat/edition: 3
| Config/testthat/parallel: true
file NAMESPACE
| export(area)
file ry.toml
| [check]
| object-systems = false
file R/area.R
| area <- function(width, height) width * height
file tests/testthat/helper-worker.R
| worker_facts <- function() {
|   classes <- tryCatch({
|     methods::setClass("Shape", representation(side = "numeric"))
|     "allowed"
|   }, error = function(e) "refused")
|   paste0(
|     "worker=", testthat::is_parallel(),
|     " forked=", parallel:::isChild(),
|     " loader_masks_utils=", match("tools:ry", search()) < match("package:utils", search()),
|     " classes=", classes
|   )
| }
file tests/testthat/setup-teardown.R
| cat("printed by the setup\n")
| log <- normalizePath("../../teardown.txt", mustWork = FALSE)
| withr::defer(cat("torn down\n", file = log, append = TRUE), teardown_env())
| marker <- normalizePath("../../marker", mustWork = FALSE)
| file.create(marker)
| withr::defer(unlink(marker), teardown_env())
file tests/testthat/test-area.R
| test_that("area multiplies", {
|   cat("printed by a worker\n")
|   expect_true(dir.exists(tempdir()))
|   expect_equal(area(2, 3), 6)
|   expect_equal(worker_facts(), "worker=TRUE forked=TRUE loader_masks_utils=TRUE classes=refused")
| })
file tests/testthat/test-square.R
| test_that("a square's area", {
|   expect_equal(area(2, 2), 4)
|   expect_equal(worker_facts(), "worker=TRUE forked=TRUE loader_masks_utils=TRUE classes=refused")
| })
file tests/testthat/test-slow.R
| test_that("the setup's state outlives the other workers' files", {
|   Sys.sleep(1)
|   expect_true(file.exists(marker))
| })
file tests/testthat/test-wrong.R
| test_that("a wrong expectation fails the run", expect_equal(area(2, 2), 5))

# The package declares parallel tests, so a plain run starts workers, as many as
# `TESTTHAT_CPUS` names. An inherited R_HOME naming a GNU R would make the workers start that R
# instead of ry's, so the journey starts without one.
unset R_HOME
env TESTTHAT_CPUS 3
run ry test --reporter summary --runtime ry
expect exit 1
expect stderr "Starting 3 test processes."
expect stdout "square: .."

run ry test --jobs 2 --reporter summary --runtime ry
expect exit 1
expect stderr "Starting 2 test processes."
expect stdout "area: .."
expect stdout "square: .."
expect stdout "wrong: 1"
expect stdout "Expected `area(2, 2)` to equal 5."
expect stdout "> test-area.R: printed by a worker"
expect stdout "slow: ."
expect stdout lacks "printed by the setup"
expect file teardown.txt "torn down"

# One job runs the files in the `ry test` process, whatever the package declares. The helper
# then reports no worker, so the files that expect one fail.
run ry test --jobs 1 --reporter summary --runtime ry
expect exit 1
expect stderr lacks "test processes"
expect stdout "worker=FALSE"
expect stdout "wrong: 3"

# A worker that exits in the middle of a file stops the run and names the file.
file tests/testthat/test-exit.R
| test_that("quits", quit(save = "no", status = 3))
run ry test --jobs 2 --runtime ry
expect exit 1
expect stderr "testthat subprocess exited in file 'test-exit.R'."

# A package that queries a DataFrame as it loads may have started Polars' thread pool, so its
# workers are callr processes.
remove tests/testthat/test-exit.R
file R/zzz.R
| .onLoad <- function(libname, pkgname) DataFrame(a = 1:3)
run ry test --jobs 2 --reporter summary --runtime ry
expect exit 1
expect stderr "Starting 2 test processes."
expect stdout "forked=FALSE"
remove R/zzz.R

# A profile summary describes one process, so it cannot cover workers.
run ry test --jobs 2 --runtime ry --profile-summary summary.txt
expect exit 2
expect stderr "--profile-summary measures one process"

run ry test --jobs 0
expect exit 2
expect stderr "0 is not in 1.."
