# A package's typed functions keep their declared types once the package is installed: a new
# session checks their arguments, converts a whole number to the `I64` a parameter declares, and
# runs them as compiled for the declared types, with the code image and without it. A strict file
# goes in as the preflight elaborates it, so a conversion compiles at its first call and a
# parameter declared with an alias is checked as the type the alias names.
#
# The install writes the package's typed code file, so a new session attaches the machine code of
# each typed function at its first call instead of compiling it; a version the file cannot
# supply compiles in the session as it would without the file.

requires ry-runtime

file pkg/DESCRIPTION
| Package: typedpkg
| Version: 1.0.0
| Title: Typed
| Description: Typed functions that an install must keep typed.
| License: MIT
file pkg/NAMESPACE
| export(grow, total, label, total_reading, length_of, capped, step_total)
file pkg/R/typed.R
| grow <- function(x: F64, rate: F64) -> F64 x + rate * x
| total <- function(n: I64, rate: F64) -> F64 {
|   sum <- 0.0
|   for (i in List.range(1, n)) {
|     sum <- grow(sum, rate) + Num.to_f64(i)
|   }
|   sum
| }
| label <- function(name: Str, n: I64) -> Str Str.concat(name, Num.to_str(n))
file pkg/R/strict.R
| # typing: strict
| alias Point = Record{x: F64, y: F64}
| total_reading <- function(scale: F64) -> F64 {
|   xs <- List.from_r(seq(0.5, 2.5))
|   List.walk(xs, 0.0, \(sum, x) sum + x * scale)
| }
| length_of <- function(p: Point) -> F64 Num.sqrt(p$x * p$x + p$y * p$y)
| limit <- 10
| steps <- [1, 2, 3, 4]
| capped <- function(n: I64) -> I64 if (n > limit) limit else n
| step_total <- function() -> I64 List.walk(steps, 0, \(sum, x) sum + x)

run ry install pkg -l library
expect exit 0
expect stdout "typed code: closures=7 written=4 (left out: compiles with its caller (1), does not compile (2))"

file use.R
| library(typedpkg, lib.loc = "library")
| print(total(1000, 0.001))
| print(label("a", 3))
| print(tryCatch(grow("a", 1), error = conditionMessage))
| print(total_reading(2))
| wrong <- list(x = 3, y = 4)
| print(tryCatch(length_of(wrong), error = conditionMessage))
| print(capped(20) == 10)
| print(step_total() == 10)

env RY_TYPED_LOG 1
run ry run --runtime ry use.R
expect exit 0
expect stdout "[1] 718640.9"
expect stdout "[1] \"a3\""
expect stdout "[1] \"argument `x` must be `F64`, not `character`\""
expect stderr "typed: attached `total` for [I64, Dbl] -> Dbl from typedpkg's code file"
expect stderr "typed: attached `label` for [Str, I64] -> Str from typedpkg's code file"
expect stdout "[1] 9"
expect stderr "typed: attached `total_reading` for [Dbl] -> Dbl from typedpkg's code file"
expect stderr lacks "typed: compiled"
expect stderr lacks "`total_reading` runs in the interpreter"
expect stdout "[1] \"argument `p` must be `Record{x: F64, y: F64}`, not `list`\""
expect stdout "[1] TRUE\n[1] TRUE"

env RY_CODE_IMAGE 0
run ry run --runtime ry use.R
expect exit 0
expect stdout "[1] 718640.9"
expect stdout "[1] \"argument `x` must be `F64`, not `character`\""
expect stderr "typed: attached `total` for [I64, Dbl] -> Dbl from typedpkg's code file"

# A version the file does not supply compiles in the session, with the same output.
env RY_AHEAD_MISS 1
run ry run --runtime ry use.R
expect exit 0
expect stdout "[1] 718640.9"
expect stdout "[1] \"a3\""
expect stdout "[1] 9"
expect stderr "typed: compiled for [I64, Dbl] -> Dbl"
expect stderr lacks "typed: attached"
unset RY_AHEAD_MISS
env RY_CODE_IMAGE 1

# Attached code keeps what it reads alive across collections at every allocation.
env RY_GC_STRESS 1
run ry run --runtime ry use.R
expect exit 0
expect stdout "[1] 718640.9"
expect stdout "[1] 9"
expect stderr "typed: attached `total` for [I64, Dbl] -> Dbl from typedpkg's code file"
unset RY_GC_STRESS

# A saved typed function reads back typed too.
file save.R
| half <- function(x: F64) -> F64 x / 2
| saveRDS(half, "half.rds")
| again <- readRDS("half.rds")
| print(again(3))
| print(tryCatch(again("a"), error = conditionMessage))
| print(names(attributes(again)))

run ry run --runtime ry save.R
expect exit 0
expect stdout "[1] 1.5"
expect stdout "[1] \"argument `x` must be `F64`, not `character`\""
expect stdout "NULL"

# `ry build --aot` installs the package with its typed code file, as `ry install` does, and
# points a script at `ry run --aot`.
run ry build --aot pkg -l built
expect exit 0
expect stdout "typed code: closures=7 written=4"
env RY_TYPED_LOG 1
file use-built.R
| library(typedpkg, lib.loc = "built")
| print(total(1000, 0.001))
run ry run --runtime ry use-built.R
expect exit 0
expect stdout "[1] 718640.9"
expect stderr "typed: attached `total` for [I64, Dbl] -> Dbl from typedpkg's code file"

run ry build --aot use.R
expect exit 2
expect stderr "use.R is a script, and `ry build --aot` compiles a package: run the script with `ry run --aot use.R`"

# Under `ry run --aot`, a package whose typed code file is another build's compiles its typed
# functions as its namespace loads, and the run says to reinstall it.
file foreign.R
| file <- list.files("built/typedpkg/R", "\\.ryt$", full.names = TRUE)
| stopifnot(file.rename(file, "built/typedpkg/R/typedpkg.0000000000000000.ryt"))
run ry run --runtime ry foreign.R
expect exit 0
unset RY_TYPED_LOG
run ry run --runtime ry use-built.R
expect exit 0
expect stdout "[1] 718640.9"
expect stderr lacks "reinstall"
env RY_TYPED_LOG 1
run ry run --aot --runtime ry use-built.R
expect exit 0
expect stdout "[1] 718640.9"
expect stderr "typed: compiled 4 functions ahead of time"
expect stderr "ry: another build of ry installed typedpkg, so its typed functions compiled as it loaded; reinstall it to compile them at install"
expect stderr lacks "typed: attached"
