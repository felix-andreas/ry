# A function's signature counts the same wherever it is written. A user who keeps their files
# plain R writes it in a `#:` comment, compact or with `@param` lines, or on the name the function
# is assigned to, and gets what the inline spelling gets: the argument check at the function's
# boundary and native code. That holds in a script, at the console, with inline annotations
# turned off, and in a package that is loaded for development or installed.
# Each form declares different parameter types, so each `typed: compiled` line names one of them.

requires ry-runtime

file ry.toml
| [check]
| typing = true
| strict = true

file forms.R
| #: fn(n: I64) -> I64
| in_a_comment <- function(n) n * 2
|
| #: @param x {F64}
| #: @return {F64}
| in_an_expanded_comment <- function(x) x / 2.0
|
| on_the_name: fn(label: Str, n: I64) -> Str <- function(label, n) Str.concat(label, Num.to_str(n))
|
| #: fn(flag: Bool, n: I64) -> I64
| mixed <- function(flag: Bool, n) if (flag) n else 0
|
| print(in_a_comment(21))
| print(in_an_expanded_comment(3.0))
| print(on_the_name("a", 3))
| print(mixed(TRUE, 7))
| print(tryCatch(do.call(in_a_comment, list("a")), error = conditionMessage))

run ry check
expect exit 0

env RY_TYPED_LOG 1
run ry run --runtime ry forms.R
expect exit 0
expect stdout "42i64"
expect stdout "[1] 1.5"
expect stdout "[1] \"a3\""
expect stdout "7i64"
expect stdout "[1] \"argument `n` must be `I64`, not `character`\""
expect stderr "typed: compiled for [I64] -> I64"
expect stderr "typed: compiled for [Dbl] -> Dbl"
expect stderr "typed: compiled for [Str, I64] -> Str"
expect stderr "typed: compiled for [Lgl, I64] -> I64"

# The console reads the line after a `#:` block into the same command, so the block attaches.
file console.txt
| #: fn(n: I64) -> I64
| double_it <- function(n) n * 2
| double_it(4)
| print(tryCatch(do.call(double_it, list("a")), error = conditionMessage))

stdin console.txt
run ry run --runtime ry
expect exit 0
expect stdout "8i64"
expect stdout "[1] \"argument `n` must be `I64`, not `character`\""
expect stderr "typed: compiled for [I64] -> I64"

# A signature that is only the name of an alias is the one form the runtime does not read, and
# the check says so.
file aliased.R
| #: @alias Pick {fn(n: I64, m: I64) -> I64}
|
| #: Pick
| first_of <- function(n, m) n
| print(first_of(1, 2))

run ry check aliased.R
expect exit 1
expect stderr "interpreted"
expect stderr "a function whose signature is a type alias"

# A script that ends in a `#:` block is still checked before it runs: the block annotates
# nothing, and only a console waits for the statement after one. `cat` writes the file without
# a final line break.
file ending.txt
| print("ran unchecked")
| #: fn(n: I64) -> I64
file write-ending.R
| lines <- readLines("ending.txt")
| cat(lines, sep = "\n", file = "ending.R")

run ry run --runtime ry write-ending.R
expect exit 0
run ry run --runtime ry ending.R
expect exit 1
expect stderr "A `#:` typing comment must be followed immediately by an expression"
expect stdout lacks "ran unchecked"

# A blank line detaches the block, so the function below it is plain R.
file ry.toml
| [check]
| typing = true
file apart.R
| #: fn(n: I64) -> I64
|
| apart <- function(n) n
| print(apart("a"))

run ry run --runtime ry apart.R
expect exit 0
expect stdout "[1] \"a\""
expect stderr lacks "typed: compiled"

# With inline annotations turned off, the `#:` block is the whole signature and is still checked.
file ry.toml
| [check]
| inline-annotations = false
file off.R
| #: fn(values: double) -> double
| scale <- function(values) values * 2
| print(tryCatch(scale("a"), error = conditionMessage))

run ry run --runtime ry off.R
expect exit 0
expect stdout "[1] \"argument `values` must be `double`, not `character`\""

# A package written with comment signatures: `total` calls `grow` before anything else forced
# `grow`'s lazy definition, and both run on native code.
file ry.toml
| [check]
| typing = true
| strict = true
file pkg/ry.toml
| [check]
| typing = true
| strict = true
file pkg/DESCRIPTION
| Package: commented
| Version: 1.0.0
| Title: Commented
| Description: Typed functions whose signatures are comments.
| License: MIT
file pkg/NAMESPACE
| export(grow, total, label, scale_by)
file pkg/R/typed.R
| #' Grow a value.
| #: fn(x: F64, rate: F64) -> F64
| grow <- function(x, rate) x + rate * x
| #: @param n {I64}
| #: @param rate {F64}
| #: @return {F64}
| total <- function(n, rate) {
|   sum <- 0.0
|   for (i in List.range(1, n)) {
|     sum <- grow(sum, rate) + Num.to_f64(i)
|   }
|   sum
| }
| label: fn(name: Str, n: I64) -> Str <- function(name, n) Str.concat(name, Num.to_str(n))
| scale_by: fn(x: F64, by: I64) -> F64 <-
|   function(x, by) x * Num.to_f64(by)
file pkg/use.R
| print(total(1000, 0.001))
| print(label("a", 3))
| print(scale_by(1.5, 2))
| print(tryCatch(do.call(grow, list("a", 1)), error = conditionMessage))

run ry load pkg -e "source('pkg/use.R')"
expect exit 0
expect stdout "[1] 718640.9"
expect stdout "[1] \"a3\""
expect stdout "[1] 3"
expect stdout "[1] \"argument `x` must be `F64`, not `character`\""
expect stderr "typed: compiled for [I64, Dbl] -> Dbl"
expect stderr "typed: compiled for [Str, I64] -> Str"
expect stderr "typed: compiled for [Dbl, I64] -> Dbl"
expect stderr lacks "runs in the interpreter: it calls"

# The second load reads the cached index, which lowers each definition from the file's text.
run ry load pkg -e "source('pkg/use.R')"
expect exit 0
expect stdout "[1] 718640.9"
expect stdout "[1] \"argument `x` must be `F64`, not `character`\""
expect stderr "typed: compiled for [I64, Dbl] -> Dbl"

run ry install pkg -l library
expect exit 0

file installed.R
| library(commented, lib.loc = "library")
| source("pkg/use.R")

run ry run --runtime ry installed.R
expect exit 0
expect stdout "[1] 718640.9"
expect stdout "[1] \"a3\""
expect stdout "[1] \"argument `x` must be `F64`, not `character`\""
expect stderr "typed: compiled for [I64, Dbl] -> Dbl"
expect stderr "typed: compiled for [Str, I64] -> Str"

# A `#:` line that does not read as an annotation is a comment, in a package as in a script: the
# check reports it, and the definition below it still loads, from the syntax tree on the first
# load and from the file's text on the second.
file notes/ry.toml
| [check]
| typing = true
file notes/DESCRIPTION
| Package: notes
| Version: 1.0.0
file notes/NAMESPACE
| export(noted)
file notes/R/noted.R
| #: note: see the table below!
| noted <- function(n) n + 1

run ry load notes -e "print(noted(1))"
expect exit 0
expect stdout "[1] 2"
run ry load notes -e "print(noted(1))"
expect exit 0
expect stdout "[1] 2"
