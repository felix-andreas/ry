#---- sections_inside_function_nest_helpers
f <- function(data) {
  # Prepare ----
  clean <- function(value) trimws(value)
  ## Checks ----
  check <- function(value) nzchar(value)
  # Finish ----
  report <- function(value) value
  report(clean(data))
}
#++++
