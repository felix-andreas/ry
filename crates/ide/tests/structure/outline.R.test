#---- members_of_classes_and_types
Person <- R6::R6Class("Person",
  public = list(
    name = NULL,
    greet = function() cat("Hi", self$name)
  ),
  active = list(
    upper = function() toupper(self$name)
  )
)
setClass("Account", contains = "Base", representation("VIRTUAL", Base, owner = "character"), slots = c(balance = "numeric"))
deposit <- function(account, amount) account@balance + amount
alias Shape =
  | :Circle(radius: double)
  | :Empty
area <- function(s: Shape) -> double {
  match (s) {
    :Circle(radius = r) => pi * r^2
    :Empty => 0
  }
}
point <- (x = 1, y = 2)
total <- point$x + point$y
person <- Person$new()
person$greet()
#++++
