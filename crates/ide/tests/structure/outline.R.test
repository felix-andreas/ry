#==== code_lenses
#---- tests_and_run_file
library(testthat)
helper <- function(x) x + 1
test_that("adds one", {
  expect_equal(helper(1), 2)
})
testthat::test_that(desc = "named description", expect_true(TRUE))
test_that(paste("built", "name"), expect_true(TRUE))
#++++
