#==== selection
#---- grows_from_a_name
f <- function(x) {
  total <- sum(x, na.rm = T$0RUE)
  total
}
#++++
symbol f (Function fn(x)) at "f"
fold 0..=2 Block
token "f" Function
token "x" Parameter
token "sum" Function
token "x" Parameter
select "TRUE"
select "na.rm = TRUE"
select "x, na.rm = TRUE"
select "(x, na.rm = TRUE)"
select "sum(x, na.rm = TRUE)"
select "total <- sum(x, na.rm = TRUE)"
select "total <- sum(x, na.rm = TRUE)\n  total"
select "{\n  total <- sum(x, na.rm = TRUE)\n  total\n}"
select "function(x) {\n  total <- sum(x, na.rm = TRUE)\n  total\n}"
select "f <- function(x) {\n  total <- sum(x, na.rm = TRUE)\n  total\n}"

#---- string_contents_first
message("hel$0lo world")
#++++
token "message" Function
select "hello world"
select "\"hello world\""
select "(\"hello world\")"
select "message(\"hello world\")"

#---- cursor_in_whitespace
f(a,  $0 b)
#++++
token "f" Function
select "a,   b"
select "(a,   b)"
select "f(a,   b)"

#==== tokens
#---- r_names
f <- function(x, n = 2) {
  y <- stats::median(x)
  helper(y, n)
}
#++++
symbol f (Function fn(x, n)) at "f"
fold 0..=2 Block
token "f" Function
token "x" Parameter
token "n" Parameter
token "stats" Namespace
token "median" Function
token "x" Parameter
token "helper" Function
token "n" Parameter

#==== fixes
#---- lint_fixes
flag = T
c(1, 2,)
#++++
symbol flag (Value) at "flag"
token "c" Function
fix Change to `<-`: "=" -> "<-"
fix Change to `TRUE`: "T" -> "TRUE"
fix Remove the trailing comma: "," -> ""

#---- misspelled_name
#' @export
compute <- function(values) {
  total <- sum(values)
  totl
}
#++++
symbol compute (Function fn(values)) at "compute"
fold 1..=3 Block
token "compute" Function
token "values" Parameter
token "sum" Function
token "values" Parameter
fix Change to `total`: "totl" -> "total"

#---- misspelled_argument
f <- function(alpha, beta) alpha + beta
f(alpah = 1, beta = 2)
#++++
symbol f (Function fn(alpha, beta)) at "f"
token "f" Function
token "alpha" Parameter
token "beta" Parameter
token "alpha" Parameter
token "beta" Parameter
token "f" Function
fix Change to `alpha`: "alpah" -> "alpha"
