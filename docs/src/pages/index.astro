  if(nrow(big)==0){
  warning("no rows")
  return(NULL)}
  for(region in unique(big$region)) report(big,region)
  invisible(big)
}`,
    beforeChanged: [2, 3, 4, 5, 6],
    after: `summarise <- function(sales, min_units = 1) {
  big <- sales[sales$units >= min_units, ]
  if (nrow(big) == 0) {
    warning("no rows")
    return(NULL)
  }
