                gap: 2px;
                padding: 3px;
                width: fit-content;
                max-width: 100%;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: color-mix(
                    in oklab,
                    var(--code-bg) 72%,
                    transparent
                );
            }
            /* Above this width every pill fits on one row, so the control reads as a
         single track; below it the pills wrap rather than hiding behind a
         scroll the reader has to discover. */
            @media (min-width: 700px) {
                .seg {
                    flex-wrap: nowrap;
                }
            }
            .seg [role="tab"] {
                flex: none;
                font-family: "Geist Sans", system-ui, sans-serif;
                font-size: 13.5px;
                font-weight: 450;
                letter-spacing: -0.005em;
                color: var(--muted);
                background: transparent;
                border: none;
                border-radius: 5px;
                padding: 0.44rem 0.8rem;
                cursor: pointer;
                white-space: nowrap;
                transition:
                    color 0.15s ease,
                    background 0.15s ease;
            }
            .seg [role="tab"]:hover {
                color: var(--foreground);
                background: oklch(1 0 0 / 0.05);
            }
            .seg [role="tab"][aria-selected="true"] {
                color: var(--foreground);
                font-weight: 550;
                background: color-mix(
                    in oklch,
                    var(--cap) 15%,
                    oklch(1 0 0 / 0.03)
                );
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 40%, transparent);
            }
            .seg [role="tab"]:focus-visible {
                outline: 2px solid
                    color-mix(in oklch, var(--cap) 65%, transparent);
                outline-offset: 1px;
            }

            /* ---------- stage frame ---------- */
            .stage {
                --pane-bg: var(--code-bg);
                /* Unitless on purpose: an `em` here would resolve against the frame's
           font size, not the code's, and every code block would be too airy. */
                --lh: 1.62;
                display: flex;
                flex-direction: column;
                /* `<-` and `->` must render as the characters you actually type; the
           mono face would otherwise ligate them into arrows. */
                font-variant-ligatures: none;
                font-feature-settings:
                    "calt" 0,
                    "liga" 0;
                min-width: 0;
                background: var(--pane-bg);
                border: 1px solid var(--border);
                border-radius: 8px;
                overflow: hidden;
                box-shadow: 0 30px 70px -50px oklch(0 0 0 / 0.9);
            }
            .stage-body {
                flex: 1;
                min-height: 0;
            }
            .stage-head,
            .stage-foot {
                display: flex;
                flex: none;
                align-items: center;
                gap: 1rem;
                justify-content: space-between;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 11.5px;
                color: var(--muted);
            }
            .stage-head {
                min-height: 36px;
                padding: 0 10px;
                border-bottom: 1px solid var(--border);
                background: color-mix(in oklab, var(--pane-bg) 72%, #000);
            }
            .stage-foot {
                min-height: 40px;
                flex-wrap: wrap;
                padding: 9px 12px;
                border-top: 1px solid var(--border);
                background: color-mix(in oklab, var(--pane-bg) 84%, #000);
            }
            .ftabs {
                display: flex;
                align-items: flex-end;
                gap: 2px;
                min-width: 0;
            }
            .ftab {
                padding: 0.3rem 0.6rem;
                color: oklch(0.62 0 0);
                white-space: nowrap;
            }
            .ftab.is-active {
                color: oklch(0.93 0 0);
                background: var(--pane-bg);
                box-shadow: inset 0 1px 0
                    color-mix(in oklch, var(--cap) 55%, transparent);
            }
            .stage-meta {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                flex: none;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .stage-meta .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: color-mix(in oklch, var(--cap) 85%, transparent);
            }
            /* Footer slots stack in one grid cell so swapping the active note never
         changes the frame's height. */
            .foot-notes,
            .foot-methods {
                display: grid;
                min-width: 0;
            }
            .foot-note,
            .foot-method,
            .foot-cmd {
                grid-area: 1 / 1;
            }
            .foot-note {
                font-family: "Geist Sans", system-ui, sans-serif;
                font-size: 12.5px;
                line-height: 1.45;
                color: oklch(0.74 0 0);
                max-width: 74ch;
            }
            .foot-note code {
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 0.92em;
                color: oklch(0.9 0 0);
            }
            .foot-method,
            .foot-cmd {
                flex: none;
                white-space: nowrap;
                color: color-mix(in oklch, var(--cap) 80%, oklch(0.9 0 0));
            }
            .foot-cmd .sh {
                color: var(--muted);
            }
            /* The formatter's footer quotes the CLI's own summary line, so it keeps
         the terminal's typeface rather than the page's prose face. */
            .fmt .foot-note {
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 11.5px;
                color: oklch(0.68 0 0);
                text-align: right;
            }
            .foot-notes > .foot-note,
            .foot-methods > .foot-method {
                opacity: 0;
                visibility: hidden;
                transition: opacity 0.18s ease;
            }
            .foot-notes > .foot-note.is-on,
            .foot-methods > .foot-method.is-on {
                opacity: 1;
                visibility: visible;
            }

            /* ---------- code rendering (one palette for the whole page) ---------- */
            .code {
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: var(--code-size);
                line-height: var(--lh);
                padding: 13px 0;
                width: max-content;
                min-width: 100%;
                tab-size: 2;
            }
            .code-scroll {
                min-width: 0;
                min-height: 0;
                overflow-x: auto;
                overscroll-behavior-x: contain;
            }
            .code-scroll,
            .stage.split .pane {
                scrollbar-width: thin;
                scrollbar-color: oklch(1 0 0 / 0.16) transparent;
            }
            .code-scroll::-webkit-scrollbar,
            .stage.split .pane::-webkit-scrollbar {
                height: 8px;
            }
            .code-scroll::-webkit-scrollbar-thumb,
            .stage.split .pane::-webkit-scrollbar-thumb {
                background: oklch(1 0 0 / 0.16);
                border-radius: 4px;
            }
            .cl {
                display: flex;
                position: relative;
            }
            .ln {
                position: sticky;
                left: 0;
                z-index: 2;
                flex: none;
                width: 4.6ch;
                padding-right: 1.5ch;
                text-align: right;
                color: oklch(0.47 0 0);
                background: var(--pane-bg);
                user-select: none;
            }
            .cx {
                position: relative;
                white-space: pre;
                padding-right: 20px;
            }
            .t-id {
                color: oklch(0.88 0 0);
            }
            .t-kw {
                color: oklch(0.775 0.095 300);
            }
            .t-fn {
                color: oklch(0.855 0.08 88);
            }
            .t-str {
                color: oklch(0.815 0.085 145);
            }
            .t-num {
                color: oklch(0.8 0.07 250);
            }
            .t-op {
                color: oklch(0.645 0.012 250);
            }
            .t-com {
                color: oklch(0.585 0.012 250);
            }
            .t-type {
                color: oklch(0.8 0.09 195);
            }
            .tok {
                color: oklch(0.88 0 0);
            }
            /* Formatter panes visualise leading whitespace, so the indentation
         example shows what actually changed instead of an invisible shift. */
            .ws {
                color: oklch(0.36 0 0);
            }

            /* diagnostic squiggle under the exact reported span */
            .squig {
                position: relative;
                text-decoration-line: underline;
                text-decoration-style: wavy;
                text-decoration-skip-ink: none;
                text-underline-offset: 3px;
                text-decoration-thickness: 1px;
            }
            .squig.err {
                text-decoration-color: var(--d-err);
            }
            .squig.warn {
                text-decoration-color: var(--d-warn);
            }

            /* ==================================================================
         Language server: one editor, one file, six overlays. `data-feature`
         on the showcase decides which overlay and which token decorations are
         visible, so the code itself is written exactly once.
         ================================================================== */
            .ide-body {
                position: relative;
                display: grid;
                grid-template-rows: 1fr;
                min-height: 322px;
            }
            .ide-body [data-for] {
                display: none;
            }
            .ide[data-feature="hover"] .hovercard,
            .ide[data-feature="completion"] .comp,
            .ide[data-feature="completion"] .caretbar,
            .ide[data-feature="references"] .peek {
                display: block;
            }
            .ide[data-feature="inlay"] .inlay,
            .ide[data-feature="rename"] .renamebadge {
                display: inline;
            }

            /* the cursor's line, and the token the feature is about */
            .ide[data-feature="definition"] .cl[data-line="4"],
            .ide[data-feature="rename"] .cl[data-line="4"] {
                background: oklch(1 0 0 / 0.035);
            }
            .ide[data-feature="definition"] .cl[data-line="4"] {
                animation: jumpLand 900ms ease;
            }
            @keyframes jumpLand {
                from {
                    background: color-mix(
                        in oklch,
                        var(--cap) 22%,
                        transparent
                    );
                }
            }
            .ide[data-feature="definition"] [data-mark~="def-source"] {
                color: var(--cap);
                text-decoration: underline;
                text-underline-offset: 3px;
                cursor: pointer;
            }
            .ide[data-feature="definition"] [data-mark~="def-target"] {
                border-radius: 3px;
                background: color-mix(in oklch, var(--cap) 20%, transparent);
                box-shadow: 0 0 0 1px
                    color-mix(in oklch, var(--cap) 45%, transparent);
            }
            .ide[data-feature="definition"] .cl[data-line="4"] .ln::after {
                content: "";
                position: absolute;
                left: 0;
                top: 0.3em;
                bottom: 0.3em;
                width: 2px;
                border-radius: 2px;
                background: var(--cap);
            }
            .ide[data-feature="references"] [data-mark~="references"] {
                border-radius: 3px;
                background: color-mix(in oklch, var(--cap) 13%, transparent);
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 50%, transparent);
            }
            .ide[data-feature="rename"] [data-mark~="rename"] {
                border-radius: 3px;
                padding: 0 1px;
                color: var(--foreground);
                background: color-mix(in oklch, var(--cap) 10%, transparent);
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 60%, transparent);
            }
            .ide[data-feature="rename"] [data-mark~="rename"]::after {
                content: "";
                display: inline-block;
                width: 1.5px;
                height: 1.1em;
                margin-left: 1px;
                vertical-align: text-bottom;
                background: var(--cap);
                animation: caretBlink 1.05s steps(1, end) infinite;
            }
            .ide[data-feature="rename"] [data-mark~="rename-ghost"] {
                color: oklch(0.985 0 0 / 0.5);
            }
            .ide[data-feature="rename"] [data-mark~="rename-ghost"].is-renamed {
                color: var(--foreground);
                background: color-mix(in oklch, var(--cap) 22%, transparent);
                border-radius: 3px;
                transition: background 0.6s ease 0.2s;
            }
            .ide[data-feature="hover"] [data-mark~="hover-anchor"] {
                border-bottom: 1px solid var(--cap);
            }

            /* floating panels: hover card and completion list */
            .card {
                position: absolute;
                z-index: 6;
                background: var(--card);
                border: 1px solid var(--border-strong);
                border-radius: 8px;
                box-shadow:
                    0 22px 48px -24px oklch(0 0 0 / 0.95),
                    0 1px 0 oklch(1 0 0 / 0.04) inset;
                white-space: normal;
                text-align: left;
            }
            .hovercard {
                left: 14ch;
                bottom: calc(100% + 7px);
                width: max-content;
                max-width: min(62ch, 76vw);
                padding: 9px 11px;
                border-color: color-mix(
                    in oklch,
                    var(--cap) 24%,
                    var(--border-strong)
                );
            }
            .card-code {
                display: block;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 0.94em;
                line-height: 1.5;
                color: oklch(0.9 0 0);
                font-variant-ligatures: none;
            }
            .card-meta {
                display: block;
                margin-top: 7px;
                padding-top: 7px;
                border-top: 1px solid var(--border);
                font-family: "Geist Sans", system-ui, sans-serif;
                font-size: 11.5px;
                color: var(--muted);
            }
            .card-meta code {
                color: oklch(0.85 0 0);
            }
            .card-notch {
                position: absolute;
                bottom: -5px;
                left: 22px;
                width: 9px;
                height: 9px;
                background: var(--card);
                border-right: 1px solid
                    color-mix(in oklch, var(--cap) 24%, var(--border-strong));
                border-bottom: 1px solid
                    color-mix(in oklch, var(--cap) 24%, var(--border-strong));
                transform: rotate(45deg);
            }
            .comp {
                left: 19ch;
                top: calc(100% + 3px);
                min-width: 27ch;
                padding: 3px;
            }
            .comp-row {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 0 7px;
                height: 26px;
                border-radius: 5px;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 0.92em;
            }
            .comp-row.is-active {
                background: color-mix(in oklch, var(--cap) 17%, transparent);
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 34%, transparent);
            }
            .ckind {
                flex: none;
                font-size: 0.72em;
                letter-spacing: 0.02em;
                color: var(--cap);
                background: color-mix(in oklch, var(--cap) 13%, transparent);
                border: 1px solid
                    color-mix(in oklch, var(--cap) 28%, var(--border));
                border-radius: 4px;
                padding: 0 4px;
            }
            .cname {
                color: oklch(0.92 0 0);
            }
            .cdetail {
                margin-left: auto;
                padding-left: 1.2ch;
                color: var(--muted);
                font-size: 0.9em;
            }
            .caretbar {
                position: absolute;
                left: 19ch;
                top: 0.16em;
                width: 1.5px;
                height: 1.16em;
                background: var(--cap);
                animation: caretBlink 1.05s steps(1, end) infinite;
            }
            @keyframes caretBlink {
                50% {
                    opacity: 0;
                }
            }

            /* references peek, docked to the bottom of the editor */
            .peek {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 4;
                border-top: 1px solid var(--border);
                background: color-mix(in oklab, var(--pane-bg) 86%, #000);
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: calc(var(--code-size) - 0.5px);
            }
            .peek-head {
                display: flex;
                align-items: center;
                gap: 0.5ch;
                padding: 6px 12px 4px;
                color: var(--muted);
                font-size: 11.5px;
                border-bottom: 1px solid var(--border);
            }
            .peek-count {
                color: var(--cap);
            }
            .peek-row {
                display: flex;
                align-items: baseline;
                gap: 1.4ch;
                padding: 1px 12px;
                white-space: nowrap;
                overflow: hidden;
            }
            .peek-row:last-child {
                padding-bottom: 7px;
            }
            .peek-file {
                flex: none;
                width: 11ch;
                color: oklch(0.78 0 0);
            }
            .peek-pos {
                flex: none;
                width: 5ch;
                color: var(--muted);
            }
            .peek-src {
                color: oklch(0.66 0 0);
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .peek-src mark {
                background: color-mix(in oklch, var(--cap) 16%, transparent);
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 45%, transparent);
                border-radius: 3px;
                color: oklch(0.94 0 0);
            }

            /* inlay hints — rendered as the editor renders them: inline, dimmed */
            .inlay {
                display: none;
                margin-left: 0.5ch;
                padding: 0 5px;
                border-radius: 4px;
                font-size: 0.86em;
                color: oklch(0.985 0 0 / 0.52);
                background: oklch(1 0 0 / 0.055);
            }
            .inlay.is-on {
                display: inline;
            }

            /* the "N edits in M files" the rename response actually reports */
            .renamebadge {
                margin-left: 1.5ch;
                padding: 0 5px;
                border-radius: 4px;
                font-size: 0.82em;
                color: var(--cap);
                background: color-mix(in oklch, var(--cap) 12%, transparent);
                border: 1px solid
                    color-mix(in oklch, var(--cap) 26%, var(--border));
            }

            /* ==================================================================
         Split stages: source next to result. Used by the analysis section
         (source | `ry check` output) and the formatter section
         (before | after), so both read with the same geometry.
         ================================================================== */
            .stage.split .stage-body {
                display: grid;
                grid-template-columns: minmax(0, var(--split, 1fr)) minmax(
                        0,
                        1fr
                    );
                align-items: stretch;
            }
            .stage.split .pane {
                position: relative;
                min-width: 0;
                overflow-x: auto;
                overscroll-behavior-x: contain;
            }
            .stage.split .pane + .pane {
                border-left: 1px solid var(--border);
            }
            .stage.split .pane-out {
                background: color-mix(in oklab, var(--pane-bg) 88%, #000);
            }
            .stage.split .pane-out .ln {
                background: color-mix(in oklab, var(--pane-bg) 88%, #000);
            }
            @media (max-width: 900px) {
                .stage.split .stage-body {
                    grid-template-columns: minmax(0, 1fr);
                    /* Stacked panes size to their own content; the leftover height of the
             shared cell collects once at the bottom instead of twice. */
                    grid-auto-rows: min-content;
                    align-content: start;
                }
                .stage.split .pane + .pane {
                    border-left: 0;
                    border-top: 1px solid var(--border);
                }
            }
            @media (max-width: 640px) {
                .stage-head {
                    flex-wrap: wrap;
                    gap: 0.4rem;
                }
                .stage-foot {
                    gap: 0.4rem;
                }
                /* On a phone the stacked footer notes would reserve the tallest note's
           height on every tab; the small reflow is the better trade there. */
                .foot-notes,
                .foot-methods {
                    display: block;
                }
                .foot-notes > .foot-note,
                .foot-methods > .foot-method {
                    display: none;
                }
                .foot-notes > .foot-note.is-on,
                .foot-methods > .foot-method.is-on {
                    display: block;
                }
                .fmt .foot-note {
                    text-align: left;
                }
            }
            .pane-label {
                position: sticky;
                left: 0;
                padding: 8px 12px 0;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 10.5px;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: oklch(0.55 0 0);
            }
            .pane-out .pane-label {
                color: color-mix(in oklch, var(--cap) 62%, oklch(0.62 0 0));
            }
            .pane-label + .code {
                padding-top: 7px;
            }

            /* ---------- terminal output, rendered as the CLI prints it ---------- */
            .term {
                padding: 13px 14px;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: var(--code-size);
                line-height: var(--lh);
                font-variant-ligatures: none;
                font-feature-settings:
                    "calt" 0,
                    "liga" 0;
                color: oklch(0.86 0 0);
            }
            /* Source and caret lines must never wrap — the caret aligns under the
         reported column. Message lines are prose and wrap like a terminal's. */
            .tl {
                white-space: pre;
            }
            .tl.msg {
                white-space: pre-wrap;
            }
            .tl.gap {
                height: calc(var(--lh) * 1em);
            }
            .sh {
                color: color-mix(in oklch, var(--cap) 80%, oklch(0.7 0 0));
            }
            .derr {
                color: var(--d-err);
                font-weight: 600;
            }
            .dwarn {
                color: var(--d-warn);
                font-weight: 600;
            }
            .dmsg {
                color: oklch(0.93 0 0);
                font-weight: 550;
            }
            .darrow,
            .dgutter {
                color: var(--d-blue);
                font-weight: 600;
            }
            .dcaret-err {
                color: var(--d-err);
                font-weight: 600;
            }
            .dcaret-warn {
                color: var(--d-warn);
                font-weight: 600;
            }
            .dsum {
                color: oklch(0.7 0 0);
            }

            /* ---------- formatter panes ---------- */
            .fmt .cl.is-changed .ln {
                color: oklch(0.56 0 0);
            }
            .fmt .cl.is-changed::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 2px;
                z-index: 3;
            }
            .fmt .pane-src .cl.is-changed {
                background: color-mix(in oklch, var(--d-del) 7%, transparent);
            }
            .fmt .pane-src .cl.is-changed::before {
                background: color-mix(in oklch, var(--d-del) 70%, transparent);
            }
            .fmt .pane-out .cl.is-changed {
                background: color-mix(in oklch, var(--d-add) 7%, transparent);
            }
            .fmt .pane-out .cl.is-changed::before {
                background: color-mix(in oklch, var(--d-add) 70%, transparent);
            }
            .fmt .ln {
                background: transparent;
            }
            .fmt .pane-out {
                background: var(--pane-bg);
            }
            .fmt .pane-src {
                background: color-mix(in oklab, var(--pane-bg) 88%, #000);
            }
            /* The formatted pane settles in line by line when the panel becomes
         visible, so the reader watches the rewrite rather than reading a
         static after-shot. */
            .fmt .pane-out .cl {
                opacity: 1;
            }
            .fmt .stage.is-playing .pane-out .cl {
                animation: lineSettle 420ms cubic-bezier(0.22, 0.61, 0.36, 1)
                    both;
                animation-delay: calc(var(--i, 0) * 55ms);
            }
            @keyframes lineSettle {
                from {
                    opacity: 0;
                    transform: translateY(5px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            .fmt .stage.is-playing .pane-src .cl.is-changed {
                animation: delFade 420ms ease both;
            }
            @keyframes delFade {
                from {
                    background: color-mix(
                        in oklch,
                        var(--d-del) 26%,
                        transparent
                    );
                }
            }

            /* ---------- responsive code sizing ---------- */
            .stage {
                --code-size: 13px;
            }
            /* Split panes are half the frame, so their code sits one notch smaller. */
            .stage.split {
                --code-size: 12.5px;
            }
            @media (max-width: 1100px) {
                .stage {
                    --code-size: 12.5px;
                }
                .stage.split {
                    --code-size: 12px;
                }
                .ide-body {
                    min-height: 314px;
                }
            }
            @media (max-width: 640px) {
                .stage {
                    --code-size: 11.5px;
                }
                .stage.split {
                    --code-size: 11px;
                }
                .comp {
                    left: 0;
                }
                .hovercard {
                    left: 0;
                }
                .card-notch {
                    left: 14px;
                }
                .ide-body {
                    min-height: 296px;
                }
                .stage-head,
                .stage-foot {
                    font-size: 11px;
                }
                .peek-file {
                    width: 10ch;
                }
            }

            /* ---------- closer ---------- */
            .band-closer {
                position: relative;
                overflow: hidden;
                border-bottom: none;
                display: grid;
                align-items: center;
                min-height: clamp(36rem, 92vh, 54rem);
            }
            #closer-canvas {
                position: absolute;
                inset: 0;
                z-index: 0;
                pointer-events: none;
            }
            .closer-scrim {
                position: absolute;
                inset: 0;
                z-index: 1;
                pointer-events: none;
                background: radial-gradient(
                    125% 115% at 50% 50%,
                    oklch(0.145 0 0 / 0.82) 0%,
                    oklch(0.145 0 0 / 0.58) 42%,
                    oklch(0.145 0 0 / 0.18) 74%,
                    oklch(0.145 0 0 / 0) 100%
                );
            }
            .closer-col {
                position: relative;
                z-index: 2;
                max-width: var(--prose);
                margin: 0 auto;
                /* Driven by the closer parallax scroll handler: the copy rides a plane
           that scrolls slower than the page, separating it from the dot-matrix
           background. Unset (and under reduced motion never set), it is 0. */
                transform: translateY(calc(var(--closer-parallax, 0) * 1px));
                will-change: transform;
            }
            .closer-col h2 {
                font-size: clamp(2.6rem, 6vw, 4.2rem);
                letter-spacing: -0.02em;
                line-height: 1.05;
            }
            .closer-col .cta-cluster {
                margin-top: 1.75rem;
            }

            /* ---------- footer ---------- */
            .footer {
                padding: 2.4rem clamp(1.2rem, 5vw, 2.5rem);
                background: var(--background);
                border-top: 1px solid var(--border);
            }
            .footer-inner {
                max-width: var(--frame);
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1.2rem;
                flex-wrap: wrap;
            }
            .footer-meta {
                display: inline-flex;
                align-items: center;
                gap: 0.7rem;
            }
            .footer-copy {
                font-size: 0.84rem;
                color: var(--muted);
            }
            .footer-legal {
                font-size: 0.84rem;
                color: var(--muted);
                transition: color 0.15s ease;
            }
            .footer-legal:hover {
                color: var(--foreground);
            }

            @media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }
                .doclink span,
                .cap-icon .tick {
                    transition: none;
                }
                .caretbar,
                .ide[data-feature="rename"] [data-mark~="rename"]::after,
                .ide[data-feature="definition"] .cl[data-line="4"],
                .fmt .stage.is-playing .pane-out .cl,
                .fmt .stage.is-playing .pane-src .cl.is-changed {
                    animation: none !important;
                }
            }
        </style>
    </body>
</html>
