        <script>
            // ======================================================================
            // Hero particle field. On load the field opens as fine sharp particles
            // streaming on a flow current, which then fly in and assemble into the R logo
            // leaving soft light trails. Stirring the gathered shape with the pointer
            // charges it — it shivers, then seethes — until it detonates into the
            // swarm and re-gathers as the other shape (logo <-> "ry"). As you then scroll
            // the hero, the same particles are constrained into the headline "Modern
            // developer tooling for R." — the letters are drawn by the particles
            // themselves; there is no separate DOM heading laid on top.
            // ======================================================================
            type Particle = {
                x: number;
                y: number;
                vx: number;
                vy: number;
                // The three shapes a particle can lock onto, in scroll order: its logo
                // point (assembled during the intro), its "ry" wordmark point, and its
                // headline point. When claimed by none it flows freely on the field.
                lx: number;
                ly: number;
                rx: number;
                ry: number;
                hx: number;
                hy: number;
                // How strongly this particle joins the shapes: ~1 = settles onto the glyph
                // and then the letters, 0 = a pure drifter that only ever flows.
                logoness: number;
                depth: number;
            };
            type Target = { x: number; y: number };

            const heroCanvas = document.getElementById(
                "hero-canvas",
            ) as HTMLCanvasElement | null;
            // The particle field fills the sticky viewport pin (100svh), not the tall
            // scroll stage (#hero) that drives the scroll morph.
            const heroEl = document.getElementById(
                "hero-viewport",
            ) as HTMLElement | null;

            // As you scroll, the particles resolve through two text shapes: first the
            // "ry" wordmark, then the headline (wrapped to two lines so the particle
            // text roughly matches the hidden <h1>).
            const WORDMARK_LINES = ["ry"];
            const HEADING_LINES = ["Modern developer", "tooling for R."];

            function initHero() {
                if (!heroCanvas || !heroEl) return;
                const ctx = heroCanvas.getContext("2d");
                if (!ctx) return;
                const context = ctx;
                const reduceMotion = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches;

                // Load intro (seconds): the field streams free on the flow current for
                // INTRO_DELAY so the hero opens as a living swarm, then particles fly in and
                // assemble onto the logo. `intro` (below) rises 0->1 over the assemble window
                // and then stays 1 — the logo holds rather than dispersing.
                const INTRO_DELAY = 0.8;
                const ASSEMBLE = 1.4;
                // Stir-to-burst: parked at the top, the gathered shape holds until the
                // reader agitates it. Pointer travel across the glyph (or a click on it)
                // builds charge and the shape grows visibly more turbulent; at full
                // charge it detonates into the streaming swarm, which then re-gathers
                // onto the other shape — logo, then the "ry" wordmark, back and forth.
                // Charge drains whenever the stirring stops, so a parked pointer never
                // fires. The rates are set against the drain so gentle motion only
                // simmers while a deliberate stir (~600-800 px/s) fires in roughly two
                // to three seconds; clicks charge too, mainly for touch, where there is
                // no hover to stir with.
                const CHARGE_PER_PX = 1 / 700;
                // A click is a third of the charge with headroom for the drain between
                // clicks, so three unhurried clicks fire (and two rapid ones just do).
                const CHARGE_CLICK = 0.5;
                const CHARGE_DRAIN = 1 / 2.5;
                // The release is near-instant, and the burst fires only once it has completed.
                // Detonating while the shape still holds its spring would snap the shrapnel
                // straight back to the glyph — it reads as an implosion, not an explosion. Too
                // long a release and the logo visibly sags before the bang.
                const RELEASE = 0.15;
                const STREAM = 4.5;
                const RISE = 2;

                let dpr = Math.min(window.devicePixelRatio || 1, 2);
                let cssW = 0;
                let cssH = 0;
                let particles: Particle[] = [];
                let logoTargets: Target[] = [];
                let wordmarkTargets: Target[] = [];
                let headingTargets: Target[] = [];
                let running = false;
                let rafId = 0;
                let clock = 0;
                let lastTime = 0;
                let progress = 0;
                // Stir state: the shape currently gathered (or gathering), how far the
                // reader has charged it, and where the release -> stream -> gather
                // sequence stands after a detonation. Scrolling resets all of it, so
                // returning to the top always restarts calm, on the logo.
                let shapeIndex = 0;
                let charge = 0;
                let burstState:
                    "held" | "releasing" | "streaming" | "gathering" = "held";
                let stateClock = 0;
                let centroidX = 0;
                let centroidY = 0;
                const mouse = { x: -9999, y: -9999, active: false };

                const logoImg = new Image();
                const logoReady = (async () => {
                    logoImg.src = "/logo.svg";
                    try {
                        await logoImg.decode();
                    } catch {
                        await new Promise<void>((resolve) => {
                            logoImg.onload = () => resolve();
                            logoImg.onerror = () => resolve();
                        });
                    }
                })();

                function particleCount() {
                    return cssW < 720 ? 3900 : cssW < 1100 ? 6300 : 8600;
                }
                // Every dot is this one size — depth reads as brightness alone, never as size,
                // so the field is one population rather than near dots and far dots. Fractional
                // on purpose: the grain sits a touch above a hairline without going chunky, and
                // positions are fractional anyway, so nothing gets sharper by rounding it.
                const GRAIN = 1.6;
                function sampleStride() {
                    return cssW < 720 ? 4 : 3;
                }
                function clamp01(t: number) {
                    return t < 0 ? 0 : t > 1 ? 1 : t;
                }
                function smooth01(t: number) {
                    return t * t * (3 - 2 * t);
                }

                function hash(ix: number, iy: number) {
                    const n = Math.sin(ix * 127.1 + iy * 311.7) * 43758.5453;
                    return n - Math.floor(n);
                }
                function valueNoise(x: number, y: number) {
                    const ix = Math.floor(x);
                    const iy = Math.floor(y);
                    const fx = smooth01(x - ix);
                    const fy = smooth01(y - iy);
                    const a = hash(ix, iy);
                    const b = hash(ix + 1, iy);
                    const c = hash(ix, iy + 1);
                    const d = hash(ix + 1, iy + 1);
                    return (
                        a +
                        (b - a) * fx +
                        (c - a) * fy +
                        (a - b - c + d) * fx * fy
                    );
                }
                function flowAngle(x: number, y: number, t: number) {
                    return (
                        valueNoise(
                            x * 0.0016 + t * 0.025,
                            y * 0.0016 - t * 0.012,
                        ) *
                        Math.PI *
                        4
                    );
                }

                // Shared alpha>128 stride sampler over an already-rendered offscreen
                // canvas. `place` maps a sampled pixel to a CSS-space target; the
                // adaptive stride lands the point count near the particle budget.
                function sampleAlpha(
                    data: Uint8ClampedArray,
                    w: number,
                    h: number,
                    ss: number,
                    place: (sx: number, sy: number) => Target,
                ) {
                    const want = Math.round(particleCount() * 0.8);
                    const baseStride = sampleStride() * ss;
                    const run = (st: number) => {
                        const out: Target[] = [];
                        for (let sy = Math.floor(st / 2); sy < h; sy += st) {
                            for (
                                let sx = Math.floor(st / 2);
                                sx < w;
                                sx += st
                            ) {
                                if (data[(sy * w + sx) * 4 + 3] > 128)
                                    out.push(place(sx, sy));
                            }
                        }
                        return out;
                    };
                    let pts = run(baseStride);
                    if (pts.length > want * 1.15) pts = run(baseStride + 1);
                    else if (pts.length < want * 0.7 && baseStride > ss)
                        pts = run(baseStride - 1);
                    return pts;
                }

                // Logo target: draw /logo.svg into an offscreen canvas at SS=2 and
                // sample its alpha. Also fixes the shared centroid the whole loop reuses.
                function buildLogoTarget(): Target[] {
                    const SS = 2;
                    const logoH = Math.min(cssH * 0.42, 320);
                    const logoW = logoH * 0.75;
                    const left = centroidX - logoW / 2;
                    const top = centroidY - logoH / 2;
                    if (!logoImg.width || !logoImg.height) return [];
                    const off = document.createElement("canvas");
                    off.width = Math.max(2, Math.round(logoW * SS));
                    off.height = Math.max(2, Math.round(logoH * SS));
                    const octx = off.getContext("2d");
                    if (!octx) return [];
                    octx.clearRect(0, 0, off.width, off.height);
                    octx.drawImage(logoImg, 0, 0, off.width, off.height);
                    let data: Uint8ClampedArray;
                    try {
                        data = octx.getImageData(
                            0,
                            0,
                            off.width,
                            off.height,
                        ).data;
                    } catch {
                        return [];
                    }
                    return sampleAlpha(
                        data,
                        off.width,
                        off.height,
                        SS,
                        (sx, sy) => ({
                            x: left + sx / SS + (Math.random() - 0.5) * 1.5,
                            y: top + sy / SS + (Math.random() - 0.5) * 1.5,
                        }),
                    );
                }

                // Headline target: render the wrapped headline (matching the <h1>'s sans
                // font and weight) into an offscreen canvas, then run the same alpha
                // sampler. Centered on the shared centroid so it lines up with the DOM copy.
                function buildTextTarget(
                    lines: string[],
                    widthFrac = 0.7,
                    widthCap = 660,
                ): Target[] {
                    const SS = 2;
                    const fontFamily = `'Geist Sans', system-ui, sans-serif`;
                    const probe = document
                        .createElement("canvas")
                        .getContext("2d");
                    if (!probe) return [];
                    const basePx = 100;
                    probe.font = `600 ${basePx}px ${fontFamily}`;
                    let maxW = 1;
                    for (const line of lines)
                        maxW = Math.max(maxW, probe.measureText(line).width);
                    const targetW = Math.min(cssW * widthFrac, widthCap);
                    let fontPx = (basePx * targetW) / maxW;
                    const maxFont = Math.min(cssW * 0.086, cssH * 0.142);
                    if (fontPx > maxFont) fontPx = maxFont;
                    if (fontPx < 12) fontPx = 12;
                    const leading = fontPx * 1.04;
                    const blockW =
                        Math.ceil((maxW * fontPx) / basePx) + Math.ceil(fontPx);
                    const blockH = Math.ceil(leading * lines.length + fontPx);
                    const off = document.createElement("canvas");
                    off.width = Math.max(2, Math.round(blockW * SS));
                    off.height = Math.max(2, Math.round(blockH * SS));
                    const octx = off.getContext("2d");
                    if (!octx) return [];
                    octx.clearRect(0, 0, off.width, off.height);
                    octx.scale(SS, SS);
                    octx.fillStyle = "#fff";
                    octx.font = `600 ${fontPx}px ${fontFamily}`;
                    octx.textBaseline = "middle";
                    octx.textAlign = "center";
                    const midX = blockW / 2;
                    const startY =
                        blockH / 2 - (leading * (lines.length - 1)) / 2;
                    for (let i = 0; i < lines.length; i++)
                        octx.fillText(lines[i], midX, startY + i * leading);
                    let data: Uint8ClampedArray;
                    try {
                        data = octx.getImageData(
                            0,
                            0,
                            off.width,
                            off.height,
                        ).data;
                    } catch {
                        return [];
                    }
                    const left = centroidX - blockW / 2;
                    const top = centroidY - blockH / 2;
                    return sampleAlpha(
                        data,
                        off.width,
                        off.height,
                        SS,
                        (sx, sy) => ({
                            x: left + sx / SS + (Math.random() - 0.5) * 0.5,
                            y: top + sy / SS + (Math.random() - 0.5) * 0.5,
                        }),
                    );
                }

                function spawnParticles() {
                    const count = particleCount();
                    particles = [];
                    for (let i = 0; i < count; i++) {
                        // Spread evenly over the whole field: released particles flow on the
                        // current and wrap at the edges, so an even field is what the swarm
                        // settles back to and the hero opens already streaming rather than as a
                        // blob that has to spread. Starting velocity is taken from the current
                        // itself rather than a random direction, so the very first frame is
                        // already streaming coherently instead of easing out of a freeze.
                        const x = Math.random() * cssW;
                        const y = Math.random() * cssH;
                        const ang = flowAngle(x, y, 0);
                        particles.push({
                            x,
                            y,
                            vx: Math.cos(ang) * 0.55,
                            vy: Math.sin(ang) * 0.55,
                            lx: 0,
                            ly: 0,
                            rx: 0,
                            ry: 0,
                            hx: 0,
                            hy: 0,
                            // ~80% of particles settle (almost) fully onto the glyph so the R
                            // reads clearly at rest — a small residual keeps the strokes from
                            // looking mechanically stamped; the other ~20% never join a shape and
                            // keep flowing across the field so it always feels alive.
                            logoness:
                                Math.random() < 0.8
                                    ? 0.96 + Math.random() * 0.04
                                    : 0,
                            depth: 0.35 + Math.random() * 0.65,
                        });
                    }
                }

                // Give every particle its logo, "ry", and headline points. All three
                // target sets are ordered left-to-right and paired by fractional index, so
                // particles flow horizontally between the shapes rather than crossing over
                // each other. The point counts differ from the particle count, so a few
                // points are shared — the drift hides the slight overlap.
                function pairTargets() {
                    if (
                        !logoTargets.length ||
                        !wordmarkTargets.length ||
                        !headingTargets.length
                    )
                        return;
                    const byX = (a: Target, b: Target) =>
                        a.x - b.x || a.y - b.y;
                    const logo = logoTargets.slice().sort(byX);
                    const word = wordmarkTargets.slice().sort(byX);
                    const head = headingTargets.slice().sort(byX);
                    const total = particles.length;
                    for (let i = 0; i < total; i++) {
                        const f = total > 1 ? i / (total - 1) : 0;
                        const l =
                            logo[
                                Math.min(
                                    logo.length - 1,
                                    Math.floor(f * logo.length),
                                )
                            ];
                        const w =
                            word[
                                Math.min(
                                    word.length - 1,
                                    Math.floor(f * word.length),
                                )
                            ];
                        const h =
                            head[
                                Math.min(
                                    head.length - 1,
                                    Math.floor(f * head.length),
                                )
                            ];
                        const p = particles[i];
                        p.lx = l.x;
                        p.ly = l.y;
                        p.rx = w.x;
                        p.ry = w.y;
                        p.hx = h.x;
                        p.hy = h.y;
                    }
                }

                function relayout() {
                    dpr = Math.min(window.devicePixelRatio || 1, 2);
                    const r = heroEl!.getBoundingClientRect();
                    cssW = r.width;
                    cssH = r.height;
                    heroCanvas!.width = Math.floor(cssW * dpr);
                    heroCanvas!.height = Math.floor(cssH * dpr);
                    heroCanvas!.style.width = cssW + "px";
                    heroCanvas!.style.height = cssH + "px";
                    context.setTransform(dpr, 0, 0, dpr, 0, 0);
                    // Anchor the particle headline on the invisible <h1>'s laid-out box, so
                    // the particle letters land exactly where the heading would sit and the
                    // subhead below flows under them without overlap. The <h1> is fully
                    // transparent (a screen-reader label) but keeps its layout box.
                    const headline = heroEl!.querySelector(
                        ".hero-copy h1",
                    ) as HTMLElement | null;
                    if (headline) {
                        const hr = headline.getBoundingClientRect();
                        centroidX = hr.left - r.left + hr.width / 2;
                        centroidY = hr.top - r.top + hr.height / 2;
                    } else {
                        centroidX = cssW / 2;
                        centroidY = cssH * 0.44;
                    }
                    logoTargets = buildLogoTarget();
                    // The wordmark is two letters, so the width cap barely binds — the
                    // shared font-size cap keeps its cap height near the headline's.
                    wordmarkTargets = buildTextTarget(
                        WORDMARK_LINES,
                        0.34,
                        400,
                    );
                    headingTargets = buildTextTarget(HEADING_LINES);
                    spawnParticles();
                    pairTargets();
                }

                // Logo-assembly amount for the load intro: 0 before it starts, eases up to 1
                // as particles fly onto the glyph, then stays 1 — the logo holds instead of
                // dispersing. The idle cycle and scroll morph take the shape from there.
                function introAmount() {
                    if (clock <= INTRO_DELAY) return 0;
                    if (clock < INTRO_DELAY + ASSEMBLE)
                        return smooth01((clock - INTRO_DELAY) / ASSEMBLE);
                    return 1;
                }

                // How gathered the current shape is (1 = parked on its points, 0 =
                // exploded into the streaming swarm) across the burst sequence.
                function burstClaim() {
                    if (burstState === "releasing")
                        return 1 - smooth01(stateClock / RELEASE);
                    if (burstState === "streaming") return 0;
                    if (burstState === "gathering")
                        return smooth01(stateClock / RISE);
                    return 1;
                }

                // One outward impulse, fired the instant the release completes, so the
                // shape bursts into radial streaks rather than just fading into the
                // swarm. The speed spread is wide on purpose: the flow current moves
                // neighbours in lockstep, so without it the released shape would slide
                // off as one lump instead of thinning out into a swarm.
                function detonate() {
                    const wellRadius = Math.min(cssW, cssH) * 0.85;
                    for (const particle of particles) {
                        const dx = particle.x - centroidX;
                        const dy = particle.y - centroidY;
                        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
                        // The shape becomes shrapnel: squaring the roll sends most of it drifting
                        // out while a thin fast fraction is thrown clear across the field, which
                        // is what makes it read as a burst rather than a uniform expanding ring.
                        // The free field is not a bystander — it takes a shock wave that falls
                        // off with distance, so the blast visibly travels outward through it.
                        const speed =
                            particle.logoness > 0
                                ? 9 + Math.random() * Math.random() * 46
                                : 14 /
                                  (1 +
                                      (dist * dist) /
                                          (wellRadius * wellRadius));
                        particle.vx +=
                            (dx / dist) * speed + (Math.random() - 0.5) * 4;
                        particle.vy +=
                            (dy / dist) * speed + (Math.random() - 0.5) * 4;
                    }
                }

                // Advances the stir sequence: a fully charged shape releases, detonates,
                // streams, and gathers as the other shape. The target swap happens while
                // nothing is gathered, so there is no visible jump.
                function advanceBurst(dt: number) {
                    if (burstState === "held") {
                        if (charge >= 1) {
                            burstState = "releasing";
                            stateClock = 0;
                        } else {
                            charge = Math.max(0, charge - CHARGE_DRAIN * dt);
                        }
                        return;
                    }
                    stateClock += dt;
                    if (burstState === "releasing" && stateClock >= RELEASE) {
                        detonate();
                        shapeIndex = 1 - shapeIndex;
                        charge = 0;
                        burstState = "streaming";
                        stateClock = 0;
                    } else if (
                        burstState === "streaming" &&
                        stateClock >= STREAM
                    ) {
                        burstState = "gathering";
                        stateClock = 0;
                    } else if (
                        burstState === "gathering" &&
                        stateClock >= RISE
                    ) {
                        burstState = "held";
                        stateClock = 0;
                    }
                }

                // One frame. Every particle sits on one axis: how strongly a shape claims it.
                // Unclaimed, it rides the flow current and wraps at the field edges; claimed,
                // it springs onto its point in the current shape. So the field streams before
                // the first assembly and again between shapes, and the ~20% that never join a
                // shape stream the whole time. Parked at the top the shape holds until the
                // reader stirs it into detonating (alternating between the logo and the "ry"
                // wordmark), and scrolling slides it into the headline (scrolling back up
                // returns it to the logo).
                // Rather than clearing, the frame is faded toward black so moving
                // particles leave soft light trails; the trail vanishes to a full clear as the
                // scroll text locks in so the letters read crisp.
                function render(now: number) {
                    // The morph completes well before the end of the scroll track so the text
                    // resolves quickly; the remaining scroll just holds it.
                    const morph = smooth01(clamp01(progress / 0.72));
                    const intro = introAmount();
                    const claim = burstClaim();
                    const shapeSel = shapeIndex;
                    // How much of a shape is actually standing there right now — it is what the
                    // free particles orbit, so it fades in with the load intro and out with each
                    // burst.
                    const presence = claim * intro;
                    const wellCore = Math.min(cssW, cssH) * 0.19;
                    const wellRadius = Math.min(cssW, cssH) * 0.85;
                    // How strongly the scroll text is claimed — ramps in fast so the headline
                    // reads crisp. Drives the trail crispening below.
                    const textForm = smooth01(clamp01(morph / 0.32));
                    context.globalAlpha = 1;
                    // Fade toward black for motion trails; the trail vanishes to a full clear
                    // as the scroll text locks in so the letters read crisp, not smeared.
                    // Charging lengthens the trails, so the boil reads as energy even
                    // before the dots have travelled far.
                    context.fillStyle = `rgba(0,0,0,${(0.13 + 0.86 * textForm) * (1 - 0.6 * charge)})`;
                    context.fillRect(0, 0, cssW, cssH);
                    context.fillStyle = "#fff";
                    // Looseness peaks mid-transition so the field breathes as it reshapes.
                    const settle = Math.max(
                        intro < 1 ? Math.sin(Math.PI * intro) : 0,
                        Math.sin(Math.PI * morph),
                    );
                    for (let i = 0; i < particles.length; i++) {
                        const p = particles[i];
                        // `shaped` = does this dot take part in shapes (1 after the intro), vs a
                        // pure drifter (0). `form` = how gathered onto a shape it is right now
                        // (drops to 0 as the cycle scatters it into the swarm).
                        const shaped = p.logoness * intro;
                        const form = shaped * claim;
                        let pullX = 0;
                        let pullY = 0;
                        if (form > 0.0001) {
                            // The shape it gathers onto (logo or "ry" by the cycle), slid
                            // across to the headline as you scroll.
                            const shapeX = p.lx + (p.rx - p.lx) * shapeSel;
                            const shapeY = p.ly + (p.ry - p.ly) * shapeSel;
                            const gx = shapeX + (p.hx - shapeX) * morph;
                            const gy = shapeY + (p.hy - shapeY) * morph;
                            // Nothing holds a released particle in place — the pull exists only in
                            // proportion to how claimed the shape is, so a dot eases out of the flow
                            // as the shape gathers and back into it as the shape lets go.
                            const springK = (0.045 + 0.07 * form) * form;
                            pullX = (gx - p.x) * springK;
                            pullY = (gy - p.y) * springK;
                            // Stirring heats the glyph: the charge drives a per-dot boil plus
                            // a fine shared current, and the spring loosens as it rises, so
                            // the shape shivers at first touch, seethes and swells as the
                            // charge builds, and visibly strains before it blows.
                            if (charge > 0.001) {
                                const heat = charge * form;
                                const swirl = flowAngle(
                                    p.x * 3 + 41,
                                    p.y * 3 - 17,
                                    clock * 5,
                                );
                                pullX =
                                    pullX * (1 - 0.6 * charge) +
                                    (Math.random() - 0.5) * 5 * heat +
                                    Math.cos(swirl) * 1.8 * heat;
                                pullY =
                                    pullY * (1 - 0.6 * charge) +
                                    (Math.random() - 0.5) * 5 * heat +
                                    Math.sin(swirl) * 1.8 * heat;
                            }
                        }
                        // Flow current: whatever the shape has not claimed rides the current, so
                        // the field streams before the first assembly and again after each burst,
                        // and only the gathered dots hold still.
                        // Flow direction is shared — every dot reads the same noise field, so
                        // neighbours travel together and the swarm streams in visible currents and
                        // eddies. (Offsetting the *angle* per particle would scatter the
                        // directions and the field would degenerate into individual jitter.) Only
                        // the speed varies, by depth, so a clump stretches along the current into a
                        // ribbon rather than sliding as a rigid lump.
                        const flow =
                            0.055 * (1 - form) * (0.55 + 0.95 * p.depth);
                        const angle = flowAngle(p.x, p.y, clock);
                        p.vx += pullX + Math.cos(angle) * flow;
                        p.vy += pullY + Math.sin(angle) * flow;
                        // A gathered shape has mass: everything still loose in the field is drawn
                        // toward it and swept around it, so the free particles read as the same
                        // swarm reacting to the logo rather than as a second, unrelated layer.
                        // Inside the shape's own radius the pull inverts into a push, so the field
                        // orbits and skims the glyph instead of collapsing into a pile at its
                        // centre. The well fades out with the shape, and during the burst there is
                        // nothing left to orbit — the whole field just streams. Weighted by
                        // `1 - shaped`, not by `form`: a dot on its way onto the glyph must not be
                        // shoved back out by the very shape it is joining.
                        const wellPull = 0.15 * presence * (1 - shaped);
                        if (wellPull > 0.0005) {
                            const wx = centroidX - p.x;
                            const wy = centroidY - p.y;
                            const dist = Math.sqrt(wx * wx + wy * wy) || 1;
                            const falloff =
                                1 /
                                (1 + (dist * dist) / (wellRadius * wellRadius));
                            const radial = Math.max(
                                -1.4,
                                Math.min(1, 1 - wellCore / dist),
                            );
                            const acc = wellPull * falloff;
                            // Mostly swirl, only a little draw: a stronger radial term would vacuum
                            // the outer field into a ring and leave the corners empty.
                            p.vx +=
                                ((wx / dist) * radial * 0.45 -
                                    (wy / dist) * 0.9) *
                                acc;
                            p.vy +=
                                ((wy / dist) * radial * 0.45 +
                                    (wx / dist) * 0.9) *
                                acc;
                        }
                        if (mouse.active) {
                            const mdx = p.x - mouse.x;
                            const mdy = p.y - mouse.y;
                            const d2 = mdx * mdx + mdy * mdy;
                            if (d2 < 12000 && d2 > 0.01) {
                                const push = (1 - d2 / 12000) * 1.7;
                                const inv = 1 / Math.sqrt(d2);
                                p.vx += mdx * inv * push;
                                p.vy += mdy * inv * push;
                            }
                        }
                        // Drifters keep their momentum so the flow streams; assembled shape dots
                        // damp harder so the shape settles crisp.
                        const damp = 0.92 - 0.05 * form;
                        p.vx *= damp;
                        p.vy *= damp;
                        p.x += p.vx;
                        p.y += p.vy;
                        // A released dot wraps the field so the stream is endless in every
                        // direction. Wrapping is suppressed the moment a shape starts claiming it,
                        // because a teleport mid-gather reads as a glitch rather than as flow.
                        if (form < 0.01) {
                            if (p.x < -4) p.x += cssW + 8;
                            else if (p.x > cssW + 4) p.x -= cssW + 8;
                            if (p.y < -4) p.y += cssH + 8;
                            else if (p.y > cssH + 4) p.y -= cssH + 8;
                        }
                        // Bright while sitting on a shape, dim while flowing, so the streaming
                        // field stays quiet behind the letters. The gathered term is generous
                        // enough that most dots clamp at full white: the shapes are read as text,
                        // and text that is only mostly opaque reads as washed out.
                        const base = 0.26 + p.depth * 0.32;
                        let alpha = base + form * (0.72 + p.depth * 0.4);
                        alpha *= 1 - settle * 0.22;
                        context.globalAlpha =
                            alpha < 0 ? 0 : alpha > 1 ? 1 : alpha;
                        context.fillRect(p.x, p.y, GRAIN, GRAIN);
                    }
                    context.globalAlpha = 1;
                }

                // Scroll only updates progress and the nav/copy/hint reveal. The rAF loop
                // owns rendering so the spring integration advances on a real timestep.
                const stage = document.getElementById("hero");
                const nav = document.getElementById("nav");
                const copy = heroEl!.querySelector(
                    ".hero-copy",
                ) as HTMLElement | null;
                const hint = heroEl!.querySelector(
                    ".scroll-hint",
                ) as HTMLElement | null;

                function syncScroll() {
                    const vh = window.innerHeight || 1;
                    const y = window.scrollY || window.pageYOffset || 0;
                    const scrollable = Math.max(
                        1,
                        (stage ? stage.offsetHeight : vh) - vh,
                    );
                    progress = clamp01(y / scrollable);
                    if (nav)
                        nav.style.setProperty(
                            "--reveal",
                            String(clamp01((y - vh * 0.12) / (vh * 0.16))),
                        );
                    // The subhead and buttons fade in right after the particles resolve into
                    // the headline (which completes at progress 0.72). The headline itself is
                    // never shown as DOM text — the particles are the heading.
                    const copyP = smooth01(clamp01((progress - 0.6) / 0.22));
                    if (copy)
                        copy.style.setProperty("--copy-op", String(copyP));
                    if (hint)
                        hint.style.setProperty(
                            "--hint-op",
                            String(clamp01(1 - y / (vh * 0.14))),
                        );
                }

                function loop(now: number) {
                    if (!running) return;
                    if (lastTime === 0) lastTime = now;
                    let dt = (now - lastTime) / 1000;
                    lastTime = now;
                    if (dt > 0.05) dt = 0.05;
                    clock += dt;
                    // Advance the stir sequence only while parked at the very top, and only
                    // once the load intro has finished assembling — a shape still flying in
                    // cannot be charged. Any scroll resets the sequence so returning to the
                    // top restarts calm, on the logo.
                    if (progress < 0.02) {
                        if (clock > INTRO_DELAY + ASSEMBLE) advanceBurst(dt);
                    } else {
                        shapeIndex = 0;
                        charge = 0;
                        burstState = "held";
                        stateClock = 0;
                    }
                    render(now);
                    rafId = requestAnimationFrame(loop);
                }
                function start() {
                    if (running) return;
                    running = true;
                    lastTime = 0;
                    rafId = requestAnimationFrame(loop);
                }
                function stop() {
                    running = false;
                    if (rafId) cancelAnimationFrame(rafId);
                    rafId = 0;
                }

                let resizeTimer = 0;
                window.addEventListener("resize", () => {
                    window.clearTimeout(resizeTimer);
                    resizeTimer = window.setTimeout(() => {
                        relayout();
                        syncScroll();
                    }, 150);
                });
                window.addEventListener("scroll", syncScroll, {
                    passive: true,
                });
                // Stirring, not presence, charges the shape: only pointer travel over the
                // gathered glyph counts (capped per event, so a single fast swipe cannot
                // detonate on its own), and a click lands a solid kick. A parked pointer
                // adds nothing, and the charge it built drains away.
                function stir(amount: number, x: number, y: number) {
                    if (burstState !== "held" || progress >= 0.02) return;
                    if (clock <= INTRO_DELAY + ASSEMBLE) return;
                    const dx = x - centroidX;
                    const dy = y - centroidY;
                    const reach = Math.min(cssW, cssH) * 0.28;
                    if (dx * dx + dy * dy > reach * reach) return;
                    charge = Math.min(1, charge + amount);
                }
                let lastMouseX = -9999;
                let lastMouseY = -9999;
                window.addEventListener("mousemove", (e) => {
                    const r = heroCanvas!.getBoundingClientRect();
                    mouse.x = e.clientX - r.left;
                    mouse.y = e.clientY - r.top;
                    mouse.active = mouse.y >= 0 && mouse.y <= cssH;
                    if (lastMouseX > -9000) {
                        const travel = Math.min(
                            40,
                            Math.hypot(
                                mouse.x - lastMouseX,
                                mouse.y - lastMouseY,
                            ),
                        );
                        stir(travel * CHARGE_PER_PX, mouse.x, mouse.y);
                    }
                    lastMouseX = mouse.x;
                    lastMouseY = mouse.y;
                });
                window.addEventListener("pointerdown", (e) => {
                    const r = heroCanvas!.getBoundingClientRect();
                    stir(CHARGE_CLICK, e.clientX - r.left, e.clientY - r.top);
                });
                window.addEventListener(
                    "mouseleave",
                    () => (mouse.active = false),
                );

                const begin = () => {
                    relayout();
                    syncScroll();
                    if (reduceMotion) {
                        // No animation: show the crisp DOM headline and copy. The particles rest
                        // as a faint static scatter behind the text (intro never runs, so nothing
                        // assembles) so nothing competes with the legible <h1>.
                        progress = 0;
                        clock = 0;
                        render(0);
                        if (nav) nav.style.setProperty("--reveal", "1");
                        if (copy) copy.style.setProperty("--copy-op", "1");
                        return;
                    }
                    if (typeof IntersectionObserver === "undefined") {
                        start();
                        return;
                    }
                    const observer = new IntersectionObserver(
                        (entries) => {
                            for (const entry of entries) {
                                if (entry.isIntersecting) start();
                                else stop();
                            }
                        },
                        { threshold: 0 },
                    );
                    observer.observe(heroEl!);
                };

                const fontsReady =
                    document.fonts && document.fonts.ready
                        ? document.fonts.ready
                        : Promise.resolve();
                Promise.all([fontsReady, logoReady]).then(begin).catch(begin);
            }

            // ======================================================================
            // Showcase controls: an accessible tablist (roving tabindex, arrow keys,
            // Home/End) over either one reused stage or one stage per tab.
            //
            // The language-server showcase reuses a single stage for all six
            // features — the code is written once and `data-feature` selects the
            // overlay — so its tabs point at one panel and `aria-labelledby` follows
            // the selection. The other two showcases have a stage per tab.
            // ======================================================================
            const RENAME_FROM = "margin";
            const RENAME_TO = "net_of_fees";

            function setupShowcase(root: HTMLElement) {
                const reduce = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches;
                const tablist = root.querySelector('[role="tablist"]');
                const tabs = Array.from(
                    root.querySelectorAll('[role="tab"]'),
                ) as HTMLElement[];
                if (!tabs.length) return;
                const sharedPanel = root.classList.contains("ide");
                const panels = sharedPanel
                    ? []
                    : tabs.map(
                          (tab) =>
                              root.querySelector(
                                  "#" + tab.getAttribute("aria-controls"),
                              ) as HTMLElement | null,
                      );
                const footNotes = Array.from(
                    root.querySelectorAll(".foot-notes > .foot-note"),
                ) as HTMLElement[];
                const footMethods = Array.from(
                    root.querySelectorAll(".foot-methods > .foot-method"),
                ) as HTMLElement[];
                let renameTimer = 0;

                function selectedIndex() {
                    const found = tabs.findIndex(
                        (tab) => tab.getAttribute("aria-selected") === "true",
                    );
                    return found < 0 ? 0 : found;
                }

                function activate(index: number, focusTab: boolean) {
                    const key = tabs[index]?.dataset.key ?? "";
                    tabs.forEach((tab, i) => {
                        const selected = i === index;
                        tab.setAttribute(
                            "aria-selected",
                            selected ? "true" : "false",
                        );
                        tab.tabIndex = selected ? 0 : -1;
                        const panel = panels[i];
                        if (panel) panel.hidden = !selected;
                    });
                    if (sharedPanel) {
                        root.dataset.feature = key;
                        const panel = root.querySelector('[role="tabpanel"]');
                        if (panel)
                            panel.setAttribute(
                                "aria-labelledby",
                                tabs[index].id,
                            );
                        resetRename();
                        if (key === "rename") playRename();
                    } else {
                        const panel = panels[index];
                        if (panel) playFormat(panel);
                    }
                    for (const note of footNotes)
                        note.classList.toggle(
                            "is-on",
                            note.dataset.for === key,
                        );
                    for (const method of footMethods)
                        method.classList.toggle(
                            "is-on",
                            method.dataset.for === key,
                        );
                    if (focusTab) tabs[index].focus();
                }

                // The formatted pane replays its line-by-line settle whenever the panel
                // becomes the visible one, so the reader watches the rewrite happen.
                function playFormat(panel: HTMLElement) {
                    if (reduce || !root.classList.contains("fmt")) return;
                    panel.classList.remove("is-playing");
                    void panel.offsetWidth;
                    panel.classList.add("is-playing");
                }

                function renameTargets() {
                    return Array.from(
                        root.querySelectorAll(
                            '[data-mark~="rename"], [data-mark~="rename-ghost"]',
                        ),
                    ) as HTMLElement[];
                }
                function resetRename() {
                    if (renameTimer) {
                        window.clearInterval(renameTimer);
                        renameTimer = 0;
                    }
                    for (const target of renameTargets()) {
                        target.textContent = RENAME_FROM;
                        target.classList.remove("is-renamed");
                    }
                }
                function playRename() {
                    resetRename();
                    const input = root.querySelector(
                        '[data-mark~="rename"]',
                    ) as HTMLElement | null;
                    const ghosts = Array.from(
                        root.querySelectorAll('[data-mark~="rename-ghost"]'),
                    ) as HTMLElement[];
                    if (!input) return;
                    if (reduce) {
                        input.textContent = RENAME_TO;
                        for (const ghost of ghosts) {
                            ghost.textContent = RENAME_TO;
                            ghost.classList.add("is-renamed");
                        }
                        return;
                    }
                    let text = RENAME_FROM;
                    let erasing = true;
                    renameTimer = window.setInterval(() => {
                        if (erasing) {
                            text = text.slice(0, -1);
                            if (!text.length) erasing = false;
                        } else {
                            text = RENAME_TO.slice(0, text.length + 1);
                        }
                        input.textContent = text;
                        if (text === RENAME_TO) {
                            window.clearInterval(renameTimer);
                            renameTimer = 0;
                            for (const ghost of ghosts) {
                                ghost.textContent = RENAME_TO;
                                ghost.classList.add("is-renamed");
                            }
                        }
                    }, 48);
                }

                if (tablist) {
                    tablist.addEventListener("keydown", (event) => {
                        const key = (event as KeyboardEvent).key;
                        const current = selectedIndex();
                        const count = tabs.length;
                        let next = -1;
                        if (key === "ArrowRight" || key === "ArrowDown")
                            next = (current + 1) % count;
                        else if (key === "ArrowLeft" || key === "ArrowUp")
                            next = (current - 1 + count) % count;
                        else if (key === "Home") next = 0;
                        else if (key === "End") next = count - 1;
                        else return;
                        event.preventDefault();
                        activate(next, true);
                    });
                }
                tabs.forEach((tab, i) =>
                    tab.addEventListener("click", () => activate(i, true)),
                );
                // Paint the initial selection through the same path the clicks take, so
                // the footer note and the shared stage's feature state are never blank.
                activate(selectedIndex(), false);

                // Play the entry animation only once the showcase is actually on
                // screen, and replay it when the reader scrolls back to it.
                if (typeof IntersectionObserver !== "undefined" && !reduce) {
                    let wasVisible = false;
                    const observer = new IntersectionObserver(
                        (entries) => {
                            for (const entry of entries) {
                                const visible = entry.intersectionRatio >= 0.3;
                                if (visible && !wasVisible) {
                                    const index = selectedIndex();
                                    if (sharedPanel) {
                                        resetRename();
                                        if (
                                            tabs[index]?.dataset.key ===
                                            "rename"
                                        )
                                            playRename();
                                    } else {
                                        const panel = panels[index];
                                        if (panel) playFormat(panel);
                                    }
                                }
                                wasVisible = visible;
                            }
                        },
                        { threshold: [0, 0.3, 0.6] },
                    );
                    observer.observe(root);
                }
                if (
                    reduce &&
                    sharedPanel &&
                    tabs[selectedIndex()]?.dataset.key === "rename"
                )
                    playRename();
            }

            // ======================================================================
            // Closer: dot-matrix halftone field with a sweeping wavefront.
            // Self-contained and namespaced; pauses offscreen; static halftone
            // fallback under reduced motion. Shares no globals with the hero field.
            // ======================================================================
            function initCloserMatrix() {
                const matrixCanvas = document.getElementById(
                    "closer-canvas",
                ) as HTMLCanvasElement | null;
                const matrixSection = document.getElementById(
                    "get-started",
                ) as HTMLElement | null;
                if (!matrixCanvas || !matrixSection) return;
                const ctx = matrixCanvas.getContext("2d", { alpha: false });
                if (!ctx) return;
                const reduceMatrix = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                );
                const finePointer = window.matchMedia("(pointer: fine)");

                const BG = "#0a0a0a";
                const TRAIL = "rgba(10,10,10,0.14)";
                const RAMP = " ·∶∷▪█";
                const RAMP_CODES = RAMP.split("").map((c) => c.charCodeAt(0));
                const TOKENS = [
                    "integer",
                    "double",
                    "character",
                    "logical",
                    "<T: numeric>",
                    "fn(..)->",
                ];
                const DIR_X = 0.7771;
                const DIR_Y = 0.6294;
                const PERIOD = 13.0;
                const LEVELS = 18;
                const WHITE = LEVELS;
                const probeR = 130;
                const BLOCK = RAMP.charCodeAt(RAMP.length - 1);

                const logoImg = new Image();
                const logoReady = (async () => {
                    logoImg.src = "/logo.svg";
                    try {
                        await logoImg.decode();
                    } catch {
                        await new Promise<void>((resolve) => {
                            logoImg.onload = () => resolve();
                            logoImg.onerror = () => resolve();
                        });
                    }
                })();

                let dpr = 1;
                let W = 0;
                let H = 0;
                let cellW = 11;
                let cellH = 18;
                let cols = 0;
                let rows = 0;
                let maxProj = 0;
                let bandPx = 0;
                let rowStreams: string[] = [];
                let styles: string[] = [];
                let bx: Float32Array[] = [];
                let by: Float32Array[] = [];
                let bc: Uint16Array[] = [];
                let bn: number[] = [];
                let mouseX = -1e9;
                let mouseY = -1e9;
                let hasMouse = false;
                let logoHit: Uint8Array | null = null;
                let showFullLogo = false;

                function buildStyles() {
                    styles = [];
                    for (let i = 0; i < LEVELS; i++) {
                        const a = 0.1 + (i / (LEVELS - 1)) * 0.3;
                        styles.push("rgba(238,238,238," + a.toFixed(3) + ")");
                    }
                }

                function hash3(x: number, y: number, z: number) {
                    let n =
                        (x | 0) * 374761393 +
                        (y | 0) * 668265263 +
                        (z | 0) * 1274126177;
                    n = (n ^ (n >> 13)) >>> 0;
                    n = Math.imul(n, 1274126177) >>> 0;
                    return (n & 0xffffff) / 0x1000000;
                }
                function smooth(t: number) {
                    return t * t * (3 - 2 * t);
                }
                function vnoise(x: number, y: number, z: number) {
                    const xi = Math.floor(x);
                    const yi = Math.floor(y);
                    const zi = Math.floor(z);
                    const xf = x - xi;
                    const yf = y - yi;
                    const zf = z - zi;
                    const u = smooth(xf);
                    const v = smooth(yf);
                    const w = smooth(zf);
                    const c000 = hash3(xi, yi, zi);
                    const c100 = hash3(xi + 1, yi, zi);
                    const c010 = hash3(xi, yi + 1, zi);
                    const c110 = hash3(xi + 1, yi + 1, zi);
                    const c001 = hash3(xi, yi, zi + 1);
                    const c101 = hash3(xi + 1, yi, zi + 1);
                    const c011 = hash3(xi, yi + 1, zi + 1);
                    const c111 = hash3(xi + 1, yi + 1, zi + 1);
                    const x00 = c000 + (c100 - c000) * u;
                    const x10 = c010 + (c110 - c010) * u;
                    const x01 = c001 + (c101 - c001) * u;
                    const x11 = c011 + (c111 - c011) * u;
                    const y0 = x00 + (x10 - x00) * v;
                    const y1 = x01 + (x11 - x01) * v;
                    return y0 + (y1 - y0) * w;
                }
                function fbm(x: number, y: number, z: number) {
                    let f = 0;
                    let amp = 0.5;
                    let freq = 1;
                    for (let o = 0; o < 3; o++) {
                        f += amp * vnoise(x * freq, y * freq, z * freq);
                        freq *= 2.0;
                        amp *= 0.5;
                    }
                    return f;
                }
                function tokenChar(col: number, row: number) {
                    const s = rowStreams[row];
                    if (!s) return 0;
                    return s.charCodeAt(col % s.length);
                }

                function resize() {
                    dpr = Math.min(window.devicePixelRatio || 1, 2);
                    const rect = matrixSection!.getBoundingClientRect();
                    W = Math.max(2, Math.round(rect.width));
                    H = Math.max(2, Math.round(rect.height));
                    const small = W < 720;
                    cellW = small ? 13 : 11;
                    cellH = small ? 21 : 18;
                    matrixCanvas!.width = Math.floor(W * dpr);
                    matrixCanvas!.height = Math.floor(H * dpr);
                    matrixCanvas!.style.width = W + "px";
                    matrixCanvas!.style.height = H + "px";
                    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                    ctx.textBaseline = "top";
                    ctx.textAlign = "left";
                    ctx.font =
                        Math.round(cellH * 0.82) + "px 'Geist Mono', monospace";
                    cols = Math.ceil(W / cellW) + 1;
                    rows = Math.ceil(H / cellH) + 1;
                    maxProj = W * DIR_X + H * DIR_Y;
                    bandPx = cellW * 2.6;

                    rowStreams = new Array(rows);
                    for (let r = 0; r < rows; r++) {
                        const seed = Math.floor(
                            hash3(r * 7 + 1, 13, 29) * 1000,
                        );
                        const parts: string[] = [];
                        for (let k = 0; k < 14; k++)
                            parts.push(TOKENS[(seed + k * 5) % TOKENS.length]);
                        rowStreams[r] = parts.join("  ") + "  ";
                    }

                    const maxCells = cols * rows;
                    bx = [];
                    by = [];
                    bc = [];
                    bn = [];
                    for (let i = 0; i <= LEVELS; i++) {
                        bx.push(new Float32Array(maxCells));
                        by.push(new Float32Array(maxCells));
                        bc.push(new Uint16Array(maxCells));
                        bn.push(0);
                    }
                    ctx.fillStyle = BG;
                    ctx.fillRect(0, 0, W, H);
                    buildLogoMask();
                }

                function buildLogoMask() {
                    logoHit = new Uint8Array(cols * rows);
                    if (!logoImg.naturalWidth || !logoImg.naturalHeight) return;
                    const logoH = Math.min(H * 0.62, 440);
                    const logoW = logoH * 0.75;
                    const left = (W - logoW) / 2;
                    const top = (H - logoH) / 2;
                    const ow = Math.max(2, Math.round(logoW));
                    const oh = Math.max(2, Math.round(logoH));
                    const off = document.createElement("canvas");
                    off.width = ow;
                    off.height = oh;
                    const octx = off.getContext("2d");
                    if (!octx) return;
                    octx.clearRect(0, 0, ow, oh);
                    octx.drawImage(logoImg, 0, 0, ow, oh);
                    let data: Uint8ClampedArray;
                    try {
                        data = octx.getImageData(0, 0, ow, oh).data;
                    } catch {
                        logoHit = null;
                        return;
                    }
                    for (let r = 0; r < rows; r++) {
                        const cy = r * cellH + cellH * 0.5;
                        const ly = cy - top;
                        if (ly < 0 || ly >= logoH) continue;
                        let sy = Math.floor((ly / logoH) * oh);
                        if (sy >= oh) sy = oh - 1;
                        for (let c = 0; c < cols; c++) {
                            const cx = c * cellW + cellW * 0.5;
                            const lx = cx - left;
                            if (lx < 0 || lx >= logoW) continue;
                            let sx = Math.floor((lx / logoW) * ow);
                            if (sx >= ow) sx = ow - 1;
                            if (data[(sy * ow + sx) * 4 + 3] > 128)
                                logoHit[r * cols + c] = 1;
                        }
                    }
                }

                function render(time: number) {
                    ctx.fillStyle = TRAIL;
                    ctx.fillRect(0, 0, W, H);

                    for (let i = 0; i <= LEVELS; i++) bn[i] = 0;

                    const phase = (time / PERIOD) % 1;
                    const frontPos =
                        phase * (maxProj + bandPx * 4) - bandPx * 2;
                    const tz = time * 0.15;
                    const revealIn = bandPx * 2.2;
                    const revealHold = bandPx * 2.4;
                    const revealOut = bandPx * 6.5;

                    for (let r = 0; r < rows; r++) {
                        const py = r * cellH;
                        const cy = py + cellH * 0.5;
                        for (let c = 0; c < cols; c++) {
                            const px = c * cellW;
                            const cx = px + cellW * 0.5;

                            let b = fbm(px * 0.006 + 11, py * 0.006 + 7, tz);
                            b = (b - 0.25) / 0.5;
                            if (b < 0) b = 0;
                            else if (b > 1) b = 1;

                            const proj = cx * DIR_X + cy * DIR_Y;
                            const w = proj - frontPos;

                            if (logoHit && logoHit[r * cols + c]) {
                                let reveal: number;
                                if (showFullLogo) {
                                    reveal = 1;
                                } else {
                                    const dpass = frontPos - proj;
                                    let tin = (dpass + revealIn) / revealIn;
                                    if (tin < 0) tin = 0;
                                    else if (tin > 1) tin = 1;
                                    let tout =
                                        1 - (dpass - revealHold) / revealOut;
                                    if (tout < 0) tout = 0;
                                    else if (tout > 1) tout = 1;
                                    reveal = tin < tout ? tin : tout;
                                }
                                if (reveal > 0.5) {
                                    const idx = bn[WHITE]++;
                                    bx[WHITE][idx] = px;
                                    by[WHITE][idx] = py;
                                    bc[WHITE][idx] = BLOCK;
                                    continue;
                                } else if (reveal > 0.14) {
                                    const lvl = LEVELS - 1;
                                    const idx = bn[lvl]++;
                                    bx[lvl][idx] = px;
                                    by[lvl][idx] = py;
                                    bc[lvl][idx] = BLOCK;
                                    continue;
                                }
                            }

                            let resolved = w < bandPx && w > -bandPx;
                            if (!resolved && hasMouse) {
                                const dx = cx - mouseX;
                                const dy = cy - mouseY;
                                if (
                                    dx * dx + dy * dy < probeR * probeR &&
                                    b > 0.32
                                )
                                    resolved = true;
                            }

                            if (resolved) {
                                const code = tokenChar(c, r);
                                if (code === 32 || code === 0) continue;
                                const idx = bn[WHITE]++;
                                bx[WHITE][idx] = px;
                                by[WHITE][idx] = py;
                                bc[WHITE][idx] = code;
                                continue;
                            }

                            if (w <= -bandPx) b = Math.min(1, b + 0.08);

                            const gi = Math.min(
                                RAMP_CODES.length - 1,
                                Math.floor(b * RAMP_CODES.length),
                            );
                            const code = RAMP_CODES[gi];
                            if (code === 32) continue;

                            let lvl = Math.round(b * (LEVELS - 1));
                            if (lvl < 0) lvl = 0;
                            else if (lvl >= LEVELS) lvl = LEVELS - 1;
                            const idx = bn[lvl]++;
                            bx[lvl][idx] = px;
                            by[lvl][idx] = py;
                            bc[lvl][idx] = code;
                        }
                    }

                    for (let lvl = 0; lvl < LEVELS; lvl++) {
                        const n = bn[lvl];
                        if (!n) continue;
                        ctx.fillStyle = styles[lvl];
                        const xs = bx[lvl];
                        const ys = by[lvl];
                        const cs = bc[lvl];
                        for (let i = 0; i < n; i++)
                            ctx.fillText(
                                String.fromCharCode(cs[i]),
                                xs[i],
                                ys[i],
                            );
                    }
                    const wn = bn[WHITE];
                    if (wn) {
                        ctx.fillStyle = "#ffffff";
                        const xs = bx[WHITE];
                        const ys = by[WHITE];
                        const cs = bc[WHITE];
                        for (let i = 0; i < wn; i++)
                            ctx.fillText(
                                String.fromCharCode(cs[i]),
                                xs[i],
                                ys[i],
                            );
                    }
                }

                let running = false;
                let startTime = 0;
                let rafId = 0;
                let inView = false;

                function loop(now: number) {
                    if (!running) return;
                    if (!startTime) startTime = now;
                    render((now - startTime) / 1000);
                    rafId = requestAnimationFrame(loop);
                }
                function start() {
                    if (running) return;
                    running = true;
                    startTime = 0;
                    rafId = requestAnimationFrame(loop);
                }
                function stop() {
                    running = false;
                    if (rafId) cancelAnimationFrame(rafId);
                    rafId = 0;
                }
                function staticFrame() {
                    ctx.fillStyle = BG;
                    ctx.fillRect(0, 0, W, H);
                    hasMouse = false;
                    showFullLogo = true;
                    render(PERIOD * 0.5);
                    showFullLogo = false;
                }

                function onMove(e: MouseEvent) {
                    const rect = matrixSection!.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    if (x >= 0 && x <= W && y >= 0 && y <= H) {
                        mouseX = x;
                        mouseY = y;
                        hasMouse = true;
                    } else {
                        hasMouse = false;
                    }
                }
                function onLeave() {
                    hasMouse = false;
                }

                function setup() {
                    buildStyles();
                    resize();

                    if (reduceMatrix.matches) {
                        staticFrame();
                    } else {
                        if (finePointer.matches) {
                            window.addEventListener("mousemove", onMove, {
                                passive: true,
                            });
                            window.addEventListener("mouseout", onLeave, {
                                passive: true,
                            });
                        }
                        if (typeof IntersectionObserver !== "undefined") {
                            const observer = new IntersectionObserver(
                                (entries) => {
                                    for (const entry of entries) {
                                        inView = entry.isIntersecting;
                                        if (inView) start();
                                        else stop();
                                    }
                                },
                                { threshold: 0 },
                            );
                            observer.observe(matrixSection!);
                        } else {
                            inView = true;
                            start();
                        }
                    }

                    let resizeTimer = 0;
                    window.addEventListener("resize", () => {
                        window.clearTimeout(resizeTimer);
                        resizeTimer = window.setTimeout(() => {
                            stop();
                            resize();
                            if (reduceMatrix.matches) staticFrame();
                            else if (inView) start();
                        }, 150);
                    });

                    reduceMatrix.addEventListener("change", () => {
                        stop();
                        if (reduceMatrix.matches) staticFrame();
                        else if (inView) start();
                    });
                }

                const fontsReady =
                    document.fonts && document.fonts.ready
                        ? document.fonts.ready
                        : Promise.resolve();
                Promise.all([fontsReady, logoReady]).then(setup).catch(setup);
            }

            // ======================================================================
            // Closer parallax: while the closer scrolls through the viewport, its
            // copy drifts slower than the page, so the copy and the dot-matrix
            // background separate into two planes. One passive scroll handler writes
            // a CSS variable; the transform itself lives in CSS.
            // ======================================================================
            function initCloserParallax() {
                const section = document.getElementById("get-started");
                const col = section?.querySelector(
                    ".closer-col",
                ) as HTMLElement | null;
                if (!section || !col) return;
                if (
                    window.matchMedia("(prefers-reduced-motion: reduce)")
                        .matches
                )
                    return;
                let rafId = 0;
                const update = () => {
                    rafId = 0;
                    const rect = section.getBoundingClientRect();
                    const vh = window.innerHeight || 1;
                    // 0 while the section is still below the viewport, 1 once it has
                    // left above; the drift crosses zero with the section centered, so
                    // the copy sits exactly where static layout would put it.
                    const t = Math.min(
                        1,
                        Math.max(0, (vh - rect.top) / (vh + rect.height)),
                    );
                    col.style.setProperty(
                        "--closer-parallax",
                        ((0.5 - t) * 160).toFixed(1),
                    );
                };
                const onScroll = () => {
                    if (!rafId) rafId = requestAnimationFrame(update);
                };
                window.addEventListener("scroll", onScroll, { passive: true });
                window.addEventListener("resize", onScroll, { passive: true });
                update();
            }

            function initNav() {
                const nav = document.getElementById("nav");
                if (!nav) return;
                const onScroll = () =>
                    nav.classList.toggle("scrolled", window.scrollY > 8);
                onScroll();
                window.addEventListener("scroll", onScroll, { passive: true });
            }

