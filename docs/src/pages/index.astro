                background: transparent;
                position: relative;
                z-index: 1;
                border: none;
                border-radius: 7px;
                padding: 0.46rem 0.85rem;
                cursor: pointer;
                white-space: nowrap;
                transition:
                    color var(--switch-duration) var(--switch-ease),
                    background var(--switch-duration) var(--switch-ease);
            }
            .seg [role="tab"]:hover {
                color: var(--foreground);
            }
            .seg [role="tab"][aria-selected="true"] {
                color: var(--foreground);
                background: oklch(1 0 0 / 0.09);
                box-shadow:
                    0 1px 2px oklch(0 0 0 / 0.5),
                    inset 0 1px 0 oklch(1 0 0 / 0.07);
            }
            .seg.has-ind [role="tab"][aria-selected="true"] {
                background: transparent;
                box-shadow: none;
            }
            .seg.has-ind [role="tab"]:hover:not([aria-selected="true"]) {
                background: oklch(1 0 0 / 0.04);
            }
            .seg [role="tab"]:focus-visible {
                outline: 2px solid oklch(1 0 0 / 0.6);
                outline-offset: 1px;
            }

            .stage {
                position: relative;
                --pane-bg: var(--code-bg);
                /* Unitless: an `em` would resolve against the frame's font size, not the code's. */
                --lh: 1.62;
                display: flex;
                flex-direction: column;
                /* The mono face would otherwise ligate `<-` and `->` into arrows. */
                font-variant-ligatures: none;
                font-feature-settings:
                    "calt" 0,
                    "liga" 0;
                min-width: 0;
                background: var(--pane-bg);
                border: 1px solid var(--border);
                border-radius: 8px;
                overflow: hidden;
                box-shadow: 0 30px 70px -50px oklch(0 0 0 / 0.9);
            }
            .stage-body {
                flex: 1;
                min-height: 0;
            }
            .stage-head,
            .stage-foot {
                display: flex;
                flex: none;
                align-items: center;
                gap: 1rem;
                justify-content: space-between;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 11.5px;
                color: var(--muted);
            }
            .stage-head {
                min-height: 36px;
                padding: 0 10px;
                border-bottom: 1px solid var(--border);
                background: color-mix(in oklab, var(--pane-bg) 72%, #000);
            }
            .stage-foot {
                min-height: 40px;
                flex-wrap: wrap;
                padding: 9px 12px;
                border-top: 1px solid var(--border);
                background: color-mix(in oklab, var(--pane-bg) 84%, #000);
            }
            .ftabs {
                display: flex;
                align-items: flex-end;
                gap: 2px;
                min-width: 0;
            }
            .ftab {
                padding: 0.3rem 0.6rem;
                color: oklch(0.62 0 0);
                white-space: nowrap;
            }
            .ftab.is-active {
                color: oklch(0.93 0 0);
                background: var(--pane-bg);
                box-shadow: inset 0 1px 0
                    color-mix(in oklch, var(--cap) 55%, transparent);
            }
            /* One shared grid cell, so swapping notes never changes the frame's height. */
            .foot-notes,
            .foot-methods {
                display: grid;
                min-width: 0;
            }
            .foot-note,
            .foot-method,
            .foot-cmd {
                grid-area: 1 / 1;
            }
            .foot-note {
                font-family: "Geist Sans", system-ui, sans-serif;
                font-size: 12.5px;
                line-height: 1.45;
                color: oklch(0.74 0 0);
                max-width: 74ch;
            }
            .foot-note code {
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 0.92em;
                color: oklch(0.9 0 0);
            }
            .foot-method,
            .foot-cmd {
                flex: none;
                white-space: nowrap;
                color: color-mix(in oklch, var(--cap) 80%, oklch(0.9 0 0));
            }
            .foot-cmd .sh {
                color: var(--muted);
            }
            /* Quotes the CLI's summary line, so it keeps the terminal typeface. */
            .fmt .foot-note {
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 11.5px;
                color: oklch(0.68 0 0);
                text-align: right;
            }
            .foot-notes > .foot-note,
            .foot-methods > .foot-method {
                opacity: 0;
                visibility: hidden;
                transition: opacity 0.18s ease;
            }
            .foot-notes > .foot-note.is-on,
            .foot-methods > .foot-method.is-on {
                opacity: 1;
                visibility: visible;
            }

            .code {
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: var(--code-size);
                line-height: var(--lh);
                padding: 13px 0;
                width: max-content;
                min-width: 100%;
                tab-size: 2;
            }
            .code-scroll {
                min-width: 0;
                min-height: 0;
                overflow-x: auto;
                overscroll-behavior-x: contain;
            }
            .code-scroll,
            .stage.split .pane {
                scrollbar-width: thin;
                scrollbar-color: oklch(1 0 0 / 0.16) transparent;
            }
            .code-scroll::-webkit-scrollbar,
            .stage.split .pane::-webkit-scrollbar {
                height: 8px;
            }
            .code-scroll::-webkit-scrollbar-thumb,
            .stage.split .pane::-webkit-scrollbar-thumb {
                background: oklch(1 0 0 / 0.16);
                border-radius: 4px;
            }
            .cl {
                display: flex;
                position: relative;
            }
            .ln {
                position: sticky;
                left: 0;
                z-index: 2;
                flex: none;
                width: 4.6ch;
                padding-right: 1.5ch;
                text-align: right;
                color: oklch(0.47 0 0);
                background: var(--pane-bg);
                user-select: none;
            }
            .cx {
                position: relative;
                white-space: pre;
                padding-right: 20px;
            }
            .t-id {
                color: oklch(0.88 0 0);
            }
            .t-kw {
                color: oklch(0.775 0.095 300);
            }
            .t-fn {
                color: oklch(0.855 0.08 88);
            }
            .t-str {
                color: oklch(0.815 0.085 145);
            }
            .t-num {
                color: oklch(0.8 0.07 250);
            }
            .t-op {
                color: oklch(0.645 0.012 250);
            }
            .t-com {
                color: oklch(0.585 0.012 250);
            }
            .t-type {
                color: oklch(0.8 0.09 195);
            }
            .tok {
                color: oklch(0.88 0 0);
            }
            /* Visible leading whitespace, so the indentation example shows what changed. */
            .ws {
                color: oklch(0.36 0 0);
            }

            .squig {
                position: relative;
                text-decoration-line: underline;
                text-decoration-style: wavy;
                text-decoration-skip-ink: none;
                text-underline-offset: 3px;
                text-decoration-thickness: 1px;
            }
            .squig.err {
                text-decoration-color: var(--d-err);
            }
            .squig.warn {
                text-decoration-color: var(--d-warn);
            }

            .ide-body {
                position: relative;
                display: grid;
                grid-template-rows: 1fr;
                /* Tall enough for the completion popup under line 6, and level with the other toolchain tabs. */
                min-height: 249px;
            }
            .ide-body [data-for] {
                display: none;
            }
            .ide[data-feature="hover"] .hovercard,
            .ide[data-feature="completion"] .comp,
            .ide[data-feature="completion"] .caretbar,
            .ide[data-feature="references"] .peek {
                display: block;
            }
            .ide[data-feature="inlay"] .inlay,
            .ide[data-feature="rename"] .renamebadge {
                display: inline;
            }

            .ide[data-feature="definition"] .cl[data-line="4"],
            .ide[data-feature="rename"] .cl[data-line="4"] {
                background: oklch(1 0 0 / 0.035);
            }
            .ide[data-feature="definition"] .cl[data-line="4"] {
                animation: jumpLand 900ms ease;
            }
            @keyframes jumpLand {
                from {
                    background: color-mix(
                        in oklch,
                        var(--cap) 22%,
                        transparent
                    );
                }
            }
            .ide[data-feature="definition"] [data-mark~="def-source"] {
                color: var(--cap);
                text-decoration: underline;
                text-underline-offset: 3px;
                cursor: pointer;
            }
            .ide[data-feature="definition"] [data-mark~="def-target"] {
                border-radius: 3px;
                background: color-mix(in oklch, var(--cap) 20%, transparent);
                box-shadow: 0 0 0 1px
                    color-mix(in oklch, var(--cap) 45%, transparent);
            }
            .ide[data-feature="definition"] .cl[data-line="4"] .ln::after {
                content: "";
                position: absolute;
                left: 0;
                top: 0.3em;
                bottom: 0.3em;
                width: 2px;
                border-radius: 2px;
                background: var(--cap);
            }
            .ide[data-feature="references"] [data-mark~="references"] {
                border-radius: 3px;
                background: color-mix(in oklch, var(--cap) 13%, transparent);
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 50%, transparent);
            }
            .ide[data-feature="rename"] [data-mark~="rename"] {
                border-radius: 3px;
                padding: 0 1px;
                color: var(--foreground);
                background: color-mix(in oklch, var(--cap) 10%, transparent);
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 60%, transparent);
            }
            .ide[data-feature="rename"] [data-mark~="rename"]::after {
                content: "";
                display: inline-block;
                width: 1.5px;
                height: 1.1em;
                margin-left: 1px;
                vertical-align: text-bottom;
                background: var(--cap);
                animation: caretBlink 1.05s steps(1, end) infinite;
            }
            .ide[data-feature="rename"] [data-mark~="rename-ghost"] {
                color: oklch(0.985 0 0 / 0.5);
            }
            .ide[data-feature="rename"] [data-mark~="rename-ghost"].is-renamed {
                color: var(--foreground);
                background: color-mix(in oklch, var(--cap) 22%, transparent);
                border-radius: 3px;
                transition: background 0.6s ease 0.2s;
            }
            .ide[data-feature="hover"] [data-mark~="hover-anchor"] {
                border-bottom: 1px solid var(--cap);
            }

            .card {
                position: absolute;
                z-index: 6;
                background: var(--card);
                border: 1px solid var(--border-strong);
                border-radius: 8px;
                box-shadow:
                    0 22px 48px -24px oklch(0 0 0 / 0.95),
                    0 1px 0 oklch(1 0 0 / 0.04) inset;
                white-space: normal;
                text-align: left;
            }
            .hovercard {
                left: 14ch;
                bottom: calc(100% + 7px);
                width: max-content;
                max-width: min(62ch, 76vw);
                padding: 9px 11px;
                border-color: color-mix(
                    in oklch,
                    var(--cap) 24%,
                    var(--border-strong)
                );
            }
            .card-code {
                display: block;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 0.94em;
                line-height: 1.5;
                color: oklch(0.9 0 0);
                font-variant-ligatures: none;
            }
            .card-meta {
                display: block;
                margin-top: 7px;
                padding-top: 7px;
                border-top: 1px solid var(--border);
                font-family: "Geist Sans", system-ui, sans-serif;
                font-size: 11.5px;
                color: var(--muted);
            }
            .card-meta code {
                color: oklch(0.85 0 0);
            }
            .card-notch {
                position: absolute;
                bottom: -5px;
                left: 22px;
                width: 9px;
                height: 9px;
                background: var(--card);
                border-right: 1px solid
                    color-mix(in oklch, var(--cap) 24%, var(--border-strong));
                border-bottom: 1px solid
                    color-mix(in oklch, var(--cap) 24%, var(--border-strong));
                transform: rotate(45deg);
            }
            .comp {
                left: 19ch;
                top: calc(100% + 3px);
                min-width: 27ch;
                padding: 3px;
            }
            .comp-row {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 0 7px;
                height: 26px;
                border-radius: 5px;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 0.92em;
            }
            .comp-row.is-active {
                background: color-mix(in oklch, var(--cap) 17%, transparent);
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 34%, transparent);
            }
            .ckind {
                flex: none;
                font-size: 0.72em;
                letter-spacing: 0.02em;
                color: var(--cap);
                background: color-mix(in oklch, var(--cap) 13%, transparent);
                border: 1px solid
                    color-mix(in oklch, var(--cap) 28%, var(--border));
                border-radius: 4px;
                padding: 0 4px;
            }
            .cname {
                color: oklch(0.92 0 0);
            }
            .cdetail {
                margin-left: auto;
                padding-left: 1.2ch;
                color: var(--muted);
                font-size: 0.9em;
            }
            .caretbar {
                position: absolute;
                left: 19ch;
                top: 0.16em;
                width: 1.5px;
                height: 1.16em;
                background: var(--cap);
                animation: caretBlink 1.05s steps(1, end) infinite;
            }
            @keyframes caretBlink {
                50% {
                    opacity: 0;
                }
            }

            .peek {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 4;
                border-top: 1px solid var(--border);
                background: color-mix(in oklab, var(--pane-bg) 86%, #000);
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: calc(var(--code-size) - 0.5px);
            }
            .peek-head {
                display: flex;
                align-items: center;
                gap: 0.5ch;
                padding: 6px 12px 4px;
                color: var(--muted);
                font-size: 11.5px;
                border-bottom: 1px solid var(--border);
            }
            .peek-count {
                color: var(--cap);
            }
            .peek-row {
                display: flex;
                align-items: baseline;
                gap: 1.4ch;
                padding: 1px 12px;
                white-space: nowrap;
                overflow: hidden;
            }
            .peek-row:last-child {
                padding-bottom: 7px;
            }
            .peek-file {
                flex: none;
                width: 11ch;
                color: oklch(0.78 0 0);
            }
            .peek-pos {
                flex: none;
                width: 5ch;
                color: var(--muted);
            }
            .peek-src {
                color: oklch(0.66 0 0);
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .peek-src mark {
                background: color-mix(in oklch, var(--cap) 16%, transparent);
                box-shadow: inset 0 0 0 1px
                    color-mix(in oklch, var(--cap) 45%, transparent);
                border-radius: 3px;
                color: oklch(0.94 0 0);
            }

            .inlay {
                display: none;
                margin-left: 0.5ch;
                padding: 0 5px;
                border-radius: 4px;
                font-size: 0.86em;
                color: oklch(0.985 0 0 / 0.52);
                background: oklch(1 0 0 / 0.055);
            }
            .inlay.is-on {
                display: inline;
            }

            .renamebadge {
                margin-left: 1.5ch;
                padding: 0 5px;
                border-radius: 4px;
                font-size: 0.82em;
                color: var(--cap);
                background: color-mix(in oklch, var(--cap) 12%, transparent);
                border: 1px solid
                    color-mix(in oklch, var(--cap) 26%, var(--border));
            }

            .stage.split .stage-body {
                display: grid;
                grid-template-columns: minmax(0, var(--split, 1fr)) minmax(
                        0,
                        1fr
                    );
                align-items: stretch;
            }
            .stage.split .pane {
                position: relative;
                min-width: 0;
                overflow-x: auto;
                overscroll-behavior-x: contain;
            }
            .stage.split .pane + .pane {
                border-left: 1px solid var(--border);
            }
            .stage-note {
                margin: 0;
                padding: 0.6rem 1rem;
                border-top: 1px solid var(--border);
                color: var(--muted);
                font-size: 0.85rem;
            }
            .stage.split .pane-out {
                background: color-mix(in oklab, var(--pane-bg) 88%, #000);
            }
            .stage.split .pane-out .ln {
                background: color-mix(in oklab, var(--pane-bg) 88%, #000);
            }
            @media (max-width: 900px) {
                .stage.split .stage-body {
                    grid-template-columns: minmax(0, 1fr);
                    /* The shared cell is as tall as the tallest panel; the output pane absorbs the rest. */
                    grid-template-rows: auto 1fr;
                }
                .stage.split .pane + .pane {
                    border-left: 0;
                    border-top: 1px solid var(--border);
                }
            }
            @media (max-width: 640px) {
                .stage-head {
                    flex-wrap: wrap;
                    gap: 0.4rem;
                }
                .stage-foot {
                    gap: 0.4rem;
                }
                /* Stacked notes would reserve the tallest note's height on every tab; reflowing is better. */
                .foot-notes,
                .foot-methods {
                    display: block;
                }
                .foot-notes > .foot-note,
                .foot-methods > .foot-method {
                    display: none;
                }
                .foot-notes > .foot-note.is-on,
                .foot-methods > .foot-method.is-on {
                    display: block;
                }
                .fmt .foot-note {
                    text-align: left;
                }
            }
            .pane-label {
                position: sticky;
                left: 0;
                padding: 8px 12px 0;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 10.5px;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: oklch(0.55 0 0);
            }
            .pane-out .pane-label {
                color: color-mix(in oklch, var(--cap) 62%, oklch(0.62 0 0));
            }
            .pane-label + .code {
                padding-top: 7px;
            }

            .term {
                padding: 13px 14px;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: var(--code-size);
                line-height: var(--lh);
                font-variant-ligatures: none;
                font-feature-settings:
                    "calt" 0,
                    "liga" 0;
                color: oklch(0.86 0 0);
            }
            /* The caret aligns under the reported column; message lines wrap like a terminal's. */
            .tl {
                white-space: pre;
            }
            /* A wrapped message continues under its own text, not under the severity marker. */
            .tl.msg {
                white-space: pre-wrap;
                padding-left: 4ch;
                text-indent: -4ch;
            }
            .tl.gap {
                height: calc(var(--lh) * 1em);
            }
            .sh {
                color: color-mix(in oklch, var(--cap) 80%, oklch(0.7 0 0));
            }
            .derr {
                color: var(--d-err);
                font-weight: 600;
            }
            .dwarn {
                color: var(--d-warn);
                font-weight: 600;
            }
            .dmsg {
                color: oklch(0.93 0 0);
                font-weight: 550;
            }
            .darrow,
            .dgutter {
                color: var(--d-blue);
                font-weight: 600;
            }
            .dcaret-err {
                color: var(--d-err);
                font-weight: 600;
            }
            .dcaret-warn {
                color: var(--d-warn);
                font-weight: 600;
            }
            .dsum {
                color: oklch(0.7 0 0);
            }

            .fmt .cl.is-changed .ln {
                color: oklch(0.56 0 0);
            }
            .fmt .cl.is-changed::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 2px;
                z-index: 3;
            }
            .fmt .pane-src .cl.is-changed {
                background: color-mix(in oklch, var(--d-del) 7%, transparent);
            }
            .fmt .pane-src .cl.is-changed::before {
                background: color-mix(in oklch, var(--d-del) 70%, transparent);
            }
            .fmt .pane-out .cl.is-changed {
                background: color-mix(in oklch, var(--d-add) 7%, transparent);
            }
            .fmt .pane-out .cl.is-changed::before {
                background: color-mix(in oklch, var(--d-add) 70%, transparent);
            }
            .fmt .ln {
                background: transparent;
            }
            .fmt .pane-out {
                background: var(--pane-bg);
            }
            .fmt .pane-src {
                background: color-mix(in oklab, var(--pane-bg) 88%, #000);
            }
            .fmt .pane-out .cl {
                opacity: 1;
            }
            .fmt .stage.is-playing .pane-out .cl {
                animation: lineSettle 420ms cubic-bezier(0.22, 0.61, 0.36, 1)
                    both;
                animation-delay: calc(var(--i, 0) * 55ms);
            }
            @keyframes lineSettle {
                from {
                    opacity: 0;
                    transform: translateY(5px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            .fmt .stage.is-playing .pane-src .cl.is-changed {
                animation: delFade 420ms ease both;
            }
            @keyframes delFade {
                from {
                    background: color-mix(
                        in oklch,
                        var(--d-del) 26%,
                        transparent
                    );
                }
            }

            .stage {
                --code-size: 13px;
            }
            /* Split panes are half the frame, so their code sits one notch smaller. */
            .stage.split {
                --code-size: 12.5px;
            }
            @media (max-width: 1100px) {
                .stage {
                    --code-size: 12.5px;
                }
                .stage.split {
                    --code-size: 12px;
                }
                .ide-body {
                    min-height: 240px;
                }
            }
            @media (max-width: 640px) {
                .stage {
                    --code-size: 11.5px;
                }
                .stage.split {
                    --code-size: 11px;
                }
                .comp {
                    left: 0;
                }
                .hovercard {
                    left: 0;
                }
                .card-notch {
                    left: 14px;
                }
                .ide-body {
                    min-height: 214px;
                }
                .stage-head,
                .stage-foot {
                    font-size: 11px;
                }
                .peek-file {
                    width: 10ch;
                }
            }


            /* The runtime band: centered, taller, with a slow aura behind the stage. */
            #runtime.showband {
                padding-block: clamp(4.5rem, 9vw, 7.5rem);
            }
            #runtime .band-head {
                margin-inline: auto;
                text-align: center;
            }
            #runtime .lede {
                margin-inline: auto;
            }
            #runtime .showcase > .seg {
                justify-self: center;
            }
            #runtime::after {
                content: "";
                position: absolute;
                inset: 0;
                z-index: 0;
                pointer-events: none;
                background-image:
                    linear-gradient(oklch(1 0 0 / 0.05) 1px, transparent 1px),
                    linear-gradient(90deg, oklch(1 0 0 / 0.05) 1px, transparent 1px);
                background-size: 56px 56px;
                background-position: center top;
                -webkit-mask-image: radial-gradient(60% 55% at 50% 45%, #000 20%, transparent 75%);
                mask-image: radial-gradient(60% 55% at 50% 45%, #000 20%, transparent 75%);
            }
            #runtime .band-inner::before {
                content: "";
                position: absolute;
                inset: 30% 4% -6%;
                z-index: -1;
                pointer-events: none;
                background:
                    radial-gradient(45% 55% at 28% 50%, color-mix(in oklch, var(--cap-violet) 34%, transparent), transparent 70%),
                    radial-gradient(40% 55% at 74% 55%, color-mix(in oklch, oklch(0.68 0.16 255) 26%, transparent), transparent 70%);
                filter: blur(48px);
                animation: aura 16s ease-in-out infinite alternate;
            }
            @keyframes aura {
                from {
                    transform: translate3d(-2%, 0, 0) scale(1);
                }
                to {
                    transform: translate3d(2%, -3%, 0) scale(1.06);
                }
            }
            .stage-hero {
                --code-size: 14px;
                border-color: color-mix(in oklch, var(--cap) 10%, var(--border));
                box-shadow:
                    0 50px 120px -50px color-mix(in oklch, var(--cap) 50%, transparent),
                    0 30px 70px -50px oklch(0 0 0 / 0.9);
            }
            .stage-hero::before {
                content: "";
                position: absolute;
                top: 0;
                left: 12%;
                right: 12%;
                z-index: 3;
                height: 1px;
                background: linear-gradient(90deg, transparent, color-mix(in oklch, var(--cap) 80%, transparent), transparent);
            }
            .stage-hero .code {
                padding-block: 20px;
            }
            .stage-hero .term {
                padding: 20px 22px;
            }
            .stage-hero .stage-note {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.7rem 1.1rem;
                color: color-mix(in oklch, var(--cap) 55%, var(--foreground));
                background: color-mix(in oklch, var(--cap) 6%, transparent);
            }
            .stage-hero .stage-note::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--cap);
                box-shadow: 0 0 10px var(--cap);
            }
            @media (max-width: 1100px) {
                .stage-hero {
                    --code-size: 13px;
                }
            }
            @media (max-width: 640px) {
                .stage-hero {
                    --code-size: 11.5px;
                }
                .stage-hero .term {
                    padding: 14px;
                }
            }

            /* The untyped/typed toggle sits in the frame's header row, so the two views share one frame. */
            .checker {
                gap: 0;
            }
            .checker > .seg {
                grid-row: 1;
                grid-column: 1;
                justify-self: end;
                align-self: start;
                z-index: 3;
                margin: 4px 6px 0 0;
            }
            .checker > .stage {
                grid-row: 1;
            }
            .checker .stage-body {
                flex: 1;
            }
            /* On wide frames the feature tabs join the header row too, as the checker's toggle does. */
            @media (min-width: 1024px) {
                .ide {
                    gap: 0;
                }
                .ide > .seg {
                    grid-row: 1;
                    grid-column: 1;
                    justify-self: end;
                    align-self: start;
                    z-index: 3;
                    margin: 4px 6px 0 0;
                    padding: 2px;
                    border-radius: 8px;
                }
                .ide > .seg [role="tab"] {
                    font-size: 12px;
                    padding: 0.2rem 0.65rem;
                    border-radius: 6px;
                }
                .ide > .seg .seg-ind {
                    border-radius: 6px;
                }
                .ide > .stage {
                    grid-row: 1;
                }
            }
            .seg-mini {
                padding: 2px;
                border-radius: 8px;
            }
            .seg-mini [role="tab"] {
                font-size: 12px;
                padding: 0.2rem 0.65rem;
                border-radius: 6px;
            }
            .seg-mini .seg-ind {
                border-radius: 6px;
            }
            p.stage-foot {
                margin: 0;
            }
            .stage-foot a {
                flex: none;
                font-family: "Geist Sans", system-ui, sans-serif;
                font-size: 12.5px;
                color: oklch(0.86 0 0);
                text-decoration: underline;
                text-decoration-color: oklch(1 0 0 / 0.3);
                text-underline-offset: 3px;
            }
            .stage-foot a:hover {
                color: var(--foreground);
                text-decoration-color: currentColor;
            }
            .stage-foot > span {
                font-family: "Geist Sans", system-ui, sans-serif;
                font-size: 12.5px;
                line-height: 1.45;
                color: oklch(0.74 0 0);
            }
            .stage-foot code {
                font-family: "Geist Mono", ui-monospace, monospace;
                color: oklch(0.9 0 0);
            }

            /* Speedup over GNU R on one linear axis from zero, so the 1x tick shows where ry is slower. */
            /* Every panel shares one grid cell, so the table grows into the height the tallest code tab sets. */
            .bench-table {
                flex: 1;
                width: 100%;
                border-collapse: collapse;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: var(--code-size);
                font-variant-numeric: tabular-nums;
            }
            .bench-table th,
            .bench-table td {
                padding: 0.55rem 0.9rem;
                text-align: left;
                font-weight: 400;
                white-space: nowrap;
            }
            .bench-table thead th {
                padding-top: 1rem;
                color: var(--muted);
                font-size: 0.85em;
            }
            .bench-table tbody th {
                color: var(--foreground);
            }
            .bench-table td {
                color: var(--muted);
            }
            .bench-table .num {
                text-align: right;
            }
            .bench-table .bench-ratio {
                color: var(--foreground);
                font-weight: 500;
            }
            .bench-axis {
                position: relative;
                width: 100%;
            }
            .bench-tick {
                position: absolute;
                bottom: 0;
                padding-bottom: 0.55rem;
                left: calc(0.9rem + (100% - 1.8rem) * var(--one));
                transform: translateX(-50%);
            }
            .bench-table thead .bench-axis::before,
            .bench-table tbody .bench-axis::before {
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: calc(0.9rem + (100% - 1.8rem) * var(--one));
                z-index: 1;
                width: 1px;
                background: color-mix(in oklch, var(--foreground) 40%, transparent);
            }
            .bench-table thead .bench-axis::before {
                top: auto;
                height: 0.35rem;
            }
            /* The zero baseline, so the bars stand on something. */
            .bench-table tbody .bench-axis::after {
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0.9rem;
                width: 1px;
                background: color-mix(in oklch, var(--foreground) 18%, transparent);
            }
            .bench-table .is-slower .bench-bar {
                background: var(--muted);
                border-radius: 0;
            }
            .bench-table .is-slower .bench-ratio {
                color: var(--muted);
            }
            .bench-bar {
                display: block;
                width: calc(100% * var(--x));
                height: 10px;
                border-radius: 0 4px 4px 0;
                background: var(--cap);
                transform-origin: left;
            }
            .bench-foot {
                margin: auto 0 0;
                padding: 0.8rem 0.9rem 1rem;
                border-top: 1px solid var(--border);
                color: var(--muted);
                font-size: 13px;
            }
            .bench-foot a {
                white-space: nowrap;
                color: var(--foreground);
                text-decoration: underline;
                text-decoration-color: oklch(1 0 0 / 0.35);
                text-underline-offset: 3px;
            }
            .bench-foot a:hover {
                text-decoration-color: currentColor;
            }
            .reveal.is-waiting > .stage .bench-bar {
                transform: scaleX(0);
            }
            .reveal > .stage.is-entering .bench-bar {
                animation: barIn calc(var(--switch-duration) * 2) var(--switch-ease) both;
                animation-delay: calc(120ms + var(--k, 0) * 60ms);
            }
            @keyframes barIn {
                from {
                    transform: scaleX(0);
                }
            }
            @media (max-width: 640px) {
                .bench-table th,
                .bench-table td {
                    padding-inline: 0.45rem;
                }
                /* The code tabs make the shared cell tall on phones, and rows stretched that far stop reading as one chart. */
                .bench-table {
                    flex: none;
                }
                /* The bars need the width more than the times do, and the linked table has them. */
                .bench-table .bench-time {
                    display: none;
                }
                .bench-tick,
                .bench-table thead .bench-axis::before,
                .bench-table tbody .bench-axis::before {
                    left: calc(0.45rem + (100% - 0.9rem) * var(--one));
                }
                .bench-table tbody .bench-axis::after {
                    left: 0.45rem;
                }
            }

            /* The typing path: steps and their code on the left, the diagram beside them, so the marker moves next to the tab you click. */
            .path > .venn {
                margin: 0;
                max-width: none;
                container-type: inline-size;
            }
            .path > .seg-steps {
                flex-direction: column;
                flex-wrap: nowrap;
                width: 100%;
                padding: 6px;
            }
            .seg-steps [role="tab"] {
                display: flex;
                justify-content: space-between;
                gap: 1rem;
                width: 100%;
                align-items: center;
                padding: 1rem 1.1rem;
                font-size: 15px;
                text-align: left;
                white-space: normal;
            }
            /* The caption below names strict mode on step 4, so the diagram's own label would repeat it. */
            .path .v-strict {
                display: none;
            }
            .venn-foot {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 0.35rem;
                margin-top: 0.25rem;
            }
            .venn-dots {
                display: flex;
            }
            /* The bar is 4px tall, so the padding gives it a finger-sized hit area. */
            .venn-dot {
                width: 38px;
                height: 20px;
                padding: 8px 3px;
                border: 0;
                background: oklch(1 0 0 / 0.16);
                background-clip: content-box;
                border-radius: 4px;
                cursor: pointer;
                transition: background-color var(--switch-duration) var(--switch-ease);
            }
            .venn-dot:hover {
                background-color: oklch(1 0 0 / 0.3);
            }
            .venn-dot.is-on {
                background-color: color-mix(in oklch, var(--cap) 85%, white);
            }
            .venn-captions {
                display: grid;
                margin: 0;
                text-align: center;
                font-size: 15px;
                color: var(--foreground);
            }
            .venn-caption {
                grid-area: 1 / 1;
                opacity: 0;
                transform: translateY(6px);
                transition:
                    opacity var(--switch-duration) var(--switch-ease),
                    transform var(--switch-duration) var(--switch-ease);
            }
            .venn-caption.is-on {
                opacity: 1;
                transform: none;
            }
            @media (prefers-reduced-motion: reduce) {
                .venn-caption,
                .venn-dot {
                    transition: none;
                }
            }
            .step-where {
                flex: none;
                padding: 0.12rem 0.5rem;
                border-radius: 999px;
                font-family: "Geist Mono", ui-monospace, monospace;
                font-size: 11px;
                color: oklch(0.72 0 0);
                background: oklch(1 0 0 / 0.06);
                transition:
                    color var(--switch-duration) var(--switch-ease),
                    background var(--switch-duration) var(--switch-ease);
            }
            .visually-hidden {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip-path: inset(50%);
                white-space: nowrap;
            }
            [aria-selected="true"] > .step-where {
                color: color-mix(in oklch, var(--cap) 85%, white);
                background: color-mix(in oklch, var(--cap) 16%, transparent);
            }
            @media (min-width: 900px) {
                .path {
                    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                    column-gap: clamp(1.5rem, 3.5vw, 3rem);
                    row-gap: 1rem;
                }
                .path > .seg-steps {
                    grid-row: 1;
                    grid-column: 1;
                }
                .path .seg-steps [role="tab"] {
                    padding: 0.6rem 1rem;
                }
                .showcase.path > .stage {
                    grid-row: 2;
                    grid-column: 1;
                }
                .path > .venn {
                    grid-row: 1 / 3;
                    grid-column: 2;
                    align-self: center;
                }
                /* Half the frame is too narrow for code beside output, so the output sits below the code. */
                .path > .stage .stage-body {
                    grid-template-columns: minmax(0, 1fr);
                    grid-template-rows: auto 1fr;
                }
                .path > .stage .pane + .pane {
                    border-left: 0;
                    border-top: 1px solid var(--border);
                }
            }
            @media (max-width: 420px) {
                .seg-steps [role="tab"] {
                    font-size: 14px;
                    gap: 0.6rem;
                }
            }
            @media (max-width: 899px) {
                .path > .venn {
                    grid-row: 1;
                    width: 100%;
                    max-width: 520px;
                    margin: 0 auto;
                }
                .path > .seg-steps {
                    grid-row: 2;
                }
                .showcase.path > .stage {
                    grid-row: 3;
                }
            }

            /* The output waits until the code has landed, so the eye reads source first, then result. */
            .reveal.is-waiting > .stage .pane-src .cl,
            .reveal.is-waiting > .stage .tl {
                opacity: 0;
            }
            .reveal > .stage.is-entering .pane-src .cl {
                animation: lineIn var(--switch-duration) var(--switch-ease) both;
                animation-delay: calc(var(--i, 0) * 34ms);
            }
            .reveal > .stage.is-entering .tl {
                animation: lineIn var(--switch-duration) var(--switch-ease) both;
                animation-delay: calc(640ms + var(--j, 0) * 55ms);
            }
            .reveal > .stage.is-entering .tl-cmd {
                animation: typeIn 0.5s steps(24, end) 160ms both;
            }
            .showcase > .is-switching {
                animation: panelIn var(--switch-duration) var(--switch-ease) both;
            }
            @keyframes panelIn {
                from {
                    opacity: 0;
                }
            }
            @keyframes lineIn {
                from {
                    opacity: 0;
                    transform: translateY(6px);
                }
                to {
                    opacity: 1;
                    transform: none;
                }
            }
            @keyframes typeIn {
                from {
                    clip-path: inset(0 100% 0 0);
                }
                to {
                    clip-path: inset(0 0 0 0);
                }
            }


            .band-closer {
                position: relative;
                overflow: hidden;
                border-bottom: none;
                display: grid;
                grid-template-columns: minmax(0, 1fr);
                align-items: center;
                min-height: clamp(36rem, 92vh, 54rem);
            }
            #closer-canvas {
                position: absolute;
                inset: 0;
                z-index: 0;
                pointer-events: none;
            }
            .closer-scrim {
                position: absolute;
                inset: 0;
                z-index: 1;
                pointer-events: none;
                background: radial-gradient(
                    125% 115% at 50% 50%,
                    oklch(0.145 0 0 / 0.82) 0%,
                    oklch(0.145 0 0 / 0.58) 42%,
                    oklch(0.145 0 0 / 0.18) 74%,
                    oklch(0.145 0 0 / 0) 100%
                );
            }
            .closer-col {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: var(--prose);
                margin: 0 auto;
                /* Set by the closer parallax handler; never set under reduced motion. */
                transform: translateY(calc(var(--closer-parallax, 0) * 1px));
                will-change: transform;
            }
            .closer-col h2 {
                font-size: clamp(2.6rem, 6vw, 4.2rem);
                letter-spacing: -0.02em;
                line-height: 1.05;
            }
            .closer-col .cta-cluster {
                margin-top: 1.75rem;
            }

            .footer {
                padding: 2.4rem clamp(1.2rem, 5vw, 2.5rem);
                background: var(--background);
                border-top: 1px solid var(--border);
            }
            .footer-inner {
                max-width: var(--frame);
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1.2rem;
                flex-wrap: wrap;
            }
            .footer-meta {
                display: inline-flex;
                align-items: center;
                gap: 0.7rem;
            }
            .footer-copy {
                font-size: 0.84rem;
                color: var(--muted);
            }
            .footer-legal {
                font-size: 0.84rem;
                color: var(--muted);
                transition: color 0.15s ease;
            }
            .footer-legal:hover {
                color: var(--foreground);
            }

            @media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }
                .doclink span {
                    transition: none;
                }
                .seg-ind.is-ready,
                .step-where {
                    transition: none;
                }
                #runtime .band-inner::before,
                .reveal > .stage.is-entering .pane-src .cl,
                .reveal > .stage.is-entering .tl,
                .reveal > .stage.is-entering .bench-bar,
                .showcase > .is-switching,
                .caretbar,
                .ide[data-feature="rename"] [data-mark~="rename"]::after,
                .ide[data-feature="definition"] .cl[data-line="4"],
                .fmt .stage.is-playing .pane-out .cl,
                .fmt .stage.is-playing .pane-src .cl.is-changed {
                    animation: none !important;
                }
            }
        </style>
    </body>
</html>
