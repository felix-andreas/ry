const escapeHtml = (text: string) =>
    text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const KEYWORDS = new Set([
    "function", "if", "else", "for", "while", "in", "return", "match", "type",
    "TRUE", "FALSE", "NULL", "NA",
]);
const TYPE_NAMES = new Set([
    "double", "integer", "character", "logical", "Record", "Shape", "Hole",
]);

// A small R tokenizer that emits the same `t-*` classes as the captured editor mocks.
function highlightR(source: string): string {
    const token =
        /(#.*$)|("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*')|(\b\d+(?:\.\d+)?L?\b)|([:@][A-Z]\w*)|([A-Za-z_.][\w.]*)|(\s+)|(.)/gm;
    return source
        .split("\n")
        .map((line, index) => {
            let html = "";
            for (const match of line.matchAll(token)) {
                const [text, comment, string, number, tag, word] = match;
                const escaped = escapeHtml(text);
                let cls = "t-op";
                if (comment?.startsWith("#:")) {
                    // An annotation is code to read, not a remark to skip, so its types keep their colour.
                    for (const part of comment.split(/(\b[A-Za-z_]\w*\b)/)) {
                        if (part) html += `<span class="${TYPE_NAMES.has(part) ? "t-type" : "t-com"}">${escapeHtml(part)}</span>`;
                    }
                    continue;
                }
                if (comment) cls = "t-com";
                else if (string) cls = "t-str";
                else if (number) cls = "t-num";
                else if (tag) cls = "t-type";
                else if (word)
                    cls = KEYWORDS.has(word)
                        ? "t-kw"
                        : TYPE_NAMES.has(word)
                          ? "t-type"
                          : line.slice((match.index ?? 0) + text.length).startsWith("(")
                            ? "t-fn"
                            : "t-id";
                else if (/^\s+$/.test(text)) {
                    html += escaped;
                    continue;
                }
                html += `<span class="${cls}">${escaped}</span>`;
            }
            return `<div class="cl" style="--i:${index}"><span class="ln" aria-hidden="true">${index + 1}</span><span class="cx">${html}</span></div>`;
        })
        .join("\n");
}

// Colors raw `ry` output the way the terminal shows it. `--j` orders the lines for the reveal.
function terminal(command: string, output: string): string {
    const rows = output.split("\n");
    const lines = rows.map((line, index) => {
        const order = `style="--j:${index + 1}"`;
        const escaped = escapeHtml(line);
        if (line === "") return `<div class="tl gap"></div>`;
        if ((index === 0 || rows[index - 1] === "") && /^[a-z-]+$/.test(line)) {
            const severity = rows[index + 2]?.startsWith("  ! ") ? "dwarn" : "derr";
            return `<div class="tl" ${order}><span class="${severity}">${escaped}</span></div>`;
        }
        const message = line.match(/^  ([x!]) (.*)$/);
        if (message) {
            const severity = message[1] === "x" ? "derr" : "dwarn";
            return `<div class="tl msg" ${order}><span class="${severity}">  ${message[1]} </span><span class="dmsg">${escapeHtml(message[2])}</span></div>`;
        }
        if (/^ +--\[/.test(line)) return `<div class="tl" ${order}><span class="darrow">${escaped}</span></div>`;
        const gutter = line.match(/^( *\d* \|)(.*)$/);
        if (gutter) {
            const rest = gutter[2];
            const body = /^ *\^+$/.test(rest)
                ? rest.replace(/\^+/, (carets) => `<span class="dcaret-err">${carets}</span>`)
                : escapeHtml(rest);
            return `<div class="tl" ${order}><span class="dgutter">${escapeHtml(gutter[1])}</span>${body}</div>`;
        }
        if (line.startsWith("Error")) return `<div class="tl msg" ${order}><span class="derr">${escaped}</span></div>`;
        return `<div class="tl msg" ${order}>${escaped}</div>`;
    });
    return [`<div class="tl tl-cmd" style="--j:0"><span class="sh">$</span> ${escapeHtml(command)}</div>`, ...lines].join("\n");
}

