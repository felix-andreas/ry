// The same file twice: plain R with one bug, then that bug fixed and one `#:` annotation, which finds
// a second. Each mode shows one diagnostic, so the two outputs are the same height.
const checkerCode = `fee_rate <- function(region) {
  if (region == "north") 0.18 else 0.22
}

quote <- list(region = "north", amount = 1240.5)
fee <- quote$amount * fee_rate(quote$amount)
message("fee: " + fee)`;
const checkerModes = [
    {
        key: "untyped",
        label: "Untyped",
        code: checkerCode,
        output: `type-mismatch

  x expected a numeric value (\`integer\` or \`double\`), found \`character\`
   --[R/pricing.R:7:9]
 6 | fee <- quote$amount * fee_rate(quote$amount)
 7 | message("fee: " + fee)
   |         ^^^^^^^

1 problem in 1 file`,
        caption: "Plain R with no annotations: types are inferred, and the bug is found anyway.",
        link: { href: "/guides/checking", label: "Checking guide" },
    },
    {
        key: "typed",
        label: "Typed",
        code: `#: fn(region: character) -> double
${checkerCode.replace('message("fee: " + fee)', 'message("fee: ", fee)')}`,
        output: `type-mismatch

  x expected \`character\`, found \`double\`
   --[R/pricing.R:7:32]
 6 | quote <- list(region = "north", amount = 1240.5)
