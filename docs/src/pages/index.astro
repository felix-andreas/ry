            // Hero reveal: the first viewport shows only the pinned particle field;
            // scrolling through the tall stage slides the header in and parallaxes
            // the hero copy into place. Drives transform/opacity via CSS variables
            // from a single rAF-coalesced scroll handler — no layout reads per frame
            // beyond scrollY / innerHeight, no layout thrash.
            // ======================================================================
            initHero();
            document
                .querySelectorAll("[data-tabs]")
                .forEach((el) => setupShowcase(el as HTMLElement));
            initCloserMatrix();
            initCloserParallax();
            initNav();
