const markChanged = (html: string, changed: number[]) =>
    html
        .split("\n")
        .map((line, index) => (changed.includes(index + 1) ? line.replace('class="cl"', 'class="cl is-changed"') : line))
        .join("\n");

const year = new Date().getFullYear();
