<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            ry: editor support, error checking and formatting for R
        </title>
        <meta
            name="description"
            content="ry gives R completion and go-to-definition in your editor, catches mistakes before you run a script, and formats a whole project in one command. It includes the first static type checker for R. Type annotations are ordinary comments, so your code still runs anywhere."
        />
        <link rel="icon" href="/favicon.svg" />
        <script is:inline>
            // Set the reveal/static mode synchronously before first paint so the
            // hidden-until-scroll hero choreography never flashes its end state.
            (function () {
                var reduce =
                    window.matchMedia &&
                    window.matchMedia("(prefers-reduced-motion: reduce)")
                        .matches;
                document.documentElement.classList.add(
                    reduce ? "hero-static" : "hero-reveal",
                );
            })();
        </script>
    </head>
    <body>
        <header class="nav" id="nav">
            <a class="brand" href="/getting-started" aria-label="ry home">
                <img
                    class="logo"
                    src="/logo.svg"
                    alt=""
                    width="24"
                    height="24"
                />
            </a>
            <nav class="nav-links" aria-label="Primary">
                {
                    navLinks.map((l) => (
                        <a
                            href={l.href}
                            target={
                                l.href.startsWith("http") ? "_blank" : undefined
                            }
                            rel={
                                l.href.startsWith("http")
                                    ? "noreferrer"
                                    : undefined
                            }
                        >
                            {l.label}
                        </a>
                    ))
                }
                <a class="cta" href="/getting-started">Get started</a>
            </nav>
        </header>

        <main>
            <!-- ---------- hero ---------- -->
            <section id="hero">
                <div class="hero-viewport" id="hero-viewport">
