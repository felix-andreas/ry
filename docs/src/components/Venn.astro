---
// The positioning diagram, shared by the landing page and why-ry. Text uses currentColor, so it
// reads in light and dark themes; `id` keeps the aria ids unique per page.
interface Props {
    id: string;
}
const { id } = Astro.props;
---

<svg viewBox="0 0 660 400" role="img" aria-labelledby={`${id}-title ${id}-desc`} xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:660px;height:auto;font-family:inherit;color:inherit">
  <title id={`${id}-title`}>R, ry's additions, and strict mode</title>
  <desc id={`${id}-desc`}>Two overlapping circles. The left circle is R: untyped code, S4, R6 and eval run, with names checked but types unknown. The right circle is what ry adds: records, tagged unions, typed tables, the standard library and inline types, which need ry. The overlap is typed R written with #: comments, which is checked and also runs on GNU R. Both circles together are R++, everything ry runs. The right circle alone is strict mode, R--, where only typed code is allowed.</desc>
  <path d="M 70 50 V 40 H 590 V 50" stroke="currentColor" stroke-opacity="0.45" fill="none"/>
  <text x="330" y="30" text-anchor="middle" fill="currentColor" font-size="15" font-weight="600">R++: everything ry runs</text>
  <circle cx="245" cy="210" r="150" fill="#3b82f6" fill-opacity="0.16" stroke="#3b82f6" stroke-width="2"/>
  <circle cx="415" cy="210" r="150" fill="#a855f7" fill-opacity="0.16" stroke="#a855f7" stroke-width="2" stroke-dasharray="7 5"/>
  <g fill="currentColor" text-anchor="middle">
    <text x="175" y="165" font-size="22" font-weight="700">R</text>
    <text x="175" y="198" font-size="13">untyped code</text>
    <text x="175" y="217" font-size="13">S4, R6, eval</text>
    <text x="175" y="246" font-size="12" fill-opacity="0.7">types unknown</text>
    <text x="330" y="165" font-size="15" font-weight="700">typed R</text>
    <text x="330" y="198" font-size="13" font-family="ui-monospace, monospace">#: comments</text>
    <text x="330" y="246" font-size="12" fill-opacity="0.7">checked, and</text>
    <text x="330" y="262" font-size="12" fill-opacity="0.7">runs on GNU R</text>
    <text x="485" y="165" font-size="17" font-weight="700">ry additions</text>
    <text x="485" y="194" font-size="13">records</text>
    <text x="485" y="212" font-size="13">tagged unions</text>
    <text x="485" y="230" font-size="13">typed tables</text>
    <text x="485" y="248" font-size="13">stdlib, inline types</text>
    <text x="485" y="274" font-size="12" fill-opacity="0.7">needs ry</text>
  </g>
  <text x="485" y="385" text-anchor="middle" fill="currentColor" font-size="15" font-weight="600">strict mode (R--): only this circle</text>
</svg>
