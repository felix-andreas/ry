---
// One fact about how a results file was measured: the machine and GNU R version, or how many times
// each engine ran.
import { benchmarkFact } from '../lib/benchmarks';

interface Props {
	suite?: 'real' | 'kernels';
	field?: 'machine' | 'repeat';
}

const { suite = 'kernels', field = 'machine' } = Astro.props;
---

<span>{benchmarkFact(suite, field)}</span>
