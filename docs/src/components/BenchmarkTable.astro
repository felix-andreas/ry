---
// A suite's measurement as tables, one tab each for time, peak memory and test counts where the
// results hold them. The tabs share a sync key, so the reader's choice holds across suites.
import { TabItem, Tabs } from '@astrojs/starlight/components';
import { suite as findSuite, suiteMetadata, tableViews } from '../lib/benchmarks';

interface Props {
	suite: string;
}

const suite = findSuite(Astro.props.suite);
const views = suite?.results === undefined ? [] : tableViews(suite);
---

{
	views.length > 0 && suite !== undefined && (
		<>
			<Tabs syncKey="benchmark-metric">
				{views.map((view) => (
					<TabItem label={view.label}>
						<table>
							<thead>
								<tr>
									{view.columns.map((column, index) => (
										<th style={index > 0 ? 'text-align: right' : undefined}>{column}</th>
									))}
								</tr>
							</thead>
							<tbody>
								{view.rows.map((row) => (
									<tr>
										{row.map((cell, index) => (
											<td style={index > 0 ? 'text-align: right' : undefined}>{cell}</td>
										))}
									</tr>
								))}
							</tbody>
						</table>
						{view.note && <p>{view.note}</p>}
					</TabItem>
				))}
			</Tabs>
			<p>{suiteMetadata(suite)}</p>
		</>
	)
}
