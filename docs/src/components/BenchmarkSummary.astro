---
// One row per measured suite that compares ry with GNU R: what it is and ry's geometric-mean speed
// against GNU R, untyped and typed in strict mode. A suite measured against Rust gets a sentence
// under the table, because its ratio reads the other way. Each suite's measurement line follows.
import { measuredSuites, slowdownSummaries, suiteMetadata, summaryColumns, summaryNote, summaryRows } from '../lib/benchmarks';
---

<table>
	<thead>
		<tr>
			{summaryColumns.map((column, index) => <th style={index > 1 ? 'text-align: right' : undefined}>{column}</th>)}
		</tr>
	</thead>
	<tbody>
		{
			summaryRows().map((row) => (
				<tr>
					{row.map((cell, index) => <td style={index > 1 ? 'text-align: right' : undefined}>{cell}</td>)}
				</tr>
			))
		}
	</tbody>
</table>
<p>{summaryNote}</p>
{slowdownSummaries().map((sentence) => <p>{sentence}</p>)}
<ul>
	{
		measuredSuites().map((suite) => (
			<li>
				{suite.name}: {suiteMetadata(suite).replace(/^M/, 'm')}
			</li>
		))
	}
</ul>
