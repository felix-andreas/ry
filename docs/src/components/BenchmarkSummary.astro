---
// One row per measured suite: what it is and ry's geometric-mean speed against GNU R, untyped and
// typed in strict mode, with each suite's measurement line under the table.
import { measuredSuites, suiteMetadata, summaryColumns, summaryNote, summaryRows } from '../lib/benchmarks';
---

<table>
	<thead>
		<tr>
			{summaryColumns.map((column, index) => <th style={index > 1 ? 'text-align: right' : undefined}>{column}</th>)}
		</tr>
	</thead>
	<tbody>
		{
			summaryRows().map((row) => (
				<tr>
					{row.map((cell, index) => <td style={index > 1 ? 'text-align: right' : undefined}>{cell}</td>)}
				</tr>
			))
		}
	</tbody>
</table>
<p>{summaryNote}</p>
<ul>
	{
		measuredSuites().map((suite) => (
			<li>
				{suite.name}: {suiteMetadata(suite).replace(/^M/, 'm')}
			</li>
		))
	}
</ul>
