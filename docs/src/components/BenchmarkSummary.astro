---
// The two untyped benchmarks side by side: what each measures and ry's geometric-mean speed against GNU R.
import { benchmarkSummaryColumns, benchmarkSummaryRows } from '../lib/benchmarks';
---

<table>
	<thead>
		<tr>
			{benchmarkSummaryColumns.map((column, index) => <th style={index > 1 ? 'text-align: right' : undefined}>{column}</th>)}
		</tr>
	</thead>
	<tbody>
		{
			benchmarkSummaryRows().map((row) => (
				<tr>
					{row.map((cell, index) => <td style={index > 1 ? 'text-align: right' : undefined}>{cell}</td>)}
				</tr>
			))
		}
	</tbody>
</table>
