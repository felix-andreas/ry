---
// One row per suite: what it is and ry's geometric-mean speed against GNU R, untyped and typed.
import { benchmarkSummaryColumns, benchmarkSummaryNote, benchmarkSummaryRows, suiteMetadata } from '../lib/benchmarks';
---

<table>
	<thead>
		<tr>
			{benchmarkSummaryColumns.map((column, index) => <th style={index > 1 ? 'text-align: right' : undefined}>{column}</th>)}
		</tr>
	</thead>
	<tbody>
		{
			benchmarkSummaryRows().map((row) => (
				<tr>
					{row.map((cell, index) => <td style={index > 1 ? 'text-align: right' : undefined}>{cell}</td>)}
				</tr>
			))
		}
	</tbody>
</table>
<p>{benchmarkSummaryNote}</p>
<ul>
	<li>Numeric kernels {suiteMetadata('kernels').replace(/^M/, 'm')}</li>
	<li>Application workloads {suiteMetadata('real').replace(/^M/, 'm')}</li>
</ul>
