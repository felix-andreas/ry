---
// The application-style workloads from tools/bench/real/results.json with their geometric mean.
import { formatRatio, realGeomean, realGeomeanNoJit, realWorkloadRows, seconds, suiteMetadata } from '../lib/benchmarks';

const rows = realWorkloadRows();
const time = seconds;
const columns = ['workload', 'GNU R', 'ry, JIT on', 'ry, JIT off', 'speed-up, JIT on', 'speed-up, JIT off'];
---

<table>
	<thead>
		<tr>{columns.map((column, index) => <th style={index > 0 ? 'text-align: right' : undefined}>{column}</th>)}</tr>
	</thead>
	<tbody>
		{
			rows.map((row) => (
				<tr>
					<td><code>{row.workload}</code>{row.tooShort && ' (too short)'}</td>
					<td style="text-align: right">{time(row.gnuR)}</td>
					<td style="text-align: right">{time(row.ryJit)}</td>
					<td style="text-align: right">{time(row.ryNoJit)}</td>
					<td style="text-align: right">{formatRatio(row.gnuR / row.ryJit)}</td>
					<td style="text-align: right">{formatRatio(row.gnuR / row.ryNoJit)}</td>
				</tr>
			))
		}
		<tr>
			<td>geometric mean</td>
			<td></td><td></td><td></td>
			<td style="text-align: right">{formatRatio(realGeomean)}</td>
			<td style="text-align: right">{formatRatio(realGeomeanNoJit)}</td>
		</tr>
	</tbody>
</table>
<p>{suiteMetadata('real')}</p>
