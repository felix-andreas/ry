---
// A horizontal bar chart of a suite's speed relative to GNU R, rendered to static HTML at build time.
// The axis is logarithmic and centred on 1x, so a bar to the right means faster than GNU R and a bar
// to the left slower, and 10x either way has the same length. A thin line across a bar spans its
// interval. Values sit in their own columns beside the bars, so they stay legible on a phone, and
// every bar's title gives the seconds behind it. A suite with groups gets one chart per group.
import { engineLabel, formatRatio, suite as findSuite, suiteCharts } from '../lib/benchmarks';

interface Props {
	suite: string;
}

const suite = findSuite(Astro.props.suite);
const charts = suite?.results === undefined ? [] : suiteCharts(suite);
// Color follows the engine, so ry is the same blue in every chart.
const engineColors: Record<string, number> = { ry: 0, ry_typed: 1 };
const color = (engine: string, index: number) => engineColors[engine] ?? index % 3;

function axis(values: number[]) {
	const low = Math.min(1, ...values);
	const high = Math.max(1, ...values);
	// The axis spans the data with a little room at both ends. Ticks fall on decades when the data
	// spans more than one, otherwise on halvings and doublings around 1x.
	const minimum = Math.log(low / 1.25);
	const span = Math.log(high * 1.25) - minimum;
	const base = high / low > 16 ? 10 : 2;
	const ticks: number[] = [];
	for (let exponent = Math.ceil(minimum / Math.log(base)); base ** exponent <= high * 1.25; exponent++) ticks.push(base ** exponent);
	const position = (value: number) => ((Math.log(value) - minimum) / span) * 100;
	return { ticks, position, one: position(1) };
}
const tickLabel = (value: number) => (value >= 1 ? `${value}x` : `${Number(value.toPrecision(2))}x`);
---

{
	charts.map((chart) => {
		const values = chart.rows.flatMap((row) => row.bars.flatMap((bar) => (bar.ratio === undefined ? [] : [bar.ratio.median, bar.ratio.low ?? bar.ratio.median, bar.ratio.high ?? bar.ratio.median])));
		const { ticks, position, one } = axis(values);
		return (
			<figure class="speed-chart not-content" style={`--series-count: ${chart.engines.length}`}>
				<figcaption>{chart.caption}</figcaption>
				{chart.engines.length > 1 && (
					<ul class="legend">
						{chart.engines.map((engine, index) => (
							<li>
								<span class={`swatch series-${color(engine, index)}`} aria-hidden="true" />
								{engineLabel(engine)}
							</li>
						))}
					</ul>
				)}
				<div class="rows">
					{chart.engines.length > 1 && (
						<div class="row heading" aria-hidden="true">
							<span class="label" />
							<span />
							{chart.engines.map((engine, index) => (
								<span class="value">
									<span class={`swatch series-${color(engine, index)}`} />
								</span>
							))}
						</div>
					)}
					{chart.rows.map((row) => (
						<div class:list={['row', { summary: row.summary }]}>
							<span class="label">
								{row.id === undefined && row.href !== undefined ? (
									<a class="name" href={row.href}>
										{row.label}
									</a>
								) : (
									<span class="name">{row.label}</span>
								)}
								{row.id !== undefined &&
									(row.href === undefined ? (
										<code class="hint">{row.id}</code>
									) : (
										<a class="hint" href={row.href}>
											<code>{row.id}</code>
										</a>
									))}
								{row.flags.map((flag) => (
									<span class="flag">{flag}</span>
								))}
							</span>
							<div class="track" aria-hidden="true">
								{ticks.map((tick) => (
									<span class:list={['grid', { one: tick === 1 }]} style={`left: ${position(tick)}%`} />
								))}
								{row.bars.map((bar, index) => {
									if (bar.ratio === undefined) return null;
									const at = position(bar.ratio.median);
									const style = `--index: ${index}`;
									return [
										<span
											class:list={['bar', `series-${color(bar.engine, index)}`, bar.ratio.median >= 1 ? 'faster' : 'slower', { faded: bar.faded }]}
											style={`left: ${Math.min(at, one)}%; width: ${Math.abs(at - one)}%; ${style}`}
											title={bar.title}
										/>,
										bar.ratio.low !== undefined && bar.ratio.high !== undefined && (
											<span
												class="whisker"
												style={`left: ${position(bar.ratio.low)}%; width: ${position(bar.ratio.high) - position(bar.ratio.low)}%; ${style}`}
											/>
										),
									];
								})}
							</div>
							{row.bars.map((bar) => (
								<span class:list={['value', { faded: bar.faded }]}>
									<span class="sr-only">{engineLabel(bar.engine)}: </span>
									{bar.ratio === undefined ? 'n/a' : formatRatio(bar.ratio.median)}
								</span>
							))}
						</div>
					))}
					<div class="row axis" aria-hidden="true">
						<span class="label" />
						<div class="track">
							{ticks.map((tick) => (
								<span class="tick" style={`left: ${position(tick)}%`}>
									{tickLabel(tick)}
								</span>
							))}
						</div>
					</div>
				</div>
				<p class="note">
					Speed relative to GNU R on a log scale: a bar to the right of 1x is faster than GNU R, to the left slower.
					{values.length > 0 && chart.rows.some((row) => row.bars.some((bar) => bar.ratio?.low !== undefined)) && ' The line across a bar spans its 95% interval.'}
					{chart.notes.map((note) => ` ${note}`)}
				</p>
				<p class="note">{chart.metadata}</p>
			</figure>
		);
	})
}

<style>
	.speed-chart {
		--series-0: #2a78d6;
		--series-1: #eb6834;
		--series-2: #1f9e89;
		--ink: var(--sl-color-white);
		--ink-muted: var(--sl-color-gray-3);
		--rule: var(--sl-color-gray-6);
		--bar: 9px;
		margin-block: 1.5rem;
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
	}
	:global(:root[data-theme='dark']) .speed-chart {
		--series-0: #3987e5;
		--series-1: #d95926;
		--series-2: #25a58c;
	}
	.speed-chart[style*='--series-count: 1'] {
		--bar: 14px;
	}
	figcaption {
		color: var(--ink);
		font-weight: 600;
		margin-bottom: 0.5rem;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		list-style: none;
		margin: 0 0 0.5rem;
		padding: 0;
		color: var(--ink-muted);
	}
	.legend li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.swatch {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 3px;
	}
	.series-0 {
		background: var(--series-0);
	}
	.series-1 {
		background: var(--series-1);
	}
	.series-2 {
		background: var(--series-2);
	}
	.row {
		display: grid;
		grid-template-columns: minmax(7rem, 12rem) 1fr repeat(var(--series-count), 3.6rem);
		align-items: center;
		column-gap: 0.75rem;
		min-height: calc(var(--series-count) * (var(--bar) + 2px) + 0.6rem);
		padding-block: 0.15rem;
	}
	.row.summary {
		border-top: 1px solid var(--rule);
		margin-top: 0.25rem;
		padding-top: 0.35rem;
		font-weight: 600;
		color: var(--ink);
	}
	.label {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.25;
	}
	.label > * {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.label .name {
		white-space: normal;
	}
	.label .hint,
	.label .hint code {
		font-size: 0.75rem;
		color: var(--ink-muted);
		background: none;
		padding: 0;
		border: 0;
	}
	.label a.hint {
		text-decoration: none;
	}
	.label a.hint:hover code {
		color: var(--sl-color-text-accent);
		text-decoration: underline;
	}
	.label .flag {
		font-size: 0.75rem;
		color: var(--ink-muted);
		font-style: italic;
	}
	.track {
		position: relative;
		align-self: stretch;
	}
	.grid {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--rule);
	}
	.grid.one {
		width: 2px;
		margin-left: -0.5px;
		background: var(--ink-muted);
	}
	.bar,
	.whisker {
		position: absolute;
		top: calc(50% - var(--series-count) * (var(--bar) + 2px) / 2 + var(--index) * (var(--bar) + 2px));
	}
	.bar {
		height: var(--bar);
		min-width: 2px;
	}
	.bar.faster {
		border-radius: 0 4px 4px 0;
	}
	.bar.slower {
		border-radius: 4px 0 0 4px;
	}
	.bar.faded {
		opacity: 0.35;
	}
	.whisker {
		height: 2px;
		margin-top: calc(var(--bar) / 2 - 1px);
		background: var(--ink);
		opacity: 0.7;
	}
	.value {
		text-align: right;
		white-space: nowrap;
		color: var(--ink);
	}
	.value.faded {
		color: var(--ink-muted);
	}
	.row.heading {
		min-height: 1rem;
	}
	.row.heading .swatch {
		display: inline-block;
	}
	.row.axis {
		min-height: 1.5rem;
	}
	.tick {
		position: absolute;
		top: 0.2rem;
		transform: translateX(-50%);
		color: var(--ink-muted);
		font-size: var(--sl-text-xs);
		white-space: nowrap;
	}
	.note {
		margin-top: 0.25rem;
		color: var(--ink-muted);
		font-size: var(--sl-text-xs);
	}
	@media (max-width: 40rem) {
		.speed-chart {
			font-size: var(--sl-text-xs);
		}
		.row {
			grid-template-columns: 7rem 1fr repeat(var(--series-count), 2.6rem);
			column-gap: 0.4rem;
		}
	}
	@media (forced-colors: active) {
		.bar {
			background: CanvasText;
		}
	}
</style>
