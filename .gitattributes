# Check every text file out with LF endings on every platform. ry embeds R sources with
# include_str!, and GNU R's parse(text = ) rejects a carriage return, so a CRLF checkout on
# Windows would break the embedded loader and drivers.
* text=auto eol=lf

# Files committed with CRLF endings, kept byte for byte so the rule above does not rewrite them.
crates/oracle/cases/io__write_table.expected -text
.vscode/settings.json -text
.vscode/tasks.json -text
editors/code/tsconfig.json -text
tools/research/data/*.csv -text

# The knowledge base is mostly appended to, by many sessions at once, so two branches that each add
# a line at the end of one section would otherwise conflict on every merge. A union merge keeps the
# lines of both sides. Where both sides rewrote the same line, both versions survive and the next
# memory pass prunes the stale one. GitHub's own merge button ignores this; a local `git merge` or
# `git rebase` applies it.
.agents/memory/*.md merge=union
