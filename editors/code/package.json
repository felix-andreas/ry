{
	"name": "ry",
	"displayName": "ry",
	"description": "R language support",
	"author": "Felix Andreas",
	"version": "0.4.0",
	"publisher": "felix-andreas",
	"license": "UPL-1.0",
	"homepage": "https://ry-lang.org",
	"repository": {
		"type": "git",
		"url": "https://github.com/felix-andreas/ry"
	},
	"bugs": {
		"url": "https://github.com/felix-andreas/ry/issues"
	},
	"icon": "images/icon.png",
	"keywords": [
		"r",
		"language server",
		"formatting",
		"linting",
		"debugger"
	],
	"categories": [
		"Formatters",
		"Linters",
		"Programming Languages",
		"Debuggers"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"scripts": {
		"vscode:prepublish": "bun run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"package": "vsce package",
		"vsce": "vsce"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@types/node": "^20.19.8",
		"@types/vscode": "^1.75.1",
		"@vscode/vsce": "^3.6.0",
		"eslint": "^9.31.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.37.0"
	},
	"main": "./out/extension",
	"activationEvents": [
		"onLanguage:r",
		"workspaceContains:*.r",
		"workspaceContains:*.R",
		"onDebugResolve:ry",
		"onDebugDynamicConfigurations:ry"
	],
	"contributes": {
		"languages": [
			{
				"id": "ry-type",
				"aliases": [
					"ry type notation"
				]
			},
			{
				"id": "r",
				"aliases": [
					"R",
					"r"
				],
				"extensions": [
					".R",
					".r",
					".Rprofile",
					".rprofile"
				],
				"filenames": [
					"NAMESPACE"
				],
				"configuration": "language-configuration.json"
			}
		],
		"grammars": [
			{
				"scopeName": "ry.type-annotation.injection",
				"path": "./r-annotation.tmLanguage.json",
				"injectTo": [
					"source.r"
				]
			},
			{
				"language": "ry-type",
				"scopeName": "source.ry-type",
				"path": "./ry-type.tmLanguage.json"
			}
		],
		"commands": [
			{
				"title": "ry: Restart Server",
				"command": "ry.restartServer"
			},
			{
				"title": "ry: Start Server",
				"command": "ry.startServer"
			},
			{
				"title": "ry: Stop Server",
				"command": "ry.stopServer"
			},
			{
				"title": "ry: Open Logs",
				"command": "ry.openLogs"
			},
			{
				"title": "Run File",
				"category": "ry",
				"command": "ry.runFile",
				"icon": "$(play)"
			},
			{
				"title": "Run Test",
				"category": "ry",
				"command": "ry.runTest"
			},
			{
				"title": "Debug Test",
				"category": "ry",
				"command": "ry.debugTest"
			},
			{
				"title": "Show References",
				"category": "ry",
				"command": "ry.showReferences"
			},
			{
				"title": "Open Console",
				"category": "ry",
				"command": "ry.openConsole"
			},
			{
				"title": "Send Selection or Line to Console",
				"category": "ry",
				"command": "ry.sendSelection"
			},
			{
				"title": "Send Function to Console",
				"category": "ry",
				"command": "ry.sendFunction"
			},
			{
				"title": "Source File in Console",
				"category": "ry",
				"command": "ry.sourceFile"
			}
		],
		"configuration": {
			"type": "object",
			"title": "ry",
			"properties": {
				"ry.path": {
					"scope": "resource",
					"type": [
						"null",
						"string"
					],
					"format": "path",
					"markdownDescription": "Location of the `ry` executable, e.g., `\"/path/to/ry\"`.",
					"default": null
				},
				"ry.args": {
					"scope": "resource",
					"type": [
						"null",
						"array"
					],
					"items": {
						"type": "string"
					},
					"markdownDescription": "Arguments passed to the `ry` executable.",
					"default": null
				},
				"ry.experimentalFeatures": {
					"scope": "resource",
					"type": [
						"null",
						"array"
					],
					"items": {
						"type": "string"
					},
					"markdownDescription": "Enable experimental features.",
					"default": null
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "ry.runTest",
					"when": "false"
				},
				{
					"command": "ry.debugTest",
					"when": "false"
				},
				{
					"command": "ry.showReferences",
					"when": "false"
				},
				{
					"command": "ry.runFile",
					"when": "editorLangId == r"
				},
				{
					"command": "ry.sendSelection",
					"when": "editorLangId == r"
				},
				{
					"command": "ry.sendFunction",
					"when": "editorLangId == r"
				},
				{
					"command": "ry.sourceFile",
					"when": "editorLangId == r"
				}
			],
			"editor/title/run": [
				{
					"command": "ry.runFile",
					"when": "resourceLangId == r",
					"group": "navigation"
				}
			]
		},
		"keybindings": [
			{
				"command": "ry.sendSelection",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorTextFocus && editorLangId == r"
			},
			{
				"command": "ry.sendFunction",
				"key": "ctrl+alt+f",
				"mac": "cmd+alt+f",
				"when": "editorTextFocus && editorLangId == r"
			}
		],
		"breakpoints": [
			{
				"language": "r"
			}
		],
		"debuggers": [
			{
				"type": "ry",
				"label": "ry",
				"languages": [
					"r"
				],
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": "string",
								"description": "The R script to debug.",
								"default": "${file}"
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Arguments the script reads with `commandArgs(trailingOnly = TRUE)`.",
								"default": []
							},
							"cwd": {
								"type": "string",
								"description": "The working directory of the program. Defaults to the workspace folder.",
								"default": "${workspaceFolder}"
							},
							"stopOnEntry": {
								"type": "boolean",
								"description": "Stop at the program's first statement.",
								"default": false
							},
							"prelude": {
								"type": "string",
								"description": "R code to run before the program, without stopping in it, such as `load_all(\".\")`."
							},
							"testName": {
								"type": "string",
								"description": "Run only the top-level `test_that` call with this description."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "ry",
						"request": "launch",
						"name": "Debug R file",
						"program": "${file}"
					}
				],
				"configurationSnippets": [
					{
						"label": "ry: Debug R file",
						"description": "Debug the active R file on ry's runtime",
						"body": {
							"type": "ry",
							"request": "launch",
							"name": "Debug R file",
							"program": "^\"\\${file}\""
						}
					},
					{
						"label": "ry: Debug package tests",
						"description": "Load the package, then debug a test file",
						"body": {
							"type": "ry",
							"request": "launch",
							"name": "Debug tests",
							"program": "^\"\\${file}\"",
							"prelude": "load_all(\".\"); library(testthat)"
						}
					}
				]
			}
		]
	}
}
