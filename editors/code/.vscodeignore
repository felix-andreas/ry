# ignore everything
*
*/**

# allow what we need
!README.md
!LICENSE
!language-configuration.json
!r-annotation.tmLanguage.json
!ry-type.tmLanguage.json
!out/*.js
# ry looks for its runtime and ry-rcmd beside itself
!bin/ry
!bin/ry.exe
!bin/libR.so
!bin/libR.dylib
!bin/R.dll
!bin/ry-rcmd
!bin/ry-rcmd.exe
!images/icon.png
# allow js
node_modules/**
!node_modules/vscode-jsonrpc/**
!node_modules/vscode-languageclient/**
!node_modules/vscode-languageserver-protocol/**
!node_modules/vscode-languageserver-types/**
!node_modules/{minimatch,brace-expansion,concat-map,balanced-match}/**
!node_modules/{semver,lru-cache,yallist}/**
