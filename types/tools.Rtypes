# tools: utilities shipped with R.
toTitleCase : @pure fn(text: character[]) -> character[]
file_ext : @pure fn(x: character[]) -> character[]
file_path_sans_ext : @pure fn(x: character[], [compression]: logical) -> character[]
# `bytes` arrived in R 4.5, so `md5sum(bytes = s)` hashes a raw vector without a file.
md5sum : fn([files]: character[], [bytes]: raw[]) -> character[named]
