# Standard-library stubs: grDevices package.
#
# Declaration-only stub file (`.Rtypes`); see base.Rtypes for the format and the shared compromise
# vocabulary. NOT YET LOADED: adding this file to the shipped corpus requires a two-line entry in
# `SHIPPED_STUBS` (`stdlib.rs`) plus its snapshot registration — noted for the lead.

# File devices: closed formal sets, NULL return (the device is opened as a side effect). Dimension and
# resolution arguments are Any-param (numeric literals).
png : fn([filename]: character, [width]: Any, [height]: Any, [units]: character, [pointsize]: Any, [bg]: Any, [res]: Any, [family]: Any, [type]: character, [antialias]: character, ...: Any) -> NULL
jpeg : fn([filename]: character, [width]: Any, [height]: Any, [units]: character, [pointsize]: Any, [quality]: Any, [bg]: Any, [res]: Any, [family]: Any, [type]: character, [antialias]: character, ...: Any) -> NULL
bmp : fn([filename]: character, [width]: Any, [height]: Any, [units]: character, [pointsize]: Any, [bg]: Any, [res]: Any, [family]: Any, [type]: character, [antialias]: character, ...: Any) -> NULL
tiff : fn([filename]: character, [width]: Any, [height]: Any, [units]: character, [pointsize]: Any, [compression]: character, [bg]: Any, [res]: Any, [family]: Any, [type]: character, [antialias]: character, ...: Any) -> NULL
svg : fn([filename]: character, [width]: Any, [height]: Any, [pointsize]: Any, [onefile]: logical, [family]: Any, [bg]: Any, [antialias]: character, [symbolfamily]: Any) -> NULL
pdf : fn([file]: Any, [width]: Any, [height]: Any, [onefile]: logical, [family]: Any, [title]: character, [fonts]: Any, [version]: character, [paper]: character, [encoding]: character, [bg]: Any, [fg]: Any, [pointsize]: Any, [compress]: logical, [pagecentre]: Any, [colormodel]: Any, [useDingbats]: Any, [useKerning]: Any, [fillOddEven]: Any) -> NULL
postscript : Any

# Device bookkeeping. `dev.off`/`dev.cur` return the (named) active-device number — a named integer
# the grammar cannot claim without losing the name, so `Any`; `graphics.off` genuinely returns NULL.
# `dev.new` forwards arbitrary device arguments by name.
dev.off : fn([which]: Any) -> Any
dev.cur : fn() -> Any
dev.set : fn([which]: Any) -> Any
dev.list : fn() -> Any
dev.new : Any
dev.copy : Any
dev.print : Any
graphics.off : fn() -> NULL

# Colors. The constructors genuinely return color strings; palette generators return one string per
# requested color. `colorRampPalette` returns a palette function — a precise higher-order signature.
rgb : fn(red: Any, [green]: Any, [blue]: Any, [alpha]: Any, [names]: Any, [maxColorValue]: Any) -> character
hsv : fn([h]: Any, [s]: Any, [v]: Any, [alpha]: Any) -> character
hcl : fn([h]: Any, [c]: Any, [l]: Any, [alpha]: Any, [fixup]: logical) -> character
gray : fn(level: Any, [alpha]: Any) -> character
grey : fn(level: Any, [alpha]: Any) -> character
adjustcolor : fn(col: Any, [alpha.f]: Any, [red.f]: Any, [green.f]: Any, [blue.f]: Any, [offset]: Any, [transform]: Any) -> character
gray.colors : fn(n: Any, [start]: Any, [end]: Any, [gamma]: Any, [alpha]: Any, [rev]: logical) -> character[]
grey.colors : fn(n: Any, [start]: Any, [end]: Any, [gamma]: Any, [alpha]: Any, [rev]: logical) -> character[]
rainbow : fn(n: Any, [s]: Any, [v]: Any, [start]: Any, [end]: Any, [alpha]: Any, [rev]: logical) -> character[]
heat.colors : fn(n: Any, [alpha]: Any, [rev]: logical) -> character[]
terrain.colors : fn(n: Any, [alpha]: Any, [rev]: logical) -> character[]
topo.colors : fn(n: Any, [alpha]: Any, [rev]: logical) -> character[]
cm.colors : fn(n: Any, [alpha]: Any, [rev]: logical) -> character[]
colors : fn([distinct]: logical) -> character[]
colours : fn([distinct]: logical) -> character[]
palette : fn([value]: Any) -> character[]
colorRampPalette : fn(colors: Any, ...: Any) -> fn(Any) -> character[]
col2rgb : Any
