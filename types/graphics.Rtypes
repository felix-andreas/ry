# Standard-library stubs: graphics package.
#
# Declaration-only stub file (`.Rtypes`); see base.Rtypes for the format and the shared compromise
# vocabulary. NOT YET LOADED: adding this file to the shipped corpus requires a two-line entry in
# `SHIPPED_STUBS` (`stdlib.rs`) plus its snapshot registration — noted for the lead.
#
# Nearly every plotting entry point forwards arbitrary graphical parameters (`col =`, `lwd =`,
# `main =`, any `par()` name) as named arguments. The checker never routes a named argument into a
# rest parameter, so a variadic function stub would falsely reject `plot(x, main = "t")`; until named
# arguments can be absorbed, these are `Any` values — the goal here is that ordinary plotting scripts
# RESOLVE with zero false errors, not precise signatures.
plot : Any
hist : Any
barplot : Any
boxplot : Any
pairs : Any
image : Any
contour : Any
curve : Any
matplot : Any
stripchart : Any
mosaicplot : Any
lines : Any
points : Any
abline : Any
segments : Any
arrows : Any
rect : Any
polygon : Any
text : fn(...: Any) -> NULL
mtext : Any
title : Any
legend : Any
axis : Any
box : Any
grid : Any
rug : Any
symbols : Any
par : Any
layout : Any
plot.window : Any
strwidth : Any
strheight : Any

# Fixed zero-argument frame starters genuinely return NULL.
plot.new : fn() -> NULL
frame : fn() -> NULL
