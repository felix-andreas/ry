# Standard-library stubs: stats package.
#
# Declaration-only stub file (`.Rtypes`); see base.Rtypes for the format and the shared compromise
# vocabulary (Any-param, scalar-claim, type-preserving, NULL-hybrid, named-formals).
#
# Summary statistics: numeric arguments are Any-param (no integer-to-double widening at parameter
# positions). `sd` is defined for vectors only, so its scalar double is genuine. `var`/`cor`/`cov`
# return a scalar for two vectors but a matrix for a single matrix argument — `cor(m)` is idiomatic —
# so without overload sets their returns stay `Any`. `median` preserves integer for odd-length integer
# input (type-preserving), so `double` would be falsely precise.
sd : @pure fn(x: Any, [na.rm]: logical) -> double
var : @pure fn(x: Any, [y]: Any, [na.rm]: logical, [use]: character) -> Any
cor : @pure fn(x: Any, [y]: Any, [use]: character, [method]: character) -> Any
cov : @pure fn(x: Any, [y]: Any, [use]: character, [method]: character) -> Any
median : @pure fn(x: Any, [na.rm]: logical, ...: Any) -> Any
weighted.mean : @pure fn(x: Any, [w]: Any, [na.rm]: logical, ...: Any) -> double
mad : @pure fn(x: Any, [center]: Any, [constant]: Any, [na.rm]: logical, [low]: logical, [high]: logical) -> double
IQR : @pure fn(x: Any, [na.rm]: logical, [type]: Any) -> double
# `quantile`'s second positional is `probs` (not `na.rm`). The default interpolating types always
# return double; types 1/3 can preserve integer input — a rare edge accepted for a precise default.
quantile : @pure fn(x: Any, [probs]: Any, [na.rm]: logical, [names]: logical, [type]: Any, [digits]: Any, ...: Any) -> double[]
fivenum : @pure fn(x: Any, [na.rm]: logical) -> double[]

# `setNames` returns its first argument with names attached: a genuine generic.
setNames : @pure <T> fn(object: list[T], nm: character[]) -> list[named: T]
setNames : <T> fn([object]: T, nm: Any) -> T

# NA handling. `na.omit` mirrors its input (type-preserving). `complete.cases` is one logical per row
# (scalar-claim).
na.omit : @pure fn(object: Any, ...: Any) -> Any
complete.cases : @pure fn(...: Any) -> logical

# Model fitting and prediction: the result is a model object whose shape depends on the formula and
# data, so results stay `Any` — but the fitters' subjects are checkable: the formula comes first
# positionally, `data`/`family` are real named formals, and every other keyword is absorbed by the
# rest parameter (R forwards them to the fitting method).
lm : fn(formula, [data]: Any, [subset]: Any, [weights]: Any, [na.action]: Any, ...: Any) -> Any
glm : fn(formula, [family]: Any, [data]: Any, [subset]: Any, [weights]: Any, [na.action]: Any, ...: Any) -> Any
nls : Any
loess : Any
aov : Any
anova : Any
predict : Any
residuals : Any
fitted : Any
coef : Any
confint : Any
formula : @pure Any
as.formula : @pure Any
aggregate : Any
optim : Any
optimize : Any
uniroot : fn(f: fn(double) -> double, [interval]: double[], ...: Any, [lower]: double, [upper]: double, [f.lower]: double, [f.upper]: double, [extendInt]: character, [check.conv]: logical, [tol]: double, [maxiter]: integer, [trace]: integer) -> list{root: double, f.root: double, iter: integer, init.it: integer, estim.prec: double}
integrate : Any
approx : Any
density : Any
ecdf : @pure Any
t.test : Any
wilcox.test : Any
chisq.test : Any
cor.test : Any
@type ts
ts : @pure fn([data]: Any, [start]: double[], [end]: double[], [frequency]: double, [deltat]: double, [ts.eps]: double, [class]: character, [names]: character[]) -> ts
lag : @pure fn(x: ts, [k]: integer) -> ts
approxfun : @pure fn(x: Any, [y]: Any, [method]: character, [yleft]: Any, [yright]: Any, [rule]: Any, [f]: double, [ties]: Any, [na.rm]: logical) -> fn(v: Any) -> double[]

# Random generation: a double vector of `n` draws (`rbinom`/`rpois` genuinely return integer draws).
# Distribution parameters are Any-param (numeric literals and vectorized parameters).
rnorm : fn(n: Any, [mean]: Any, [sd]: Any) -> double[]
runif : fn(n: Any, [min]: Any, [max]: Any) -> double[]
rexp : fn(n: Any, [rate]: Any) -> double[]
rlnorm : fn(n: Any, [meanlog]: Any, [sdlog]: Any) -> double[]
rgamma : fn(n: Any, shape: Any, [rate]: Any, [scale]: Any) -> double[]
rbeta : fn(n: Any, shape1: Any, shape2: Any, [ncp]: Any) -> double[]
rt : fn(n: Any, df: Any, [ncp]: Any) -> double[]
rchisq : fn(n: Any, df: Any, [ncp]: Any) -> double[]
rbinom : fn(n: Any, size: Any, prob: Any) -> integer[]
rpois : fn(n: Any, lambda: Any) -> integer[]

# Density / distribution / quantile functions: elementwise doubles over their first argument
# (scalar-claim would fight the vector idiom less, but these mirror the established `double[]` claim
# of the r-family; both directions are shape compromises until `T[]` generics land).
dnorm : @pure fn(x: Any, [mean]: Any, [sd]: Any, [log]: logical) -> double[]
pnorm : @pure fn(q: Any, [mean]: Any, [sd]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qnorm : @pure fn(p: Any, [mean]: Any, [sd]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dbinom : @pure fn(x: Any, size: Any, prob: Any, [log]: logical) -> double[]
pbinom : @pure fn(q: Any, size: Any, prob: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qbinom : @pure fn(p: Any, size: Any, prob: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dpois : @pure fn(x: Any, lambda: Any, [log]: logical) -> double[]
ppois : @pure fn(q: Any, lambda: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qpois : @pure fn(p: Any, lambda: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dunif : @pure fn(x: Any, [min]: Any, [max]: Any, [log]: logical) -> double[]
punif : @pure fn(q: Any, [min]: Any, [max]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qunif : @pure fn(p: Any, [min]: Any, [max]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dexp : @pure fn(x: Any, [rate]: Any, [log]: logical) -> double[]
pexp : @pure fn(q: Any, [rate]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qexp : @pure fn(p: Any, [rate]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dt : @pure fn(x: Any, df: Any, [ncp]: Any, [log]: logical) -> double[]
pt : @pure fn(q: Any, df: Any, [ncp]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qt : @pure fn(p: Any, df: Any, [ncp]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dchisq : @pure fn(x: Any, df: Any, [ncp]: Any, [log]: logical) -> double[]
pchisq : @pure fn(q: Any, df: Any, [ncp]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qchisq : @pure fn(p: Any, df: Any, [ncp]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
