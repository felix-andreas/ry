# Standard-library stubs: stats package.
#
# Declaration-only stub file (`.Rtypes`); see base.Rtypes for the format and the shared compromise
# vocabulary (Any-param, scalar-claim, type-preserving, NULL-hybrid, named-formals).
#
# Summary statistics: numeric arguments are Any-param (no integer-to-double widening at parameter
# positions). `sd` is defined for vectors only, so its scalar double is genuine. `var`/`cor`/`cov`
# return a scalar for two vectors but a matrix for a single matrix argument — `cor(m)` is idiomatic —
# so without overload sets their returns stay `Any`. `median` preserves integer for odd-length integer
# input (type-preserving), so `double` would be falsely precise.
sd : fn(x: Any, [na.rm]: logical) -> double
var : fn(x: Any, [y]: Any, [na.rm]: logical, [use]: character) -> Any
cor : fn(x: Any, [y]: Any, [use]: character, [method]: character) -> Any
cov : fn(x: Any, [y]: Any, [use]: character, [method]: character) -> Any
median : fn(x: Any, [na.rm]: logical, ...: Any) -> Any
weighted.mean : fn(x: Any, [w]: Any, [na.rm]: logical, ...: Any) -> double
mad : fn(x: Any, [center]: Any, [constant]: Any, [na.rm]: logical, [low]: logical, [high]: logical) -> double
IQR : fn(x: Any, [na.rm]: logical, [type]: Any) -> double
# `quantile`'s second positional is `probs` (not `na.rm`). The default interpolating types always
# return double; types 1/3 can preserve integer input — a rare edge accepted for a precise default.
quantile : fn(x: Any, [probs]: Any, [na.rm]: logical, [names]: logical, [type]: Any, [digits]: Any, ...: Any) -> double[]
fivenum : fn(x: Any, [na.rm]: logical) -> double[]

# `setNames` returns its first argument with names attached: a genuine generic.
setNames : <T> fn([object]: T, nm: Any) -> T

# NA handling. `na.omit` mirrors its input (type-preserving). `complete.cases` is one logical per row
# (scalar-claim).
na.omit : fn(object: Any, ...: Any) -> Any
complete.cases : fn(...: Any) -> logical

# Model fitting and prediction: the result is a model object whose shape depends on the formula and
# data, so results stay `Any` — but the fitters' subjects are checkable: the formula comes first
# positionally, `data`/`family` are real named formals, and every other keyword is absorbed by the
# rest parameter (R forwards them to the fitting method).
lm : fn(formula, [data]: Any, [subset]: Any, [weights]: Any, [na.action]: Any, ...: Any) -> Any
glm : fn(formula, [family]: Any, [data]: Any, [subset]: Any, [weights]: Any, [na.action]: Any, ...: Any) -> Any
nls : Any
loess : Any
aov : Any
anova : Any
predict : Any
residuals : Any
fitted : Any
coef : Any
confint : Any
formula : Any
as.formula : Any
aggregate : Any
optim : Any
optimize : Any
uniroot : Any
integrate : Any
approx : Any
density : Any
ecdf : Any
t.test : Any
wilcox.test : Any
chisq.test : Any
cor.test : Any
ts : Any

# Random generation: a double vector of `n` draws (`rbinom`/`rpois` genuinely return integer draws).
# Distribution parameters are Any-param (numeric literals and vectorized parameters).
rnorm : fn(n: Any, [mean]: Any, [sd]: Any) -> double[]
runif : fn(n: Any, [min]: Any, [max]: Any) -> double[]
rexp : fn(n: Any, [rate]: Any) -> double[]
rlnorm : fn(n: Any, [meanlog]: Any, [sdlog]: Any) -> double[]
rgamma : fn(n: Any, shape: Any, [rate]: Any, [scale]: Any) -> double[]
rbeta : fn(n: Any, shape1: Any, shape2: Any, [ncp]: Any) -> double[]
rt : fn(n: Any, df: Any, [ncp]: Any) -> double[]
rchisq : fn(n: Any, df: Any, [ncp]: Any) -> double[]
rbinom : fn(n: Any, size: Any, prob: Any) -> integer[]
rpois : fn(n: Any, lambda: Any) -> integer[]

# Density / distribution / quantile functions: elementwise doubles over their first argument
# (scalar-claim would fight the vector idiom less, but these mirror the established `double[]` claim
# of the r-family; both directions are shape compromises until `T[]` generics land).
dnorm : fn(x: Any, [mean]: Any, [sd]: Any, [log]: logical) -> double[]
pnorm : fn(q: Any, [mean]: Any, [sd]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qnorm : fn(p: Any, [mean]: Any, [sd]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dbinom : fn(x: Any, size: Any, prob: Any, [log]: logical) -> double[]
pbinom : fn(q: Any, size: Any, prob: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qbinom : fn(p: Any, size: Any, prob: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dpois : fn(x: Any, lambda: Any, [log]: logical) -> double[]
ppois : fn(q: Any, lambda: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qpois : fn(p: Any, lambda: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dunif : fn(x: Any, [min]: Any, [max]: Any, [log]: logical) -> double[]
punif : fn(q: Any, [min]: Any, [max]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qunif : fn(p: Any, [min]: Any, [max]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dexp : fn(x: Any, [rate]: Any, [log]: logical) -> double[]
pexp : fn(q: Any, [rate]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qexp : fn(p: Any, [rate]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dt : fn(x: Any, df: Any, [ncp]: Any, [log]: logical) -> double[]
pt : fn(q: Any, df: Any, [ncp]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qt : fn(p: Any, df: Any, [ncp]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
dchisq : fn(x: Any, df: Any, [ncp]: Any, [log]: logical) -> double[]
pchisq : fn(q: Any, df: Any, [ncp]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
qchisq : fn(p: Any, df: Any, [ncp]: Any, [lower.tail]: logical, [log.p]: logical) -> double[]
