# ry's standard library: the `Result`, `List`, `Str`, `Num`, `Bool`, `Dict` and `Set` modules.
#
# This file is the single source of truth for the library's signatures and documentation. The
# checker reads the declarations, hover and completion show the `#'` lines above each one, and
# `just docs-std` generates the API pages under `docs/src/content/docs/reference/std/` from it.
# A `#'` block directly above a `# Module` heading documents the module. An example is a fenced
# `r` block; `dput` after `r` means its `#>` lines are the `dput()` of the value.
#
# The functions run only on ry's runtime, which binds them in the `std` namespace
# (`crates/interp/src/standard_library.rs`). Conventions shared by every module:
# - The library works over ry's own types: numbers such as `I64` and `F64`, `Bool`, `Str`,
#   `List<T>`, `Dict<K, V>`, `Set<T>`, records, tuples and tags. R values enter through the
#   `from_r` functions (`Num.from_r`, `Bool.from_r`, `Str.from_r`, `List.from_r`) and leave
#   through `Num.to_r` and `List.to_r`.
# - A position or a length is an `I64`, and positions are 1-based.
# - A function that can fail returns a `Result` whose error is a descriptive tag.
# - Equality is structural, the same as `==` on ry values.

@alias Result<T, E> {:Ok(T) | :Err(E)}
@type List<T>
@type Dict<K, V>
@type Set<T>

#' A result is `:Ok(value)` or `:Err(error)`, typed `Result<T, E>`. The alias is built in, so every
#' annotation can use it.
# Result

#' Whether the result is `:Ok`.
#'
#' ```r dput
#' Result.is_ok(:Ok(1))
#' #> TRUE
#' ```
Result.is_ok : <T, E> fn(result: Result<T, E>) -> Bool

#' Whether the result is `:Err`.
#'
#' ```r dput
#' Result.is_err(:Ok(1))
#' #> FALSE
#' ```
Result.is_err : <T, E> fn(result: Result<T, E>) -> Bool

#' The `:Ok` value, or `default` for an `:Err`.
#'
#' ```r dput
#' Result.with_default(:Err(:Missing), 0)
#' #> 0
#' ```
Result.with_default : <T, E> fn(result: Result<T, E>, default: T) -> T

#' Applies `f` to an `:Ok` value and leaves an `:Err` alone.
#'
#' ```r dput
#' Result.map(:Ok(2), function(x) x * 10)
#' #> :Ok(20)
#' ```
Result.map : <A, B, E> fn(result: Result<A, E>, f: fn(A) -> B) -> Result<B, E>

#' Applies `f` to an `:Err` value and leaves an `:Ok` alone.
#'
#' ```r dput
#' Result.map_err(:Err("disk full"), function(e) :IoError(e))
#' #> :Err(:IoError("disk full"))
#' ```
Result.map_err : <T, A, B> fn(result: Result<T, A>, f: fn(A) -> B) -> Result<T, B>

#' Applies `on_ok` to an `:Ok` value or `on_err` to an `:Err` value.
#'
#' ```r dput
#' Result.map_both(:Err(404), function(x) x, function(code) Str.concat("HTTP ", Num.to_str(code)))
#' #> :Err("HTTP 404")
#' ```
Result.map_both : <A, B, C, D> fn(result: Result<A, B>, on_ok: fn(A) -> C, on_err: fn(B) -> D) -> Result<C, D>

#' Combines two `:Ok` values with `f`, or returns the first `:Err`.
#'
#' ```r dput
#' Result.map2(Str.to_i64("6"), Str.to_i64("7"), function(a, b) a * b)
#' #> :Ok(42i64)
#' ```
Result.map2 : <A, B, C, E, F> fn(first: Result<A, E>, second: Result<B, F>, f: fn(A, B) -> C) -> Result<C, E | F>

#' Chains a step that can fail: `f` gets the `:Ok` value and returns the next result. The error type
#' of the chain joins both, so a step can fail with a reason of its own.
#'
#' ```r dput
#' Result.and_then(Str.to_i64("-3"), function(n) if (n > 0) :Ok(n) else :Err(:NotPositive))
#' #> :Err(:NotPositive)
#' ```
Result.and_then : <A, B, E, F> fn(result: Result<A, E>, f: fn(A) -> Result<B, F>) -> Result<B, E | F>

#' Recovers from an `:Err`: `f` gets the error and returns the next result.
#'
#' ```r dput
#' Result.on_err(Str.to_i64("x"), function(e) :Ok(0))
#' #> :Ok(0)
#' ```
Result.on_err : <T, A, B> fn(result: Result<T, A>, f: fn(A) -> Result<T, B>) -> Result<T, B>

#' Functions over `List<T>`, ry's ordered sequence of values of one type. `[1, 2, 3]` builds a
#' list, and `List.from_r` converts an R vector or list. A function whose result items come from a
#' callback, such as `List.map`, requires them to be ry values (the
#' [`item` constraint](/reference/type-system/#constraints)), so `List.map([1, 2], \(x) list(x))` is
#' a type error.
# List

#' Converts an R vector or list into a `List`, checking every item: it refuses `NA`, a classed
#' object and a ragged list, and drops names. A `double` vector becomes a `List<F64>`, an
#' `integer` vector a `List<I32>`, a `logical` vector a `List<Bool>`, a `character` vector a
#' `List<Str>` and a `raw` vector a `List<U8>`.
#'
#' ```r dput
#' List.from_r(c(3, 1, 2))
#' #> [3, 1, 2]
#' ```
List.from_r : fn(vector: logical[]) -> List<Bool>
List.from_r : fn(vector: integer[]) -> List<I32>
List.from_r : fn(vector: double[]) -> List<F64>
List.from_r : fn(vector: character[]) -> List<Str>
List.from_r : fn(vector: raw[]) -> List<U8>
List.from_r : <T: item> fn(vector: list[T]) -> List<T>

#' Converts a `List` into the R vector it shares a representation with. A list of ry integers
#' becomes an `integer` vector when every item fits in 32 bits and a `double` vector otherwise. A
#' `List<F64>`, `List<Bool>` or `List<Str>` already passes to R code as a vector without this call.
#'
#' ```r dput
#' List.to_r([3i64, 1i64])
#' #> c(3L, 1L)
#' ```
List.to_r : fn(list: List<F64>) -> double[]
List.to_r : fn(list: List<Bool>) -> logical[]
List.to_r : fn(list: List<Str>) -> character[]
List.to_r : <T: int> fn(list: List<T>) -> integer[] | double[]
List.to_r : <T: item> fn(list: List<T>) -> list[T]

#' The number of elements.
#'
#' ```r dput
#' List.len(["a", "b"])
#' #> 2i64
#' ```
List.len : <T> fn(list: List<T>) -> I64

#' Whether the list has no elements.
#'
#' ```r dput
#' List.is_empty([])
#' #> TRUE
#' ```
List.is_empty : <T> fn(list: List<T>) -> Bool

#' The element at a 1-based position, or `:Err(:OutOfBounds)`.
#'
#' ```r dput
#' List.get(["a", "b"], 3)
#' #> :Err(:OutOfBounds)
#' ```
List.get : <T> fn(list: List<T>, index: I64) -> Result<T, :OutOfBounds>

#' Replaces the element at a position; a position out of range leaves the list unchanged.
#'
#' ```r dput
#' List.set(["a", "b"], 2, "z")
#' #> ["a", "z"]
#' ```
List.set : <T> fn(list: List<T>, index: I64, value: T) -> List<T>

#' Replaces the element at a position with `f` of it.
#'
#' ```r dput
#' List.update([1, 2], 1, function(x) x + 10)
#' #> [11, 2]
#' ```
List.update : <T> fn(list: List<T>, index: I64, f: fn(T) -> T) -> List<T>

#' Adds an element at the end.
#'
#' ```r dput
#' List.append([1, 2], 3)
#' #> [1, 2, 3]
#' ```
List.append : <T> fn(list: List<T>, value: T) -> List<T>

#' Adds an element at the start.
#'
#' ```r dput
#' List.prepend([1, 2], 0)
#' #> [0, 1, 2]
#' ```
List.prepend : <T> fn(list: List<T>, value: T) -> List<T>

#' The elements of `first` followed by those of `second`.
#'
#' ```r dput
#' List.concat([1], [2, 3])
#' #> [1, 2, 3]
#' ```
List.concat : <T> fn(first: List<T>, second: List<T>) -> List<T>

#' A list of one element.
#'
#' ```r dput
#' List.single("only")
#' #> ["only"]
#' ```
List.single : <T> fn(value: T) -> List<T>

#' A list of `count` copies of `value`.
#'
#' ```r dput
#' List.repeat("x", 3)
#' #> ["x", "x", "x"]
#' ```
List.repeat : <T> fn(value: T, count: I64) -> List<T>

#' The integers from `start` up to and including `end`, or an empty list when `end` is smaller.
#' Unlike R's `:`, it never counts down.
#'
#' Both `List.range` and `List.repeat` stop with an error when the list would hold more than
#' 2,147,483,647 elements, the longest vector an R integer index reaches.
#'
#' ```r dput
#' List.range(2, 5)
#' #> [2i64, 3i64, 4i64, 5i64]
#' List.range(3, 1)
#' #> []
#' ```
List.range : <T: int> fn(start: T, end: T) -> List<T>

#' The elements in reverse order.
#'
#' ```r dput
#' List.reverse([1, 2, 3])
#' #> [3, 2, 1]
#' ```
List.reverse : <T> fn(list: List<T>) -> List<T>

#' Concatenates a list of lists.
#'
#' ```r dput
#' List.join([[1], [], [2, 3]])
#' #> [1, 2, 3]
#' ```
List.join : <T> fn(lists: List<List<T>>) -> List<T>

#' Applies `f` to every element.
#'
#' ```r dput
#' List.map([1, 2, 3], function(x) x * 2)
#' #> [2, 4, 6]
#' ```
List.map : <A, B: item> fn(list: List<A>, f: fn(A) -> B) -> List<B>

#' Applies `f` to every element and its 1-based position.
#'
#' ```r dput
#' List.map_with_index(["a", "b"], function(x, i) Str.concat(x, Num.to_str(i)))
#' #> ["a1", "b2"]
#' ```
List.map_with_index : <A, B: item> fn(list: List<A>, f: fn(A, I64) -> B) -> List<B>

#' Applies `f` to the elements of two lists pairwise, stopping at the shorter one.
#'
#' ```r dput
#' List.map2([1, 2, 3], [10, 20], function(a, b) a + b)
#' #> [11, 22]
#' ```
List.map2 : <A, B, C: item> fn(first: List<A>, second: List<B>, f: fn(A, B) -> C) -> List<C>

#' Applies `f` to the elements at each position of three lists, up to the shortest one.
#'
#' ```r dput
#' List.map3([1, 2], [10, 20], [100, 200], function(a, b, c) a + b + c)
#' #> [111, 222]
#' ```
List.map3 : <A, B, C, D: item> fn(first: List<A>, second: List<B>, third: List<C>, f: fn(A, B, C) -> D) -> List<D>

#' Applies `f` to the elements at each position of four lists, up to the shortest one.
#'
#' ```r dput
#' List.map4([1], [2], [3], [4], function(a, b, c, d) a * b * c * d)
#' #> [24]
#' ```
List.map4 : <A, B, C, D, E: item> fn(first: List<A>, second: List<B>, third: List<C>, fourth: List<D>, f: fn(A, B, C, D) -> E) -> List<E>

#' Applies `f`, which returns a list, to every element and concatenates the results.
#'
#' ```r dput
#' List.join_map([1, 2], function(x) [x, x])
#' #> [1, 1, 2, 2]
#' ```
List.join_map : <A, B> fn(list: List<A>, f: fn(A) -> List<B>) -> List<B>

#' The elements for which `predicate` is `TRUE`.
#'
#' ```r dput
#' List.keep_if([1, 5, 2], function(x) x > 1)
#' #> [5, 2]
#' ```
List.keep_if : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> List<T>

#' The elements for which `predicate` returns `:Ok(TRUE)`, or the first `:Err` it returns.
#'
#' ```r dput
#' List.keep_if_try(["1", "20", "3"], function(s) Result.map(Str.to_i64(s), function(n) n > 2))
#' #> :Ok(["20", "3"])
#' List.keep_if_try(["1", "x"], function(s) Result.map(Str.to_i64(s), function(n) n > 2))
#' #> :Err(:InvalidNumStr)
#' ```
List.keep_if_try : <T, E> fn(list: List<T>, predicate: fn(T) -> Result<Bool, E>) -> Result<List<T>, E>

#' The elements for which `predicate` is `FALSE`.
#'
#' ```r dput
#' List.drop_if([1, 5, 2], function(x) x > 1)
#' #> [1]
#' ```
List.drop_if : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> List<T>

#' Applies `f` to every element and keeps the `:Ok` values.
#'
#' ```r dput
#' List.keep_oks(["1", "x", "3"], Str.to_i64)
#' #> [1i64, 3i64]
#' ```
List.keep_oks : <A, B: item, E> fn(list: List<A>, f: fn(A) -> Result<B, E>) -> List<B>

#' Applies `f` to every element and keeps the `:Err` values.
#'
#' ```r dput
#' List.keep_errs(["1", "x"], Str.to_i64)
#' #> [:InvalidNumStr]
#' ```
List.keep_errs : <A, B, E: item> fn(list: List<A>, f: fn(A) -> Result<B, E>) -> List<E>

#' Applies `f` to every element and stops at the first `:Err`.
#'
#' ```r dput
#' List.map_try(["1", "2"], Str.to_i64)
#' #> :Ok([1i64, 2i64])
#' ```
List.map_try : <A, B: item, E> fn(list: List<A>, f: fn(A) -> Result<B, E>) -> Result<List<B>, E>

#' Folds from the first element: `f` gets the state and an element and returns the next state.
#'
#' ```r dput
#' List.walk([1, 2, 3], 0, function(total, x) total + x)
#' #> 6
#' ```
List.walk : <T, S> fn(list: List<T>, state: S, f: fn(S, T) -> S) -> S

#' Folds from the last element.
#'
#' ```r dput
#' List.walk_backwards(["a", "b", "c"], "", function(text, x) Str.concat(text, x))
#' #> "cba"
#' ```
List.walk_backwards : <T, S> fn(list: List<T>, state: S, f: fn(S, T) -> S) -> S

#' Folds until `f` returns `:Break(state)`; `:Continue(state)` goes on.
#'
#' ```r dput
#' List.walk_until([1, 2, 3, 4], 0, function(total, x) if (total >= 3) :Break(total) else :Continue(total + x))
#' #> 3
#' ```
List.walk_until : <T, S> fn(list: List<T>, state: S, f: fn(S, T) -> :Continue(S) | :Break(S)) -> S

#' Folds the list from the last element until `f` returns `:Break(state)`.
#'
#' ```r dput
#' List.walk_backwards_until([1, 5, 2, 3], 0, function(total, x) if (x > 4) :Break(total) else :Continue(total + x))
#' #> 5
#' ```
List.walk_backwards_until : <T, S> fn(list: List<T>, state: S, f: fn(S, T) -> :Continue(S) | :Break(S)) -> S

#' Folds the list, passing `f` each element's 1-based position too.
#'
#' ```r dput
#' List.walk_with_index([10, 20, 30], 0, function(total, x, i) total + x * i)
#' #> 140i64
#' ```
List.walk_with_index : <T, S> fn(list: List<T>, state: S, f: fn(S, T, I64) -> S) -> S

#' Folds the list with positions until `f` returns `:Break(state)`.
#'
#' ```r dput
#' List.walk_with_index_until(["a", "b", "c"], "", function(seen, x, i) if (i > 2) :Break(seen) else :Continue(Str.concat(seen, x)))
#' #> "ab"
#' ```
List.walk_with_index_until : <T, S> fn(list: List<T>, state: S, f: fn(S, T, I64) -> :Continue(S) | :Break(S)) -> S

#' Folds the list from a 1-based position onwards.
#'
#' ```r dput
#' List.walk_from([1, 2, 3, 4], 3, 0, function(total, x) total + x)
#' #> 7
#' ```
List.walk_from : <T, S> fn(list: List<T>, index: I64, state: S, f: fn(S, T) -> S) -> S

#' Folds the list from a position until `f` returns `:Break(state)`.
#'
#' ```r dput
#' List.walk_from_until([1, 2, 3, 4], 2, 0, function(total, x) if (total >= 5) :Break(total) else :Continue(total + x))
#' #> 5
#' ```
List.walk_from_until : <T, S> fn(list: List<T>, index: I64, state: S, f: fn(S, T) -> :Continue(S) | :Break(S)) -> S

#' Folds the list while `f` returns `:Ok(state)`, stopping at the first `:Err`.
#'
#' ```r dput
#' List.walk_try(["1", "2", "x"], 0, function(total, s) Result.map(Str.to_i64(s), function(n) total + n))
#' #> :Err(:InvalidNumStr)
#' ```
List.walk_try : <T, S, E> fn(list: List<T>, state: S, f: fn(S, T) -> Result<S, E>) -> Result<S, E>

#' Calls `f` on each element for its effect, and returns `NULL` invisibly.
#'
#' ```r
#' List.for_each(["a", "b"], function(x) cat(x, "\n"))
#' #> a
#' #> b
#' ```
List.for_each : <T> fn(list: List<T>, f: fn(T) -> Any) -> NULL

#' Calls `f` on each element, stopping at the first `:Err`.
#'
#' ```r dput
#' List.for_each_try([1, -2, 3], function(x) if (x < 0) :Err(:Negative(x)) else :Ok(NULL))
#' #> :Err(:Negative(-2))
#' ```
List.for_each_try : <T, E> fn(list: List<T>, f: fn(T) -> Result<Any, E>) -> Result<NULL, E>

#' Whether `predicate` is `TRUE` for some element.
#'
#' ```r dput
#' List.any([1, 5], function(x) x > 4)
#' #> TRUE
#' ```
List.any : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> Bool

#' Whether `predicate` is `TRUE` for every element; `TRUE` for an empty list.
#'
#' ```r dput
#' List.all([1, 5], function(x) x > 4)
#' #> FALSE
#' ```
List.all : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> Bool

#' Whether some element is `identical()` to `value`.
#'
#' ```r dput
#' List.contains(["a", "b"], "b")
#' #> TRUE
#' ```
List.contains : <T: eq> fn(list: List<T>, value: T) -> Bool

#' The number of elements for which `predicate` is `TRUE`.
#'
#' ```r dput
#' List.count_if([1, 5, 7], function(x) x > 4)
#' #> 2i64
#' ```
List.count_if : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> I64

#' The first element for which `predicate` is `TRUE`, or `:Err(:NotFound)`.
#'
#' ```r dput
#' List.find_first([1, 5, 7], function(x) x > 4)
#' #> :Ok(5)
#' ```
List.find_first : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> Result<T, :NotFound>

#' The last element for which `predicate` is `TRUE`, or `:Err(:NotFound)`.
#'
#' ```r dput
#' List.find_last([1, 5, 7], function(x) x > 4)
#' #> :Ok(7)
#' ```
List.find_last : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> Result<T, :NotFound>

#' The position of the first match, or `:Err(:NotFound)`.
#'
#' ```r dput
#' List.find_first_index([1, 5, 7], function(x) x > 4)
#' #> :Ok(2i64)
#' ```
List.find_first_index : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> Result<I64, :NotFound>

#' The position of the last match, or `:Err(:NotFound)`.
#'
#' ```r dput
#' List.find_last_index([1, 5, 7], function(x) x > 9)
#' #> :Err(:NotFound)
#' ```
List.find_last_index : <T> fn(list: List<T>, predicate: fn(T) -> Bool) -> Result<I64, :NotFound>

#' The first element, or `:Err(:ListWasEmpty)`.
#'
#' ```r dput
#' List.first(["a", "b"])
#' #> :Ok("a")
#' ```
List.first : <T> fn(list: List<T>) -> Result<T, :ListWasEmpty>

#' The last element, or `:Err(:ListWasEmpty)`.
#'
#' ```r dput
#' List.last([])
#' #> :Err(:ListWasEmpty)
#' ```
List.last : <T> fn(list: List<T>) -> Result<T, :ListWasEmpty>

#' The first `count` elements, or all of them if there are fewer.
#'
#' ```r dput
#' List.take_first([1, 2, 3], 2)
#' #> [1, 2]
#' ```
List.take_first : <T> fn(list: List<T>, count: I64) -> List<T>

#' The last `count` elements.
#'
#' ```r dput
#' List.take_last([1, 2, 3], 2)
#' #> [2, 3]
#' ```
List.take_last : <T> fn(list: List<T>, count: I64) -> List<T>

#' Everything but the first `count` elements.
#'
#' ```r dput
#' List.drop_first([1, 2, 3], 2)
#' #> [3]
#' ```
List.drop_first : <T> fn(list: List<T>, count: I64) -> List<T>

#' Everything but the last `count` elements.
#'
#' ```r dput
#' List.drop_last([1, 2, 3], 2)
#' #> [1]
#' ```
List.drop_last : <T> fn(list: List<T>, count: I64) -> List<T>

#' Removes the element at a position.
#'
#' ```r dput
#' List.drop_at(["a", "b", "c"], 2)
#' #> ["a", "c"]
#' ```
List.drop_at : <T> fn(list: List<T>, index: I64) -> List<T>

#' `count` elements starting at position `start`.
#'
#' ```r dput
#' List.sublist([1, 2, 3, 4], 2, 2)
#' #> [2, 3]
#' ```
List.sublist : <T> fn(list: List<T>, start: I64, count: I64) -> List<T>

#' The first `count` elements as `before` and the rest as `others`.
#'
#' ```r dput
#' List.split_at([1, 2, 3], 1)
#' #> (before = [1], others = [2, 3])
#' ```
List.split_at : <T> fn(list: List<T>, count: I64) -> Record{before: List<T>, others: List<T>}

#' Splits the list around the first element identical to `delimiter`.
#'
#' ```r dput
#' List.split_first(["a", "-", "b", "-", "c"], "-")
#' #> :Ok((after = ["b", "-", "c"], before = ["a"]))
#' ```
List.split_first : <T> fn(list: List<T>, delimiter: T) -> Result<Record{before: List<T>, after: List<T>}, :NotFound>

#' Splits the list around the last element identical to `delimiter`.
#'
#' ```r dput
#' List.split_last(["a", "-", "b", "-", "c"], "-")
#' #> :Ok((after = ["c"], before = ["a", "-", "b"]))
#' ```
List.split_last : <T> fn(list: List<T>, delimiter: T) -> Result<Record{before: List<T>, after: List<T>}, :NotFound>

#' The runs of elements between elements identical to `delimiter`.
#'
#' ```r dput
#' List.split_on([1, 0, 2, 3, 0, 4], 0)
#' #> [[1], [2, 3], [4]]
#' ```
List.split_on : <T> fn(list: List<T>, delimiter: T) -> List<List<T>>

#' The runs of elements between occurrences of the sublist `delimiter`.
#'
#' ```r dput
#' List.split_on_list([1, 0, 0, 2, 0, 3], [0, 0])
#' #> [[1], [2, 0, 3]]
#' ```
List.split_on_list : <T> fn(list: List<T>, delimiter: List<T>) -> List<List<T>>

#' Groups of `size` elements; the last group may be shorter.
#'
#' ```r dput
#' List.chunks_of([1, 2, 3], 2)
#' #> [[1, 2], [3]]
#' ```
List.chunks_of : <T> fn(list: List<T>, size: I64) -> List<List<T>>

#' Puts `separator` between every two elements.
#'
#' ```r dput
#' List.intersperse(["a", "b", "c"], "-")
#' #> ["a", "-", "b", "-", "c"]
#' ```
List.intersperse : <T> fn(list: List<T>, separator: T) -> List<T>

#' A stable sort by `compare`, which returns `:LT`, `:EQ` or `:GT`.
#'
#' ```r dput
#' List.sort_with([3, 1, 2], Num.compare)
#' #> [1, 2, 3]
#' ```
List.sort_with : <T> fn(list: List<T>, compare: fn(T, T) -> :LT | :EQ | :GT) -> List<T>

#' Sorts numbers from smallest to largest.
#'
#' ```r dput
#' List.sort_asc([3, 1, 2])
#' #> [1, 2, 3]
#' ```
List.sort_asc : <T: number> fn(list: List<T>) -> List<T>

#' Sorts numbers from largest to smallest.
#'
#' ```r dput
#' List.sort_desc([1.5, 3, 2])
#' #> [3, 2, 1.5]
#' ```
List.sort_desc : <T: number> fn(list: List<T>) -> List<T>

#' Exchanges the elements at two positions; an out-of-range position leaves the list unchanged.
#'
#' ```r dput
#' List.swap(["a", "b", "c"], 1, 3)
#' #> ["c", "b", "a"]
#' ```
List.swap : <T> fn(list: List<T>, first: I64, second: I64) -> List<T>

#' Replaces the element at a position, returning the new list and the element it replaced.
#'
#' ```r dput
#' List.replace(["a", "b"], 2, "z")
#' #> (list = ["a", "z"], value = "b")
#' ```
List.replace : <T> fn(list: List<T>, index: I64, value: T) -> Record{list: List<T>, value: T}

#' Adds an `:Ok` value at the end; an `:Err` leaves the list unchanged.
#'
#' ```r dput
#' List.append_if_ok([1], Str.to_i64("2"))
#' #> [1i64, 2i64]
#' ```
List.append_if_ok : <T, E> fn(list: List<T>, result: Result<T, E>) -> List<T>

#' Adds an `:Ok` value at the start; an `:Err` leaves the list unchanged.
#'
#' ```r dput
#' List.prepend_if_ok([1], Str.to_i64("x"))
#' #> [1]
#' ```
List.prepend_if_ok : <T, E> fn(list: List<T>, result: Result<T, E>) -> List<T>

#' Appends the UTF-8 bytes of a string to a list of bytes.
#'
#' ```r dput
#' List.concat_utf8([104], "i")
#' #> [104u8, 105u8]
#' ```
List.concat_utf8 : fn(list: List<I64>, string: Str) -> List<I64>

#' An empty list with room for `capacity` elements, so appending that many never copies.
#'
#' ```r dput
#' List.len(List.with_capacity(1000))
#' #> 0i64
#' ```
List.with_capacity : <T> fn(capacity: I64) -> List<T>

#' The list with room for `spare` more elements.
#'
#' ```r dput
#' List.reserve([1, 2], 100)
#' #> [1, 2]
#' ```
List.reserve : <T> fn(list: List<T>, spare: I64) -> List<T>

#' The list with no room beyond its elements, which gives back what `List.reserve` or
#' `List.with_capacity` set aside.
#'
#' ```r dput
#' List.release_excess_capacity(List.reserve([1, 2], 100))
#' #> [1, 2]
#' ```
List.release_excess_capacity : <T> fn(list: List<T>) -> List<T>

#' The sum of the elements; `0L` for an empty list. An `integer` sum that overflows is an error, so
#' sum doubles, or fold with `Num.add_checked` to get `:Err(:Overflow)` instead. A `double` sum is
#' accumulated like R's `sum()`, with more precision than a plain left-to-right fold, so
#' `List.sum(xs)` and `sum(xs)` give the same number.
#'
#' ```r dput
#' List.sum([1, 2, 3])
#' #> 6
#' ```
List.sum : <T: number> fn(list: List<T>) -> T

#' The product of the elements; `1L` for an empty list. An `integer` product that overflows is an
#' error, as for `List.sum`.
#'
#' ```r dput
#' List.product([2, 2.5])
#' #> 5
#' ```
List.product : <T: number> fn(list: List<T>) -> T

#' The smallest element, or `:Err(:ListWasEmpty)`.
#'
#' ```r dput
#' List.min([3, 1, 2])
#' #> :Ok(1)
#' ```
List.min : <T: number> fn(list: List<T>) -> Result<T, :ListWasEmpty>

#' The largest element, or `:Err(:ListWasEmpty)`.
#'
#' ```r dput
#' List.max([])
#' #> :Err(:ListWasEmpty)
#' ```
List.max : <T: number> fn(list: List<T>) -> Result<T, :ListWasEmpty>

#' Whether the list begins with the elements of `prefix`.
#'
#' ```r dput
#' List.starts_with([1, 2, 3], [1, 2])
#' #> TRUE
#' ```
List.starts_with : <T> fn(list: List<T>, prefix: List<T>) -> Bool

#' Whether the list ends with the elements of `suffix`.
#'
#' ```r dput
#' List.ends_with([1, 2, 3], [2])
#' #> FALSE
#' ```
List.ends_with : <T> fn(list: List<T>, suffix: List<T>) -> Bool

#' Functions over single strings. Patterns and separators are matched literally, never as regular
#' expressions.
# Str

#' Converts an R string into a `Str`, refusing `NA` and a length other than one.
Str.from_r : fn(value: character) -> Str

#' Whether the string is `""`.
#'
#' ```r dput
#' Str.is_empty("")
#' #> TRUE
#' ```
Str.is_empty : fn(string: Str) -> Bool

#' `first` followed by `second`.
#'
#' ```r dput
#' Str.concat("snake", "_case")
#' #> "snake_case"
#' ```
Str.concat : fn(first: Str, second: Str) -> Str

#' Joins a list of strings with `separator` between them.
#'
#' ```r dput
#' Str.join_with(["a", "b", "c"], ", ")
#' #> "a, b, c"
#' ```
Str.join_with : fn(strings: List<Str>, separator: Str) -> Str

#' Splits at every occurrence of `separator`.
#'
#' ```r dput
#' Str.split_on("a,b,,c", ",")
#' #> ["a", "b", "", "c"]
#' ```
Str.split_on : fn(string: Str, separator: Str) -> List<Str>

#' `count` copies of the string.
#'
#' ```r dput
#' Str.repeat("ab", 3)
#' #> "ababab"
#' ```
Str.repeat : fn(string: Str, count: I64) -> Str

#' Whether the string begins with `prefix`.
#'
#' ```r dput
#' Str.starts_with("report.csv", "report")
#' #> TRUE
#' ```
Str.starts_with : fn(string: Str, prefix: Str) -> Bool

#' Whether the string ends with `suffix`.
#'
#' ```r dput
#' Str.ends_with("report.csv", ".R")
#' #> FALSE
#' ```
Str.ends_with : fn(string: Str, suffix: Str) -> Bool

#' Whether `part` occurs in the string, matched literally.
#'
#' ```r dput
#' Str.contains("a.b", ".")
#' #> TRUE
#' ```
Str.contains : fn(string: Str, part: Str) -> Bool

#' Removes leading and trailing whitespace.
#'
#' ```r dput
#' Str.trim("  hi  ")
#' #> "hi"
#' ```
Str.trim : fn(string: Str) -> Str

#' Removes leading whitespace.
#'
#' ```r dput
#' Str.trim_start("  hi  ")
#' #> "hi  "
#' ```
Str.trim_start : fn(string: Str) -> Str

#' Removes trailing whitespace.
#'
#' ```r dput
#' Str.trim_end("  hi  ")
#' #> "  hi"
#' ```
Str.trim_end : fn(string: Str) -> Str

#' Removes `prefix` if the string begins with it.
#'
#' ```r dput
#' Str.drop_prefix("v1.2", "v")
#' #> "1.2"
#' ```
Str.drop_prefix : fn(string: Str, prefix: Str) -> Str

#' Removes `suffix` if the string ends with it.
#'
#' ```r dput
#' Str.drop_suffix("data.csv", ".csv")
#' #> "data"
#' ```
Str.drop_suffix : fn(string: Str, suffix: Str) -> Str

#' Puts `prefix` in front of the string.
#'
#' ```r dput
#' Str.with_prefix("world", "hello ")
#' #> "hello world"
#' ```
Str.with_prefix : fn(string: Str, prefix: Str) -> Str

#' Replaces every occurrence of `pattern`, matched literally.
#'
#' ```r dput
#' Str.replace_each("a.b.c", ".", "-")
#' #> "a-b-c"
#' ```
Str.replace_each : fn(string: Str, pattern: Str, replacement: Str) -> Str

#' Replaces the first occurrence of `pattern`.
#'
#' ```r dput
#' Str.replace_first("a.b.c", ".", "-")
#' #> "a-b.c"
#' ```
Str.replace_first : fn(string: Str, pattern: Str, replacement: Str) -> Str

#' Replaces the last occurrence of `pattern`.
#'
#' ```r dput
#' Str.replace_last("a.b.c", ".", "-")
#' #> "a.b-c"
#' ```
Str.replace_last : fn(string: Str, pattern: Str, replacement: Str) -> Str

#' Splits at the first `separator` into `before` and `after`, or `:Err(:NotFound)`.
#'
#' ```r dput
#' Str.split_first("key=value=more", "=")
#' #> :Ok((after = "value=more", before = "key"))
#' ```
Str.split_first : fn(string: Str, separator: Str) -> Result<Record{before: Str, after: Str}, :NotFound>

#' Splits at the last `separator`.
#'
#' ```r dput
#' Str.split_last("key=value=more", "=")
#' #> :Ok((after = "more", before = "key=value"))
#' ```
Str.split_last : fn(string: Str, separator: Str) -> Result<Record{before: Str, after: Str}, :NotFound>

#' The number of bytes in the string's UTF-8 encoding.
#'
#' ```r dput
#' Str.count_utf8_bytes("hé")
#' #> 3i64
#' ```
Str.count_utf8_bytes : fn(string: Str) -> I64

#' The bytes of the string's UTF-8 encoding.
#'
#' ```r dput
#' Str.to_utf8("hé")
#' #> [104u8, 195u8, 169u8]
#' ```
Str.to_utf8 : fn(string: Str) -> List<U8>

#' The string a list of bytes encodes, or `:Err(:BadUtf8)`.
#'
#' ```r dput
#' Str.from_utf8([104, 105])
#' #> :Ok("hi")
#' ```
Str.from_utf8 : fn(bytes: List<U8>) -> Result<Str, :BadUtf8>

#' Decodes UTF-8 bytes, replacing each invalid sequence with U+FFFD.
#'
#' ```r dput
#' Str.from_utf8_lossy([104, 255, 105])
#' #> "h�i"
#' ```
Str.from_utf8_lossy : fn(bytes: List<U8>) -> Str

#' Parses a whole number that fits an `integer`, or `:Err(:InvalidNumStr)`.
#'
#' ```r dput
#' Str.to_i64("4.2")
#' #> :Err(:InvalidNumStr)
#' ```
Str.to_i64 : fn(string: Str) -> Result<I64, :InvalidNumStr>

#' Parses a decimal number, or `:Err(:InvalidNumStr)`; `NA` and `NaN` are not numbers.
#'
#' ```r dput
#' Str.to_f64("4.5e1")
#' #> :Ok(45)
#' ```
Str.to_f64 : fn(string: Str) -> Result<F64, :InvalidNumStr>

#' Lowercases the ASCII letters and leaves every other character alone.
#'
#' ```r dput
#' Str.with_ascii_lowercased("Straße ABC")
#' #> "straße abc"
#' ```
Str.with_ascii_lowercased : fn(string: Str) -> Str

#' Uppercases the ASCII letters.
#'
#' ```r dput
#' Str.with_ascii_uppercased("straße abc")
#' #> "STRAßE ABC"
#' ```
Str.with_ascii_uppercased : fn(string: Str) -> Str

#' Whether two strings are equal when ASCII case is ignored.
#'
#' ```r dput
#' Str.caseless_ascii_equals("Content-Type", "content-type")
#' #> TRUE
#' ```
Str.caseless_ascii_equals : fn(first: Str, second: Str) -> Bool

#' Folds the string's UTF-8 bytes: `f(state, byte)` gives the next state.
#'
#' ```r dput
#' Str.walk_utf8("abc", 0, function(total, byte) total + Num.to_i64(byte))
#' #> 294i64
#' ```
Str.walk_utf8 : <S> fn(string: Str, state: S, f: fn(S, U8) -> S) -> S

#' Folds the string's UTF-8 bytes, passing `f` each byte's 1-based position too.
#'
#' ```r dput
#' Str.walk_utf8_with_index("ab", [], function(seen, byte, i) List.append(seen, Num.to_i64(byte) * i))
#' #> [97i64, 196i64]
#' ```
Str.walk_utf8_with_index : <S> fn(string: Str, state: S, f: fn(S, U8, I64) -> S) -> S

#' The string's UTF-16 code units, each an integer from 0 to 65535. A character outside the Basic
#' Multilingual Plane takes two units, a surrogate pair.
#'
#' ```r dput
#' Str.to_utf16("h\U0001F600")
#' #> [104u16, 55357u16, 56832u16]
#' ```
Str.to_utf16 : fn(string: Str) -> List<U16>

#' Decodes UTF-16 code units, or `:Err(:BadUtf16)` for an unpaired surrogate or a zero unit, which
#' an R string cannot hold. A number outside 0 to 65535 is an error.
#'
#' ```r dput
#' Str.from_utf16([104, 55357])
#' #> :Err(:BadUtf16)
#' ```
Str.from_utf16 : fn(units: List<U16>) -> Result<Str, :BadUtf16>

#' Decodes UTF-16 code units, replacing each unpaired surrogate and each zero unit with U+FFFD.
#'
#' ```r dput
#' Str.from_utf16_lossy([104, 105])
#' #> "hi"
#' ```
Str.from_utf16_lossy : fn(units: List<U16>) -> Str

#' The string's Unicode code points, one per character.
#'
#' ```r dput
#' Str.to_utf32("h\u00e9")
#' #> [104u32, 233u32]
#' ```
Str.to_utf32 : fn(string: Str) -> List<U32>

#' Builds a string from Unicode code points, or `:Err(:BadUtf32)` for a number that is not one (a
#' surrogate, a negative number, or one above 1114111) and for zero.
#'
#' ```r dput
#' Str.from_utf32([55296])
#' #> :Err(:BadUtf32)
#' ```
Str.from_utf32 : fn(code_points: List<U32>) -> Result<Str, :BadUtf32>

#' Builds a string from Unicode code points, replacing each number that is not one with U+FFFD.
#'
#' ```r dput
#' Str.from_utf32_lossy([82, 121])
#' #> "Ry"
#' ```
Str.from_utf32_lossy : fn(code_points: List<U32>) -> Str

#' Functions over single numbers, `integer` or `double`, and eight constants (`Num.pi`, `Num.tau`,
#' `Num.e`, `Num.infinity` and the integer and double limits). A checked operation returns the
#' failure as a tag where R would return `NA`, `NaN` or `Inf` with a warning; its unchecked twin
#' (`Num.add` beside `Num.add_checked`) stops with an error in that case. A `NaN` result, such as
#' `Inf - Inf` or `Num.sin(Inf)`, is `:Err(:Undefined)` from a checked operation and an error from
#' any other. The bit operations take integers as 32-bit two's complement.
# Num

#' The number as text, with up to 15 significant digits.
#'
#' ```r dput
#' Num.to_str(1 / 3)
#' #> "0.333333333333333"
#' ```
Num.to_str : <T: number> fn(number: T) -> Str

#' `:LT`, `:EQ` or `:GT`, comparing `first` with `second`.
#'
#' ```r dput
#' Num.compare(2, 1)
#' #> :GT
#' ```
Num.compare : <T: number> fn(first: T, second: T) -> :LT | :EQ | :GT

#' The smaller number.
#'
#' ```r dput
#' Num.min(2, 1)
#' #> 1
#' ```
Num.min : <T: number> fn(first: T, second: T) -> T

#' The larger number.
#'
#' ```r dput
#' Num.max(2.5, 1)
#' #> 2.5
#' ```
Num.max : <T: number> fn(first: T, second: T) -> T

#' Whether `first < second`.
#'
#' ```r dput
#' Num.is_lt(1, 2)
#' #> TRUE
#' ```
Num.is_lt : <T: number> fn(first: T, second: T) -> Bool

#' Whether `first > second`.
#'
#' ```r dput
#' Num.is_gt(1, 2)
#' #> FALSE
#' ```
Num.is_gt : <T: number> fn(first: T, second: T) -> Bool

#' Whether `first <= second`.
#'
#' ```r dput
#' Num.is_lte(2, 2)
#' #> TRUE
#' ```
Num.is_lte : <T: number> fn(first: T, second: T) -> Bool

#' Whether `first >= second`.
#'
#' ```r dput
#' Num.is_gte(1.5, 2)
#' #> FALSE
#' ```
Num.is_gte : <T: number> fn(first: T, second: T) -> Bool

#' Whether two numbers are equal within a relative tolerance `rtol` (default `1e-5`) or an absolute
#' tolerance `atol` (default `1e-8`).
#'
#' ```r dput
#' Num.is_approx_eq(0.1 + 0.2, 0.3)
#' #> TRUE
#' ```
Num.is_approx_eq : <T: frac> fn(first: T, second: T, [rtol]: F64, [atol]: F64) -> Bool

#' Whether the number is zero.
#'
#' ```r dput
#' Num.is_zero(-0)
#' #> TRUE
#' ```
Num.is_zero : <T: number> fn(number: T) -> Bool

#' Whether the number is greater than zero.
#'
#' ```r dput
#' Num.is_positive(0)
#' #> FALSE
#' ```
Num.is_positive : <T: number> fn(number: T) -> Bool

#' Whether the number is less than zero.
#'
#' ```r dput
#' Num.is_negative(-1)
#' #> TRUE
#' ```
Num.is_negative : <T: number> fn(number: T) -> Bool

#' Whether the number is a whole, even number.
#'
#' ```r dput
#' Num.is_even(4)
#' #> TRUE
#' ```
Num.is_even : <T: int> fn(number: T) -> Bool

#' Whether the number is a whole, odd number.
#'
#' ```r dput
#' Num.is_odd(-3)
#' #> TRUE
#' ```
Num.is_odd : <T: int> fn(number: T) -> Bool

#' Whether `first` is a whole multiple of `second`. Only zero is a multiple of zero.
#'
#' ```r dput
#' Num.is_multiple_of(12, 4)
#' #> TRUE
#' ```
Num.is_multiple_of : <T: int> fn(first: T, second: T) -> Bool

#' Whether the number is neither infinite nor `NaN`.
#'
#' ```r dput
#' Num.is_finite(1 / 0)
#' #> FALSE
#' ```
Num.is_finite : <T: frac> fn(number: T) -> Bool

#' Whether the number is `Inf` or `-Inf`.
#'
#' ```r dput
#' Num.is_infinite(-1 / 0)
#' #> TRUE
#' ```
Num.is_infinite : <T: frac> fn(number: T) -> Bool

#' The absolute value.
#'
#' ```r dput
#' Num.abs(-3)
#' #> 3
#' ```
Num.abs : <T: number> fn(number: T) -> T

#' The absolute difference of two numbers. An integer result that overflows is an error.
#'
#' ```r dput
#' Num.abs_diff(3, 10)
#' #> 7
#' ```
Num.abs_diff : <T: number> fn(first: T, second: T) -> T

#' The number with its sign flipped.
#'
#' ```r dput
#' Num.neg(2.5)
#' #> -2.5
#' ```
Num.neg : <T: number> fn(number: T) -> T

#' Rounds up to a whole number, keeping the number type.
#'
#' ```r dput
#' Num.ceiling(1.2)
#' #> 2i64
#' ```
Num.ceiling : <T: frac> fn(number: T) -> I64

#' Rounds down to a whole number, as an `I64`.
#'
#' ```r dput
#' Num.floor(-1.2)
#' #> -2i64
#' ```
Num.floor : <T: frac> fn(number: T) -> I64

#' Rounds to the nearest whole number, halves away from zero, as an `I64`.
#'
#' ```r dput
#' Num.round(2.5)
#' #> 3i64
#' ```
Num.round : <T: frac> fn(number: T) -> I64

#' Drops the fraction, rounding toward zero, as an `I64`.
#'
#' ```r dput
#' Num.truncate(-1.7)
#' #> -1i64
#' ```
Num.truncate : <T: frac> fn(number: T) -> I64

#' `base` raised to `exponent`. A result that is not a real number, as for `Num.pow(-1, 0.5)`, is an
#' error.
#'
#' ```r dput
#' Num.pow(2, 10)
#' #> 1024
#' ```
Num.pow : <T: number> fn(base: T, exponent: T) -> T

#' The sine of an angle in radians. An infinite angle is an error, because its sine is undefined;
#' the same holds for `Num.cos` and `Num.tan`.
#'
#' ```r dput
#' Num.sin(0)
#' #> 0
#' ```
Num.sin : <T: frac> fn(number: T) -> T

#' The cosine of an angle in radians.
#'
#' ```r dput
#' Num.cos(0)
#' #> 1
#' ```
Num.cos : <T: frac> fn(number: T) -> T

#' The tangent of an angle in radians.
#'
#' ```r dput
#' Num.tan(0)
#' #> 0
#' ```
Num.tan : <T: frac> fn(number: T) -> T

#' The arctangent, in radians.
#'
#' ```r dput
#' Num.atan(1) * 4
#' #> 3.14159265358979
#' ```
Num.atan : <T: frac> fn(number: T) -> T

#' The sum, or `:Err(:Overflow)`; a `NaN` sum such as `Inf + -Inf` is `:Err(:Undefined)`.
#'
#' ```r dput
#' Num.add_checked(2147483647i32, 1i32)
#' #> :Err(:Overflow)
#' ```
Num.add_checked : <T: number> fn(first: T, second: T) -> Result<T, :Overflow | :Undefined>

#' The difference, or `:Err(:Overflow)`.
#'
#' ```r dput
#' Num.sub_checked(10, 3)
#' #> :Ok(7)
#' ```
Num.sub_checked : <T: number> fn(first: T, second: T) -> Result<T, :Overflow | :Undefined>

#' The product, or `:Err(:Overflow)`; a finite double that would become infinite overflows too.
#'
#' ```r dput
#' Num.mul_checked(1e308, 10)
#' #> :Err(:Overflow)
#' ```
Num.mul_checked : <T: number> fn(first: T, second: T) -> Result<T, :Overflow | :Undefined>

#' Adds two numbers, clamping an integer result to the largest or smallest integer.
#'
#' ```r dput
#' Num.add_saturated(127i8, 1i8)
#' #> 127i8
#' ```
Num.add_saturated : <T: number> fn(first: T, second: T) -> T

#' Subtracts `second` from `first`, clamping an integer result.
#'
#' ```r dput
#' Num.sub_saturated(-127i8, 2i8)
#' #> -128i8
#' ```
Num.sub_saturated : <T: number> fn(first: T, second: T) -> T

#' Multiplies two numbers, clamping an integer result.
#'
#' ```r dput
#' Num.mul_saturated(100000i32, 100000i32)
#' #> 2147483647i32
#' ```
Num.mul_saturated : <T: number> fn(first: T, second: T) -> T

#' Adds two integers, wrapping around on overflow as two's complement arithmetic does.
#'
#' ```r dput
#' Num.add_wrap(127i8, 1i8)
#' #> -128i8
#' ```
Num.add_wrap : <T: int> fn(first: T, second: T) -> T

#' Subtracts `second` from `first`, wrapping around on overflow.
#'
#' ```r dput
#' Num.sub_wrap(0u8, 1u8)
#' #> 255u8
#' ```
Num.sub_wrap : <T: int> fn(first: T, second: T) -> T

#' Multiplies two integers, wrapping around on overflow.
#'
#' ```r dput
#' Num.mul_wrap(16u8, 16u8)
#' #> 0u8
#' ```
Num.mul_wrap : <T: int> fn(first: T, second: T) -> T

#' The quotient as a double, or `:Err(:DivByZero)`.
#'
#' ```r dput
#' Num.div_checked(7, 2)
#' #> :Ok(3.5)
#' ```
Num.div_checked : <T: frac> fn(first: T, second: T) -> Result<T, :DivByZero | :Undefined>

#' The quotient rounded toward zero, or `:Err(:DivByZero)`; `Inf` divided by `Inf` is
#' `:Err(:Undefined)`.
#'
#' ```r dput
#' Num.div_trunc_checked(-7, 2)
#' #> :Ok(-3)
#' Num.div_trunc_checked(Inf, Inf)
#' #> :Err(:Undefined)
#' ```
Num.div_trunc_checked : <T: int> fn(first: T, second: T) -> Result<T, :DivByZero | :Undefined>

#' Divides and rounds up, or `:Err(:DivByZero)`.
#'
#' ```r dput
#' Num.div_ceil_checked(7, 2)
#' #> :Ok(4)
#' ```
Num.div_ceil_checked : <T: int> fn(first: T, second: T) -> Result<T, :DivByZero | :Undefined>

#' The remainder of the truncated division, with the sign of `first`, or `:Err(:DivByZero)`.
#'
#' ```r dput
#' Num.rem_checked(-7, 2)
#' #> :Ok(-1)
#' ```
Num.rem_checked : <T: int> fn(first: T, second: T) -> Result<T, :DivByZero | :Undefined>

#' The square root, or `:Err(:SqrtOfNegative)`.
#'
#' ```r dput
#' Num.sqrt_checked(-1)
#' #> :Err(:SqrtOfNegative)
#' ```
Num.sqrt_checked : <T: frac> fn(number: T) -> Result<T, :SqrtOfNegative>

#' The natural logarithm, or `:Err(:LogNeedsPositive)`.
#'
#' ```r dput
#' Num.log_checked(exp(2))
#' #> :Ok(2)
#' ```
Num.log_checked : <T: frac> fn(number: T) -> Result<T, :LogNeedsPositive>

#' Converts an R number into a ry number, refusing `NA` and a length other than one: a `double`
#' becomes an `F64` and an `integer` an `I32`.
#'
#' ```r dput
#' Num.from_r(2.5)
#' #> 2.5
#' ```
Num.from_r : fn(value: integer) -> I32
Num.from_r : fn(value: double) -> F64

#' Converts a ry number into an R number: a fraction becomes a `double`, and an integer type an
#' `integer` when it fits in 32 bits and a `double` otherwise. An `F64` already passes to R code
#' as a `double` without this call.
#'
#' ```r dput
#' Num.to_r(5i64)
#' #> 5L
#' ```
Num.to_r : <T: number> fn(number: T) -> integer | double

#' The number as an `F64`. An integer past 2^53 rounds to the nearest `F64`.
#'
#' ```r dput
#' Num.to_f64(3i64)
#' #> 3
#' ```
Num.to_f64 : <T: number> fn(number: T) -> F64

#' The number as an `F32`, rounded to the nearest one.
Num.to_f32 : <T: number> fn(number: T) -> F32

#' The number as a `Dec`. A number a `Dec` cannot hold is an error.
Num.to_dec : <T: number> fn(number: T) -> Dec

#' The number as an `I8`. A number an `I8` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_i8_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_i8 : <T: number> fn(number: T) -> I8

#' The number as an `I8`, or `:Err(:OutOfBounds)` when an `I8` cannot hold it exactly.
Num.to_i8_checked : <T: number> fn(number: T) -> Result<I8, :OutOfBounds>

#' The number as an `I16`. A number an `I16` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_i16_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_i16 : <T: number> fn(number: T) -> I16

#' The number as an `I16`, or `:Err(:OutOfBounds)` when an `I16` cannot hold it exactly.
Num.to_i16_checked : <T: number> fn(number: T) -> Result<I16, :OutOfBounds>

#' The number as an `I32`. A number an `I32` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_i32_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_i32 : <T: number> fn(number: T) -> I32

#' The number as an `I32`, or `:Err(:OutOfBounds)` when an `I32` cannot hold it exactly.
Num.to_i32_checked : <T: number> fn(number: T) -> Result<I32, :OutOfBounds>

#' The number as an `I128`. A number an `I128` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_i128_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_i128 : <T: number> fn(number: T) -> I128

#' The number as an `I128`, or `:Err(:OutOfBounds)` when an `I128` cannot hold it exactly.
Num.to_i128_checked : <T: number> fn(number: T) -> Result<I128, :OutOfBounds>

#' The number as a `U8`. A number a `U8` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_u8_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_u8 : <T: number> fn(number: T) -> U8

#' The number as a `U8`, or `:Err(:OutOfBounds)` when a `U8` cannot hold it exactly.
Num.to_u8_checked : <T: number> fn(number: T) -> Result<U8, :OutOfBounds>

#' The number as a `U16`. A number a `U16` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_u16_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_u16 : <T: number> fn(number: T) -> U16

#' The number as a `U16`, or `:Err(:OutOfBounds)` when a `U16` cannot hold it exactly.
Num.to_u16_checked : <T: number> fn(number: T) -> Result<U16, :OutOfBounds>

#' The number as a `U32`. A number a `U32` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_u32_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_u32 : <T: number> fn(number: T) -> U32

#' The number as a `U32`, or `:Err(:OutOfBounds)` when a `U32` cannot hold it exactly.
Num.to_u32_checked : <T: number> fn(number: T) -> Result<U32, :OutOfBounds>

#' The number as a `U64`. A number a `U64` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_u64_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_u64 : <T: number> fn(number: T) -> U64

#' The number as a `U64`, or `:Err(:OutOfBounds)` when a `U64` cannot hold it exactly.
Num.to_u64_checked : <T: number> fn(number: T) -> Result<U64, :OutOfBounds>

#' The number as a `U128`. A number a `U128` cannot hold exactly, such as one with a
#' fraction, is an error; `Num.to_u128_checked` returns `:Err(:OutOfBounds)` instead.
Num.to_u128 : <T: number> fn(number: T) -> U128

#' The number as a `U128`, or `:Err(:OutOfBounds)` when a `U128` cannot hold it exactly.
Num.to_u128_checked : <T: number> fn(number: T) -> Result<U128, :OutOfBounds>

#' The number as an `I64`, or `:Err(:OutOfBounds)` when an `I64` cannot hold it exactly, such as
#' a number with a fraction. `Num.truncate` drops a fraction first.
#'
#' ```r dput
#' Num.to_i64_checked(-3.7)
#' #> :Err(:OutOfBounds)
#' ```
Num.to_i64_checked : <T: number> fn(number: T) -> Result<I64, :OutOfBounds>

#' The number as an `I64`. A number an `I64` cannot hold exactly is an
#' error; `Num.to_i64_checked` returns `:Err(:OutOfBounds)` instead.
#'
#' ```r dput
#' Num.to_i64(-3.0)
#' #> -3i64
#' ```
Num.to_i64 : <T: number> fn(number: T) -> I64

#' The sum. An `integer` sum that overflows stops with an error, so use `Num.add_checked` when
#' overflow is possible. Unlike `+`, it can be passed by name.
#'
#' ```r dput
#' List.walk([1, 2, 3], 0, Num.add)
#' #> 6
#' ```
Num.add : <T: number> fn(first: T, second: T) -> T

#' `second` subtracted from `first`. An `integer` result that overflows is an error, and so is a
#' `NaN` result such as `Inf - Inf`.
#'
#' ```r dput
#' Num.sub(10, 4)
#' #> 6
#' ```
Num.sub : <T: number> fn(first: T, second: T) -> T

#' The product. An `integer` product that overflows is an error.
#'
#' ```r dput
#' Num.mul(6, 7)
#' #> 42
#' ```
Num.mul : <T: number> fn(first: T, second: T) -> T

#' The quotient as a double. A zero divisor is an error; `Num.div_checked` returns
#' `:Err(:DivByZero)` instead.
#'
#' ```r dput
#' Num.div(7, 2)
#' #> 3.5
#' ```
Num.div : <T: frac> fn(first: T, second: T) -> T

#' The quotient rounded toward zero. A zero divisor is an error.
#'
#' ```r dput
#' Num.div_trunc(-7, 2)
#' #> -3
#' ```
Num.div_trunc : <T: int> fn(first: T, second: T) -> T

#' The quotient rounded up. A zero divisor is an error.
#'
#' ```r dput
#' Num.div_ceil(7, 2)
#' #> 4
#' ```
Num.div_ceil : <T: int> fn(first: T, second: T) -> T

#' The remainder of the truncated division, with the sign of `first`. A zero divisor is an error.
#'
#' ```r dput
#' Num.rem(-7, 2)
#' #> -1
#' ```
Num.rem : <T: int> fn(first: T, second: T) -> T

#' `base` raised to a non-negative `exponent`, as an integer. A result that overflows is an error;
#' `Num.pow` returns a double instead.
#'
#' ```r dput
#' Num.pow_int(3, 4)
#' #> 81L
#' ```
Num.pow_int : <T: int> fn(base: T, exponent: T) -> T

#' The square root. A negative number is an error; `Num.sqrt_checked` returns
#' `:Err(:SqrtOfNegative)` instead.
#'
#' ```r dput
#' Num.sqrt(16)
#' #> 4
#' ```
Num.sqrt : <T: frac> fn(number: T) -> T

#' The natural logarithm. A number that is not positive is an error; `Num.log_checked` returns
#' `:Err(:LogNeedsPositive)` instead.
#'
#' ```r dput
#' Num.log(Num.e)
#' #> 1
#' ```
Num.log : <T: frac> fn(number: T) -> T

#' The arcsine in radians. A number outside -1 to 1 is an error.
#'
#' ```r dput
#' Num.asin(1)
#' #> 1.5707963267949
#' ```
Num.asin : <T: frac> fn(number: T) -> T

#' The arccosine in radians. A number outside -1 to 1 is an error.
#'
#' ```r dput
#' Num.acos(1)
#' #> 0
#' ```
Num.acos : <T: frac> fn(number: T) -> T

#' Whether the number is `NaN`. It is the one library function that accepts `NaN`; `NA` is still an
#' error.
#'
#' ```r dput
#' Num.is_nan(0 / 0)
#' #> TRUE
#' ```
Num.is_nan : <T: frac> fn(number: T) -> Bool

#' The bits set in both integers, in 32-bit two's complement.
#'
#' ```r dput
#' Num.bitwise_and(12, 10)
#' #> 8L
#' ```
Num.bitwise_and : <T: int> fn(first: T, second: T) -> T

#' The bits set in either integer.
#'
#' ```r dput
#' Num.bitwise_or(12, 10)
#' #> 14L
#' ```
Num.bitwise_or : <T: int> fn(first: T, second: T) -> T

#' The bits set in exactly one of the integers. A result whose bit pattern is -2147483648 is an
#' error, because R uses that value for `NA`; the same holds for every bit operation.
#'
#' ```r dput
#' Num.bitwise_xor(12, 10)
#' #> 6L
#' ```
Num.bitwise_xor : <T: int> fn(first: T, second: T) -> T

#' The integer with every bit flipped, which is `-number - 1`.
#'
#' ```r dput
#' Num.bitwise_not(5)
#' #> -6L
#' ```
Num.bitwise_not : <T: int> fn(number: T) -> T

#' Shifts the bits left by `bits`, from 0 to 31. Bits shifted past the top are lost, as in Roc.
#'
#' ```r dput
#' Num.shift_left_by(1, 4)
#' #> 16L
#' ```
Num.shift_left_by : <T: int> fn(number: T, bits: T) -> T

#' Shifts the bits right by `bits`, copying the sign bit in, so a negative number stays negative.
#'
#' ```r dput
#' Num.shift_right_by(-16, 2)
#' #> -4L
#' ```
Num.shift_right_by : <T: int> fn(number: T, bits: T) -> T

#' Shifts the bits right by `bits`, filling with zeros.
#'
#' ```r dput
#' Num.shift_right_zf_by(-16, 28)
#' #> 15L
#' ```
Num.shift_right_zf_by : <T: int> fn(number: T, bits: T) -> T

#' The number of set bits.
#'
#' ```r dput
#' Num.count_one_bits(255)
#' #> 8L
#' ```
Num.count_one_bits : <T: int> fn(number: T) -> T

#' The number of zero bits above the highest set bit, 32 for zero.
#'
#' ```r dput
#' Num.count_leading_zero_bits(1)
#' #> 31L
#' ```
Num.count_leading_zero_bits : <T: int> fn(number: T) -> T

#' The number of zero bits below the lowest set bit, 32 for zero.
#'
#' ```r dput
#' Num.count_trailing_zero_bits(8)
#' #> 3L
#' ```
Num.count_trailing_zero_bits : <T: int> fn(number: T) -> T

#' The ratio of a circle's circumference to its diameter. It is a value, not a function.
#'
#' ```r dput
#' Num.pi
#' #> 3.14159265358979
#' ```
Num.pi : F64

#' The ratio of a circle's circumference to its radius, `2 * Num.pi`.
#'
#' ```r dput
#' Num.tau
#' #> 6.28318530717959
#' ```
Num.tau : F64

#' Euler's number, the base of the natural logarithm.
#'
#' ```r dput
#' Num.e
#' #> 2.71828182845905
#' ```
Num.e : F64

#' The largest `I64`, `9223372036854775807i64`. It is a value, not a function.
#'
#' ```r dput
#' Num.max_i64
#' #> 9223372036854775807i64
#' ```
Num.max_i64 : I64

#' The smallest `I64`, `-9223372036854775808i64`. It is a value, not a function.
#'
#' ```r dput
#' Num.min_i64
#' #> -9223372036854775808i64
#' ```
Num.min_i64 : I64

#' The largest finite double.
#'
#' ```r dput
#' Num.max_f64
#' #> 1.79769313486232e+308
#' ```
Num.max_f64 : F64

#' The most negative finite double, the negation of `Num.max_f64`.
#'
#' ```r dput
#' Num.min_f64
#' #> -1.79769313486232e+308
#' ```
Num.min_f64 : F64

#' Positive infinity, R's `Inf`.
#'
#' ```r dput
#' c(Num.infinity_f64, -Num.infinity_f64)
#' #> c(Inf, -Inf)
#' ```
Num.infinity_f64 : F64

#' Not a number, the `F64` that arithmetic such as `0 / 0` produces. It is not R's `NA`.
Num.nan_f64 : F64

#' A `Bool` is `TRUE` or `FALSE`, never `NA`. R's operators already cover most of this module;
#' its functions exist so that a boolean step can be passed by name, as in `List.walk(flags,
#' Bool.true, Bool.and)`, and so that code written against Roc's names reads the same.
# Bool

#' `TRUE`, as Roc spells it. It is a value, not a function.
#'
#' ```r dput
#' Bool.true
#' #> TRUE
#' ```
Bool.true : Bool

#' `FALSE`.
#'
#' ```r dput
#' Bool.false
#' #> FALSE
#' ```
Bool.false : Bool

#' Converts an R `logical` into a `Bool`, refusing `NA` and a length other than one.
Bool.from_r : fn(value: logical) -> Bool

#' Whether both are `TRUE`. Both arguments are evaluated, unlike with `&&`.
#'
#' ```r dput
#' Bool.and(TRUE, FALSE)
#' #> FALSE
#' ```
Bool.and : fn(first: Bool, second: Bool) -> Bool

#' Whether either is `TRUE`. Both arguments are evaluated, unlike with `||`.
#'
#' ```r dput
#' Bool.or(TRUE, FALSE)
#' #> TRUE
#' ```
Bool.or : fn(first: Bool, second: Bool) -> Bool

#' The opposite value.
#'
#' ```r dput
#' List.keep_if([1, 2, 3], function(x) Bool.not(Num.is_even(x)))
#' #> [1, 3]
#' ```
Bool.not : fn(value: Bool) -> Bool

#' Whether two values are equal by `identical()`, the library's equality. An integer and a double
#' are never identical, so `Bool.is_eq(1L, 1)` is `FALSE`, and a dictionary or set compares without
#' regard to order.
#'
#' ```r dput
#' Bool.is_eq(Set.from_list([1, 2]), Set.from_list([2, 1]))
#' #> TRUE
#' ```
Bool.is_eq : <T: eq> fn(first: T, second: T) -> Bool

#' Whether two values differ by `identical()`.
#'
#' ```r dput
#' Bool.is_not_eq([1], [2])
#' #> TRUE
#' ```
Bool.is_not_eq : <T: eq> fn(first: T, second: T) -> Bool

#' A dictionary maps keys to values, typed `Dict<K, V>`. See [Dictionaries and
#' sets](/reference/standard-library/#dictionaries-and-sets) for the rules on keys.
# Dict

#' A dictionary with no entries.
#'
#' ```r dput
#' Dict.empty()
#' #> Dict.empty()
#' ```
Dict.empty : <K: key, V> fn() -> Dict<K, V>

#' An empty dictionary with room for `capacity` entries, so inserting that many never grows it. The
#' room is rounded up to a power of two.
#'
#' ```r dput
#' Dict.capacity(Dict.insert(Dict.with_capacity(64), "a", 1))
#' #> 64i64
#' ```
Dict.with_capacity : <K: key, V> fn(capacity: I64) -> Dict<K, V>

#' A dictionary with one entry.
#'
#' ```r dput
#' Dict.single("a", 1)
#' #> Dict.from_list([("a", 1)])
#' ```
Dict.single : <K: key, V> fn(key: K, value: V) -> Dict<K, V>

#' A dictionary from `(key, value)` tuples; a later tuple replaces an earlier one with the same key.
#'
#' ```r dput
#' Dict.from_list([("a", 1), ("b", 2), ("a", 3)])
#' #> Dict.from_list([("a", 3), ("b", 2)])
#' ```
Dict.from_list : <K: key, V> fn(pairs: List<Tuple{K, V}>) -> Dict<K, V>

#' The entries as `(key, value)` tuples, in insertion order.
#'
#' ```r dput
#' Dict.to_list(Dict.from_list([("a", 1), ("b", 2)]))
#' #> [("a", 1), ("b", 2)]
#' ```
Dict.to_list : <K: key, V> fn(dict: Dict<K, V>) -> List<Tuple{K, V}>

#' The number of entries.
#'
#' ```r dput
#' Dict.len(Dict.single("a", 1))
#' #> 1i64
#' ```
Dict.len : <K: key, V> fn(dict: Dict<K, V>) -> I64

#' Whether the dictionary has no entries.
#'
#' ```r dput
#' Dict.is_empty(Dict.empty())
#' #> TRUE
#' ```
Dict.is_empty : <K: key, V> fn(dict: Dict<K, V>) -> Bool

#' The value for `key`, or `:Err(:KeyNotFound)`.
#'
#' ```r dput
#' Dict.get(Dict.single("a", 1), "a")
#' #> :Ok(1)
#' ```
Dict.get : <K: key, V> fn(dict: Dict<K, V>, key: K) -> Result<V, :KeyNotFound>

#' Whether the dictionary has an entry for `key`.
#'
#' ```r dput
#' Dict.contains(Dict.single("a", 1), "b")
#' #> FALSE
#' ```
Dict.contains : <K: key, V> fn(dict: Dict<K, V>, key: K) -> Bool

#' Adds an entry, or replaces the value of an existing key in place.
#'
#' ```r dput
#' Dict.insert(Dict.single("a", 1), "b", 2)
#' #> Dict.from_list([("a", 1), ("b", 2)])
#' ```
Dict.insert : <K: key, V> fn(dict: Dict<K, V>, key: K, value: V) -> Dict<K, V>

#' Removes the entry for `key`, if there is one.
#'
#' ```r dput
#' Dict.remove(Dict.from_list([("a", 1), ("b", 2)]), "a")
#' #> Dict.from_list([("b", 2)])
#' ```
Dict.remove : <K: key, V> fn(dict: Dict<K, V>, key: K) -> Dict<K, V>

#' Sets the entry for `key` from `f`, which gets `:Ok(value)` or `:Err(:Missing)` and returns
#' either; `:Err` removes the entry.
#'
#' ```r dput
#' Dict.update(Dict.single("hits", 1), "hits", function(r) :Ok(Result.with_default(r, 0) + 1))
#' #> Dict.from_list([("hits", 2)])
#' ```
Dict.update : <K: key, V> fn(dict: Dict<K, V>, key: K, f: fn(Result<V, :Missing>) -> Result<V, :Missing>) -> Dict<K, V>

#' The keys, in insertion order.
#'
#' ```r dput
#' Dict.keys(Dict.from_list([("a", 1), ("b", 2)]))
#' #> ["a", "b"]
#' ```
Dict.keys : <K: key, V> fn(dict: Dict<K, V>) -> List<K>

#' The values, in insertion order.
#'
#' ```r dput
#' Dict.values(Dict.from_list([("a", 1), ("b", 2)]))
#' #> [1, 2]
#' ```
Dict.values : <K: key, V> fn(dict: Dict<K, V>) -> List<V>

#' Folds over the entries: `f` gets the state, a key and its value.
#'
#' ```r dput
#' Dict.walk(Dict.from_list([("a", 1), ("b", 2)]), 0, function(total, k, v) total + v)
#' #> 3
#' ```
Dict.walk : <K: key, V, S> fn(dict: Dict<K, V>, state: S, f: fn(S, K, V) -> S) -> S

#' Folds the entries until `f` returns `:Break(state)`.
#'
#' ```r dput
#' Dict.walk_until(Dict.from_list([("a", 1), ("b", 5), ("c", 2)]), 0, function(total, k, v) if (v > 4) :Break(total) else :Continue(total + v))
#' #> 1
#' ```
Dict.walk_until : <K: key, V, S> fn(dict: Dict<K, V>, state: S, f: fn(S, K, V) -> :Continue(S) | :Break(S)) -> S

#' Replaces every value with `f` of its key and value.
#'
#' ```r dput
#' Dict.map(Dict.from_list([("a", 1), ("b", 2)]), function(k, v) v * 10)
#' #> Dict.from_list([("a", 10), ("b", 20)])
#' ```
Dict.map : <K: key, A, B> fn(dict: Dict<K, A>, f: fn(K, A) -> B) -> Dict<K, B>

#' Unions the dictionaries `f` returns for each entry; a later entry's value wins.
#'
#' ```r dput
#' Dict.join_map(Dict.from_list([("a", 1), ("b", 2)]), function(k, v) Dict.single(v, k))
#' #> Dict.from_list([(1, "a"), (2, "b")])
#' ```
Dict.join_map : <K: key, V, X: key, Y> fn(dict: Dict<K, V>, f: fn(K, V) -> Dict<X, Y>) -> Dict<X, Y>

#' The entries for which `predicate` of the key and value is `TRUE`.
#'
#' ```r dput
#' Dict.keep_if(Dict.from_list([("a", 1), ("b", 2)]), function(k, v) v > 1)
#' #> Dict.from_list([("b", 2)])
#' ```
Dict.keep_if : <K: key, V> fn(dict: Dict<K, V>, predicate: fn(K, V) -> Bool) -> Dict<K, V>

#' The entries for which `predicate` is `FALSE`.
#'
#' ```r dput
#' Dict.drop_if(Dict.from_list([("a", 1), ("b", 2)]), function(k, v) v > 1)
#' #> Dict.from_list([("a", 1)])
#' ```
Dict.drop_if : <K: key, V> fn(dict: Dict<K, V>, predicate: fn(K, V) -> Bool) -> Dict<K, V>

#' The entries of both; where a key is in both, `second`'s value wins.
#'
#' ```r dput
#' Dict.insert_all(Dict.single("a", 1), Dict.from_list([("a", 5), ("b", 2)]))
#' #> Dict.from_list([("a", 5), ("b", 2)])
#' ```
Dict.insert_all : <K: key, V> fn(first: Dict<K, V>, second: Dict<K, V>) -> Dict<K, V>

#' The entries of `first` whose key and value are both in `second`.
#'
#' ```r dput
#' Dict.keep_shared(Dict.from_list([("a", 1), ("b", 2)]), Dict.from_list([("a", 1), ("b", 0)]))
#' #> Dict.from_list([("a", 1)])
#' ```
Dict.keep_shared : <K: key, V> fn(first: Dict<K, V>, second: Dict<K, V>) -> Dict<K, V>

#' The entries of `first` whose key is not in `second`.
#'
#' ```r dput
#' Dict.remove_all(Dict.from_list([("a", 1), ("b", 2)]), Dict.single("a", 0))
#' #> Dict.from_list([("b", 2)])
#' ```
Dict.remove_all : <K: key, V> fn(first: Dict<K, V>, second: Dict<K, V>) -> Dict<K, V>

#' The dictionary with room for `spare` more entries.
#'
#' ```r dput
#' Dict.reserve(Dict.single("a", 1), 1000)
#' #> Dict.from_list([("a", 1)])
#' ```
Dict.reserve : <K: key, V> fn(dict: Dict<K, V>, spare: I64) -> Dict<K, V>

#' How many entries the dictionary holds before its storage must grow.
#'
#' ```r dput
#' Dict.capacity(Dict.reserve(Dict.single("a", 1), 9))
#' #> 10i64
#' ```
Dict.capacity : <K: key, V> fn(dict: Dict<K, V>) -> I64

#' The dictionary with no room beyond its entries. An empty dictionary keeps its smallest index,
#' which has room for 4.
#'
#' ```r dput
#' Dict.capacity(Dict.release_excess_capacity(Dict.reserve(Dict.single("a", 1), 9)))
#' #> 1i64
#' ```
Dict.release_excess_capacity : <K: key, V> fn(dict: Dict<K, V>) -> Dict<K, V>

#' An empty dictionary of the same type.
#'
#' ```r dput
#' Dict.clear(Dict.single("a", 1))
#' #> Dict.empty()
#' ```
Dict.clear : <K: key, V> fn(dict: Dict<K, V>) -> Dict<K, V>

#' A set of distinct keys, typed `Set<T>`.
# Set

#' A set with no elements.
#'
#' ```r dput
#' Set.empty()
#' #> Set.empty()
#' ```
Set.empty : <T: key> fn() -> Set<T>

#' An empty set with room for `capacity` elements, so inserting that many never grows it. The room
#' is rounded up to a power of two.
#'
#' ```r dput
#' Set.capacity(Set.insert(Set.with_capacity(64), "a"))
#' #> 64i64
#' ```
Set.with_capacity : <T: key> fn(capacity: I64) -> Set<T>

#' A set with one element.
#'
#' ```r dput
#' Set.single("a")
#' #> Set.from_list(["a"])
#' ```
Set.single : <T: key> fn(element: T) -> Set<T>

#' A set of the list's elements, without duplicates, in first-seen order.
#'
#' ```r dput
#' Set.from_list([2, 1, 2])
#' #> Set.from_list([2, 1])
#' ```
Set.from_list : <T: key> fn(list: List<T>) -> Set<T>

#' The elements, in insertion order.
#'
#' ```r dput
#' Set.to_list(Set.from_list(["b", "a"]))
#' #> ["b", "a"]
#' ```
Set.to_list : <T: key> fn(set: Set<T>) -> List<T>

#' The number of elements.
#'
#' ```r dput
#' Set.len(Set.from_list([1, 1, 2]))
#' #> 2i64
#' ```
Set.len : <T: key> fn(set: Set<T>) -> I64

#' Whether the set has no elements.
#'
#' ```r dput
#' Set.is_empty(Set.empty())
#' #> TRUE
#' ```
Set.is_empty : <T: key> fn(set: Set<T>) -> Bool

#' Whether `element` is in the set.
#'
#' ```r dput
#' Set.contains(Set.from_list([1, 2]), 2)
#' #> TRUE
#' ```
Set.contains : <T: key> fn(set: Set<T>, element: T) -> Bool

#' Adds an element.
#'
#' ```r dput
#' Set.insert(Set.single(1), 2)
#' #> Set.from_list([1, 2])
#' ```
Set.insert : <T: key> fn(set: Set<T>, element: T) -> Set<T>

#' Removes an element, if it is there.
#'
#' ```r dput
#' Set.remove(Set.from_list([1, 2]), 1)
#' #> Set.from_list([2])
#' ```
Set.remove : <T: key> fn(set: Set<T>, element: T) -> Set<T>

#' The elements of either set.
#'
#' ```r dput
#' Set.union(Set.from_list([1, 2]), Set.from_list([2, 3]))
#' #> Set.from_list([1, 2, 3])
#' ```
Set.union : <T: key> fn(first: Set<T>, second: Set<T>) -> Set<T>

#' The elements of both sets.
#'
#' ```r dput
#' Set.intersection(Set.from_list([1, 2]), Set.from_list([2, 3]))
#' #> Set.from_list([2])
#' ```
Set.intersection : <T: key> fn(first: Set<T>, second: Set<T>) -> Set<T>

#' The elements of `first` that are not in `second`.
#'
#' ```r dput
#' Set.difference(Set.from_list([1, 2]), Set.from_list([2, 3]))
#' #> Set.from_list([1])
#' ```
Set.difference : <T: key> fn(first: Set<T>, second: Set<T>) -> Set<T>

#' Folds over the elements.
#'
#' ```r dput
#' Set.walk(Set.from_list([1, 2, 3]), 0, function(total, x) total + x)
#' #> 6
#' ```
Set.walk : <T: key, S> fn(set: Set<T>, state: S, f: fn(S, T) -> S) -> S

#' Folds the elements until `f` returns `:Break(state)`.
#'
#' ```r dput
#' Set.walk_until(Set.from_list([1, 2, 3]), 0, function(total, x) if (x > 2) :Break(total) else :Continue(total + x))
#' #> 3
#' ```
Set.walk_until : <T: key, S> fn(set: Set<T>, state: S, f: fn(S, T) -> :Continue(S) | :Break(S)) -> S

#' The set of `f` of every element.
#'
#' ```r dput
#' Set.map(Set.from_list([1, 2, 3]), function(x) x %% 2)
#' #> Set.from_list([1, 0])
#' ```
Set.map : <A: key, B: key> fn(set: Set<A>, f: fn(A) -> B) -> Set<B>

#' Unions the sets `f` returns for each element.
#'
#' ```r dput
#' Set.join_map(Set.from_list([1, 2]), function(x) Set.from_list([x, x * 10]))
#' #> Set.from_list([1, 10, 2, 20])
#' ```
Set.join_map : <A: key, B: key> fn(set: Set<A>, f: fn(A) -> Set<B>) -> Set<B>

#' The elements for which `predicate` is `TRUE`.
#'
#' ```r dput
#' Set.keep_if(Set.from_list([1, 2, 3]), function(x) x > 1)
#' #> Set.from_list([2, 3])
#' ```
Set.keep_if : <T: key> fn(set: Set<T>, predicate: fn(T) -> Bool) -> Set<T>

#' The elements for which `predicate` is `FALSE`.
#'
#' ```r dput
#' Set.drop_if(Set.from_list([1, 2, 3]), function(x) x > 1)
#' #> Set.from_list([1])
#' ```
Set.drop_if : <T: key> fn(set: Set<T>, predicate: fn(T) -> Bool) -> Set<T>

#' The set with room for `spare` more elements.
#'
#' ```r dput
#' Set.reserve(Set.single("a"), 1000)
#' #> Set.from_list(["a"])
#' ```
Set.reserve : <T: key> fn(set: Set<T>, spare: I64) -> Set<T>

#' How many elements the set holds before its storage must grow.
#'
#' ```r dput
#' Set.capacity(Set.reserve(Set.single("a"), 9))
#' #> 10i64
#' ```
Set.capacity : <T: key> fn(set: Set<T>) -> I64

#' The set with no room beyond its elements. An empty set keeps its smallest index, which has room
#' for 4.
#'
#' ```r dput
#' Set.capacity(Set.release_excess_capacity(Set.reserve(Set.single("a"), 9)))
#' #> 1i64
#' ```
Set.release_excess_capacity : <T: key> fn(set: Set<T>) -> Set<T>
