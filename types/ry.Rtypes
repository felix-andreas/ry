# ry's runtime package, `ry`: the DataFrame API, the data.table helpers that also take frames,
# and the conversions into ry's own values.
#
# The functions run only on ry's runtime, which binds them in the `ry` namespace and attaches it as
# `package:ry`. `crates/interp/src/frame.rs` and `dataframe.rs` implement them, and a test keeps
# this file's names and the runtime's equal. The standard library is its own namespace, declared
# in `std.Rtypes`.

# Conversions from a list to ry's own values. They are base builtins on ry's runtime, not part
# of `package:ry`, so the test that keeps this file and the runtime's table equal skips them.

as.record : fn(x: list[Any]) -> Any
as.tuple : fn(x: list[Any]) -> Any
as.tag : fn(x: list[Any]) -> Any

# DataFrame
#
# A Polars-style table API. The checker types the verbs structurally: the schema flows through
# `select`, `with_columns`, `filter`, `group_by`, `agg`, `sort`, `join`, `join_asof`, `head` and
# `collect`, and a
# string that names a column must name one the frame has. These declarations give the shapes the
# checker refines and cover the conversions and file IO.

@type Expr

DataFrame : fn(...: Any) -> DataFrame
as.DataFrame : fn(x: Any) -> DataFrame
is.DataFrame : fn(x: Any) -> logical
DataFrame.schema : fn(df: DataFrame) -> character
DataFrame.height : fn(df: DataFrame) -> integer
DataFrame.width : fn(df: DataFrame) -> integer
DataFrame.columns : fn(df: DataFrame) -> character
DataFrame.read_csv : fn(path: character, [strings_as_factors]: logical) -> DataFrame
DataFrame.read_parquet : fn(path: character) -> DataFrame
DataFrame.write_csv : fn(df: DataFrame, path: character) -> DataFrame
DataFrame.write_parquet : fn(df: DataFrame, path: character) -> DataFrame
DataFrame.select : fn(df: DataFrame, ...: Expr | character) -> DataFrame
DataFrame.with_columns : fn(df: DataFrame, ...: Expr | character) -> DataFrame
DataFrame.filter : fn(df: DataFrame, ...: Expr) -> DataFrame
DataFrame.group_by : fn(df: DataFrame, ...: Expr | character) -> GroupBy
DataFrame.sort : fn(df: DataFrame, ...: Expr | character, [descending]: logical) -> DataFrame
DataFrame.head : fn(df: DataFrame, [n]: integer | double) -> DataFrame
DataFrame.tail : fn(df: DataFrame, [n]: integer | double) -> DataFrame
DataFrame.join : fn(df: DataFrame, other: DataFrame, [on]: character, [how]: character, [left_on]: character, [right_on]: character, [suffix]: character) -> DataFrame
DataFrame.join_asof : fn(df: DataFrame, other: DataFrame, on: character, [by]: character | NULL, [strategy]: character, [suffix]: character) -> DataFrame
DataFrame.lazy : fn(df: DataFrame) -> LazyFrame
DataFrame.pivot : fn(df: DataFrame, on: character, index: character, values: character, [agg]: character | NULL) -> DataFrame
GroupBy.agg : fn(group: GroupBy, ...: Expr) -> DataFrame
LazyFrame.scan_csv : fn(path: character) -> LazyFrame
LazyFrame.scan_parquet : fn(path: character) -> LazyFrame
LazyFrame.select : fn(lf: LazyFrame, ...: Expr | character) -> LazyFrame
LazyFrame.with_columns : fn(lf: LazyFrame, ...: Expr | character) -> LazyFrame
LazyFrame.filter : fn(lf: LazyFrame, ...: Expr) -> LazyFrame
LazyFrame.group_by : fn(lf: LazyFrame, ...: Expr | character) -> LazyGroupBy
LazyFrame.sort : fn(lf: LazyFrame, ...: Expr | character, [descending]: logical) -> LazyFrame
LazyFrame.head : fn(lf: LazyFrame, [n]: integer | double) -> LazyFrame
LazyFrame.tail : fn(lf: LazyFrame, [n]: integer | double) -> LazyFrame
LazyFrame.join : fn(lf: LazyFrame, other: LazyFrame | DataFrame, [on]: character, [how]: character, [left_on]: character, [right_on]: character, [suffix]: character) -> LazyFrame
LazyFrame.join_asof : fn(lf: LazyFrame, other: LazyFrame | DataFrame, on: character, [by]: character | NULL, [strategy]: character, [suffix]: character) -> LazyFrame
LazyFrame.collect : fn(lf: LazyFrame) -> DataFrame
LazyFrame.explain : fn(lf: LazyFrame) -> character
LazyFrame.pivot : fn(lf: LazyFrame, on: character, index: character, values: character, [agg]: character | NULL) -> DataFrame
LazyGroupBy.agg : fn(group: LazyGroupBy, ...: Expr) -> LazyFrame

# Arithmetic, comparison and logic on an expression build a bigger expression, and a plain value
# on the other side is a literal.
Ops.Expr : fn(e1: Expr, e2: Expr | double | integer | character | logical | Date) -> Expr
Ops.Expr : fn(e1: double | integer | character | logical | Date, e2: Expr) -> Expr

col : fn(x: character, [as.factor]: logical) -> Expr
col : fn(x: Any, [as.factor]: logical) -> Any
lit : fn(value: Any) -> Expr
Expr.alias : fn(expr: Expr, name: character) -> Expr
Expr.sum : fn(expr: Expr) -> Expr
Expr.mean : fn(expr: Expr) -> Expr
Expr.min : fn(expr: Expr) -> Expr
Expr.max : fn(expr: Expr) -> Expr
Expr.first : fn(expr: Expr) -> Expr
Expr.last : fn(expr: Expr) -> Expr
Expr.median : fn(expr: Expr) -> Expr
Expr.std : fn(expr: Expr) -> Expr
Expr.var : fn(expr: Expr) -> Expr
Expr.count : fn(expr: Expr) -> Expr
Expr.head : fn(expr: Expr, [n]: integer | double) -> Expr
Expr.is_null : fn(expr: Expr) -> Expr
Expr.len : fn() -> Expr
Expr.if_else : fn(test: Expr, yes: Any, no: Any) -> Expr
Expr.cor : fn(first: Expr, second: Expr) -> Expr
Expr.over : fn(expr: Expr, ...: character) -> Expr
Expr.rank : fn(expr: Expr, [descending]: logical) -> Expr
