# xml2: parsing XML and HTML.
#
# R's classes form a hierarchy (`xml_document` is also an `xml_node`), which nominal types do not
# have, so a function that accepts a node names every class it accepts. A function with one overload
# per class ends with one over all of them, for a value whose class the checker does not know.
# `xml_find_first()` on a single node finds no match as an `xml_missing`, and searching an
# `xml_missing` finds nothing again. Searching and reading a parsed document are pure, while
# `read_xml()` and `read_html()` may read a file or a URL. A nodeset is a list of nodes, so `lapply`
# walks it, and xml2's `[` method keeps the class on a subset.

@type xml_document
@type xml_node
@type xml_nodeset {list[xml_node]}
@type xml_missing

[.xml_nodeset : fn(x: xml_nodeset, ...: Any) -> xml_nodeset

read_xml : fn(x: Any, [encoding]: character, ...: Any, [as_html]: logical, [options]: character[]) -> xml_document
read_html : fn(x: Any, [encoding]: character, ...: Any, [options]: character[]) -> xml_document
xml_find_all : @pure fn(x: xml_document | xml_node | xml_nodeset | xml_missing, xpath: character, [ns]: Any, ...: Any) -> xml_nodeset
xml_find_first : @pure fn(x: xml_nodeset, xpath: character, [ns]: Any) -> xml_nodeset
xml_find_first : fn(x: xml_document | xml_node | xml_missing, xpath: character, [ns]: Any) -> xml_node | xml_missing
xml_find_first : fn(x: xml_document | xml_node | xml_nodeset | xml_missing, xpath: character, [ns]: Any) -> xml_node | xml_nodeset | xml_missing
xml_attr : @pure fn(x: xml_nodeset, attr: character, [ns]: Any, [default]: character) -> character[]
xml_attr : fn(x: xml_document | xml_node | xml_missing, attr: character, [ns]: Any, [default]: character) -> character
xml_attr : fn(x: xml_document | xml_node | xml_nodeset | xml_missing, attr: character, [ns]: Any, [default]: character) -> character[]
xml_text : @pure fn(x: xml_nodeset, [trim]: logical) -> character[]
xml_text : fn(x: xml_document | xml_node | xml_missing, [trim]: logical) -> character
xml_text : fn(x: xml_document | xml_node | xml_nodeset | xml_missing, [trim]: logical) -> character[]
