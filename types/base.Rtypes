scan : Any
dput : <T> fn(x: T, [file]: Any, [control]: Any) -> T
file : fn([description]: character, [open]: character, [blocking]: logical, [encoding]: character, [raw]: logical, [method]: character) -> connection
url : fn(description: character, [open]: character, [blocking]: logical, [encoding]: character, [method]: character, [headers]: Any) -> connection
gzfile : fn(description: character, [open]: character, [encoding]: character, [compression]: Any) -> connection
textConnection : fn(object: Any, [open]: character, [local]: logical, [name]: character, [encoding]: character) -> connection
