file.path : @pure fn(...: Any, [fsep]: character) -> character
file.exists : fn(...: Any) -> logical
file.remove : fn(...: Any) -> logical
file.size : fn(...: Any) -> double
file.copy : fn(from: Any, to: Any, [overwrite]: logical, [recursive]: logical, [copy.mode]: logical, [copy.date]: logical) -> logical
file.rename : fn(from: Any, to: Any) -> logical
dir.exists : fn(paths: Any) -> logical
dir.create : fn(path: Any, [showWarnings]: logical, [recursive]: logical, [mode]: character) -> logical
