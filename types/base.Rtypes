readline : fn([prompt]: character) -> character

# Date and time construction. `difftime` and `as.difftime` produce the class the
# `Arith.difftime` / `Compare.difftime` methods above give arithmetic to;
# `format`/`strftime` render a date back to text.
difftime : @pure fn(time1: Any, time2: Any, [tz]: character, [units]: character) -> difftime
as.difftime : @pure fn(tim: Any, [format]: character, [units]: character) -> difftime
strftime : fn(x: Any, [format]: character, [tz]: character, [usetz]: logical, ...: Any) -> character
strptime : fn(x: Any, format: character, [tz]: character) -> POSIXct
weekdays : @pure fn(x: Any, [abbreviate]: logical) -> character
# lubridate adds months.numeric, which builds a period (`months(1)`).
months : @pure fn(x: double | integer) -> Any
months : fn(x: Any, [abbreviate]: logical) -> character
julian : @pure Any

# System and session.
Sys.time : fn() -> POSIXct
Sys.Date : fn() -> Date
Sys.getenv : fn([x]: Any, [unset]: Any, [names]: logical) -> character
# `Sys.setenv(VAR = "v")`: arbitrary variable names as named arguments.
Sys.setenv : Any
Sys.unsetenv : fn(x: Any) -> logical
Sys.sleep : fn(time: Any) -> NULL
Sys.getpid : fn() -> integer
Sys.info : fn() -> character[]
Sys.which : fn(names: Any) -> character
date : fn() -> character
system : fn(command: Any, [intern]: logical, [ignore.stdout]: logical, [ignore.stderr]: logical, [wait]: logical, [input]: Any, [timeout]: Any) -> Any
system2 : fn(command: Any, [args]: Any, [stdout]: Any, [stderr]: Any, [stdin]: Any, [input]: Any, [env]: Any, [wait]: logical, [timeout]: Any) -> Any
system.time : fn(expr: Any, [gcFirst]: logical) -> Any
quit : fn([save]: character, [status]: Any, [runLast]: logical) -> Any
q : fn([save]: character, [status]: Any, [runLast]: logical) -> Any
# `summary` is an S3 generic whose result shape is class-dependent; `diff` is type-preserving.
summary : Any
diff : @pure fn(x: Any, [lag]: Any, [differences]: Any, ...: Any) -> Any

# Interactive debugging. All side-effecting; `debug`/`trace` take the function object itself
# (Any-param: any callable value is legal), and the returns follow R (`NULL` invisibly, except
# `isdebugged`'s query and `trace`'s returned name).
browser : fn([text]: character, [condition]: Any, [expr]: Any, [skipCalls]: integer) -> NULL
debug : fn(fun: Any, [text]: character, [condition]: Any, [signature]: Any) -> NULL
debugonce : fn(fun: Any, [text]: character, [condition]: Any, [signature]: Any) -> NULL
undebug : fn(fun: Any, [signature]: Any) -> NULL
isdebugged : fn(fun: Any, [signature]: Any) -> logical
trace : fn(what: Any, [tracer]: Any, [exit]: Any, [at]: Any, [print]: logical, [signature]: Any, [where]: Any, [edit]: Any) -> character
untrace : fn(what: Any, [signature]: Any, [where]: Any) -> Any
traceback : fn([x]: Any, [max.lines]: Any) -> Any
# The S4 dispatch primitive lives in base, not methods.
standardGeneric : fn(f: character, [fdef]: Any) -> Any
