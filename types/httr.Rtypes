# httr: the legacy HTTP client.

# `parse_url()` returns a list of class "url" whose fields (`scheme`, `hostname`, `path`, ...) are
# rebuilt into a string by `build_url()`. `parse_url()` hands a `url` back unchanged, and the verbs
# parse their `url` argument, so both take either form.
@type url
@type response

parse_url : @pure fn(url: character | url) -> url
build_url : @pure fn(url: url) -> character
GET : fn([url]: character | url | NULL, [config]: Any, ...: Any, [handle]: Any) -> response
