# purrr: functional programming over lists and vectors.
#
# A mapped function receives each element. The candidates go from the shape
# that keeps the most information to the most general: a named input keeps its
# names in the result. `.f` may also be a formula, a name, or a position,
# which the last candidate of each set accepts. None of these is pure, because
# they call `.f`.
map : <T, U> fn(.x: list[named: T] | T[named], .f: fn(T) -> U, ...: Any, [.progress]: logical | character) -> list[named: U]
map : <T, U> fn(.x: list[T] | T[], .f: fn(T) -> U, ...: Any, [.progress]: logical | character) -> list[U]
map : fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> list[Any]
map_dbl : <T> fn(.x: list[named: T] | T[named], .f: fn(T) -> double, ...: Any, [.progress]: logical | character) -> double[named]
map_dbl : <T> fn(.x: list[T] | T[], .f: fn(T) -> double, ...: Any, [.progress]: logical | character) -> double[]
map_dbl : fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> double[]
map_int : <T> fn(.x: list[named: T] | T[named], .f: fn(T) -> integer, ...: Any, [.progress]: logical | character) -> integer[named]
map_int : <T> fn(.x: list[T] | T[], .f: fn(T) -> integer, ...: Any, [.progress]: logical | character) -> integer[]
map_int : fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> integer[]
map_lgl : <T> fn(.x: list[named: T] | T[named], .f: fn(T) -> logical, ...: Any, [.progress]: logical | character) -> logical[named]
map_lgl : <T> fn(.x: list[T] | T[], .f: fn(T) -> logical, ...: Any, [.progress]: logical | character) -> logical[]
map_lgl : fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> logical[]
map_chr : <T> fn(.x: list[named: T] | T[named], .f: fn(T) -> character, ...: Any, [.progress]: logical | character) -> character[named]
map_chr : <T> fn(.x: list[T] | T[], .f: fn(T) -> character, ...: Any, [.progress]: logical | character) -> character[]
map_chr : fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> character[]
map2 : <T, U, V> fn(.x: list[T] | T[], .y: list[U] | U[], .f: fn(T, U) -> V, ...: Any, [.progress]: logical | character) -> list[V]
map2 : fn(.x: Any, .y: Any, .f: Any, ...: Any, [.progress]: logical | character) -> list[Any]
map2_dbl : <T, U> fn(.x: list[T] | T[], .y: list[U] | U[], .f: fn(T, U) -> double, ...: Any, [.progress]: logical | character) -> double[]
map2_dbl : fn(.x: Any, .y: Any, .f: Any, ...: Any, [.progress]: logical | character) -> double[]
map2_chr : <T, U> fn(.x: list[T] | T[], .y: list[U] | U[], .f: fn(T, U) -> character, ...: Any, [.progress]: logical | character) -> character[]
map2_chr : fn(.x: Any, .y: Any, .f: Any, ...: Any, [.progress]: logical | character) -> character[]
walk : <T, X> fn(.x: X, .f: fn(T) -> Any, ...: Any, [.progress]: logical | character) -> X

# Filtering keeps the shape of `.x`.
keep : <T> fn(.x: T[], .p: fn(T) -> logical, ...: Any) -> T[]
keep : <T> fn(.x: list[named: T], .p: fn(T) -> logical, ...: Any) -> list[named: T]
keep : <T> fn(.x: list[T], .p: fn(T) -> logical, ...: Any) -> list[T]
keep : fn(.x: Any, .p: Any, ...: Any) -> Any
discard : <T> fn(.x: T[], .p: fn(T) -> logical, ...: Any) -> T[]
discard : <T> fn(.x: list[named: T], .p: fn(T) -> logical, ...: Any) -> list[named: T]
discard : <T> fn(.x: list[T], .p: fn(T) -> logical, ...: Any) -> list[T]
discard : fn(.x: Any, .p: Any, ...: Any) -> Any

reduce : <T, A> fn(.x: list[T] | T[], .f: fn(A, T) -> A, ...: Any, [.init]: A, [.dir]: character) -> A

# Adverbs wrap a function and only build the wrapper, so they are pure.
# `possibly()` returns `otherwise` where `.f` fails; one candidate per arity
# keeps the argument types.
possibly : @pure <A, R, O> fn(.f: fn(A) -> R, [otherwise]: O, [quiet]: logical) -> fn(A) -> R | O
possibly : @pure <A, B, R, O> fn(.f: fn(A, B) -> R, [otherwise]: O, [quiet]: logical) -> fn(A, B) -> R | O
possibly : @pure <A, B, C, R, O> fn(.f: fn(A, B, C) -> R, [otherwise]: O, [quiet]: logical) -> fn(A, B, C) -> R | O
possibly : @pure <R, O> fn(.f: fn(...: Any) -> R, [otherwise]: O, [quiet]: logical) -> fn(...: Any) -> R | O
safely : @pure <A, R, O> fn(.f: fn(A) -> R, [otherwise]: O, [quiet]: logical) -> fn(A) -> list{result: R | O, error: Any}
safely : @pure <R, O> fn(.f: fn(...: Any) -> R, [otherwise]: O, [quiet]: logical) -> fn(...: Any) -> list{result: R | O, error: Any}
