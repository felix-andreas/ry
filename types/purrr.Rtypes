# purrr: functional programming over lists and vectors.
#
# A mapped function receives each element. The candidates go from the shape
# that keeps the most information to the most general: a named input keeps its
# names in the result. `.f` may also be a formula, a name, or a position,
# which the last candidate of each set accepts. None of these is pure, because
# they call `.f`.
map : @pure(.f) <T, U> fn(.x: list[named: T] | T[named], .f: fn(T) -> U, ...: Any, [.progress]: logical | character) -> list[named: U]
map : @pure(.f) <T, U> fn(.x: list[T] | T[], .f: fn(T) -> U, ...: Any, [.progress]: logical | character) -> list[U]
map : @pure(.f) fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> list[Any]
map_dbl : @pure(.f) <T> fn(.x: list[named: T] | T[named], .f: fn(T) -> double, ...: Any, [.progress]: logical | character) -> double[named]
map_dbl : @pure(.f) <T> fn(.x: list[T] | T[], .f: fn(T) -> double, ...: Any, [.progress]: logical | character) -> double[]
map_dbl : @pure(.f) fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> double[]
map_int : @pure(.f) <T> fn(.x: list[named: T] | T[named], .f: fn(T) -> integer, ...: Any, [.progress]: logical | character) -> integer[named]
map_int : @pure(.f) <T> fn(.x: list[T] | T[], .f: fn(T) -> integer, ...: Any, [.progress]: logical | character) -> integer[]
map_int : @pure(.f) fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> integer[]
map_lgl : @pure(.f) <T> fn(.x: list[named: T] | T[named], .f: fn(T) -> logical, ...: Any, [.progress]: logical | character) -> logical[named]
map_lgl : @pure(.f) <T> fn(.x: list[T] | T[], .f: fn(T) -> logical, ...: Any, [.progress]: logical | character) -> logical[]
map_lgl : @pure(.f) fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> logical[]
map_chr : @pure(.f) <T> fn(.x: list[named: T] | T[named], .f: fn(T) -> character, ...: Any, [.progress]: logical | character) -> character[named]
map_chr : @pure(.f) <T> fn(.x: list[T] | T[], .f: fn(T) -> character, ...: Any, [.progress]: logical | character) -> character[]
map_chr : @pure(.f) fn(.x: Any, .f: Any, ...: Any, [.progress]: logical | character) -> character[]
map2 : @pure(.f) <T, U, V> fn(.x: list[T] | T[], .y: list[U] | U[], .f: fn(T, U) -> V, ...: Any, [.progress]: logical | character) -> list[V]
map2 : @pure(.f) fn(.x: Any, .y: Any, .f: Any, ...: Any, [.progress]: logical | character) -> list[Any]
map2_dbl : <T, U> fn(.x: list[T] | T[], .y: list[U] | U[], .f: fn(T, U) -> double, ...: Any, [.progress]: logical | character) -> double[]
map2_dbl : fn(.x: Any, .y: Any, .f: Any, ...: Any, [.progress]: logical | character) -> double[]
map2_chr : <T, U> fn(.x: list[T] | T[], .y: list[U] | U[], .f: fn(T, U) -> character, ...: Any, [.progress]: logical | character) -> character[]
map2_chr : fn(.x: Any, .y: Any, .f: Any, ...: Any, [.progress]: logical | character) -> character[]
walk : <T, X> fn(.x: X, .f: fn(T) -> Any, ...: Any, [.progress]: logical | character) -> X
walk : <X> fn(.x: X, .f: Any, ...: Any, [.progress]: logical | character) -> X

# Filtering keeps the shape of `.x`.
keep : @pure(.p) <T> fn(.x: T[], .p: fn(T) -> logical, ...: Any) -> T[]
keep : @pure(.p) <T> fn(.x: list[named: T], .p: fn(T) -> logical, ...: Any) -> list[named: T]
keep : @pure(.p) <T> fn(.x: list[T], .p: fn(T) -> logical, ...: Any) -> list[T]
keep : @pure(.p) fn(.x: Any, .p: Any, ...: Any) -> Any
discard : @pure(.p) <T> fn(.x: T[], .p: fn(T) -> logical, ...: Any) -> T[]
discard : @pure(.p) <T> fn(.x: list[named: T], .p: fn(T) -> logical, ...: Any) -> list[named: T]
discard : @pure(.p) <T> fn(.x: list[T], .p: fn(T) -> logical, ...: Any) -> list[T]
discard : @pure(.p) fn(.x: Any, .p: Any, ...: Any) -> Any

reduce : @pure(.f) <T, A> fn(.x: list[T] | T[], .f: fn(A, T) -> A, ...: Any, [.init]: A, [.dir]: character) -> A
reduce : @pure(.f) fn(.x: Any, .f: Any, ...: Any, [.init]: Any, [.dir]: character) -> Any

# Adverbs wrap a function and only build the wrapper, so they are pure.
# `possibly()` returns `otherwise` where `.f` fails. The wrapper takes any
# arguments: a candidate per arity would keep their types but drop their names,
# and `safely(gh)(endpoint, branch = branch)` passes them by name.
possibly : @pure <R, O> fn(.f: fn(...: Any) -> R, [otherwise]: O, [quiet]: logical) -> fn(...: Any) -> R | O
possibly : @pure fn(.f: Any, [otherwise]: Any, [quiet]: logical) -> fn(...: Any) -> Any
safely : @pure <R, O> fn(.f: fn(...: Any) -> R, [otherwise]: O, [quiet]: logical) -> fn(...: Any) -> list{result: R | O, error: Any}
safely : @pure fn(.f: Any, [otherwise]: Any, [quiet]: logical) -> fn(...: Any) -> list{result: Any, error: Any}
