# Standard-library stubs: methods package (S4).
#
# Declaration-only stub file (`.Rtypes`); see base.Rtypes for the format and the shared compromise
# vocabulary. The S4 machinery is dynamic — class membership and coercion results depend on runtime
# class definitions and dispatch — so most returns are `Any`. Stubbing the names still resolves them
# and keeps strict mode from flagging them. (S4 class, generic, and method *names* are tracked
# separately as string literals, not through these bindings.)

# widened to Any: each return is dynamic — it depends on a runtime class or argument value, not on the
# argument *types*, so a static return would be falsely precise.
# - `is(object)` returns the class vector while `is(object, class2)` returns a logical (arity-dependent).
# - `as(object, Class)` and `new(Class, ...)` return an object of the runtime-named class; `new` and
#   `representation`/`signature` also take arbitrary slot/class names as named arguments.
# - `validObject` returns its argument if valid (shape mirrors the input).
# - `setClass`/`setGeneric`/`setMethod`/`setValidity`/`setRefClass` return S4 machinery objects (a class
#   generator, the generic/method name, a class representation) tied to the dynamic dispatch system.
# - `callNextMethod` forwards to the next method (result and named arguments are dispatch-dependent).
is : Any
as : Any
new : Any
validObject : Any
setClass : Any
setGeneric : Any
setMethod : Any
setValidity : Any
setRefClass : Any
representation : Any
signature : Any
callNextMethod : Any
getMethod : Any
selectMethod : Any
getGenerics : Any
getSlots : Any

# Fixed signatures: predicates return a single logical; `slotNames` genuinely returns the slot-name
# vector; `show` is the S4 print generic (returns NULL invisibly per convention); `standardGeneric`
# dispatches and returns the method's (dynamic) value. `slot : fn(object: Any, name: Any, [check]:
# logical) -> Any` is deliberately NOT declared yet: a naming fixture binds `slot` as a local helper
# and would fire the builtin-shadow warning; rename it first, then declare.
isVirtualClass : fn(Class: character, [where]: Any) -> logical
extends : fn(class1: character, class2: character, [maybe]: Any, [fullInfo]: Any) -> logical
isGeneric : fn(f: Any, [where]: Any, [fdef]: Any, [getName]: logical) -> logical
existsMethod : fn(f: Any, [signature]: Any, [where]: Any) -> logical
hasMethod : fn(f: Any, [signature]: Any, [where]: Any) -> logical
slot : fn(object: Any, name: character) -> Any
slotNames : fn(x: Any) -> character[]
show : fn(object: Any) -> Any
